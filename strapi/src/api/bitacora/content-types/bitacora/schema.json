{
  "kind": "collectionType",
  "collectionName": "bitacoras",
  "info": {
    "singularName": "bitacora",
    "pluralName": "bitacoras",
    "displayName": "Bitácora"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "extracto": {
      "type": "text"
    },
    "contenido": {
      "type": "richtext"
    },
    "categoria": {
      "type": "string"
    },
    "tiempo_lectura": {
      "type": "integer"
    },
    "imagen": {
      "type": "string"
    },
    "fecha": {
      "type": "date"
    },
    "marca": {
      "type": "enumeration",
      "enum": [
        "tierras",
        "naturaleza",
        "meliponas",
        "cafe",
        "gestion",
        "granja"
      ],
      "required": true,
      "default": "tierras"
    },
    "destacado": {
      "type": "boolean",
      "default": false
    },
    "subsistema": {
      "type": "enumeration",
      "enum": [
        "gestion-hidrica",
        "energia",
        "biorefineria-domestica",
        "agroecosistema-productivo",
        "gemelo-digital",
        "bioarquitectura"
      ]
    },
    "experimento": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::experimento.experimento",
      "inversedBy": "bitacoras"
    },
    "publicado": { "type": "boolean", "default": true },
    "autor": { "type": "string" },
    "etiquetas": { "type": "json" },
    "fecha_actualizacion": { "type": "date" },
    "meta_title": { "type": "string" },
    "meta_description": { "type": "text" }
  }
}
