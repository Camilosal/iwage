{
  "kind": "collectionType",
  "collectionName": "experimentos",
  "info": {
    "singularName": "experimento",
    "pluralName": "experimentos",
    "displayName": "Experimento"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "extracto": {
      "type": "text"
    },
    "subsistema": {
      "type": "enumeration",
      "enum": [
        "gestion-hidrica",
        "energia",
        "biorefineria-domestica",
        "agroecosistema-productivo",
        "gemelo-digital",
        "bioarquitectura"
      ]
    },
    "estado_experimento": {
      "type": "enumeration",
      "enum": [
        "idea",
        "en_curso",
        "con_resultados",
        "validado",
        "descartado"
      ],
      "default": "idea"
    },
    "fecha": {
      "type": "date"
    },
    "imagen": {
      "type": "string"
    },
    "origen": {
      "type": "richtext"
    },
    "hipotesis": {
      "type": "richtext"
    },
    "proceso": {
      "type": "richtext"
    },
    "resultado": {
      "type": "richtext"
    },
    "leccion": {
      "type": "richtext"
    },
    "servicio_derivado": {
      "type": "richtext"
    },
    "fuentes_inspiracion": {
      "type": "richtext"
    },
    "destacado": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "string"
    },
    "tiempo_lectura": {
      "type": "integer"
    },
    "bitacoras": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bitacora.bitacora",
      "mappedBy": "experimento"
    },
    "documentos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["files", "images", "videos"]
    }
  }
}
