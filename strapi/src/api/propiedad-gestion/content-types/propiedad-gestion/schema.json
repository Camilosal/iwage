{
  "kind": "collectionType",
  "collectionName": "propiedades_gestion",
  "info": {
    "singularName": "propiedad-gestion",
    "pluralName": "propiedades-gestion",
    "displayName": "Propiedad en Gestión",
    "description": "Propiedades rurales gestionadas por Iwagé Gestión con cross-links al ecosistema"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "descripcion": {
      "type": "richtext"
    },
    "tipo_gestion": {
      "type": "enumeration",
      "enum": [
        "renta_corta",
        "finca_productiva",
        "segunda_residencia",
        "operacion_turistica"
      ],
      "default": "renta_corta"
    },
    "tipo_alojamiento": {
      "type": "enumeration",
      "enum": [
        "finca",
        "casa_campestre",
        "cabana",
        "glamping",
        "domo",
        "minicasa",
        "apartamento"
      ],
      "default": "finca"
    },
    "modelo_alianza": {
      "type": "enumeration",
      "enum": [
        "gestion_pura",
        "co_inversion",
        "operacion_compartida"
      ],
      "default": "gestion_pura"
    },
    "estado": {
      "type": "enumeration",
      "enum": [
        "activa",
        "pausada",
        "prospecto"
      ],
      "default": "activa"
    },
    "es_destacado": {
      "type": "boolean",
      "default": false
    },
    "publicado": {
      "type": "boolean",
      "default": false
    },
    "precio_noche": {
      "type": "decimal"
    },
    "precio_mensual": {
      "type": "decimal"
    },
    "moneda": {
      "type": "string",
      "default": "COP"
    },
    "ubicacion_municipio": {
      "type": "string"
    },
    "ubicacion_latitud": {
      "type": "decimal"
    },
    "ubicacion_longitud": {
      "type": "decimal"
    },
    "area_hectareas": {
      "type": "decimal"
    },
    "numero_habitaciones": {
      "type": "integer"
    },
    "numero_banos": {
      "type": "integer"
    },
    "capacidad_huespedes": {
      "type": "integer"
    },
    "amenidades": {
      "type": "json"
    },
    "highlights": {
      "type": "json"
    },
    "imagen_principal": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "galeria": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "propiedad_tierras": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::propiedad.propiedad"
    },
    "experiencias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experiencia.experiencia",
      "mappedBy": "propiedades_gestion"
    },
    "anfitriones": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::anfitrion.anfitrion",
      "inversedBy": "propiedades_gestion"
    },
    "seo_titulo": {
      "type": "string"
    },
    "seo_descripcion": {
      "type": "text"
    },
    "proveedores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::proveedor.proveedor",
      "mappedBy": "propiedades_gestion"
    },
    "complementos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::complemento.complemento",
      "mappedBy": "propiedades_gestion"
    },
    "productos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::producto.producto",
      "mappedBy": "propiedades_gestion"
    }
  }
}
