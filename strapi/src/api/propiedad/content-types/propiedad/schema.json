{
  "kind": "collectionType",
  "collectionName": "propiedades",
  "info": {
    "singularName": "propiedad",
    "pluralName": "propiedades",
    "displayName": "Propiedad"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "uuid": {
      "type": "string"
    },
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "descripcion": {
      "type": "richtext"
    },
    "seo_titulo": {
      "type": "string"
    },
    "seo_descripcion": {
      "type": "text"
    },
    "tipo_propiedad": {
      "type": "enumeration",
      "enum": [
        "finca",
        "lote",
        "casa_campestre",
        "predio_rural",
        "terreno",
        "otro"
      ],
      "default": "finca"
    },
    "operacion": {
      "type": "enumeration",
      "enum": [
        "venta",
        "arriendo"
      ],
      "default": "venta"
    },
    "precio": {
      "type": "decimal"
    },
    "moneda": {
      "type": "string",
      "default": "COP"
    },
    "estado": {
      "type": "enumeration",
      "enum": [
        "disponible",
        "reservado",
        "vendido",
        "retirado"
      ],
      "default": "disponible"
    },
    "es_destacado": {
      "type": "boolean",
      "default": false
    },
    "publicado": {
      "type": "boolean",
      "default": false
    },
    "ubicacion_direccion": {
      "type": "string"
    },
    "ubicacion_municipio": {
      "type": "string"
    },
    "ubicacion_departamento": {
      "type": "string",
      "default": "Tolima"
    },
    "ubicacion_latitud": {
      "type": "decimal"
    },
    "ubicacion_longitud": {
      "type": "decimal"
    },
    "area_total": {
      "type": "decimal"
    },
    "area_construida": {
      "type": "decimal"
    },
    "area_hectareas": {
      "type": "decimal"
    },
    "numero_habitaciones": {
      "type": "integer"
    },
    "numero_banos": {
      "type": "integer"
    },
    "numero_garajes": {
      "type": "integer"
    },
    "anno_construccion": {
      "type": "integer"
    },
    "caracteristicas": {
      "type": "json"
    },
    "video_url": {
      "type": "string"
    },
    "tour_virtual_url": {
      "type": "string"
    },
    "link_drone": {
      "type": "string"
    },
    "disponibilidad_agua": {
      "type": "string"
    },
    "energia_electrica": {
      "type": "boolean",
      "default": false
    },
    "tipo_via": {
      "type": "string"
    },
    "distancia_centro_poblado": {
      "type": "decimal"
    },
    "sello_vap": {
      "type": "enumeration",
      "enum": [
        "oro",
        "plata",
        "bronce",
        "cuarentena"
      ],
      "default": "plata"
    },
    "modelo_sugerido": {
      "type": "json"
    },
    "imagenes": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "imagen_principal": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "detalle_rural": {
      "type": "json"
    },
    "verificacion_vap": {
      "type": "json"
    },
    "perfil_comprador": {
      "type": "enumeration",
      "enum": [
        "productivo",
        "campestre",
        "nomada",
        "turistico",
        "patrimonial"
      ],
      "default": "productivo"
    },
    "proveedores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::proveedor.proveedor",
      "mappedBy": "propiedades"
    },
    "experiencias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experiencia.experiencia",
      "mappedBy": "propiedades"
    },
    "propiedades_gestion": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::propiedad-gestion.propiedad-gestion",
      "mappedBy": "propiedad_tierras"
    }
  }
}