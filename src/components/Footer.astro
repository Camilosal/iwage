---
import { SITE, NAV_LINKS } from '@/config/site';
import Icon from '@/components/shared/Icon.astro';

const primaryLinks = NAV_LINKS.filter((item) => !item.children);
const submenuGroups = NAV_LINKS.filter((item) => item.children);
---

<footer class="bg-dark-bg text-dark-text">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
                    <Icon name="hexagon" class="w-6 h-6 text-accent" />
          <span class="font-bold text-lg">{SITE.name}</span>
        </div>
        <p class="text-sm text-dark-text/60 leading-relaxed max-w-xs">
          {SITE.tagline}. Profesionalizando la meliponicultura en el Tolima mediante ciencia, conservación y transparencia radical.
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Navegación</h3>
        <ul class="space-y-2.5">
          {primaryLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-dark-text/60 hover:text-dark-text transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Each submenu group as its own column -->
      {submenuGroups.map((group) => (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-accent mb-4">{group.label}</h3>
          <ul class="space-y-2.5">
            {group.children!.map((child) => (
              <li>
                <a href={child.href} target={child.external ? '_blank' : undefined} rel={child.external ? 'noopener noreferrer' : undefined} class="text-sm text-dark-text/60 hover:text-dark-text transition-colors">
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Contacto -->
      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Contacto</h3>
        <ul class="space-y-2.5 text-sm text-dark-text/60">
          <li><Icon name="map-pin" class="w-3.5 h-3.5 inline" /> {SITE.location}</li>
          <li><Icon name="message-circle" class="w-3.5 h-3.5 inline" /> Asesoría WhatsApp</li>
          <li><Icon name="camera" class="w-3.5 h-3.5 inline" /> {SITE.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-dark-text/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="font-mono text-xs text-dark-text/40 uppercase tracking-widest">
        © {new Date().getFullYear()} {SITE.name} Meliponario. Todos los derechos reservados.
      </p>
      <a href="/" class="inline-flex items-center gap-1.5 text-xs text-dark-text/50 hover:text-dark-text transition-colors">
        <Icon name="globe" class="w-3.5 h-3.5 inline" /> Parte del ecosistema Iwagé <Icon name="arrow-right" class="w-3 h-3 inline" />
      </a>
    </div>
  </div>
</footer>
