---
interface Props {
  title: string;
  location: string;
  type: string;
  status: string;
  description: string;
  colmenas?: number;
  image?: string;
  slug?: string;
  iot?: boolean;
  trazabilidad?: boolean;
}
const { title, location, type, status, description, colmenas, image, slug, iot = false, trazabilidad = false } = Astro.props;

const statusConfig: Record<string, { label: string; class: string }> = {
  activo: { label: 'Activo', class: 'bg-brand-muted text-brand' },
  'en-proceso': { label: 'En proceso', class: 'bg-accent-muted text-accent' },
  diagnostico: { label: 'Diagnóstico', class: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300' },
  diseno: { label: 'Diseño', class: 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300' },
  instalacion: { label: 'Instalación', class: 'bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300' },
  pausado: { label: 'Pausado', class: 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300' },
  finalizado: { label: 'Finalizado', class: 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400' },
};
const st = statusConfig[status] ?? statusConfig['en-proceso'];
---

<a href={slug ? `/meliponas/proyectos/${slug}` : undefined} class="group block bg-surface-raised rounded-2xl border border-border overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
  {image && (
    <div class="aspect-[16/10] overflow-hidden bg-surface-sunken">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center gap-2 mb-3">
      <span class={`text-xs font-medium rounded-full px-3 py-1 ${st.class}`}>{st.label}</span>
      <span class="text-xs text-text-muted capitalize">{type}</span>
    </div>
    <h3 class="text-lg font-semibold text-text-primary mb-1 group-hover:text-brand transition-colors">{title}</h3>
    <p class="flex items-center gap-1 text-sm text-text-muted mb-3">
      <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
      {location}
    </p>
    <p class="text-sm text-text-secondary leading-relaxed line-clamp-2">{description}</p>
    <div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
      {colmenas ? (
        <span class="text-sm font-medium text-brand">{colmenas} colmenas</span>
      ) : <span></span>}
      <div class="flex items-center gap-2">
        {iot && (
          <span class="inline-flex items-center gap-1 text-xs text-text-muted" title="Monitoreo IoT">
            <i data-lucide="radio" class="w-3.5 h-3.5 text-brand"></i> IoT
          </span>
        )}
        {trazabilidad && (
          <span class="inline-flex items-center gap-1 text-xs text-text-muted" title="Trazabilidad QR">
            <i data-lucide="qr-code" class="w-3.5 h-3.5 text-brand"></i> QR
          </span>
        )}
      </div>
    </div>
  </div>
</a>
