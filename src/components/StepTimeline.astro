---
interface Step {
  number: number;
  title: string;
  description: string;
}
interface Props {
  steps: Step[];
  dark?: boolean;
}
const { steps, dark = false } = Astro.props;
---

<div class="relative">
  <div class={`absolute left-6 top-0 bottom-0 w-px ${dark ? 'bg-dark-text/20' : 'bg-border'}`}></div>
  <div class="space-y-10">
    {steps.map((step) => (
      <div class="relative flex gap-6">
        <div class={`relative z-10 w-12 h-12 rounded-full flex items-center justify-center shrink-0 font-mono text-sm font-medium ${dark ? 'bg-accent text-dark-bg' : 'bg-brand text-white'}`}>
          {String(step.number).padStart(2, '0')}
        </div>
        <div class="pt-2">
          <h3 class={`text-lg font-semibold mb-1 ${dark ? 'text-dark-text' : 'text-text-primary'}`}>
            {step.title}
          </h3>
          <p class={`text-sm leading-relaxed ${dark ? 'text-dark-text/60' : 'text-text-secondary'}`}>
            {step.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>
