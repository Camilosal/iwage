---
import { mediaSrc, type MediaItem } from '@/lib/media';

interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
  href: string;
  /** La portada ya normalizada (`getBitacoraByMarca`/`getResumenBitacora`). */
  image?: MediaItem | null;
}
const { title, excerpt, category, date, readTime, href, image } = Astro.props;

// `mediaSrc()` hace dos cosas acá y ninguna de las dos la hacía el `src={image}` anterior:
//  · acepta un `MediaItem`, un string o `null`, así que la tarjeta no puede pintar
//    `[object Object]` ni con un llamador que le pase la forma vieja;
//  · reduce una portada absoluta de Strapi (una URL con el host interno del compose,
//    iwage_strapi:1337) a la ruta de sitio `/uploads/...`, que es lo que sirve nginx.
//    Interpolada tal cual, la tarjeta le pediría al navegador un host inalcanzable.
const src = mediaSrc(image ?? null);
// El `alternativeText` del admin describe la foto; el título describe el artículo.
const alt = image?.alt || title;

// Fallback image placeholder (using a gradient div)
const hasImage = !!src;
---

<a
  href={href}
  class="group block bg-surface-raised rounded-2xl border border-border overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 h-full flex flex-col"
>
  <div class={`aspect-[16/10] overflow-hidden ${hasImage ? '' : 'bg-gradient-to-br from-brand-muted/30 to-accent-muted/30'}`}>
    {hasImage ? (
      <img
        src={src}
        alt={alt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
        width="640"
        height="400"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-brand/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5A2.25 2.25 0 000 6.75v10.5A2.25 2.25 0 002.25 19.5h10.5A2.25 2.25 0 0015 17.25V15m-10.5-12h11.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-11.25A1.125 1.125 0 011.5 15v-9.75c0-.621.504-1.125 1.125-1.125z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm3 13.5a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
    )}
  </div>
  <div class="p-6 flex flex-col flex-1">
    <span class="inline-block bg-brand-muted text-brand text-xs font-medium rounded-full px-3 py-1 mb-3 shrink-0">
      {category}
    </span>
    <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-brand transition-colors shrink-0">
      {title}
    </h3>
    <p class="text-sm text-text-secondary leading-relaxed line-clamp-3 flex-1">{excerpt}</p>
    <div class="flex items-center gap-3 mt-4 text-xs text-text-muted shrink-0">
      <span>{date}</span>
      <span class="w-1 h-1 rounded-full bg-text-muted"></span>
      <span>{readTime} min lectura</span>
    </div>
  </div>
</a>
