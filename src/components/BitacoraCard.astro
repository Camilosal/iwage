---
interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
  href: string;
  image?: string;
}
const { title, excerpt, category, date, readTime, href, image } = Astro.props;
---

<a
  href={href}
  class="group block bg-surface-raised rounded-2xl border border-border overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300"
>
  {image && (
    <div class="aspect-[16/10] overflow-hidden bg-surface-sunken">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <span class="inline-block bg-brand-muted text-brand text-xs font-medium rounded-full px-3 py-1 mb-3">
      {category}
    </span>
    <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-brand transition-colors">
      {title}
    </h3>
    <p class="text-sm text-text-secondary leading-relaxed line-clamp-2">{excerpt}</p>
    <div class="flex items-center gap-3 mt-4 text-xs text-text-muted">
      <span>{date}</span>
      <span class="w-1 h-1 rounded-full bg-text-muted"></span>
      <span>{readTime} min lectura</span>
    </div>
  </div>
</a>
