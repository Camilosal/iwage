---
interface Props {
  name: string;
  description: string;
  price: number;
  presentation?: string;
  image?: string;
  destacado?: boolean;
}
const { name, description, price, presentation, image, destacado = false } = Astro.props;
const formattedPrice = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(price);
---

<div class="group bg-surface-raised rounded-2xl border border-border overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
  <div class="aspect-square overflow-hidden bg-surface-sunken relative">
    {image ? (
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-text-muted">
        <i data-lucide="package" class="w-12 h-12"></i>
      </div>
    )}
    {destacado && (
      <span class="absolute top-3 left-3 bg-accent text-white text-xs font-medium rounded-full px-3 py-1">
        Destacado
      </span>
    )}
  </div>
  <div class="p-5">
    <h3 class="text-base font-semibold text-text-primary mb-1">{name}</h3>
    {presentation && (
      <p class="text-xs text-text-muted mb-2">{presentation}</p>
    )}
    <p class="text-sm text-text-secondary leading-relaxed line-clamp-2 mb-4">{description}</p>
    <div class="flex items-center justify-between">
      <span class="text-lg font-bold text-brand">{formattedPrice}</span>
      <button
        type="button"
        class="add-to-cart bg-brand text-white text-sm font-medium rounded-full px-4 py-2 hover:bg-brand-light hover:scale-[1.02] transition-all"
        data-name={name}
        data-price={price}
      >
        Agregar
      </button>
    </div>
  </div>
</div>
