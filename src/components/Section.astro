---
interface Props {
  class?: string;
  bg?: 'default' | 'sunken' | 'dark' | 'brand-muted';
  id?: string;
  width?: 'full' | '7xl' | 'xl' | 'lg' | 'md' | 'sm';
  compact?: boolean;
}
const { class: className = '', bg = 'default', id, width = 'xl', compact = false } = Astro.props;

const bgClasses = {
  default: 'bg-surface',
  sunken: 'bg-surface-sunken',
  dark: 'bg-dark-bg text-dark-text',
  'brand-muted': 'bg-brand-muted',
};
const widthClasses = {
  full: 'max-w-full',
  '7xl': 'max-w-7xl',
  xl: 'max-w-6xl',
  lg: 'max-w-5xl',
  md: 'max-w-4xl',
  sm: 'max-w-3xl',
};
const pyClasses = compact ? 'py-8 md:py-10' : 'py-10 md:py-14';
---

<section id={id} class={`${pyClasses} ${bgClasses[bg]} ${className}`}>
  <div class={`${widthClasses[width]} mx-auto px-6`}>
    <slot />
  </div>
</section>
