---
/**
 * BitacoraSidebar — Unified filter sidebar for bitácora pages.
 * Desktop: sticky sidebar (slot:sidebar), collapsible.
 * Mobile: slide-over drawer triggered by slot:toggle button.
 */
interface CategoryCount {
  name: string;
  count: number;
}

interface Props {
  categories: CategoryCount[];
  totalArticles: number;
}

const { categories, totalArticles } = Astro.props;
---

<!-- Mobile filter toggle button -->
<button
  id="filter-toggle-mobile"
  type="button"
  class="lg:hidden inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-4 py-2.5 text-sm font-medium text-text-primary shadow-sm hover:border-brand/40 transition-colors"
  aria-label="Mostrar filtros"
>
  <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
  Filtros
  <span id="active-filter-count" class="hidden items-center justify-center w-5 h-5 rounded-full bg-brand text-white text-[10px] font-bold">0</span>
</button>

<!-- Backdrop (mobile) -->
<div id="filter-backdrop" class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm opacity-0 invisible transition-all duration-300 lg:hidden"></div>

<!-- Sidebar panel -->
<aside
  id="filter-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-[280px] bg-surface border-r border-border shadow-xl overflow-y-auto
         transform -translate-x-full transition-transform duration-300 ease-out
         lg:static lg:z-auto lg:shadow-none lg:rounded-2xl lg:border lg:w-64 lg:shrink-0 lg:translate-x-0 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)]"
>
  <!-- Sidebar header -->
  <div class="flex items-center justify-between px-5 pt-5 pb-3">
    <h2 class="text-sm font-bold uppercase tracking-wider text-text-primary flex items-center gap-2">
      <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
      Filtros
    </h2>
    <div class="flex items-center gap-2">
      <button id="clear-filters" type="button" class="text-[11px] font-medium text-brand hover:underline hidden" title="Limpiar filtros">Limpiar</button>
      <button id="filter-close" type="button" class="lg:hidden p-1.5 rounded-lg hover:bg-surface-sunken text-text-muted transition-colors" aria-label="Cerrar filtros">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <div class="px-5 pb-5 space-y-6">
    <!-- Search -->
    <div>
      <label for="bitacora-search" class="block text-xs font-semibold text-text-secondary mb-2">Buscar</label>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input
          id="bitacora-search"
          type="search"
          placeholder="Título o tema..."
          autocomplete="off"
          class="w-full rounded-xl border border-border bg-surface-sunken pl-9 pr-8 py-2.5 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/15 transition-colors"
        />
        <button id="search-clear" type="button" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-text-muted hover:text-text-primary hidden" aria-label="Borrar búsqueda">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Categories -->
    <div>
      <span class="block text-xs font-semibold text-text-secondary mb-2">Categoría</span>
      <div id="category-filters" class="space-y-1">
        <button type="button" data-cat="all" class="cat-btn active w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-colors text-left">
          <span>Todas</span>
          <span class="cat-count text-xs tabular-nums">{totalArticles}</span>
        </button>
        {categories.map((cat) => (
          <button type="button" data-cat={cat.name} class="cat-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-colors text-left">
            <span>{cat.name}</span>
            <span class="cat-count text-xs tabular-nums">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Sort -->
    <div>
      <label for="bitacora-sort" class="block text-xs font-semibold text-text-secondary mb-2">Ordenar por</label>
      <select id="bitacora-sort" class="w-full rounded-xl border border-border bg-surface-sunken px-3 py-2.5 text-sm text-text-primary focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/15 transition-colors">
        <option value="recientes">Más recientes</option>
        <option value="antiguos">Más antiguos</option>
        <option value="lectura-asc">Menor tiempo de lectura</option>
        <option value="lectura-desc">Mayor tiempo de lectura</option>
      </select>
    </div>

    <!-- Results count -->
    <div class="pt-2 border-t border-border">
      <p id="results-count" class="text-xs text-text-muted">
        Mostrando <span class="font-semibold text-text-secondary">{totalArticles}</span> de {totalArticles} artículos
      </p>
    </div>
  </div>

  <!-- Desktop collapse toggle (inside aside, at bottom) -->
  <div class="hidden lg:block px-5 pb-4">
    <button
      id="sidebar-collapse"
      type="button"
      class="flex items-center gap-1.5 text-xs font-medium text-text-muted hover:text-brand transition-colors"
      aria-label="Ocultar filtros"
    >
      <svg id="collapse-icon" class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
      <span id="collapse-label">Ocultar filtros</span>
    </button>
  </div>
</aside>

<!-- Floating re-open button (desktop, visible when sidebar collapsed) -->
<button
  id="sidebar-reopen"
  type="button"
  class="hidden items-center gap-2 rounded-xl border border-border bg-surface-raised px-3 py-2.5 text-xs font-medium text-text-secondary shadow-sm hover:text-brand hover:border-brand/40 transition-colors"
  aria-label="Mostrar filtros"
>
  <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
  Filtros
</button>

<style>
  .cat-btn {
    color: var(--color-text-secondary, #555);
  }
  .cat-btn:hover {
    background: var(--color-surface-sunken, #f5f5f5);
    color: var(--color-brand, #166534);
  }
  .cat-btn.active {
    background: var(--color-brand-muted, #dcfce7);
    color: var(--color-brand, #166534);
    font-weight: 600;
  }
  .cat-btn .cat-count {
    color: var(--color-text-muted, #999);
    min-width: 1.5rem;
    text-align: right;
  }
  .cat-btn.active .cat-count {
    color: var(--color-brand, #166534);
    font-weight: 600;
  }
</style>
