---
import type { BrandConfig } from '@/config/brands/types';
import EcosystemDropdown from '@/components/shared/EcosystemDropdown.astro';

interface Props {
  brand: BrandConfig;
}

const { brand } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <!-- Brand logo -->
    <a href={`/${brand.slug}/`} class="flex items-center gap-3 group">
      <span class="text-2xl">{brand.icon}</span>
      <div class="flex flex-col">
        <span class="font-bold tracking-wide text-text-primary group-hover:text-brand transition-colors">
          {brand.name}
        </span>
        <span class="font-mono text-[9px] uppercase tracking-widest text-text-muted">
          {brand.tagline}
        </span>
      </div>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-1">
      {brand.nav.map((item) =>
        item.children ? (
          <div class="relative group/drop">
            <button
              class:list={[
                'flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg transition-colors',
                isActive(item.href) ? 'text-brand bg-brand-muted/40' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30',
              ]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {item.label}
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/drop:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full mt-1 w-56 rounded-xl border border-border bg-surface shadow-lg opacity-0 invisible translate-y-1 transition-all duration-200 group-hover/drop:opacity-100 group-hover/drop:visible group-hover/drop:translate-y-0 z-50">
              <div class="p-2">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    target={child.external ? '_blank' : undefined}
                    rel={child.external ? 'noopener noreferrer' : undefined}
                    class:list={[
                      'flex items-center justify-between gap-2 px-3 py-2 text-sm rounded-lg transition-colors',
                      currentPath === child.href ? 'text-brand bg-brand-muted/40 font-medium' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30',
                    ]}
                  >
                    <span>{child.label}</span>
                    {child.external && (
                      <svg class="w-3 h-3 opacity-50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg transition-colors',
              isActive(item.href) ? 'text-brand bg-brand-muted/40' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30',
            ]}
          >
            {item.label}
            {item.external && (
              <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            )}
          </a>
        )
      )}
    </div>

    <!-- Icon actions + Mobile toggle -->
    <div class="flex items-center gap-1">
      <!-- Search -->
      <button
        data-search-trigger
        class="p-2 rounded-lg text-text-secondary hover:text-brand hover:bg-brand-muted/50 transition-colors"
        aria-label="Buscar en el sitio"
        title="Buscar en el sitio"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <!-- Contact -->
      <a
        href={`/${brand.slug}/contacto`}
        class="p-2 rounded-lg text-text-secondary hover:text-brand hover:bg-brand-muted/50 transition-colors"
        aria-label="Contactar"
        title="Contactar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
      <!-- Ecosystem -->
      <EcosystemDropdown activeBrand={brand.slug} variant="icon" />
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="p-2 rounded-lg text-text-secondary hover:text-brand hover:bg-brand-muted/50 transition-colors"
        aria-label="Cambiar tema"
        title="Cambiar entre modo claro y oscuro"
      >
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8.66-13.66l-.71.71M4.05 19.95l-.71.71M21 12h-1M4 12H3m16.66 7.66l-.71-.71M4.05 4.05l-.71-.71M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>
      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg text-text-secondary hover:text-brand hover:bg-brand-muted/50 transition-colors"
        aria-label="Abrir menú de navegación"
        title="Menú de navegación"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-surface px-6 py-4">
    <div class="flex flex-col gap-1">
      {brand.nav.map((item) =>
        item.children ? (
          <div class="mobile-submenu">
            <button
              class="mobile-submenu-btn flex w-full items-center justify-between px-3 py-2.5 text-sm font-medium text-text-secondary hover:text-brand rounded-lg hover:bg-brand-muted/30 transition-colors"
              aria-expanded="false"
            >
              {item.label}
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="mobile-submenu-panel hidden pl-4 pb-2">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  target={child.external ? '_blank' : undefined}
                  rel={child.external ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'flex items-center justify-between gap-2 px-3 py-2 text-sm rounded-lg transition-colors',
                    currentPath === child.href ? 'text-brand bg-brand-muted/40 font-medium' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30',
                  ]}
                >
                  <span>{child.label}</span>
                  {child.external && (
                    <svg class="w-3 h-3 opacity-50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'flex items-center justify-between gap-2 px-3 py-2.5 text-sm font-medium rounded-lg transition-colors',
              isActive(item.href) ? 'text-brand bg-brand-muted/40' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30',
            ]}
          >
            <span>{item.label}</span>
            {item.external && (
              <svg class="w-3 h-3 opacity-50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            )}
          </a>
        )
      )}

      <!-- Ecosystem (mobile) -->
      <div class="pt-3 mt-2 border-t border-border/50">
        <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2 px-3">Ecosistema Iwagé</p>
        <div class="grid grid-cols-1 gap-1">
          <a href="/" class="flex items-center gap-2 px-3 py-1.5 text-sm text-text-secondary hover:text-brand rounded-lg hover:bg-brand-muted/30 transition-colors"><i data-lucide="sprout" class="w-4 h-4"></i> Hub</a>
          <a href="/meliponas/" class:list={['flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition-colors', brand.slug === 'meliponas' ? 'text-brand bg-brand-muted/30' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30']}><i data-lucide="bee" class="w-4 h-4"></i> Meliponario</a>
          <a href="/cafe/" class:list={['flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition-colors', brand.slug === 'cafe' ? 'text-brand bg-brand-muted/30' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30']}><i data-lucide="coffee" class="w-4 h-4"></i> Café</a>
          <a href="/tierras/" class:list={['flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition-colors', brand.slug === 'tierras' ? 'text-brand bg-brand-muted/30' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30']}><i data-lucide="mountain" class="w-4 h-4"></i> Tierras</a>
          <a href="/naturaleza/" class:list={['flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition-colors', brand.slug === 'naturaleza' ? 'text-brand bg-brand-muted/30' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30']}><i data-lucide="leaf" class="w-4 h-4"></i> Naturaleza</a>
          <a href="/gestion/" class:list={['flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition-colors', brand.slug === 'gestion' ? 'text-brand bg-brand-muted/30' : 'text-text-secondary hover:text-brand hover:bg-brand-muted/30']}><i data-lucide="building-2" class="w-4 h-4"></i> Gestión</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Mobile submenu accordions
  document.querySelectorAll('.mobile-submenu-btn').forEach((toggleBtn) => {
    toggleBtn.addEventListener('click', () => {
      const panel = toggleBtn.nextElementSibling;
      const isOpen = !panel?.classList.contains('hidden');
      // Close all other panels
      document.querySelectorAll('.mobile-submenu-panel').forEach((p) => p.classList.add('hidden'));
      document.querySelectorAll('.mobile-submenu-btn').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        b.querySelector('svg')?.classList.remove('rotate-180');
      });
      // Toggle current
      if (!isOpen && panel) {
        panel.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        toggleBtn.querySelector('svg')?.classList.add('rotate-180');
      }
    });
  });

  // Theme toggle (light/dark)
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    root.classList.add('theme-transition');
    root.classList.toggle('dark');
    const isDark = root.classList.contains('dark');
    localStorage.setItem('iwage-theme', isDark ? 'dark' : 'light');
    setTimeout(() => root.classList.remove('theme-transition'), 350);
  });
</script>
