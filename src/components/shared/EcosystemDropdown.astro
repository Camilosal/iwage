---
import { brandList } from '@/config/brands';
import Icon from '@/components/shared/Icon.astro';

interface Props {
  /** Current brand slug to highlight active */
  activeBrand?: string;
  /** Style variant: 'icon' for icon-only, 'pill' for legacy navbar, 'text' for brand navbar */
  variant?: 'icon' | 'pill' | 'text';
}

const { activeBrand = '', variant = 'icon' } = Astro.props;

const triggerClasses = variant === 'icon'
  ? 'p-2 rounded-lg text-text-secondary hover:text-brand hover:bg-brand-muted/50 transition-colors'
  : variant === 'pill'
    ? 'inline-flex items-center gap-1.5 text-xs font-medium text-text-muted hover:text-brand border border-border/60 rounded-full px-3 py-1.5 hover:border-brand/40 transition-colors'
    : 'inline-flex items-center gap-1 text-xs text-text-muted hover:text-brand transition-colors';
---

<div class="relative" data-ecosystem-dropdown>
  <button
    class={triggerClasses}
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Explorar ecosistema Iwagé"
    title="Explorar ecosistema Iwagé"
  >
    {variant === 'icon' ? (
      <Icon name="globe" class="w-5 h-5" />
    ) : (
      <>
        <Icon name="globe" class="w-4 h-4" /> Ecosistema
        <Icon name="chevron-down" class="w-3 h-3 transition-transform duration-200" />
      </>
    )}
  </button>

  <!-- Dropdown panel -->
  <div
    class="absolute right-0 top-full mt-2 w-72 opacity-0 invisible translate-y-1 transition-all duration-200 z-50"
    data-dropdown-panel
  >
    <div class="rounded-xl border border-border bg-surface-raised shadow-xl shadow-black/10 overflow-hidden">
      <!-- Hub link -->
      <a
        href="/"
        class="flex items-center gap-3 px-4 py-3 border-b border-border/50 hover:bg-brand-muted/30 transition-colors"
      >
        <Icon name="sprout" class="w-6 h-6 text-accent shrink-0" />
        <div>
          <p class="text-sm font-semibold text-text-primary">Hub Iwagé</p>
          <p class="text-[11px] text-text-muted">Ecosistema de desarrollo rural · Tolima</p>
        </div>
      </a>

      <!-- Brand list -->
      <div class="py-1">
        {brandList.map((brand) => (
          <a
            href={`/${brand.slug}/`}
            class:list={[
              'flex items-center gap-3 px-4 py-2.5 transition-colors group',
              activeBrand === brand.slug
                ? 'bg-brand-muted/40'
                : 'hover:bg-brand-muted/20',
            ]}
          >
            <Icon name={brand.icon} class="w-5 h-5 shrink-0 text-brand" />
            <div class="min-w-0">
              <p class:list={[
                'text-sm font-medium truncate transition-colors',
                activeBrand === brand.slug ? 'text-brand' : 'text-text-primary group-hover:text-brand',
              ]}>
                {brand.name}
                {activeBrand === brand.slug && <span class="ml-1.5 text-[10px] text-brand/70">● actual</span>}
              </p>
              <p class="text-[11px] text-text-muted truncate">{brand.tagline}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Portal de autogestión (reservas y pedidos) -->
      <a
        href="https://reservas.iwage.co/mi-cuenta"
        data-mi-cuenta-link
        class="flex items-center gap-3 px-4 py-3 border-t border-border/50 hover:bg-brand-muted/30 transition-colors"
      >
        <Icon name="user" class="w-5 h-5 shrink-0 text-brand" />
        <div>
          <p class="text-sm font-semibold text-text-primary">Mi cuenta</p>
          <p class="text-[11px] text-text-muted">Tus reservas, pedidos y perfil</p>
        </div>
      </a>
    </div>
  </div>
</div>

<script>
  // El portal valida ?volver= contra *.iwage.co para el enlace de regreso
  document.querySelectorAll<HTMLAnchorElement>('[data-mi-cuenta-link]').forEach((link) => {
    if (location.hostname.endsWith('iwage.co')) {
      link.href = `https://reservas.iwage.co/mi-cuenta?volver=${encodeURIComponent(location.href)}`;
    }
  });

  document.querySelectorAll<HTMLElement>('[data-ecosystem-dropdown]').forEach((wrapper) => {
    const btn = wrapper.querySelector('button');
    const panel = wrapper.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!btn || !panel) return;

    let open = false;

    function setOpen(state: boolean) {
      open = state;
      btn!.setAttribute('aria-expanded', String(state));
      if (state) {
        panel!.classList.remove('opacity-0', 'invisible', 'translate-y-1');
        panel!.classList.add('opacity-100', 'visible', 'translate-y-0');
      } else {
        panel!.classList.add('opacity-0', 'invisible', 'translate-y-1');
        panel!.classList.remove('opacity-100', 'visible', 'translate-y-0');
      }
      // Rotate chevron (último svg del trigger)
      const svgs = btn!.querySelectorAll('svg');
      const chevron = svgs[svgs.length - 1];
      chevron?.classList.toggle('rotate-180', state);
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!open);
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (open && !wrapper.contains(e.target as Node)) {
        setOpen(false);
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });
  });
</script>
