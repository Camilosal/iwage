---
interface Props {
  images: string[];
  title?: string;
  columns?: 4 | 3 | 2;
}

const { images, title = 'Galería', columns = 4 } = Astro.props;
if (images.length === 0) return;
---

<div class="bg-white rounded-2xl border border-gray-100 overflow-hidden" data-gallery>
  <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="text-lg">📷</span>
      <h2 class="text-lg font-bold text-[#1B4332]">{title}</h2>
      <span class="text-xs text-gray-300 font-mono">{images.length} fotos</span>
    </div>
    <button class="gallery-fullscreen-btn text-xs font-medium text-[#52B788] hover:underline" data-open-lightbox>
      ⛶ Pantalla completa
    </button>
  </div>

  <!-- Thumbnail Grid -->
  <div class:list={['grid gap-1 p-1', columns === 4 ? 'grid-cols-2 md:grid-cols-4' : columns === 3 ? 'grid-cols-2 md:grid-cols-3' : 'grid-cols-2']}>
    {images.map((img, i) => (
      <button
        class="gallery-thumb relative overflow-hidden rounded-lg aspect-[4/3] group cursor-pointer"
        data-index={i}
        data-open-lightbox
      >
        <img src={img} alt={`${title} ${i + 1}`} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
          <svg class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
        </div>
        {i === 0 && <span class="absolute top-2 left-2 px-2 py-0.5 bg-black/60 text-white text-[9px] font-bold rounded-full uppercase">Principal</span>}
      </button>
    ))}
  </div>
</div>

<!-- Lightbox Overlay -->
<div class="gallery-lightbox fixed inset-0 z-[9999] hidden" data-lightbox>
  <div class="absolute inset-0 bg-black/95" data-close-lightbox></div>
  
  <!-- Close button -->
  <button class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" data-close-lightbox>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>

  <!-- Counter -->
  <div class="absolute top-4 left-4 z-10 px-3 py-1.5 rounded-full bg-white/10 text-white text-sm font-mono">
    <span data-counter>1 / {images.length}</span>
  </div>

  <!-- Main image -->
  <div class="absolute inset-0 flex items-center justify-center p-16">
    <img data-lightbox-img src={images[0]} alt="" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl" />
  </div>

  <!-- Navigation -->
  <button class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" data-prev>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" data-next>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>

  <!-- Thumbnail strip -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex gap-2 max-w-[80vw] overflow-x-auto px-4 py-2 rounded-full bg-black/50">
    {images.map((img, i) => (
      <button class="gallery-strip-thumb w-12 h-9 rounded-md overflow-hidden shrink-0 opacity-50 hover:opacity-100 transition-opacity border-2 border-transparent data-[active=true]:border-white data-[active=true]:opacity-100" data-strip={i} data-active={i === 0 ? 'true' : 'false'}>
        <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" />
      </button>
    ))}
  </div>
</div>

<script>
  const galleryImages: string[] = Array.from(document.querySelectorAll('[data-gallery] .gallery-thumb img')).map(img => (img as HTMLImageElement).src);
  
  document.querySelectorAll('[data-gallery]').forEach(gallery => {
    const lightbox = gallery.parentElement?.querySelector('[data-lightbox]') || document.querySelector('[data-lightbox]');
    if (!lightbox) return;
    
    const lbImg = lightbox.querySelector('[data-lightbox-img]') as HTMLImageElement;
    const counter = lightbox.querySelector('[data-counter]') as HTMLElement;
    const stripThumbs = lightbox.querySelectorAll('[data-strip]');
    let current = 0;

    function show(idx: number) {
      current = (idx + galleryImages.length) % galleryImages.length;
      lbImg.src = galleryImages[current];
      counter.textContent = `${current + 1} / ${galleryImages.length}`;
      stripThumbs.forEach((t, i) => t.setAttribute('data-active', String(i === current)));
    }

    function open(idx: number) {
      show(idx);
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    gallery.querySelectorAll('[data-open-lightbox]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.hasAttribute('data-index') ? parseInt(btn.getAttribute('data-index')!) : 0;
        open(idx);
      });
    });

    lightbox.querySelectorAll('[data-close-lightbox]').forEach(el => el.addEventListener('click', close));
    lightbox.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    stripThumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>
