---
import { createHash } from 'node:crypto';
import Icon from '@/components/shared/Icon.astro';
import { toMediaList, isEmbed, embedSrc, type MediaItem } from '@/lib/media';

/**
 * MediaGallery — ÚNICA galería audiovisual del sitio con lightbox (Task 8).
 * Sirve igual a las fichas de producto que a las de experiencia, cultivo,
 * proyecto o propiedad.
 *
 * Acepta URLs sueltas o items de galería en cualquier forma (canónica o
 * histórica): la única normalización es `toMediaList()`, que entrega
 * `MediaItem` ({ url, kind: 'imagen'|'video'|'tour360', alt?, caption?, provider? }).
 * Funciona con cualquier marca (colores heredados del tema).
 *
 * Dos invariantes que este archivo mantiene a propósito:
 *  · El escenario del lightbox NUNCA emite un <img> con `src` vacío: el servidor
 *    pinta el <img> real o un div placeholder, y el cliente crea elementos por
 *    propiedad (`el.src = ...`), nunca con innerHTML interpolado.
 *  · La conversión URL de tercero → URL de embed corre UNA sola vez y en el
 *    servidor (`embedSrc`); al navegador solo le llega el resultado (`embed`)
 *    y la decisión de elemento nativo (`render`): iframe ≠ video propio ≠ img.
 */
interface Props {
  /** URLs sueltas o items de galería; se normalizan con toMediaList(). */
  items?: (MediaItem | string | unknown)[] | null;
  title?: string;
  columns?: 4 | 3 | 2;
  /**
   * `galeria` (por defecto): rejilla de miniaturas con encabezado. Es la forma
   * correcta cuando hay muchas piezas —proyectos, cultivos, experiencias—.
   * `producto`: la primera pieza es el retrato y llena la columna; las demás
   * bajan a miniaturas. Sin encabezado ni leyendas superpuestas, porque el
   * `h1` de la ficha ya dice el nombre y la insignia «Destacado» va encima.
   */
  variant?: 'galeria' | 'producto';
}

const { items: rawItems, title = 'Galería', columns = 4, variant = 'galeria' } = Astro.props;
const esProducto = variant === 'producto';

// Entrada = MediaItem + lo que el navegador debe dibujar con él:
//  · render 'img'    → <img> (imagen propia; embed === url)
//  · render 'video'  → <video controls> para archivo propio (.mp4/.webm/...),
//                     jamás un <iframe>
//  · render 'iframe' → embebido de tercero (YouTube/Vimeo/Drive/tour 360) cuya
//                     src ES `embed` = embedSrc(url) resuelto aquí, en el servidor.
interface Entry extends MediaItem {
  render: 'img' | 'video' | 'iframe';
  embed: string;
}

// Normaliza en el borde: cualquier forma (string[], la histórica, MediaItem[]) entra.
const items: Entry[] = toMediaList(rawItems).map((item) => {
  const embebible = isEmbed(item);
  return {
    ...item,
    render: embebible ? 'iframe' : item.kind === 'video' ? 'video' : 'img',
    embed: embebible ? embedSrc(item.url) : item.url,
  };
});

if (items.length === 0) return;

// Id determinista (pathname + URLs del contenido): servidor y JSON serializado
// siempre coinciden, y ningún rebuild reordena los hooks. El brief pedía
// base64(pathname:urls).slice(0,10); medido sobre el HTML servido, esa ventana
// solo alcanzaba al prefijo del pathname — `/meliponas/tienda/...` y
// `/meliponas/proyectos/...` producían el MISMO gid (`gal-L21lbGlwb2`), o sea
// colisión entre galerías de una misma página, que es justo lo que el gid evita.
// El digest sha256 sobre la misma entrada conserva la propiedad exigida
// (determinista, derivada de contenido + pathname) y sí discrimina el contenido.
// Único choque posible: dos galerías con el MISMO contenido en la MISMA página.
const gid = `gal-${createHash('sha256').update(`${Astro.url.pathname}:${items.map((i) => i.url).join('')}`).digest('hex').slice(0, 10)}`;

// \u003c en vez de `<` dentro del JSON: un `</script>` en un alt/caption no puede
// escapar del bloque de datos.
const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
---

<div class="rounded-2xl border border-border bg-surface-raised overflow-hidden" data-gallery-wrapper={gid}>
  {!esProducto && (
    <div class="px-6 py-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-3">
        <Icon name="images" class="w-5 h-5 text-brand" />
        <h2 class="text-lg font-bold text-text-primary">{title}</h2>
        <span class="text-xs text-text-muted font-mono">{items.length} {items.length === 1 ? 'elemento' : 'elementos'}</span>
      </div>
      <button class="text-xs font-medium text-brand hover:underline flex items-center gap-1" data-gal-open="0">
        <Icon name="maximize-2" class="w-3.5 h-3.5" /> Pantalla completa
      </button>
    </div>
  )}

  <!-- Rejilla: en modo producto la primera pieza ocupa las 4 columnas y es cuadrada,
       igual que el placeholder de las fichas sin foto, para que la columna no salte. -->
  <div class:list={['grid gap-1.5 p-1.5', esProducto ? 'grid-cols-4' : columns === 4 ? 'grid-cols-2 md:grid-cols-4' : columns === 3 ? 'grid-cols-2 md:grid-cols-3' : 'grid-cols-2']}>
    {items.map((item, i) => (
      <button
        class:list={['relative overflow-hidden rounded-lg group cursor-pointer', esProducto && i === 0 ? 'col-span-4 aspect-square' : 'aspect-[4/3]']}
        data-gal-open={String(i)}
        aria-label={item.alt || item.caption || `${title} ${i + 1}`}
      >
        {item.render === 'img' ? (
          <img
            src={item.url}
            alt={item.alt || item.caption || `${title} ${i + 1}`}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            data-gal-main-img={i === 0 ? 'true' : undefined}
          />
        ) : item.kind === 'tour360' ? (
          <div class="w-full h-full bg-surface-sunken flex items-center justify-center">
            <span class="w-10 h-10 rounded-full bg-accent/90 flex items-center justify-center group-hover:scale-110 transition-transform">
              <Icon name="rotate-3d" class="w-5 h-5 text-white" />
            </span>
          </div>
        ) : (
          <div class="w-full h-full bg-surface-sunken flex items-center justify-center">
            <span class="w-10 h-10 rounded-full bg-brand/90 flex items-center justify-center group-hover:scale-110 transition-transform">
              <Icon name="play" class="w-5 h-5 text-white ml-0.5" />
            </span>
          </div>
        )}
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors"></div>
        {!esProducto && (item.caption || item.alt) && (
          <span class="absolute bottom-2 left-2 right-2 text-[10px] font-medium text-white bg-black/60 backdrop-blur-sm px-2 py-1 rounded-md truncate text-left">{item.caption || item.alt}</span>
        )}
        {item.render !== 'img' && (
          <span class="absolute top-2 right-2 text-[9px] font-bold text-white bg-black/60 px-2 py-0.5 rounded-full uppercase">
            {item.kind === 'tour360' ? '360°' : item.kind === 'video' ? 'Video' : 'Drive'}
          </span>
        )}
        {!esProducto && i === 0 && item.render === 'img' && <span class="absolute top-2 left-2 px-2 py-0.5 bg-black/60 text-white text-[9px] font-bold rounded-full uppercase">Principal</span>}
      </button>
    ))}
  </div>
</div>

<!-- Lightbox Overlay -->
<div class="fixed inset-0 z-[9999] hidden" data-gal-lightbox={gid}>
  <div class="absolute inset-0 bg-black/95" data-gal-close></div>

  <!-- Close -->
  <button class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" data-gal-close aria-label="Cerrar">
    <Icon name="x" class="w-6 h-6" />
  </button>

  <!-- Counter -->
  <div class="absolute top-4 left-4 z-10 px-3 py-1.5 rounded-full bg-white/10 text-white text-sm font-mono">
    <span data-gal-counter>1 / {items.length}</span>
  </div>

  <!-- Main content: solo <img> cuando items[0] es img; si no, placeholder (nunca src vacío) -->
  <div class="absolute inset-0 flex items-center justify-center p-16" data-gal-stage>
    {items[0].render === 'img' ? (
      <img data-gal-img src={items[0].url} alt={items[0].alt || items[0].caption || ''} class="max-w-full max-h-full object-contain rounded-lg shadow-2xl" />
    ) : (
      <div data-gal-img-placeholder class="w-full max-w-4xl aspect-video rounded-lg bg-surface-sunken"></div>
    )}
  </div>

  <!-- Title -->
  <div class="absolute bottom-20 left-1/2 -translate-x-1/2 z-10 text-white text-sm font-medium bg-black/50 px-4 py-1.5 rounded-full hidden" data-gal-title></div>

  <!-- Navigation -->
  <button class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" data-gal-prev aria-label="Anterior">
    <Icon name="chevron-left" class="w-6 h-6" />
  </button>
  <button class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" data-gal-next aria-label="Siguiente">
    <Icon name="chevron-right" class="w-6 h-6" />
  </button>

  <!-- Thumbnail strip -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex gap-2 max-w-[80vw] overflow-x-auto px-4 py-2 rounded-full bg-black/50">
    {items.map((item, i) => (
      <button class="w-12 h-9 rounded-md overflow-hidden shrink-0 opacity-50 hover:opacity-100 transition-opacity border-2 border-transparent data-[active=true]:border-white data-[active=true]:opacity-100" data-gal-strip={String(i)} data-active={i === 0 ? 'true' : 'false'}>
        {item.render === 'img' ? (
          <img src={item.url} alt="" class="w-full h-full object-cover" loading="lazy" />
        ) : (
          <span class="w-full h-full flex items-center justify-center bg-white/10 text-white text-[10px]">{item.kind === 'tour360' ? '360' : '▶'}</span>
        )}
      </button>
    ))}
  </div>
</div>

<script data-gal-items={gid} type="application/json" set:html={itemsJson} />
<script define:vars={{ gid }}>
  (() => {
    const wrapper = document.querySelector(`[data-gallery-wrapper="${gid}"]`);
    const lightbox = document.querySelector(`[data-gal-lightbox="${gid}"]`);
    const scriptTag = document.querySelector(`[data-gal-items="${gid}"]`);
    if (!wrapper || !lightbox || !scriptTag) return;

    // Cada item llega ya resuelto del servidor: { url, kind, ..., render, embed }.
    // Aquí no se reconstruye ninguna URL de terceros: `embed` es la salida única
    // de embedSrc() y `render` dice qué elemento nativo corresponde.
    const items = JSON.parse(scriptTag.textContent || '[]');
    const stage = lightbox.querySelector('[data-gal-stage]');
    const img = lightbox.querySelector('[data-gal-img]');
    const counter = lightbox.querySelector('[data-gal-counter]');
    const titleEl = lightbox.querySelector('[data-gal-title]');
    const strips = lightbox.querySelectorAll('[data-gal-strip]');
    let current = 0;

    // Detiene la reproducción antes de cambiar o cerrar el visor.
    function stopMedia() {
      stage.querySelectorAll('video').forEach((v) => v.pause());
      stage.querySelectorAll('iframe').forEach((f) => { f.src = 'about:blank'; });
    }

    function show(idx) {
      current = (idx + items.length) % items.length;
      const item = items[current];
      counter.textContent = `${current + 1} / ${items.length}`;
      strips.forEach((t, i) => t.setAttribute('data-active', String(i === current)));

      // Title
      const pie = item.caption || item.alt || '';
      if (pie) {
        titleEl.textContent = pie;
        titleEl.classList.remove('hidden');
      } else {
        titleEl.classList.add('hidden');
      }

      // Render media — todo creado por propiedad (el.src = ...), nunca con
      // innerHTML interpolado. Video propio es <video>, no <iframe>.
      stopMedia();
      stage.innerHTML = '';
      if (item.render === 'iframe') {
        const frame = document.createElement('iframe');
        frame.src = item.embed;
        frame.title = item.alt || item.caption || 'Medio embebido';
        frame.className = 'w-full max-w-4xl aspect-video rounded-lg shadow-2xl';
        frame.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        frame.setAttribute('allowfullscreen', '');
        stage.appendChild(frame);
      } else if (item.render === 'video') {
        const video = document.createElement('video');
        video.src = item.embed;
        video.className = 'max-w-full max-h-full rounded-lg shadow-2xl';
        video.controls = true;
        video.preload = 'metadata';
        video.setAttribute('playsinline', '');
        stage.appendChild(video);
      } else if (img) {
        img.src = item.url;
        img.alt = item.alt || item.caption || '';
        img.style.display = '';
        stage.appendChild(img);
      } else {
        const el = document.createElement('img');
        el.src = item.url;
        el.alt = item.alt || item.caption || '';
        el.className = 'max-w-full max-h-full object-contain rounded-lg shadow-2xl';
        stage.appendChild(el);
      }
    }

    function open(idx) {
      show(idx);
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      stopMedia();
    }

    wrapper.querySelectorAll('[data-gal-open]').forEach((btn) => {
      btn.addEventListener('click', () => open(parseInt(btn.getAttribute('data-gal-open') || '0', 10)));
    });

    lightbox.querySelectorAll('[data-gal-close]').forEach((el) => el.addEventListener('click', close));
    lightbox.querySelector('[data-gal-prev]')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-gal-next]')?.addEventListener('click', () => show(current + 1));
    strips.forEach((t, i) => t.addEventListener('click', () => show(i)));

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // API: cambiar la pieza principal DESPUÉS del render es lo que hace la ficha de tienda
    // al elegir una variación. El visor pinta `items[]` (parseado del JSON), no el DOM del
    // thumbnail, así que reescribir `<img src>` por fuera dejaba el lightbox con la foto del
    // producto base —y `show(0)` revertía hasta el thumbnail. Por eso el mutante vive acá,
    // que es donde están las dos copias de ese dato.
    wrapper.__iwageGallery = {
      setMainImage(url) {
        // `url` llega de un `.textContent` ajeno a este archivo: se recorta igual que en
        // `rawOf()` de `lib/media.ts`, o un `'   '` pintaría un `src` vacío.
        const limpia = typeof url === 'string' ? url.trim() : '';
        const item = items[0];
        if (!item || !limpia) return false;
        // `render !== 'img'`: si la primera pieza es video o embed no hay `<img>` que
        // reemplazar, y pintar una foto encima mentiría sobre lo que es el activo.
        if (item.render !== 'img') return false;
        item.url = limpia;
        item.embed = limpia; // con render 'img', `embed === url` (misma convención del servidor)
        const thumb = wrapper.querySelector('[data-gal-main-img]');
        if (thumb) thumb.src = limpia;
        const stripImg = strips[0]?.querySelector('img');
        if (stripImg) stripImg.src = limpia;
        if (current === 0 && img) img.src = limpia;
        return true;
      },
    };
  })();
</script>
