---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `https://iwage.co${item.href}` } : {}),
  })),
};
---

<nav class="bg-white border-b border-gray-100 py-3" aria-label="Breadcrumb">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="max-w-7xl mx-auto px-6 text-xs text-gray-400 flex items-center gap-1.5 flex-wrap">
    {items.map((item, i) => (
      <>
        {i > 0 && <span class="text-gray-300">/</span>}
        {item.href ? (
          <a href={item.href} class="hover:text-[#52B788] transition-colors">{item.label}</a>
        ) : (
          <span class="text-[#1B4332] font-medium">{item.label}</span>
        )}
      </>
    ))}
  </div>
</nav>
