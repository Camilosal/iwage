---
import Icon from '@/components/shared/Icon.astro';
import { embedSrc, isEmbed, mediaSrc, toMediaItem } from '@/lib/media';
import { pinturaDelHero } from '@/lib/hero-overlay';

interface Props {
  titulo: string;
  subtitulo?: string | null;
  imagen?: string | null;
  cta_primario_texto?: string | null;
  cta_primario_url?: string | null;
  cta_secundario_texto?: string | null;
  cta_secundario_url?: string | null;
  /** Optional label above the title */
  label?: string | null;
  /** Tailwind gradient classes for the overlay (e.g. "from-black/50 via-black/40 to-black/70").
   *  Si no se pasa, el default depende de si hay medio pintando: ver `pinturaDelHero`. */
  color_overlay?: string | null;
  /** Optional max-width class for the content */
  max_width?: string;
  /** Text alignment: 'center' (default) or 'left' */
  align?: 'center' | 'left';
  /** Extra content rendered below the hero text (e.g. SearchBar) */
  extra?: any;
  /** Video o recorrido embebido como medio del hero (alternativa a imagen) */
  embed?: string | null;
  poster?: string | null;
}

const {
  titulo,
  subtitulo,
  imagen,
  embed,
  poster,
  cta_primario_texto,
  cta_primario_url,
  cta_secundario_texto,
  cta_secundario_url,
  label,
  color_overlay,
  max_width = 'max-w-3xl',
  align = 'center',
  extra,
} = Astro.props;

const isCenter = align === 'center';

// Densidad del overlay y fondo del header: la MISMA decisión, en `src/lib/hero-overlay.ts`
// (allí está la cuenta WCAG 1.4.3 y el motivo de que sean una sola pregunta). Con foto, el
// gradiente de siempre: no cambia ni un píxel respecto a lo de hoy.
const pintura = pinturaDelHero({ imagen, embed, poster, color_overlay });

// El medio del hero puede ser audiovisual, no solo un archivo subido. `mediaSrc`/`toMediaItem`
// son los dueños de la URL: aquí no se interpola ningún base de Strapi a mano.
const posterSrc = mediaSrc(poster);
const embedItem = toMediaItem(embed);
// Embed de tercero (YouTube/Vimeo/Drive/360) va en <iframe>; archivo propio va en <video>.
// Una imagen colada en `embed` se ignora a propósito: para eso están `imagen` y `poster`.
const esEmbedTercero = !!embedItem && isEmbed(embedItem);
const esVideoPropio = !!embedItem && !esEmbedTercero && embedItem.kind === 'video';
// El `<img>` del poster solo tiene sentido si nada lo va a tapar. Con un embed de tercero el
// `<iframe>` se apila DESPUÉS y lo cubre entero: pedirlo era descargar un bytes que nadie ve
// (FIX 3). Con un video propio el poster viaja en el atributo nativo `poster` del `<video>`,
// que sí se usa. Y con un `embed` que no pinta nada (una URL de imagen colada ahí, que este
// componente ignora a propósito) el `<img>` sí se pinta: no lo cubre ningún elemento.
const embedCubreElPoster = esEmbedTercero || esVideoPropio;
---

<header class:list={[
  'relative overflow-hidden min-h-[38vh] flex items-center',
  pintura.fondo,
  isCenter && 'justify-center',
]}>
  {imagen && (
    <img
      src={imagen}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover opacity-70 dark:opacity-50"
      loading="eager"
    />
  )}
  {posterSrc && !imagen && !embedCubreElPoster && (
    <img src={posterSrc} alt="" aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover opacity-70 dark:opacity-50" loading="eager" />
  )}
  {embedItem && !imagen && (esEmbedTercero ? (
    <iframe
      src={embedSrc(embedItem.url)}
      title=""
      aria-hidden="true"
      tabindex="-1"
      class="absolute inset-0 h-full w-full object-cover pointer-events-none"
      loading="eager"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  ) : esVideoPropio ? (
    <video
      src={embedItem.url}
      poster={posterSrc ?? undefined}
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
    ></video>
  ) : null)}
  <div class:list={['absolute inset-0 bg-gradient-to-b', pintura.overlay]}></div>
  <div class:list={[
    'relative w-full mx-auto px-6 py-16 md:py-20',
    isCenter ? `${max_width} text-center` : 'max-w-6xl text-left',
  ]}>
    {label && (
      <p class:list={[
        'font-mono text-xs uppercase tracking-widest text-[#d4920a] mb-4',
        !isCenter && 'text-left',
      ]}>{label}</p>
    )}
    <h1 class:list={[
      'text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight drop-shadow-[0_2px_8px_rgba(0,0,0,0.4)]',
      isCenter ? 'text-center' : 'text-left',
    ]}>
      <Fragment set:html={titulo} />
    </h1>
    {subtitulo && (
      <p class:list={[
        'mt-4 text-base md:text-lg text-white/80 leading-relaxed drop-shadow-[0_1px_4px_rgba(0,0,0,0.3)]',
        isCenter ? 'max-w-2xl mx-auto text-center' : 'max-w-2xl text-left',
      ]}>
        {subtitulo}
      </p>
    )}
    {(cta_primario_texto || cta_secundario_texto) && (
      <div class:list={[
        'flex flex-wrap gap-4 mt-8',
        isCenter ? 'justify-center' : 'justify-start',
      ]}>
        {cta_primario_texto && cta_primario_url && (
          <a
            href={cta_primario_url}
            class="inline-flex items-center gap-2 bg-[#52B788] text-white rounded-full px-8 py-4 font-medium hover:bg-[#7fc4a2] transition-all shadow-lg"
          >
            {cta_primario_texto}
            <Icon name="arrow-right" class="w-5 h-5" />
          </a>
        )}
        {cta_secundario_texto && cta_secundario_url && (
          <a
            href={cta_secundario_url}
            class="inline-flex items-center gap-2 border border-white/40 text-white rounded-full px-8 py-4 font-medium hover:bg-white/10 transition-all"
          >
            {cta_secundario_texto}
          </a>
        )}
      </div>
    )}
    {extra && (
      <div class:list={[isCenter ? 'mt-8' : 'mt-8']}>
        <Fragment set:html={extra} />
      </div>
    )}
  </div>
</header>
