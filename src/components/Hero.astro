---
interface Props {
  title: string;
  subtitle?: string;
  cta?: { label: string; href: string };
  dark?: boolean;
  fullWidth?: boolean;
}
const { title, subtitle, cta, dark = false, fullWidth = false } = Astro.props;
---

<section class={`relative overflow-hidden ${dark ? 'bg-dark-bg text-dark-text' : 'bg-surface'}`}>
  <div class={`mx-auto px-6 ${fullWidth ? 'max-w-6xl' : 'max-w-4xl'} py-16 md:py-24 text-center`}>
    <h1 class={`text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight ${dark ? 'text-dark-text' : 'text-text-primary'}`}>
      <slot name="title">{title}</slot>
    </h1>
    {subtitle && (
      <p class={`mt-6 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto ${dark ? 'text-dark-text/60' : 'text-text-secondary'}`}>
        {subtitle}
      </p>
    )}
    {cta && (
      <div class="mt-8">
        <a
          href={cta.href}
          class="inline-flex items-center gap-2 bg-brand text-white rounded-full px-8 py-4 font-medium hover:bg-brand-light hover:scale-[1.02] transition-all shadow-lg shadow-brand/20"
        >
          {cta.label}
          <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </a>
      </div>
    )}
    <slot />
  </div>
</section>
