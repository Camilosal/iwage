---
import Icon from '@/components/shared/Icon.astro';

/**
 * AgendarVisita — Visit booking widget integrated with app_reservas.
 *
 * Flow: on load, fetch available slots for the next 14 days in ONE call →
 * dates without slots render disabled → pick date → pick slot (in memory) →
 * fill contact form → create reservation (gratuita → confirmada) or add to
 * the unified itinerary (cart). Falls back to WhatsApp only if the API is
 * unreachable.
 */
interface Props {
  propiedadSlug: string;
  propiedadTitulo: string;
  whatsapp?: string;
}

const { propiedadSlug, propiedadTitulo, whatsapp = '573026693366' } = Astro.props;

const RESERVAS_URL = import.meta.env.PUBLIC_RESERVAS_API || 'https://reservas.iwage.co';
const RECURSO_SLUG = `visita-${propiedadSlug}`;

// Fecha local YYYY-MM-DD (toISOString usa UTC y desplaza el día después
// de las 19:00 hora Colombia).
function fmtLocal(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

// Generate next 14 days (skip today if past 3pm)
const now = new Date();
const startOffset = now.getHours() >= 15 ? 1 : 0;
const dias: Array<{ value: string; label: string }> = [];
for (let i = startOffset; i < 14; i++) {
  const d = new Date(now);
  d.setDate(d.getDate() + i);
  const value = fmtLocal(d);
  const label = d.toLocaleDateString('es-CO', { weekday: 'short', day: 'numeric', month: 'short' });
  dias.push({ value, label });
}
---

<div
  id="agendar-visita"
  class="bg-white rounded-2xl p-6 border border-gray-100"
  data-recurso={RECURSO_SLUG}
  data-reservas-url={RESERVAS_URL}
  data-titulo={propiedadTitulo}
  data-wa={whatsapp}
>
  <h3 class="font-bold text-[#1B4332] mb-1"><Icon name="calendar" class="w-5 h-5 inline" /> Agendar Visita</h3>
  <p class="text-xs text-gray-400 mb-4">Visita guiada gratuita con nuestro equipo territorial.</p>

  <!-- Step 1: Date -->
  <div data-step="fecha">
    <label class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Selecciona una fecha</label>
    <p data-dias-loading class="text-xs text-gray-400 py-3 text-center">Consultando disponibilidad...</p>
    <div class="grid grid-cols-3 gap-2 max-h-36 overflow-y-auto pr-1" data-dias>
      {dias.map((dia) => (
        <button
          type="button"
          data-fecha={dia.value}
          disabled
          class="px-2 py-2 rounded-lg border border-gray-200 text-[11px] font-medium text-gray-600 hover:border-[#52B788] hover:text-[#1B4332] transition-all capitalize disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:border-gray-200 disabled:hover:text-gray-600"
        >
          {dia.label}
        </button>
      ))}
    </div>
    <p data-dias-empty class="text-xs text-gray-400 py-2 text-center hidden">
      Sin fechas disponibles en los próximos días.
      <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hola, quiero agendar una visita a: ${propiedadTitulo}`)}`} target="_blank" rel="noopener" class="text-[#52B788] font-bold hover:underline">Escríbenos</a> para coordinarla.
    </p>
  </div>

  <!-- Step 2: Slots -->
  <div data-step="slots" class="hidden">
    <div class="flex items-center justify-between mb-2">
      <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Horarios disponibles</label>
      <button type="button" data-back-fecha class="text-[11px] text-[#52B788] font-bold hover:underline">← Cambiar fecha</button>
    </div>
    <div data-slots-grid class="grid grid-cols-3 gap-2"></div>
    <p data-slots-empty class="text-xs text-gray-400 py-3 text-center hidden">
      Sin horarios para esta fecha. Prueba otra o
      <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hola, quiero agendar una visita a: ${propiedadTitulo}`)}`} target="_blank" rel="noopener" class="text-[#52B788] font-bold hover:underline">escríbenos</a>.
    </p>
  </div>

  <!-- Step 3: Contact form -->
  <div data-step="form" class="hidden">
    <div class="flex items-center justify-between mb-3">
      <p class="text-xs text-gray-500"><span class="font-bold text-[#1B4332]" data-fecha-label></span> · <span data-slot-label class="font-bold text-[#52B788]"></span></p>
      <button type="button" data-back-slots class="text-[11px] text-[#52B788] font-bold hover:underline">← Cambiar</button>
    </div>
    <div class="space-y-3">
      <input type="text" data-nombre placeholder="Tu nombre *"
        class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2.5 focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] transition-all" />
      <input type="tel" data-telefono placeholder="WhatsApp / Teléfono *"
        class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2.5 focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] transition-all" />
      <input type="email" data-email placeholder="Email (opcional)"
        class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2.5 focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] transition-all" />
      <textarea data-notas rows="2" placeholder="¿Algo que debamos saber? (opcional)"
        class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2.5 focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] transition-all resize-none"></textarea>
      <button type="button" data-confirmar
        class="w-full bg-[#52B788] text-[#0F120E] py-3 rounded-xl font-bold text-sm hover:bg-[#52B788]/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
        Confirmar Visita
      </button>
      <button type="button" data-add-itinerario
        class="w-full border border-[#52B788] text-[#1B4332] py-2.5 rounded-xl font-bold text-sm hover:bg-[#52B788]/10 transition-all">
        + Agregar al itinerario
      </button>
      <p data-itinerario-ok class="text-xs text-[#52B788] font-bold text-center hidden">✓ Agregado a tu itinerario</p>
      <p data-form-error class="text-xs text-red-500 text-center hidden"></p>
    </div>
  </div>

  <!-- Step 4: Confirmation -->
  <div data-step="ok" class="hidden text-center py-4">
    <Icon name="check-circle" class="w-10 h-10 block mb-3 text-green-500" />
    <h4 class="font-bold text-[#1B4332] mb-1">¡Visita agendada!</h4>
    <p class="text-xs text-gray-500 mb-3">Tu código de reserva:</p>
    <p data-codigo class="font-mono text-lg font-bold text-[#52B788] bg-[#52B788]/5 rounded-lg py-2 px-4 inline-block mb-4"></p>
    <p class="text-xs text-gray-400">Te contactaremos por WhatsApp para confirmar los detalles de acceso.</p>
  </div>

  <!-- Fallback: API unavailable -->
  <div data-step="fallback" class="hidden text-center py-4">
    <Icon name="message-circle" class="w-6 h-6 block mb-3" />
    <p class="text-xs text-gray-500 mb-4">La agenda en línea no está disponible en este momento, pero podemos coordinar tu visita por WhatsApp.</p>
    <a
      href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hola, quiero agendar una visita a: ${propiedadTitulo} (${propiedadSlug})`)}`}
      target="_blank" rel="noopener"
      class="inline-block bg-[#52B788] text-[#0F120E] px-6 py-3 rounded-xl font-bold text-sm hover:bg-[#52B788]/90 transition-all">
      Agendar por WhatsApp
    </a>
  </div>
</div>

<script>
  import { addItem } from '@/lib/cart-store';

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('agendar-visita');
    if (!root) return;

    const reservasUrl = root.dataset.reservasUrl!;
    const recurso = root.dataset.recurso!;
    const titulo = root.dataset.titulo!;

    const steps = {
      fecha: root.querySelector('[data-step="fecha"]') as HTMLElement,
      slots: root.querySelector('[data-step="slots"]') as HTMLElement,
      form: root.querySelector('[data-step="form"]') as HTMLElement,
      ok: root.querySelector('[data-step="ok"]') as HTMLElement,
      fallback: root.querySelector('[data-step="fallback"]') as HTMLElement,
    };

    let fechaSel = '';
    let slotId: string | null = null;
    let slotLabel = '';
    const slotsPorFecha: Record<string, any[]> = {};

    function showStep(name: keyof typeof steps) {
      Object.values(steps).forEach((el) => el?.classList.add('hidden'));
      steps[name]?.classList.remove('hidden');
    }

    function showFallback() {
      showStep('fallback');
    }

    const dateButtons = Array.from(root.querySelectorAll('[data-fecha]')) as HTMLButtonElement[];

    function pintaFechas() {
      let algunaLibre = false;
      dateButtons.forEach((btn) => {
        const libre = (slotsPorFecha[btn.dataset.fecha!] || []).length > 0;
        if (libre) algunaLibre = true;
        btn.disabled = !libre;
      });
      const empty = root.querySelector('[data-dias-empty]') as HTMLElement;
      empty?.classList.toggle('hidden', algunaLibre);
    }

    // Pre-fetch de toda la ventana (14 días) en UNA sola llamada; los slots
    // quedan agrupados por fecha y las fechas sin cupo se deshabilitan.
    (async () => {
      const loading = root.querySelector('[data-dias-loading]') as HTMLElement;
      try {
        const fechas = dateButtons.map((b) => b.dataset.fecha!);
        const desde = fechas[0];
        const hasta = fechas[fechas.length - 1];
        const res = await fetch(
          `${reservasUrl}/api/disponibilidad?recurso=${encodeURIComponent(recurso)}&desde=${desde}&hasta=${hasta}`
        );
        if (!res.ok) throw new Error('API error');
        const json = await res.json();
        for (const slot of json.data || []) {
          (slotsPorFecha[slot.fecha] = slotsPorFecha[slot.fecha] || []).push(slot);
        }
        pintaFechas();
      } catch {
        showFallback();
      } finally {
        loading?.classList.add('hidden');
      }
    })();

    // Step 1 → 2: date selection (solo fechas habilitadas tienen slots)
    dateButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        fechaSel = btn.dataset.fecha!;
        dateButtons.forEach((b) => b.classList.remove('border-[#52B788]', 'bg-[#52B788]/10', 'text-[#1B4332]'));
        btn.classList.add('border-[#52B788]', 'bg-[#52B788]/10', 'text-[#1B4332]');

        showStep('slots');
        const grid = root.querySelector('[data-slots-grid]') as HTMLElement;
        const empty = root.querySelector('[data-slots-empty]') as HTMLElement;
        grid.innerHTML = '';

        const slots: any[] = slotsPorFecha[fechaSel] || [];
        if (slots.length === 0) {
          grid.classList.add('hidden');
          empty.classList.remove('hidden');
          return;
        }

        empty.classList.add('hidden');
        grid.classList.remove('hidden');
        slots.forEach((slot) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'px-2 py-2 rounded-lg border border-gray-200 text-[11px] font-medium text-gray-600 hover:border-[#52B788] hover:text-[#1B4332] transition-all';
          const hora = slot.hora_inicio || slot.hora || '';
          b.textContent = hora.slice(0, 5) || 'Slot';
          b.addEventListener('click', () => {
            slotId = slot.documentId ?? slot.id ?? null;
            slotLabel = b.textContent || '';
            (root.querySelector('[data-fecha-label]') as HTMLElement).textContent =
              new Date(fechaSel + 'T12:00:00').toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long' });
            (root.querySelector('[data-slot-label]') as HTMLElement).textContent = slotLabel;
            showStep('form');
          });
          grid.appendChild(b);
        });
      });
    });

    // Add to unified itinerary (cart)
    root.querySelector('[data-add-itinerario]')?.addEventListener('click', () => {
      const fechaLabel = (root.querySelector('[data-fecha-label]') as HTMLElement)?.textContent || fechaSel;
      addItem({
        recurso_slug: recurso,
        nombre: `Visita: ${titulo}`,
        precio: 0,
        cantidad: 1,
        tipo: 'visita',
        tipo_disponibilidad: 'slot_horario',
        brand: 'tierras',
        origen: 'iwage_tierras',
        requiere_pago: false,
        disponibilidad_id: slotId ? String(slotId) : undefined,
        disponibilidad_label: `${fechaLabel} · ${slotLabel}`,
        url: window.location.href,
      });
      const okEl = root.querySelector('[data-itinerario-ok]') as HTMLElement;
      okEl?.classList.remove('hidden');
      window.setTimeout(() => okEl?.classList.add('hidden'), 2000);
    });

    // Back buttons
    root.querySelector('[data-back-fecha]')?.addEventListener('click', () => showStep('fecha'));
    root.querySelector('[data-back-slots]')?.addEventListener('click', () => showStep('slots'));

    // Step 3: confirm reservation (gratuita → confirmada, sin pago)
    root.querySelector('[data-confirmar]')?.addEventListener('click', async () => {
      const nombre = (root.querySelector('[data-nombre]') as HTMLInputElement).value.trim();
      const telefono = (root.querySelector('[data-telefono]') as HTMLInputElement).value.trim();
      const email = (root.querySelector('[data-email]') as HTMLInputElement).value.trim();
      const notas = (root.querySelector('[data-notas]') as HTMLTextAreaElement).value.trim();
      const errorEl = root.querySelector('[data-form-error]') as HTMLElement;
      const btn = root.querySelector('[data-confirmar]') as HTMLButtonElement;

      errorEl.classList.add('hidden');
      if (!nombre || nombre.length < 2) {
        errorEl.textContent = 'Ingresa tu nombre.';
        errorEl.classList.remove('hidden');
        return;
      }
      if (!telefono || telefono.length < 7) {
        errorEl.textContent = 'Ingresa un número de contacto válido.';
        errorEl.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Agendando...';

      try {
        const res = await fetch(`${reservasUrl}/api/reservas`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            recurso_slug: recurso,
            disponibilidad_id: slotId,
            cliente: { nombre, telefono, email: email || undefined, origen: 'iwage' },
            cantidad_personas: 1,
            notas: notas ? `Visita a: ${titulo}. ${notas}` : `Visita a: ${titulo}`,
            origen_url: window.location.href,
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'No se pudo agendar');

        (root.querySelector('[data-codigo]') as HTMLElement).textContent = json.data?.codigo || 'CONFIRMADA';
        showStep('ok');
      } catch (err: any) {
        errorEl.textContent = err?.message || 'No se pudo agendar. Intenta por WhatsApp.';
        errorEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Confirmar Visita';
      }
    });
  });
</script>
