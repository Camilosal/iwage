---
import Icon from '@/components/shared/Icon.astro';

interface EjeVAP {
  id: string;
  label: string;
  icon: string;
  estado: 'verde' | 'amarilla' | 'roja';
  costo_saneamiento?: number;
}

interface Props {
  sello: string | null;
  verificado: boolean;
  fase?: number;
  fechaAuditoria?: string;
  auditor?: string;
  itemsAprobados?: number;
  itemsTotal?: number;
  notaTransparencia?: string;
  reporteBanderas?: EjeVAP[];
  fechaVencimiento?: string;
}

const {
  sello,
  verificado,
  fase = 0,
  fechaAuditoria,
  auditor,
  itemsAprobados = 0,
  itemsTotal = 0,
  notaTransparencia,
  reporteBanderas = [],
  fechaVencimiento,
} = Astro.props;

const METALES: Record<string, { icon: string; label: string; bg: string; color: string; desc: string; comprador: string }> = {
  oro: { icon: 'award', label: 'Sello Oro', bg: 'bg-gradient-to-br from-[#B8860B] to-[#8B6914]', color: 'text-yellow-200', desc: 'Máxima transparencia. Predio sin observaciones relevantes.', comprador: 'Inversionista patrimonial que busca certeza absoluta.' },
  plata: { icon: 'award', label: 'Sello Plata', bg: 'bg-gradient-to-br from-[#4A5568] to-[#2D3748]', color: 'text-gray-200', desc: 'Buena transparencia. Observaciones menores documentadas.', comprador: 'Comprador informado que acepta condiciones conocidas.' },
  bronce: { icon: 'award', label: 'Sello Bronce', bg: 'bg-gradient-to-br from-[#92400E] to-[#78350F]', color: 'text-orange-200', desc: 'Transparencia parcial. Requiere saneamiento en áreas específicas.', comprador: 'Inversionista con capacidad de gestión legal/técnica.' },
  cuarentena: { icon: 'alert-triangle', label: 'En Cuarentena', bg: 'bg-gradient-to-br from-[#DC2626] to-[#991B1B]', color: 'text-red-200', desc: 'Riesgos significativos identificados. No recomendado sin asesoría.', comprador: 'Solo para expertos en saneamiento predial.' },
};

const FLAG_COLORS: Record<string, string> = {
  verde: 'bg-green-400',
  amarilla: 'bg-yellow-400',
  roja: 'bg-red-500',
};

const meta = METALES[sello || 'plata'] || METALES.plata;
const vence = fechaVencimiento ? new Date(fechaVencimiento).toLocaleDateString('es-CO', { month: 'short', year: 'numeric' }) : null;
const pctAprobados = itemsTotal > 0 ? Math.round((itemsAprobados / itemsTotal) * 100) : 0;
---

{!verificado ? (
  <div class="bg-gray-50 rounded-3xl p-6 border border-gray-200 shadow-sm group hover:shadow-md transition-all">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-gray-400 border border-gray-100 shadow-sm group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <div>
        <h3 class="text-base font-black text-gray-800 tracking-tight">Protocolo VAP®</h3>
        <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Inversión No Auditada</p>
      </div>
    </div>
    <p class="text-xs text-gray-500 leading-relaxed mb-6 font-medium">
      Este predio aún no ha pasado el protocolo de transparencia técnica de Iwagé. Solicita una auditoría para garantizar tu patrimonio.
    </p>
    <a href="/tierras/protocolo-vap" class="block w-full py-3 bg-gray-800 text-white rounded-xl text-[11px] font-black uppercase tracking-widest hover:bg-[#52B788] transition-all shadow-lg text-center">
      <Icon name="target" class="w-4 h-4 inline" /> Descubrir blindaje VAP
    </a>
  </div>
) : (
  <div class={`rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden ${meta.bg}`}>
    <div class="absolute top-4 right-4 opacity-10 pointer-events-none">
      <Icon name={meta.icon} class="w-24 h-24" />
    </div>

    <div class="relative z-10">
      <!-- Header -->
      <div class="flex items-center gap-4 mb-6">
        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-2xl ring-4 ring-white/20">
          <Icon name={meta.icon} class="w-8 h-8" />
        </div>
        <div>
          <h3 class="text-lg font-black leading-tight tracking-tighter">{meta.label}</h3>
          <div class="flex items-center gap-2 mt-0.5">
            <span class={`text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded bg-black/20 ${meta.color}`}>✓ Iwagé Verificado</span>
            {vence && <span class="text-[10px] font-bold opacity-60">Vence: {vence}</span>}
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="bg-black/20 rounded-xl p-3 text-center">
          <p class="text-lg font-black">{fase}/5</p>
          <p class="text-[9px] font-bold uppercase opacity-60">Fase</p>
        </div>
        <div class="bg-black/20 rounded-xl p-3 text-center">
          <p class="text-lg font-black">{pctAprobados}%</p>
          <p class="text-[9px] font-bold uppercase opacity-60">Aprobado</p>
        </div>
        <div class="bg-black/20 rounded-xl p-3 text-center">
          <p class="text-lg font-black">{itemsAprobados}/{itemsTotal}</p>
          <p class="text-[9px] font-bold uppercase opacity-60">Items</p>
        </div>
      </div>

      <!-- Semáforo VAP -->
      {reporteBanderas.length > 0 && (
        <div class="mb-6">
          <p class="text-[10px] font-black uppercase tracking-widest text-white/50 italic mb-3">Gestión de Riesgos (Semáforo VAP®):</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
            {reporteBanderas.map((eje) => (
              <div class="bg-black/20 backdrop-blur-sm border border-white/10 rounded-xl p-3 flex flex-col items-center text-center gap-1 hover:bg-black/30 transition-colors">
                <Icon name={eje.icon} class="w-5 h-5" />
                <span class="text-[9px] font-black uppercase tracking-tighter truncate w-full">{eje.label}</span>
                <div class={`w-3 h-3 rounded-full shadow-sm mt-1 ${FLAG_COLORS[eje.estado] || 'bg-green-400'}`}></div>
                {eje.estado === 'amarilla' && eje.costo_saneamiento && (
                  <div class="mt-1 text-[8px] font-bold text-orange-300">
                    Costo: ${(eje.costo_saneamiento / 1000000).toFixed(1)}M
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Transparencia -->
      {notaTransparencia && (
        <div class="mb-6 bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/20">
          <p class="text-[10px] font-black uppercase tracking-widest text-white/50 mb-2 italic">Consentimiento Informado:</p>
          <p class="text-sm leading-relaxed font-bold">{notaTransparencia}</p>
        </div>
      )}

      <!-- Auditor info -->
      {(auditor || fechaAuditoria) && (
        <div class="flex items-center gap-4 text-[10px] font-bold opacity-60 mb-4">
          {auditor && <span class="flex items-center gap-1"><Icon name="user" class="w-3 h-3" /> Auditor: {auditor}</span>}
          {fechaAuditoria && <span class="flex items-center gap-1"><Icon name="calendar" class="w-3 h-3" /> {new Date(fechaAuditoria).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' })}</span>}
        </div>
      )}

      <!-- CTA -->
      <a href="/tierras/protocolo-vap" class="block w-full py-4 bg-white text-gray-800 rounded-2xl text-[11px] font-black uppercase tracking-widest hover:bg-[#52B788] hover:text-[#0F120E] transition-all shadow-xl text-center">
        <Icon name="folder-open" class="w-4 h-4 inline" /> Ver Diagnóstico de Riesgos Detallado
      </a>
      <p class="text-center text-[9px] font-bold opacity-30 mt-3 uppercase tracking-widest">
        Sello emitido físicamente y digitalmente por Iwagé S.A.S
      </p>
    </div>
  </div>
)}
