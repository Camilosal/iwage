---
interface Props {
  sello: 'oro' | 'plata' | 'bronce' | 'cuarentena' | null;
  notaTransparencia?: string | null;
  conclusionAuditor?: string | null;
  fechaAprobacion?: string | null;
  variant?: 'card' | 'badge';
}

const { sello, notaTransparencia, conclusionAuditor, fechaAprobacion, variant = 'card' } = Astro.props;

const METALES: Record<string, { icono: string; label: string; color: string; bg: string; border: string; desc: string }> = {
  oro: { icono: '🥇', label: 'Sello Oro', color: '#B8860B', bg: 'bg-amber-50', border: 'border-amber-200', desc: 'Cero observaciones. Documentación perfecta, linderos claros, sin riesgos jurídicos.' },
  plata: { icono: '🥈', label: 'Sello Plata', color: '#6B7280', bg: 'bg-gray-50', border: 'border-gray-200', desc: 'Máximo 2 observaciones menores. Propiedad segura con aspectos por documentar.' },
  bronce: { icono: '🥉', label: 'Sello Bronce', color: '#92400E', bg: 'bg-orange-50', border: 'border-orange-200', desc: '3+ observaciones. Requiere saneamiento parcial antes de escritura.' },
  cuarentena: { icono: '🚫', label: 'En Cuarentena', color: '#DC2626', bg: 'bg-red-50', border: 'border-red-200', desc: 'Riesgo crítico detectado. No apta para transacción hasta resolver.' },
};

const metal = sello ? METALES[sello] : null;
---

{variant === 'badge' && metal && (
  <span class:list={['inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border', metal.bg, metal.border]} style={`color: ${metal.color}`}>
    {metal.icono} {metal.label}
  </span>
)}

{variant === 'badge' && !metal && (
  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border bg-gray-50 border-gray-200 text-gray-400">
    ⚪ Sin verificar
  </span>
)}

{variant === 'card' && metal && (
  <div class:list={['rounded-2xl border-2 p-6 relative overflow-hidden', metal.bg, metal.border]}>
    <div class="absolute top-0 right-0 w-24 h-24 opacity-10 text-8xl -mr-4 -mt-4 select-none pointer-events-none">{metal.icono}</div>
    <div class="flex items-start gap-4">
      <div class="w-14 h-14 rounded-2xl bg-white shadow-sm flex items-center justify-center text-3xl shrink-0 border border-gray-100">
        {metal.icono}
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-1">
          <h3 class="font-black text-base tracking-tight" style={`color: ${metal.color}`}>{metal.label}</h3>
          <span class="px-2 py-0.5 rounded-full bg-white/80 text-[9px] font-bold uppercase tracking-wider border border-gray-100" style={`color: ${metal.color}`}>VAP®</span>
        </div>
        <p class="text-sm text-gray-600 leading-snug mb-3">{metal.desc}</p>
        
        {conclusionAuditor && (
          <div class="bg-white/70 rounded-xl p-3 border border-gray-100 mb-3">
            <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Conclusión del auditor</p>
            <p class="text-sm text-gray-700">{conclusionAuditor}</p>
          </div>
        )}

        {notaTransparencia && (
          <div class="bg-amber-50/80 rounded-xl p-3 border border-amber-100 mb-3">
            <p class="text-[10px] font-bold uppercase tracking-wider text-amber-600 mb-1">⚠️ Nota de Transparencia</p>
            <p class="text-sm text-gray-600">{notaTransparencia}</p>
          </div>
        )}

        <div class="flex items-center gap-4 text-[11px] text-gray-400">
          {fechaAprobacion && <span>📅 Aprobado: {new Date(fechaAprobacion).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' })}</span>}
          <a href="/tierras/protocolo-vap" class="hover:text-[#52B788] transition-colors font-medium">¿Qué es VAP? →</a>
        </div>
      </div>
    </div>
  </div>
)}

{variant === 'card' && !metal && (
  <div class="rounded-2xl border-2 border-dashed border-gray-200 p-6 bg-gray-50/50">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-2xl shrink-0 border border-gray-100">🔍</div>
      <div>
        <h3 class="font-bold text-gray-700 text-sm">Predio sin Verificación VAP®</h3>
        <p class="text-xs text-gray-500 mt-1">Esta propiedad aún no ha pasado el protocolo de auditoría técnica y jurídica.</p>
        <a href="/tierras/protocolo-vap" class="inline-block mt-3 text-xs font-bold text-[#52B788] hover:underline">Conocer el Protocolo VAP →</a>
      </div>
    </div>
  </div>
)}
