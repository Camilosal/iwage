---
import { icons } from 'lucide';
import Icon from '@/components/shared/Icon.astro';

function lucideSvg(name: string, cls = 'w-5 h-5'): string {
  const p = name.replace(/(^|-)(\w)/g, (_, _s, c: string) => c.toUpperCase());
  const node = (icons as Record<string, any[]>)[p];
  if (!node) return '';
  const inner = node.map(([tag, attrs]: [string, Record<string, any>]) =>
    `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`
  ).join('');
  return `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true">${inner}</svg>`;
}

const ICONS_JS = {
  mapPin: lucideSvg('map-pin', 'w-3.5 h-3.5 inline shrink-0'),
  arrowRight: lucideSvg('arrow-right', 'w-5 h-5 text-[#52B788] opacity-40 group-hover:opacity-100 transition-opacity shrink-0'),
};
/**
 * Minimal AI search bar: icon + name + input + button.
 * Results render below as clickable cards linking to property detail pages.
 */
---

<div data-search-agent class="w-full">
  <!-- Search bar -->
  <div class="flex items-center gap-3 bg-white rounded-2xl px-4 py-3 shadow-lg shadow-black/10">
    <Icon name="search" class="w-5 h-5 shrink-0" />
    <span class="hidden sm:block text-sm font-bold text-[#1B4332] whitespace-nowrap shrink-0">Búsqueda Inteligente</span>
    <input
      type="text"
      data-search-input
      placeholder="Describe lo que buscas... ej: finca cafetera con agua propia"
      class="flex-1 min-w-0 text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none bg-transparent"
    />
    <button
      data-search-btn
      class="px-5 py-2 bg-[#1B4332] text-white rounded-xl text-sm font-bold hover:bg-[#2D6A4F] transition-colors disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
    >
      Buscar
    </button>
  </div>

  <!-- Loading -->
  <div data-loading class="hidden mt-4 py-6 text-center">
    <div class="inline-flex items-center gap-3 bg-white rounded-xl px-5 py-3 text-sm text-gray-500 shadow-sm">
      <svg class="animate-spin w-4 h-4 text-[#52B788]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
      Analizando propiedades con IA...
    </div>
  </div>

  <!-- Error -->
  <div data-error class="hidden mt-4 px-4 py-3 bg-red-50 border border-red-100 rounded-xl text-sm text-red-600"></div>

  <!-- Results -->
  <div data-results class="hidden mt-4 space-y-3">
    <p data-insights class="text-sm text-white/70 bg-white/5 border border-white/10 rounded-xl px-4 py-3"></p>
    <div data-matches class="space-y-3"></div>
  </div>
</div>

<script>
  const ICONS = JSON.parse(document.getElementById('sa-icons')?.textContent || '{}');
  const agent = document.querySelector('[data-search-agent]');
  if (agent) {
    const input = agent.querySelector('[data-search-input]') as HTMLInputElement;
    const btn = agent.querySelector('[data-search-btn]') as HTMLButtonElement;
    const loading = agent.querySelector('[data-loading]') as HTMLElement;
    const error = agent.querySelector('[data-error]') as HTMLElement;
    const results = agent.querySelector('[data-results]') as HTMLElement;
    const matchesEl = agent.querySelector('[data-matches]') as HTMLElement;
    const insightsEl = agent.querySelector('[data-insights]') as HTMLElement;

    function formatPrecio(v: number | null): string {
      if (!v) return 'Consultar';
      if (v >= 1e9) return `$${(v / 1e9).toFixed(1)}B`;
      if (v >= 1e6) return `$${(v / 1e6).toFixed(0)}M`;
      return `$${v.toLocaleString('es-CO')}`;
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    async function doSearch(query: string) {
      if (!query.trim()) return;
      loading.classList.remove('hidden');
      error.classList.add('hidden');
      results.classList.add('hidden');
      btn.disabled = true;

      try {
        const res = await fetch('/api/ai-match', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error en la búsqueda');

        const matches = data.matches || [];
        if (matches.length === 0) {
          insightsEl.textContent = data.search_insights || 'No encontré propiedades que coincidan. Intenta con otros términos.';
          insightsEl.classList.remove('hidden');
          matchesEl.innerHTML = '';
          results.classList.remove('hidden');
          return;
        }

        insightsEl.textContent = data.search_insights || '';
        insightsEl.classList.toggle('hidden', !data.search_insights);

        matchesEl.innerHTML = matches.map((m: any) => {
          const slug = m.slug ? String(m.slug).trim() : '';
          const href = slug ? `/tierras/propiedades/${encodeURIComponent(slug)}` : '/tierras/propiedades';
          const score = typeof m.match_score === 'number' ? m.match_score : 0;
          const scoreColor = score >= 80 ? 'bg-emerald-500' : score >= 60 ? 'bg-amber-500' : 'bg-gray-400';
          return `
            <a href="${href}" class="block bg-white p-4 rounded-xl border border-gray-100 hover:border-[#52B788]/50 hover:shadow-md transition-all group cursor-pointer">
              <div class="flex items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="font-bold text-sm text-[#1B4332] group-hover:text-[#2D6A4F] transition-colors truncate">${escapeHtml(m.titulo || 'Propiedad')}</h3>
                    ${score > 0 ? `<span class="px-2 py-0.5 rounded-full text-[9px] font-bold text-white ${scoreColor} shrink-0">${score}%</span>` : ''}
                  </div>
                  <p class="text-xs text-gray-500 mb-1.5">${ICONS.mapPin} ${escapeHtml(m.ubicacion_municipio || 'Tolima')}${m.area_hectareas ? ` · ${m.area_hectareas} ha` : ''} · ${formatPrecio(m.precio)}</p>
                  ${m.match_reason ? `<p class="text-xs text-gray-600 bg-gray-50 rounded-lg px-3 py-2">${escapeHtml(m.match_reason)}</p>` : ''}
                </div>
                ${ICONS.arrowRight}
              </div>
            </a>`;
        }).join('');

        results.classList.remove('hidden');
      } catch (err: any) {
        error.textContent = err.message || 'Error en la búsqueda';
        error.classList.remove('hidden');
      } finally {
        loading.classList.add('hidden');
        btn.disabled = false;
      }
    }

    btn.addEventListener('click', () => doSearch(input.value));
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSearch(input.value); });
  }
</script>
<script type="application/json" id="sa-icons" set:html={JSON.stringify(ICONS_JS)} />
