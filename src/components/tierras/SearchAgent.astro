---
const SUGGESTIONS = [
  { icon: '🌾', title: 'Productor Agrícola', query: 'Finca para cultivo de café con agua propia y vía pavimentada' },
  { icon: '🏡', title: 'Vivienda Rural', query: 'Casa rural con internet de alta velocidad y cerca de pueblo' },
  { icon: '🏕️', title: 'Glamping / Turismo', query: 'Predio apto para glamping con mirador natural' },
  { icon: '🐄', title: 'Ganadería', query: 'Finca ganadera con pastos y agua disponible' },
  { icon: '💼', title: 'Inversionista', query: 'Terreno grande a buen precio con potencial de valorización' },
  { icon: '🌐', title: 'Nómada Digital', query: 'Lugar con internet de alta velocidad y energía estable' },
];
---

<div class="bg-white rounded-2xl border border-gray-100 overflow-hidden" data-search-agent>
  <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
    <span class="text-lg">🤖</span>
    <div>
      <h2 class="text-sm font-bold text-[#1B4332]">Búsqueda Inteligente</h2>
      <p class="text-[11px] text-gray-400">Describe lo que buscas en lenguaje natural</p>
    </div>
    <span class="ml-auto px-2 py-0.5 rounded-full bg-[#52B788]/10 text-[#52B788] text-[9px] font-bold uppercase">IA</span>
  </div>

  <div class="p-6">
    <!-- Input -->
    <div class="flex gap-2 mb-4">
      <input
        type="text"
        data-search-input
        placeholder="Ej: Finca con agua y buena vía para café..."
        class="flex-1 px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#52B788]/40 focus:border-[#52B788] transition-all"
      />
      <button
        data-search-btn
        class="px-5 py-3 bg-[#1B4332] text-white rounded-xl text-sm font-bold hover:bg-[#1B4332]/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
      >
        Buscar
      </button>
    </div>

    <!-- Suggestions -->
    <div data-suggestions class="grid grid-cols-2 md:grid-cols-3 gap-2 mb-4">
      {SUGGESTIONS.map(s => (
        <button class="suggestion-btn text-left px-3 py-2.5 rounded-xl border border-gray-100 hover:border-[#52B788]/40 hover:bg-[#52B788]/5 transition-all group" data-query={s.query}>
          <span class="text-sm">{s.icon}</span>
          <span class="text-xs font-medium text-gray-600 group-hover:text-[#1B4332] ml-1.5">{s.title}</span>
        </button>
      ))}
    </div>

    <!-- Loading -->
    <div data-loading class="hidden py-8 text-center">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <svg class="animate-spin w-5 h-5 text-[#52B788]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        Analizando propiedades con IA...
      </div>
    </div>

    <!-- Error -->
    <div data-error class="hidden py-4 px-4 bg-red-50 rounded-xl text-sm text-red-600 mb-4"></div>

    <!-- Results -->
    <div data-results class="hidden space-y-4">
      <!-- Profile + Insights -->
      <div data-meta class="bg-[#52B788]/5 rounded-xl p-4 border border-[#52B788]/20">
        <p class="text-xs font-bold text-[#52B788] uppercase mb-1">Perfil detectado: <span data-profile></span></p>
        <p class="text-sm text-gray-600" data-insights></p>
      </div>
      <!-- Match cards -->
      <div data-matches class="space-y-3"></div>
    </div>
  </div>
</div>

<script>
  const agent = document.querySelector('[data-search-agent]');
  if (agent) {
    const input = agent.querySelector('[data-search-input]') as HTMLInputElement;
    const btn = agent.querySelector('[data-search-btn]') as HTMLButtonElement;
    const loading = agent.querySelector('[data-loading]') as HTMLElement;
    const error = agent.querySelector('[data-error]') as HTMLElement;
    const results = agent.querySelector('[data-results]') as HTMLElement;
    const suggestions = agent.querySelector('[data-suggestions]') as HTMLElement;
    const matchesEl = agent.querySelector('[data-matches]') as HTMLElement;
    const profileEl = agent.querySelector('[data-profile]') as HTMLElement;
    const insightsEl = agent.querySelector('[data-insights]') as HTMLElement;

    function formatPrecio(v: number | null): string {
      if (!v) return 'Consultar';
      if (v >= 1e9) return `$${(v / 1e9).toFixed(1)}B`;
      if (v >= 1e6) return `$${(v / 1e6).toFixed(0)}M`;
      return `$${v.toLocaleString('es-CO')}`;
    }

    async function doSearch(query: string) {
      if (!query.trim()) return;
      loading.classList.remove('hidden');
      error.classList.add('hidden');
      results.classList.add('hidden');
      suggestions.classList.add('hidden');
      btn.disabled = true;

      try {
        const res = await fetch('/api/ai-match', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error');

        profileEl.textContent = data.user_profile || 'Explorador';
        insightsEl.textContent = data.search_insights || '';

        matchesEl.innerHTML = (data.matches || []).map((m: any) => `
          <a href="/tierras/propiedades/${m.slug}" class="block p-4 rounded-xl border border-gray-100 hover:border-[#52B788]/40 hover:shadow-md transition-all group">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="font-bold text-sm text-[#1B4332] group-hover:text-[#52B788] transition-colors">${m.titulo}</h3>
                  <span class="px-2 py-0.5 rounded-full text-[9px] font-bold text-white ${m.match_score >= 80 ? 'bg-emerald-500' : m.match_score >= 60 ? 'bg-amber-500' : 'bg-gray-400'}">${m.match_score}%</span>
                </div>
                <p class="text-xs text-gray-500 mb-2">📍 ${m.ubicacion_municipio || 'Tolima'} ${m.area_hectareas ? `· ${m.area_hectareas} ha` : ''} · ${formatPrecio(m.precio)}</p>
                <p class="text-xs text-gray-600 bg-gray-50 rounded-lg p-2">${m.match_reason}</p>
              </div>
              <span class="text-[#52B788] opacity-0 group-hover:opacity-100 transition-opacity text-lg">→</span>
            </div>
          </a>
        `).join('');

        results.classList.remove('hidden');
      } catch (err: any) {
        error.textContent = err.message || 'Error en la búsqueda';
        error.classList.remove('hidden');
      } finally {
        loading.classList.add('hidden');
        btn.disabled = false;
      }
    }

    btn.addEventListener('click', () => doSearch(input.value));
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSearch(input.value); });
    agent.querySelectorAll('.suggestion-btn').forEach(b => {
      b.addEventListener('click', () => {
        const q = b.getAttribute('data-query') || '';
        input.value = q;
        doSearch(q);
      });
    });
  }
</script>
