---
import { MUNICIPIOS_TOLIMA } from '@/lib/gestion';

interface Props {
  municipio?: string;
  checkin?: string;
  checkout?: string;
  huespedes?: string;
}

const { municipio = '', checkin = '', checkout = '', huespedes = '' } = Astro.props;
---

<form action="/gestion/alojamientos" method="get" class="w-full">
  <div class="bg-white rounded-2xl border border-gray-200 shadow-lg p-4 md:p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <!-- Location -->
      <div class="lg:col-span-1">
        <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1.5">Destino</label>
        <select name="municipio" class="w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm text-[#122640] bg-[#f8f9fb] focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] outline-none transition-colors">
          <option value="">Todo el Tolima</option>
          {MUNICIPIOS_TOLIMA.map((m) => (
            <option value={m} selected={municipio === m}>{m}</option>
          ))}
        </select>
      </div>

      <!-- Check-in -->
      <div class="lg:col-span-1">
        <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1.5">Llegada</label>
        <input
          type="date"
          name="checkin"
          value={checkin}
          class="w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm text-[#122640] bg-[#f8f9fb] focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] outline-none transition-colors"
        />
      </div>

      <!-- Check-out -->
      <div class="lg:col-span-1">
        <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1.5">Salida</label>
        <input
          type="date"
          name="checkout"
          value={checkout}
          class="w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm text-[#122640] bg-[#f8f9fb] focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] outline-none transition-colors"
        />
      </div>

      <!-- Guests -->
      <div class="lg:col-span-1">
        <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1.5">Huéspedes</label>
        <select name="huespedes" class="w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm text-[#122640] bg-[#f8f9fb] focus:border-[#52B788] focus:ring-1 focus:ring-[#52B788] outline-none transition-colors">
          <option value="">Cualquiera</option>
          {[1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20].map((n) => (
            <option value={String(n)} selected={huespedes === String(n)}>{n}+</option>
          ))}
        </select>
      </div>

      <!-- Submit -->
      <div class="lg:col-span-1 flex items-end">
        <button
          type="submit"
          class="w-full px-6 py-2.5 rounded-xl bg-[#52B788] text-[#0c1520] text-sm font-bold hover:bg-[#7fc4a2] transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          Buscar
        </button>
      </div>
    </div>
  </div>
</form>
