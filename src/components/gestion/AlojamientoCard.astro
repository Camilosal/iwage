---
import { propiedadGestionImagen, tipoGestionInfo } from '@/lib/gestion';
import type { PropiedadGestion } from '@/lib/gestion';

interface Props {
  prop: PropiedadGestion;
}

const { prop } = Astro.props;
const img = propiedadGestionImagen(prop);
const tipo = tipoGestionInfo(prop.tipo_gestion);

function formatPrecio(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  return n.toLocaleString('es-CO');
}
---

<a href={`/gestion/propiedades/${prop.slug}`} class="group block bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#52B788]/40 hover:shadow-xl transition-all duration-300">
  <!-- Image -->
  <div class="relative h-56 bg-gray-100 overflow-hidden">
    {img ? (
      <img src={img} alt={prop.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-[#1e3a5f]/10">
        <span class="text-5xl">{tipo.icon}</span>
      </div>
    )}
    <!-- Heart icon (visual) -->
    <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
      <svg class="w-4 h-4 text-[#122640]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </div>
    <!-- Featured badge -->
    {prop.es_destacado && (
      <span class="absolute top-3 left-3 bg-[#C8933E] text-white text-[10px] font-bold px-2.5 py-1 rounded-full">★ Destacado</span>
    )}
    <!-- Type badge -->
    <div class="absolute bottom-3 left-3">
      <span class="bg-white/90 backdrop-blur-sm text-[#122640] text-[10px] font-bold px-2.5 py-1 rounded-full capitalize">
        {tipo.icon} {tipo.label}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5">
    <!-- Location -->
    <p class="text-xs text-gray-400 font-medium mb-1.5 flex items-center gap-1">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      {prop.ubicacion_municipio || 'Tolima'}, Colombia
    </p>

    <!-- Title -->
    <h3 class="font-bold text-[#122640] group-hover:text-[#52B788] transition-colors mb-2 line-clamp-1">{prop.titulo}</h3>

    <!-- Capacity + rooms -->
    <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
      {prop.capacidad_huespedes && <span class="flex items-center gap-1">👥 {prop.capacidad_huespedes} huéspedes</span>}
      {prop.numero_habitaciones && <span class="flex items-center gap-1">🛏️ {prop.numero_habitaciones}</span>}
      {prop.numero_banos && <span class="flex items-center gap-1">🚿 {prop.numero_banos}</span>}
    </div>

    <!-- Amenities (top 3) -->
    {prop.amenidades && prop.amenidades.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-3">
        {prop.amenidades.slice(0, 3).map((a) => (
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#f8f9fb] text-gray-500 border border-gray-100">{a}</span>
        ))}
        {prop.amenidades.length > 3 && (
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#f8f9fb] text-gray-400 border border-gray-100">+{prop.amenidades.length - 3}</span>
        )}
      </div>
    )}

    <!-- Price + Rating -->
    <div class="flex items-center justify-between pt-3 border-t border-gray-50">
      <div>
        {prop.precio_noche ? (
          <p class="text-sm">
            <span class="font-bold text-[#122640]">${formatPrecio(prop.precio_noche)}</span>
            <span class="text-gray-400 text-xs"> / noche</span>
          </p>
        ) : (
          <p class="text-sm font-bold text-[#122640]">Consultar precio</p>
        )}
      </div>
      <div class="flex items-center gap-1 text-xs text-gray-400">
        <span class="text-[#C8933E]">★</span>
        <span>Nuevo</span>
      </div>
    </div>
  </div>
</a>
