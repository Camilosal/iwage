---
import '@/styles/global.css';
import BrandNavbar from '@/components/brand/BrandNavbar.astro';
import BrandFooter from '@/components/brand/BrandFooter.astro';
import ChatWidget from '@/components/ChatWidget.astro';
import SearchOverlay from '@/components/SearchOverlay.astro';
import UnifiedCart from '@/components/cart/UnifiedCart';
import { getBrandFromPath, defaultBrand } from '@/config/brands';
import type { BrandConfig } from '@/config/brands/types';
import { GOOGLE, FACEBOOK, SWETRIX, ANALYTICS_ENABLED } from '@/config/analytics';

interface ArticleMeta {
  title: string;
  description: string;
  datePublished: string;
  dateModified?: string;
  author?: string;
  image?: string;
  section?: string;
  wordCount?: number;
}

interface Props {
  title?: string;
  description?: string;
  brand?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  article?: ArticleMeta;
}

const props = Astro.props;

// Resolve brand: explicit prop > URL detection > default
const brandSlug = props.brand ?? getBrandFromPath(Astro.url.pathname)?.slug;
const brandConfig: BrandConfig = brandSlug
  ? (await import('@/config/brands')).getBrand(brandSlug) ?? defaultBrand
  : defaultBrand;

const title = props.title ?? brandConfig.seo.defaultTitle;
const description = props.description ?? brandConfig.seo.defaultDescription;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://iwage.co');
const ogType = props.ogType ?? 'website';
const ogImage = props.ogImage ?? `https://iwage.co/images/hero-${brandConfig.slug === 'meliponas' ? 'meliponas' : brandConfig.slug}.webp`;

// Founder Person (reused across schemas)
const founderPerson = {
  "@type": "Person",
  "@id": "https://iwage.co/#founder",
  "name": "Manuel Camilo Saldarriaga Acosta",
  "url": "https://camilosaldarriaga.com",
  "sameAs": [
    "https://camilosaldarriaga.com",
    "https://www.linkedin.com/in/camilosaldarriaga",
    "https://iwage.co"
  ],
  "jobTitle": "Fundador",
  "worksFor": { "@id": "https://iwage.co/#organization" },
  "knowsAbout": [
    "Meliponicultura", "Desarrollo rural", "Turismo regenerativo",
    "Café de especialidad", "Inmobiliaria rural", "Property management"
  ]
};

// Structured data: Organization with founder + parentOrganization
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `https://iwage.co/${brandConfig.slug}/#organization`,
  "name": brandConfig.name,
  "url": `https://iwage.co/${brandConfig.slug}/`,
  "description": brandConfig.seo.defaultDescription,
  "founder": { "@id": "https://iwage.co/#founder" },
  "parentOrganization": {
    "@id": "https://iwage.co/#organization",
    "@type": "Organization",
    "name": "Iwagé Ecosistema",
    "url": "https://iwage.co"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ibagué",
    "addressRegion": "Tolima",
    "addressCountry": "CO"
  }
};

// ── BreadcrumbList (auto-generated from URL path) ──
const BRAND_LABELS: Record<string, string> = {
  meliponas: 'Meliponario', cafe: 'Café', tierras: 'Tierras',
  naturaleza: 'Naturaleza', gestion: 'Gestión', granja: 'Granja',
};
const SECTION_LABELS: Record<string, string> = {
  tienda: 'Tienda', nosotros: 'Nosotros', bitacora: 'Bitácora',
  propiedades: 'Propiedades', experiencias: 'Experiencias',
  anfitriones: 'Anfitriones', programas: 'Programas',
  proyectos: 'Proyectos', polinizacion: 'Polinización',
  trazabilidad: 'Trazabilidad', ayuda: 'Ayuda', contacto: 'Contacto',
  landing: 'Landings', perfiles: 'Perfiles', herramientas: 'Herramientas',
  'se-anfitrion': 'Sé Anfitrión', impacto: 'Impacto',
  sistema: 'Sistema', visitas: 'Visitas',
};

function buildBreadcrumb(pathname: string): Array<{ name: string; url: string }> {
  const segments = pathname.replace(/\/$/, '').split('/').filter(Boolean);
  if (segments.length === 0) return [];
  const crumbs: Array<{ name: string; url: string }> = [
    { name: 'Inicio', url: 'https://iwage.co/' },
  ];
  let path = '';
  for (let i = 0; i < segments.length; i++) {
    path += `/${segments[i]}`;
    const seg = segments[i];
    const label = BRAND_LABELS[seg] || SECTION_LABELS[seg] || seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    crumbs.push({ name: label, url: `https://iwage.co${path}` });
  }
  return crumbs;
}

const breadcrumbItems = buildBreadcrumb(Astro.url.pathname);
const breadcrumbJsonLd = breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": item.name,
    "item": item.url,
  })),
} : null;

// Combined JSON-LD graph (Organization + Person + Breadcrumb + optional Article)
const jsonLdGraph: Record<string, any>[] = [orgJsonLd, { "@context": "https://schema.org", ...founderPerson }];
if (breadcrumbJsonLd) jsonLdGraph.push(breadcrumbJsonLd);

// Article structured data (for bitácora pages)
if (props.article) {
  const a = props.article;
  jsonLdGraph.push({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": a.title,
    "description": a.description,
    "datePublished": a.datePublished,
    ...(a.dateModified && { "dateModified": a.dateModified }),
    "author": {
      "@type": "Person",
      "name": a.author || "Manuel Camilo Saldarriaga Acosta",
      "url": "https://camilosaldarriaga.com"
    },
    "publisher": { "@id": `https://iwage.co/${brandConfig.slug}/#organization` },
    ...(a.image && { "image": a.image }),
    ...(a.section && { "articleSection": a.section }),
    ...(a.wordCount && { "wordCount": a.wordCount }),
    "mainEntityOfPage": canonicalURL.href,
    "inLanguage": "es-CO"
  });
}

---

<!doctype html>
<html lang="es" data-brand={brandConfig.slug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Iwagé" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />
    {props.article && (
      <>
        <meta property="article:published_time" content={props.article.datePublished} />
        {props.article.dateModified && <meta property="article:modified_time" content={props.article.dateModified} />}
        {props.article.section && <meta property="article:section" content={props.article.section} />}
        <meta property="article:author" content="https://camilosaldarriaga.com" />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    {jsonLdGraph.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme init (no flash) -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('iwage-theme');
        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content={GOOGLE.siteVerification} />

    <!-- Google Tag (GA4 + Ads) — solo en producción -->
    {ANALYTICS_ENABLED.googleTag && (
      <script is:inline define:vars={{ gtagId: GOOGLE.tagId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true; j.src = 'https://www.googletagmanager.com/gtag/js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtagId);
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', gtagId, { send_page_view: true });
      </script>
    )}

    <!-- Meta Pixel — solo en producción -->
    {ANALYTICS_ENABLED.facebookPixel && (
      <script is:inline define:vars={{ fbPixelId: FACEBOOK.pixelId }}>
        !function (f, b, e, v, n, t, s) {
          if (f.fbq) return; n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments)
          };
          if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0';
          n.queue = []; t = b.createElement(e); t.async = !0;
          t.src = v; s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s)
        }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', fbPixelId);
        fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <BrandNavbar brand={brandConfig} />
    <main class="flex-1">
      <slot />
    </main>
    <BrandFooter brand={brandConfig} />
    <ChatWidget />
    <SearchOverlay />
    <UnifiedCart client:only="react" />

    <script>
      import { addItem } from '@/lib/cart-store';

      // Delegación global: cualquier botón `.add-to-cart` con data-recurso-slug
      // agrega su item al carrito unificado (funciona sin depender de React).
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.add-to-cart') as HTMLElement | null;
        if (!btn || btn.hasAttribute('disabled')) return;
        const recursoSlug = btn.dataset.recursoSlug;
        if (!recursoSlug) return;
        e.preventDefault();

        addItem({
          recurso_slug: recursoSlug,
          nombre: btn.dataset.name || 'Producto',
          precio: parseInt(btn.dataset.price || '0', 10),
          cantidad: parseInt(btn.dataset.qty || '1', 10),
          tipo: btn.dataset.tipo || 'producto',
          tipo_disponibilidad: btn.dataset.tipoDisponibilidad || 'inmediato',
          brand: btn.dataset.brand || 'meliponas',
          origen: btn.dataset.origen || 'iwage_meliponas',
          requiere_pago: btn.dataset.requierePago !== 'false',
          disponibilidad_id: btn.dataset.disponibilidadId || undefined,
          disponibilidad_label: btn.dataset.disponibilidadLabel || undefined,
          url: btn.dataset.url || undefined,
        });

        // Feedback breve conservando el contenido original (iconos incluidos)
        const original = btn.innerHTML;
        btn.innerHTML = '✓ Agregado';
        btn.classList.add('opacity-80');
        window.setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove('opacity-80');
        }, 1200);
      });
    </script>

    <!-- Swetrix Analytics (self-hosted) -->
    {ANALYTICS_ENABLED.swetrix && (
      <>
        <script src={SWETRIX.scriptSrc} defer></script>
        <script is:inline define:vars={{ projectId: SWETRIX.projectId, apiURL: SWETRIX.apiURL }}>
          document.addEventListener('DOMContentLoaded', function() {
            swetrix.init(projectId, { apiURL: apiURL })
            swetrix.trackViews()
          })
        </script>
        <noscript>
          <img
            src={SWETRIX.noscriptURL}
            alt=""
            referrerpolicy="no-referrer-when-downgrade"
          />
        </noscript>
      </>
    )}

  </body>
</html>
