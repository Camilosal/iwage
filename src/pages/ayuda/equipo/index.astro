---
import WikiLayout from '../layout.astro';

const title = 'Documentación para el Equipo';
const description = 'Guías técnicas para administrar contenido, reservas, pagos y configuración de la plataforma Iwagé.';

const articles = [
  { label: 'Gestión de contenido (Strapi)', href: '/ayuda/equipo/strapi-cms', desc: 'Cómo acceder al CMS Strapi, gestionar contenido de cada marca y el flujo de publicación.' },
  { label: 'Tipos de contenido', href: '/ayuda/equipo/contenido-tipos', desc: 'Referencia detallada de cada content type: campos, relaciones y uso.' },
  { label: 'Panel de reservas (admin)', href: '/ayuda/equipo/reservas-admin', desc: 'Dashboard administrativo: estadísticas, calendario, recursos y clientes.' },
  { label: 'Ciclo de vida de reservas', href: '/ayuda/equipo/gestion-reservas', desc: 'Estados de reserva, confirmación, cancelación, reembolsos y notificaciones.' },
  { label: 'Portal de aliados', href: '/ayuda/equipo/portal-aliados', desc: 'Cómo los aliados gestionan sus recursos, ven reservas y consultan liquidaciones.' },
  { label: 'Sincronización de recursos', href: '/ayuda/equipo/sincronizacion', desc: 'Mecanismo de sync entre Strapi, app_reservas y marca_personal. Anti-echo.' },
  { label: 'Pasarela de pagos (Bold)', href: '/ayuda/equipo/pagos', desc: 'Integración con Bold, webhooks, estados de pago y manejo de errores.' },
  { label: 'Órdenes y pedidos', href: '/ayuda/equipo/ordenes', desc: 'Flujo de órdenes por carrito y WhatsApp. Estructura y gestión.' },
  { label: 'Configuración del sitio', href: '/ayuda/equipo/configuracion', desc: 'Variables de entorno, feature flags y ajustes operativos.' },
];
---

<WikiLayout title={title} description={description} activePath="/ayuda/equipo">
  <Fragment slot="breadcrumb">
    <span class="text-text-primary">Equipo</span>
  </Fragment>

  <header class="mb-10">
    <h1 class="text-3xl font-extrabold tracking-tight text-text-primary">Documentación para el Equipo</h1>
    <p class="mt-3 text-base text-text-secondary leading-relaxed max-w-2xl">
      Guías técnicas para administrar la plataforma: gestión de contenido en Strapi, operación del sistema de reservas, pagos, sincronización y configuración.
    </p>
  </header>

  <div class="grid gap-4">
    {articles.map((a, i) => (
      <a href={a.href} class="group flex items-start gap-4 p-5 rounded-xl border border-border bg-surface-raised hover:border-brand/40 hover:shadow-md transition-all">
        <div class="w-8 h-8 rounded-lg bg-accent-muted flex items-center justify-center shrink-0 text-sm font-bold text-accent">
          {i + 1}
        </div>
        <div>
          <h2 class="text-base font-semibold text-text-primary group-hover:text-brand transition-colors">{a.label}</h2>
          <p class="mt-1 text-sm text-text-secondary leading-relaxed">{a.desc}</p>
        </div>
      </a>
    ))}
  </div>
</WikiLayout>
