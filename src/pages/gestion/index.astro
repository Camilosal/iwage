---
export const prerender = true;

import BrandLayout from '@/layouts/BrandLayout.astro';
import PropiedadGestionCard from '@/components/gestion/PropiedadGestionCard.astro';
import { getPropiedadesGestionDestacadas, TIPOS_GESTION } from '@/lib/gestion';

const destacadas = await getPropiedadesGestionDestacadas(3);
---

<BrandLayout brand="gestion" title="Iwagé Gestión · Property Management Rural · Tolima" description="Gestión integral de propiedades rurales: renta corta, finca productiva, segunda residencia y operación turística. Maximiza el valor de tu tierra en el Tolima.">

  <!-- Hero -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden bg-[#0c1520]">
    <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1600&q=80" alt="Finca rural gestionada en el Tolima" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0c1520] via-[#0c1520]/70 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-2 h-2 rounded-full bg-[#52B788] animate-pulse"></div>
          <span class="text-xs font-bold tracking-[0.4em] text-[#52B788] uppercase">Iwagé Gestión</span>
        </div>
        <h1 class="text-5xl lg:text-7xl font-light text-white leading-tight mb-8">
          Tu finca, <span class="font-serif italic text-[#52B788]">siempre productiva.</span>
        </h1>
        <p class="text-xl text-white/70 leading-relaxed mb-10 max-w-2xl">
          Administramos tu propiedad rural en el Tolima con un enfoque técnico y comercial. Segunda residencia, renta corta, finca productiva y operación turística.
        </p>
        <a href="#contacto" class="inline-block px-8 py-4 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold uppercase tracking-wider hover:bg-[#7fc4a2] transition-colors">
          Solicitar valoración gratuita
        </a>
      </div>
    </div>
  </section>

  <!-- Lines of operation (compact) -->
  <section class="py-14 px-4 bg-[#f8f9fb]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-bold tracking-[0.3em] text-[#2d5a8f] uppercase">Líneas de operación</span>
        <h2 class="text-3xl lg:text-4xl font-light text-[#122640] mt-3">Ecosistema de gestión integral</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        {TIPOS_GESTION.map((tipo) => (
          <a href={`/gestion/propiedades?tipo=${tipo.slug}`} class="group p-5 rounded-2xl bg-white border border-gray-100 text-center hover:shadow-lg hover:border-[#52B788]/30 transition-all">
            <div class="text-3xl mb-3">{tipo.icon}</div>
            <h3 class="text-sm font-bold text-[#122640] group-hover:text-[#52B788] transition-colors">{tipo.label}</h3>
            <p class="text-[11px] text-gray-400 mt-1">{tipo.desc}</p>
          </a>
        ))}
      </div>

      <!-- Featured properties -->
      <div class="text-center mb-8">
        <h3 class="text-xl font-light text-[#122640]">Propiedades destacadas</h3>
      </div>

      {destacadas.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {destacadas.map((prop) => (
            <PropiedadGestionCard prop={prop} />
          ))}
        </div>
      ) : (
        <div class="text-center py-10 bg-white rounded-3xl border border-gray-100">
          <p class="text-gray-400 text-sm mb-4">Próximamente publicaremos nuestras propiedades en gestión.</p>
          <a href="/gestion/propiedades" class="text-sm font-bold text-[#52B788] hover:text-[#2d5a8f] transition-colors">Ver portafolio →</a>
        </div>
      )}

      <div class="text-center mt-8">
        <a href="/gestion/propiedades" class="inline-block px-8 py-3.5 rounded-full bg-[#1e3a5f] text-white text-sm font-bold hover:bg-[#2d5a8f] transition-colors">
          Ver todas las propiedades →
        </a>
      </div>
    </div>
  </section>

  <!-- Reporting -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-xs font-bold tracking-[0.3em] text-[#2d5a8f] uppercase">Transparencia</span>
        <h2 class="text-3xl lg:text-4xl font-light text-[#122640] mt-3 mb-6">Reportes periódicos claros</h2>
        <p class="text-gray-600 leading-relaxed mb-6">Como propietario, recibirás informes detallados que garantizan que tu propiedad está en las mejores manos:</p>
        <ul class="space-y-3">
          {['Estado de cuenta de ingresos y egresos', 'Reporte fotográfico de mantenimiento', 'Control de pago de servicios y obligaciones', 'Seguimiento técnico de personal de apoyo'].map((item) => (
            <li class="flex items-center gap-3 text-sm text-gray-700 font-medium">
              <div class="w-2 h-2 rounded-full bg-[#52B788]"></div>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-3xl overflow-hidden h-80">
        <img src="https://images.unsplash.com/photo-1554469384-e58fac16e23a?w=800&q=80" alt="Reportes de gestión de propiedades" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Contact / Lead Form -->
  <section id="contacto" class="py-14 px-4 bg-[#0c1520]">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl lg:text-5xl font-light text-white mb-6">¿Hablamos sobre <span class="font-serif italic text-[#52B788]">tu propiedad?</span></h2>
      <p class="text-white/60 mb-10 max-w-lg mx-auto">Buscamos fincas en los corredores de Ibagué, Alvarado, Venadillo y alrededores para nuestra red premium de gestión.</p>
      <a
        href="https://wa.me/573001234567?text=Hola,%20quiero%20una%20valoración%20de%20mi%20propiedad%20para%20gestión"
        target="_blank"
        rel="noopener"
        class="inline-block px-10 py-4 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold uppercase tracking-wider hover:bg-[#7fc4a2] transition-colors"
      >
        Solicitar valoración por WhatsApp
      </a>
    </div>
  </section>
</BrandLayout>
