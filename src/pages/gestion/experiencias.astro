---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import { getExperienciasGestion, CATEGORIAS_EXPERIENCIA } from '@/lib/gestion';

export const prerender = false;

const url = new URL(Astro.request.url);
const categoriaFilter = url.searchParams.get('categoria') || '';

const experiencias = await getExperienciasGestion(categoriaFilter || undefined);

function fmtPrecio(n: number): string {
  return `$${n.toLocaleString('es-CO')}`;
}
---

<BrandLayout brand="gestion" title="Experiencias de Territorio · Iwagé Gestión" description="Complementa tu alojamiento con experiencias de naturaleza, café, meliponas y territorio en el Tolima. Actividades guiadas por anfitriones locales.">

  <!-- Hero -->
  <section class="relative py-16 md:py-20 px-4 overflow-hidden bg-[#0c1520]">
    <img src="https://images.unsplash.com/photo-1499696010180-025ef6e1a8f9?w=1600&q=80" alt="Experiencias de naturaleza en el Tolima" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0c1520] via-[#0c1520]/60 to-transparent"></div>
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <span class="text-xs font-bold tracking-[0.4em] text-[#52B788] uppercase">Experiencias</span>
      <h1 class="text-4xl lg:text-5xl font-light text-white mt-3 mb-4">
        Complementa tu <span class="font-serif italic text-[#52B788]">estadía</span>
      </h1>
      <p class="text-white/60 max-w-xl mx-auto">
        Nuestros alojamientos están conectados con experiencias de naturaleza, café y territorio. Vive el Tolima de forma auténtica.
      </p>
    </div>
  </section>

  <!-- Filter chips: tipo de experiencia -->
  <section class="sticky top-0 z-20 bg-white/95 backdrop-blur-sm border-b border-gray-100 py-4 px-4">
    <div class="max-w-7xl mx-auto flex items-center gap-3 overflow-x-auto no-scrollbar">
      <a
        href="/gestion/experiencias"
        class:list={[
          'shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-colors',
          !categoriaFilter ? 'bg-[#1e3a5f] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
        ]}
      >
        Todas
      </a>
      {CATEGORIAS_EXPERIENCIA.map((cat) => (
        <a
          href={`/gestion/experiencias?categoria=${cat.slug}`}
          class:list={[
            'shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-colors flex items-center gap-1.5',
            categoriaFilter === cat.slug ? 'bg-[#1e3a5f] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
          ]}
        >
          <Icon name={cat.icon} class="w-4 h-4" />
          {cat.label}
        </a>
      ))}
      <span class="shrink-0 ml-auto text-xs text-gray-400 font-medium">
        {experiencias.length} experiencia{experiencias.length !== 1 ? 's' : ''}
      </span>
    </div>
  </section>

  <!-- Experiences grid -->
  <section class="py-12 px-4 bg-[#f8f9fb] min-h-[40vh]">
    <div class="max-w-7xl mx-auto">
      {experiencias.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {experiencias.map((exp) => (
            <a href={`/naturaleza/experiencias/${exp.slug}`} class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#52B788]/40 hover:shadow-xl transition-all duration-300">
              <!-- Imagen -->
              <div class="relative h-44 bg-gray-100 overflow-hidden">
                {exp.imagen ? (
                  <img src={exp.imagen} alt={exp.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-[#2E7D32]/10">
                    <Icon name="leaf" class="w-12 h-12 text-[#2E7D32]/40" />
                  </div>
                )}
                {exp.es_destacado && (
                  <span class="absolute top-3 left-3 bg-[#C8933E] text-white text-[10px] font-bold px-2.5 py-1 rounded-full">★ Destacada</span>
                )}
                <!-- Categoría badge -->
                <div class="absolute bottom-3 left-3">
                  <span class="bg-white/90 backdrop-blur-sm text-[#122640] text-[10px] font-bold px-2.5 py-1 rounded-full">
                    <Icon name={(CATEGORIAS_EXPERIENCIA.find((c) => c.slug === exp.categoria) || CATEGORIAS_EXPERIENCIA[0]).icon} class="w-3 h-3 inline" /> {exp.categoria}
                  </span>
                </div>
              </div>

              <!-- Contenido -->
              <div class="p-5 flex flex-1 flex-col">
                {exp.ubicacion && (
                  <p class="text-xs text-gray-400 font-medium mb-1.5 flex items-center gap-1">
                    <Icon name="map-pin" class="w-3 h-3" /> {exp.ubicacion}
                  </p>
                )}
                <h3 class="font-bold text-[#122640] group-hover:text-[#52B788] transition-colors mb-2 line-clamp-2 min-h-[2.75rem] leading-snug">{exp.titulo}</h3>

                <!-- Datos básicos clave -->
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 mb-3">
                  {exp.duracion && <span class="flex items-center gap-1"><Icon name="clock" class="w-3 h-3" /> {exp.duracion}</span>}
                  {exp.cupo_maximo_desc && <span class="flex items-center gap-1"><Icon name="users" class="w-3 h-3" /> {exp.cupo_maximo_desc}</span>}
                  <span class="flex items-center gap-1"><Icon name="gauge" class="w-3 h-3" /> Nivel {exp.nivel_dificultad}/7</span>
                </div>

                {exp.resumen && (
                  <p class="text-xs text-gray-500 line-clamp-2 mb-3">{exp.resumen}</p>
                )}

                <!-- Precio + CTA -->
                <div class="mt-auto flex items-center justify-between pt-3 border-t border-gray-50">
                  {exp.precio_desde ? (
                    <p class="text-sm">
                      <span class="text-gray-400 text-xs">Desde </span>
                      <span class="font-bold text-[#122640]">{fmtPrecio(exp.precio_desde)}</span>
                      <span class="text-gray-400 text-xs"> /persona</span>
                    </p>
                  ) : (
                    <span class="text-sm text-gray-400">Consultar</span>
                  )}
                  <span class="text-xs text-[#52B788] font-bold group-hover:translate-x-1 transition-transform shrink-0">Ver <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-24">
          <Icon name="leaf" class="w-10 h-10 block mb-4 mx-auto" />
          <h2 class="text-xl font-semibold text-[#122640] mb-2">
            {categoriaFilter ? `Sin experiencias de ${categoriaFilter} por ahora` : 'Próximamente nuevas experiencias'}
          </h2>
          <p class="text-gray-500 max-w-md mx-auto mb-6">
            Estamos conectando nuestros alojamientos con experiencias únicas de territorio. Mientras tanto, explora las experiencias de Iwagé Naturaleza.
          </p>
          <a href="/naturaleza/experiencias" class="inline-block px-6 py-3 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold hover:bg-[#7fc4a2] transition-colors">
            Ver experiencias de Naturaleza <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA: Browse accommodations -->
  <section class="py-14 px-4 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-light text-[#122640] mb-4">¿Ya tienes dónde quedarte?</h2>
      <p class="text-gray-600 mb-8 max-w-lg mx-auto">
        Explora nuestros alojamientos rurales y reserva tu estadía con experiencias incluidas.
      </p>
      <a href="/gestion/alojamientos" class="inline-block px-8 py-3.5 rounded-full bg-[#1e3a5f] text-white text-sm font-bold hover:bg-[#2d5a8f] transition-colors">
        Ver alojamientos <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
      </a>
    </div>
  </section>

  <!-- Naturaleza cross-link -->
  <section class="py-14 px-4 bg-[#0c1520]">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-light text-white mb-4">Turismo regenerativo con Iwagé Naturaleza</h2>
      <p class="text-white/60 mb-8 max-w-lg mx-auto">
        Descubre itinerarios sensoriales, anfitriones locales y experiencias inmersivas diseñadas para reconectar con el territorio.
      </p>
      <a href="/naturaleza" class="inline-block px-8 py-3.5 rounded-full border border-white/30 text-white text-sm font-medium hover:bg-white/10 transition-colors">
        Explorar Iwagé Naturaleza <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
      </a>
    </div>
  </section>
</BrandLayout>
