---
export const prerender = true;
import BrandLayout from '@/layouts/BrandLayout.astro';

const CATEGORIES = [{"id": "todos", "label": "Todos", "icon": "📋"}, {"id": "renta", "label": "Renta Corta", "icon": "🏠"}, {"id": "operacion", "label": "Operación", "icon": "⚙️"}, {"id": "finanzas", "label": "Finanzas", "icon": "📊"}, {"id": "alianzas", "label": "Alianzas", "icon": "🤝"}];

const FAQS = [{"pregunta": "¿Qué incluye la gestión integral de Iwagé?", "respuesta": "Administración completa: marketing y publicación en plataformas (Airbnb, Booking), atención al huésped, limpieza y mantenimiento, gestión de precios dinámicos, reportes financieros mensuales y soporte 24/7.", "categoria": "operacion"}, {"pregunta": "¿Cuánto cuesta el property management?", "respuesta": "Cobramos entre 20-25% de los ingresos generados, dependiendo del tipo de propiedad y servicios requeridos. Sin ingresos, sin cobro. No hay costos fijos mensuales.", "categoria": "operacion"}, {"pregunta": "¿En qué plataformas publican mi propiedad?", "respuesta": "Airbnb, Booking.com, Vrbo y nuestro propio canal directo en iwage.co. Optimizamos títulos, fotos y precios para cada plataforma. El canal directo tiene 0% comisión de plataforma.", "categoria": "renta"}, {"pregunta": "¿Cómo manejan los precios?", "respuesta": "Usamos pricing dinámico basado en demanda, temporada, eventos locales y competencia. Ajustamos semanalmente para maximizar ocupación y tarifa promedio sin degradar la percepción de valor.", "categoria": "renta"}, {"pregunta": "¿Qué tipo de propiedades gestionan?", "respuesta": "Fincas productivas, casas campestres, segundas residencias, glampings y propiedades con potencial turístico en el Tolima. Evaluamos cada caso para determinar el modelo operativo óptimo.", "categoria": "renta"}, {"pregunta": "¿Cómo recibo mis ingresos?", "respuesta": "Transferencia bancaria mensual con reporte detallado: ingresos brutos, ocupación, tarifa promedio, deducciones (comisión, limpieza, mantenimiento) y neto a pagar. Acceso a dashboard en tiempo real.", "categoria": "finanzas"}, {"pregunta": "¿Qué rentabilidad puedo esperar?", "respuesta": "Depende de la propiedad, ubicación y temporada. En promedio, propiedades bien ubicadas en el Tolima generan 8-14% de rentabilidad anual sobre el valor del inmueble. Hacemos un análisis personalizado antes de firmar.", "categoria": "finanzas"}, {"pregunta": "¿Cómo funciona el modelo de alianzas?", "respuesta": "Para propietarios que no quieren vender pero sí monetizar: aportamos gestión, marketing y operación; el propietario aporta el inmueble. Repartimos ingresos según acuerdo (típicamente 70/30 propietario/gestor).", "categoria": "alianzas"}, {"pregunta": "¿Puedo usar mi propiedad cuando quiera?", "respuesta": "Sí. Bloqueamos las fechas que necesites sin costo. Solo pedimos 7 días de anticipación para reorganizar reservas existentes. Tu propiedad sigue siendo tuya.", "categoria": "alianzas"}];
---

<BrandLayout brand="gestion" title="Centro de Ayuda · Iwagé Gestión" description="Preguntas frecuentes y soporte de Iwagé Gestión. Encuentra respuestas rápidas.">
  <!-- Hero -->
  <section class="bg-surface pt-12 pb-8">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="text-4xl block mb-4">🏗️</span>
      <h1 class="text-3xl md:text-4xl font-serif text-text-primary mb-3">Centro de Ayuda</h1>
      <p class="text-text-secondary max-w-lg mx-auto mb-8">Todo sobre property management, renta corta y operación de propiedades rurales.</p>
      <!-- Search -->
      <div class="max-w-md mx-auto relative">
        <input
          type="search"
          id="faq-search"
          placeholder="Buscar pregunta..."
          class="w-full rounded-full border border-border bg-surface-raised px-5 py-3 pl-11 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand"
        />
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-sm">🔍</span>
      </div>
    </div>
  </section>

  <!-- Category filter -->
  <div class="max-w-4xl mx-auto px-6 mb-8">
    <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2 justify-center flex-wrap">
      {CATEGORIES.map((cat, i) => (
        <button
          type="button"
          class={`cat-pill rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap transition-all ${i === 0 ? 'bg-brand text-white' : 'bg-surface-sunken text-text-secondary hover:bg-brand-muted hover:text-brand'}`}
          data-cat={cat.id}
        >
          {cat.icon} {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- FAQ List -->
  <section class="max-w-3xl mx-auto px-6 pb-20">
    <div id="faq-list" class="space-y-3">
      {FAQS.map(faq => (
        <details class="faq-item group bg-surface-raised rounded-xl border border-border overflow-hidden" data-cat={faq.categoria}>
          <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer select-none hover:bg-brand-muted/30 transition-colors">
            <span class="text-sm font-medium text-text-primary">{faq.pregunta}</span>
            <span class="text-text-muted group-open:rotate-180 transition-transform shrink-0">▾</span>
          </summary>
          <div class="px-6 pb-5">
            <p class="text-sm text-text-secondary leading-relaxed">{faq.respuesta}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Empty state -->
    <div id="faq-empty" class="hidden text-center py-12">
      <span class="text-3xl block mb-3">🤷</span>
      <p class="text-text-secondary">No encontramos preguntas que coincidan.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-surface-sunken py-12">
    <div class="max-w-xl mx-auto px-6 text-center">
      <h2 class="text-xl font-bold text-text-primary mb-3">¿No encontraste tu respuesta?</h2>
      <p class="text-text-secondary mb-6">Escríbenos directamente y te ayudamos en menos de 2 horas.</p>
      <a href="/gestion/contacto" class="inline-flex items-center gap-2 bg-brand text-white rounded-full px-6 py-3 font-medium hover:bg-brand-light transition-all">
        Contactar soporte <i data-lucide="arrow-right" class="w-3.5 h-3.5 inline"></i>
      </a>
    </div>
  </section>
</BrandLayout>

<script>
  const searchInput = document.getElementById('faq-search') as HTMLInputElement;
  const pills = document.querySelectorAll('.cat-pill');
  const items = document.querySelectorAll('.faq-item');
  const emptyState = document.getElementById('faq-empty') as HTMLElement;
  let activeCat = 'todos';

  function filterFaqs() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const cat = el.getAttribute('data-cat') || '';
      const text = el.textContent?.toLowerCase() || '';
      const matchCat = activeCat === 'todos' || cat === activeCat;
      const matchSearch = !query || text.includes(query);
      if (matchCat && matchSearch) {
        el.style.display = '';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });
    emptyState.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', filterFaqs);

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCat = pill.getAttribute('data-cat') || 'todos';
      pills.forEach((p) => {
        p.classList.remove('bg-brand', 'text-white');
        p.classList.add('bg-surface-sunken', 'text-text-secondary');
      });
      pill.classList.add('bg-brand', 'text-white');
      pill.classList.remove('bg-surface-sunken', 'text-text-secondary');
      filterFaqs();
    });
  });

  // URL param support
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get('category');
  if (catParam) {
    const target = document.querySelector(`.cat-pill[data-cat="${catParam}"]`) as HTMLElement;
    target?.click();
  }
</script>
