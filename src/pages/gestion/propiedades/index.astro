---
import BrandLayout from '@/layouts/BrandLayout.astro';
import PropiedadGestionCard from '@/components/gestion/PropiedadGestionCard.astro';
import { getPropiedadesGestion, TIPOS_GESTION } from '@/lib/gestion';

// SSR for query param filtering
export const prerender = false;

const url = new URL(Astro.request.url);
const tipoFilter = url.searchParams.get('tipo') || '';

const { data: propiedades, total } = await getPropiedadesGestion({
  tipo: tipoFilter || undefined,
  pageSize: 24,
});
---

<BrandLayout brand="gestion" title="Propiedades en Gestión · Iwagé Gestión" description="Portafolio de propiedades rurales gestionadas por Iwagé: renta corta, finca productiva, segunda residencia y operación turística en el Tolima.">

  <!-- Hero compacto -->
  <section class="relative py-16 px-4 overflow-hidden bg-[#0c1520]">
    <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1600&q=80" alt="Propiedades rurales gestionadas" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0c1520] via-[#0c1520]/60 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto text-center">
      <span class="text-xs font-bold tracking-[0.4em] text-[#52B788] uppercase">Portafolio</span>
      <h1 class="text-4xl lg:text-5xl font-light text-white mt-3 mb-4">
        Propiedades en <span class="font-serif italic text-[#52B788]">gestión</span>
      </h1>
      <p class="text-white/60 max-w-xl mx-auto">
        Cada propiedad es operada con estándares profesionales y conectada a nuestro ecosistema: inmobiliaria, experiencias y anfitriones locales.
      </p>
    </div>
  </section>

  <!-- Filters -->
  <section class="sticky top-0 z-20 bg-white/95 backdrop-blur-sm border-b border-gray-100 py-4 px-4">
    <div class="max-w-6xl mx-auto flex items-center gap-3 overflow-x-auto no-scrollbar">
      <a
        href="/gestion/propiedades"
        class:list={[
          'shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-colors',
          !tipoFilter ? 'bg-[#1e3a5f] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
        ]}
      >
        Todos
      </a>
      {TIPOS_GESTION.map((tipo) => (
        <a
          href={`/gestion/propiedades?tipo=${tipo.slug}`}
          class:list={[
            'shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-colors flex items-center gap-1.5',
            tipoFilter === tipo.slug ? 'bg-[#1e3a5f] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
          ]}
        >
          <span>{tipo.icon}</span>
          {tipo.label}
        </a>
      ))}
      <span class="shrink-0 ml-auto text-xs text-gray-400 font-medium">{total} propiedad{total !== 1 ? 'es' : ''}</span>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-12 px-4 bg-[#f8f9fb] min-h-[50vh]">
    <div class="max-w-6xl mx-auto">
      {propiedades.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {propiedades.map((prop) => (
            <PropiedadGestionCard prop={prop} />
          ))}
        </div>
      ) : (
        <div class="text-center py-24">
          <div class="text-5xl mb-4">🏗️</div>
          <h2 class="text-xl font-semibold text-[#122640] mb-2">
            {tipoFilter ? 'No hay propiedades de este tipo aún' : 'Próximamente'}
          </h2>
          <p class="text-gray-500 max-w-md mx-auto mb-6">
            Estamos incorporando nuevas propiedades a nuestro portafolio de gestión. Déjanos tus datos y te avisamos.
          </p>
          <a
            href="https://wa.me/573001234567?text=Hola,%20quiero%20información%20sobre%20propiedades%20en%20gestión"
            target="_blank"
            rel="noopener"
            class="inline-block px-6 py-3 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold hover:bg-[#7fc4a2] transition-colors"
          >
            Avisarme por WhatsApp
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA propietarios -->
  <section class="py-14 px-4 bg-[#0c1520]">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl lg:text-3xl font-light text-white mb-4">¿Tienes una propiedad rural?</h2>
      <p class="text-white/60 mb-8 max-w-lg mx-auto">
        La incorporamos a nuestro portafolio de gestión. Evaluación gratuita y sin compromiso.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/573001234567?text=Hola,%20quiero%20una%20valoración%20de%20mi%20propiedad%20para%20gestión"
          target="_blank"
          rel="noopener"
          class="px-8 py-3.5 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold uppercase tracking-wider hover:bg-[#7fc4a2] transition-colors"
        >
          Solicitar valoración
        </a>
        <a
          href="/gestion/modelo-alianzas"
          class="px-8 py-3.5 rounded-full border border-white/30 text-white text-sm font-medium hover:bg-white/10 transition-colors"
        >
          Conocer modelos de alianza →
        </a>
      </div>
    </div>
  </section>
</BrandLayout>
