---
export const prerender = true;
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import { getPropiedadesGestion } from '@/lib/gestion';

const { total: propiedadesActivas } = await getPropiedadesGestion({ estado: 'activa', pageSize: 1 });
---

<BrandLayout brand="gestion" title="Modelo de Alianzas · Iwagé Gestión" description="Alianzas estratégicas con propietarios rurales en el Tolima. Modelo de co-gestión transparente: tú pones la tierra, nosotros la operación. Compartimos resultados.">

  <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-[#0c1520]">
    <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=1600&q=80" alt="Alianza colaborativa rural" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0c1520] via-[#0c1520]/70 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4">
      <span class="text-xs font-bold tracking-[0.4em] text-[#52B788] uppercase">Modelo de Alianzas</span>
      <h1 class="text-5xl lg:text-6xl font-light text-white leading-tight mt-4 mb-6">
        Tu tierra + nuestra operación = <span class="font-serif italic text-[#52B788]">resultados.</span>
      </h1>
      <p class="text-xl text-white/70 max-w-2xl">No necesitas invertir en operación. Ponemos el equipo, la tecnología y la experiencia comercial. Tú mantienes la propiedad y compartimos los resultados.</p>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 px-4 bg-[#f8f9fb]">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-light text-[#122640] text-center mb-12">¿Cómo funciona la alianza?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { icon: 'globe', rol: 'Tú pones', items: ['La propiedad (finca, casa, lote)', 'Acceso y permisos básicos', 'Visión de largo plazo'] },
          { icon: 'settings', rol: 'Nosotros ponemos', items: ['Equipo de gestión y operación', 'Tecnología y plataformas', 'Marketing y comercialización', 'Red de aliados y proveedores'] },
          { icon: 'trending-up', rol: 'Compartimos', items: ['Ingresos según modelo acordado', 'Reportes transparentes', 'Decisiones estratégicas conjuntas', 'Riesgos y oportunidades'] },
        ].map((col) => (
          <div class="p-8 rounded-3xl bg-white border border-gray-100">
            <div class="mb-4"><Icon name={col.icon} class="w-10 h-10 mx-auto text-[#2d5a8f]" /></div>
            <h3 class="text-lg font-bold text-[#122640] mb-4">{col.rol}</h3>
            <ul class="space-y-2">
              {col.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="text-[#52B788] mt-0.5">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Models -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-light text-[#122640] text-center mb-10">Modelos de participación</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { modelo: 'Gestión Pura', icon: 'key-round', desc: 'Administramos tu propiedad por un fee mensual fijo + porcentaje de ingresos. Ideal para segunda residencia y renta corta.', tag: 'Bajo riesgo', cta: 'Más común en Renta Corta' },
          { modelo: 'Co-Inversión', icon: 'rocket', desc: 'Invertimos juntos en adecuaciones y compartimos utilidades en proporción al aporte. Ideal para proyectos turísticos y productivos.', tag: 'Alto retorno', cta: 'Ideal para Op. Turística' },
          { modelo: 'Operación Compartida', icon: 'handshake', desc: 'Tú mantienes parte de la operación (ej: agricultura) y nosotros gestionamos el componente turístico/comercial.', tag: 'Flexibilidad', cta: 'Perfecto para Fincas Productivas' },
        ].map((m) => (
          <div class="p-7 rounded-3xl bg-[#f8f9fb] border border-gray-100 hover:shadow-xl hover:border-[#52B788]/30 transition-all duration-300 flex flex-col">
            <div class="mb-4"><Icon name={m.icon} class="w-8 h-8 mx-auto text-[#2d5a8f]" /></div>
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-bold text-[#122640]">{m.modelo}</h3>
              <span class="px-2.5 py-0.5 rounded-full bg-[#52B788]/10 text-[#2d5a8f] text-[10px] font-bold">{m.tag}</span>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed flex-1">{m.desc}</p>
            <p class="mt-4 pt-3 border-t border-gray-200 text-xs text-[#52B788] font-medium">{m.cta}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Properties in management -->
  <section class="py-16 px-4 bg-[#f8f9fb]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-light text-[#122640] mb-4">Propiedades que ya gestionamos</h2>
      <p class="text-gray-600 mb-8 max-w-lg mx-auto">
        {propiedadesActivas > 0
          ? `Actualmente operamos ${propiedadesActivas} propiedad${propiedadesActivas !== 1 ? 'es' : ''} bajo estos modelos en el Tolima.`
          : 'Estamos construyendo nuestro portafolio de propiedades gestionadas en el Tolima.'}
      </p>
      <a href="/gestion/propiedades" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#1e3a5f] text-white text-sm font-bold hover:bg-[#2d5a8f] transition-colors">
        Ver portafolio de propiedades <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
      </a>
    </div>
  </section>

  <!-- Testimonial / Case study -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="relative p-8 lg:p-12 rounded-3xl bg-[#0c1520] overflow-hidden">
        <div class="absolute top-0 right-0 w-40 h-40 bg-[#52B788]/10 rounded-full blur-3xl"></div>
        <div class="relative z-10">
          <div class="text-4xl text-[#52B788] mb-4">"</div>
          <p class="text-white/80 text-lg leading-relaxed mb-6 italic">
            Antes mi finca estaba abandonada la mitad del año. Ahora genera ingresos constantes y yo no tengo que preocuparme por nada. El equipo de Iwagé se encarga de todo: huéspedes, mantenimiento, reportes.
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#52B788]/20 flex items-center justify-center"><Icon name="user" class="w-5 h-5 text-[#52B788]" /></div>
            <div>
              <p class="text-white font-medium text-sm">Propietario aliado</p>
              <p class="text-white/40 text-xs">Finca en Alvarado, Tolima · Gestión Pura</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Requirements -->
  <section class="py-16 px-4 bg-[#1e3a5f]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-light text-white mb-8">¿Qué buscamos en un aliado?</h2>
      <div class="grid sm:grid-cols-2 gap-4 text-left">
        {[
          'Propiedad rural en el Tolima (Ibagué, Alvarado, Venadillo, Coello, Lérida)',
          'Documentación al día (escritura, tradición y libertad)',
          'Acceso vehicular razonable',
          'Interés en una relación de largo plazo (mínimo 1 año)',
          'Disponibilidad para visitas técnicas iniciales',
          'Alineación con valores de sostenibilidad y respeto al territorio',
        ].map((req) => (
          <div class="flex items-start gap-3 p-4 rounded-xl bg-white/5">
            <span class="text-[#52B788]">•</span>
            <span class="text-sm text-white/80">{req}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-4 bg-[#0c1520] text-center">
    <h2 class="text-3xl font-light text-white mb-4">Construyamos juntos</h2>
    <p class="text-white/60 mb-8">Cuéntanos sobre tu propiedad y exploremos el modelo de alianza ideal.</p>
    <a href="https://wa.me/573026693366?text=Hola,%20quiero%20explorar%20una%20alianza%20de%20gestión%20para%20mi%20propiedad" target="_blank" rel="noopener" class="inline-block px-10 py-4 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold uppercase tracking-wider hover:bg-[#7fc4a2] transition-colors">
      Proponer alianza
    </a>
  </section>
</BrandLayout>
