---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import Hero from '@/components/Hero.astro';
import { getHeroBySlug } from '@/lib/heroes';

const hero = await getHeroBySlug('/gestion/propietarios/finca-productiva');
---

<BrandLayout brand="gestion" title="Finca Productiva · Iwagé Gestión" description="Administración técnica y administrativa de fincas productivas en el Tolima. Supervisión de cultivos, nóminas rurales, inventarios y reportes de productividad por hectárea.">

  <!-- Banner -->
  <div class="bg-[#52B788]/10 border-b border-[#52B788]/20 px-4 py-3 text-center">
    <p class="text-sm text-[#122640]">Conoce las fincas productivas que gestionamos → <a href="/gestion/alojamientos?tipo=finca_productiva" class="font-bold text-[#2d5a8f] underline hover:text-[#52B788]">Ver portafolio</a></p>
  </div>

  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Finca Productiva"
      align="left"
    />
  ) : (
    <header class="relative min-h-[60vh] flex items-center overflow-hidden bg-[#0c1520]">
      <img src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?w=1600&q=80" alt="Finca productiva en el Tolima" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0c1520] via-[#0c1520]/70 to-transparent"></div>
      <div class="relative z-10 max-w-6xl mx-auto px-4">
        <span class="text-xs font-bold tracking-[0.4em] text-[#52B788] uppercase">Finca Productiva</span>
        <h1 class="text-5xl lg:text-6xl font-light text-white leading-tight mt-4 mb-6">
          Que la tierra <span class="font-serif italic text-[#52B788]">trabaje por ti.</span>
        </h1>
        <p class="text-xl text-white/70 max-w-2xl">Control técnico y administrativo profesional para que tu finca rinda al máximo. Supervisión de labores agropecuarias con indicadores claros.</p>
      </div>
    </header>
  )}

  <section class="py-16 px-4 bg-[#f8f9fb]">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-light text-[#122640] text-center mb-12">Gestión integral del campo</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {[
          { icon: 'package', title: 'Inventarios', desc: 'Control de insumos, herramientas, semillas y agroquímicos con alertas de reabastecimiento.' },
          { icon: 'wheat', title: 'Supervisión Técnica', desc: 'Planes de fertilización, siembra, poda y cosecha con seguimiento agronómico profesional.' },
          { icon: 'hard-hat', title: 'Nóminas Rurales', desc: 'Gestión administrativa de operarios, trabajadores temporales y prestaciones de ley.' },
          { icon: 'bar-chart-2', title: 'Indicadores', desc: 'Reportes mensuales de producción, rendimiento por hectárea y costos operativos.' },
          { icon: 'handshake', title: 'Proveedores', desc: 'Coordinación con proveedores agrícolas, veterinarios y servicios técnicos especializados.' },
          { icon: 'beef', title: 'Ganadería', desc: 'Control sanitario, rotación de potreros, suplementación y registros de producción lechera.' },
        ].map((item) => (
          <div class="p-6 rounded-2xl bg-white border border-gray-100 hover:shadow-lg transition-all">
            <div class="mb-3"><Icon name={item.icon} class="w-8 h-8 mx-auto text-[#2d5a8f]" /></div>
            <h3 class="font-semibold text-[#122640] mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-light text-[#122640] mb-6">¿Qué recibes como propietario?</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {[
          { metric: 'Mensual', label: 'Reporte de producción y costos' },
          { metric: 'Quincenal', label: 'Visita técnica con registro fotográfico' },
          { metric: 'Tiempo real', label: 'Alertas de novedades y emergencias' },
        ].map((r) => (
          <div class="p-6 rounded-2xl bg-[#f8f9fb]">
            <div class="text-xl font-bold text-[#2d5a8f]">{r.metric}</div>
            <div class="text-sm text-gray-600 mt-2">{r.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 bg-[#0c1520] text-center">
    <h2 class="text-3xl font-light text-white mb-4">Tu finca merece gestión profesional</h2>
    <p class="text-white/60 mb-8">Diagnóstico inicial gratuito de tu predio productivo.</p>
    <a href="https://wa.me/573026693366?text=Hola,%20quiero%20gestión%20para%20mi%20finca%20productiva" target="_blank" rel="noopener" class="inline-block px-10 py-4 rounded-full bg-[#52B788] text-[#0c1520] text-sm font-bold uppercase tracking-wider hover:bg-[#7fc4a2] transition-colors">
      Solicitar diagnóstico
    </a>
  </section>
</BrandLayout>
