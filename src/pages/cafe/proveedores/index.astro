---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Icon from '@/components/shared/Icon.astro';
import { getProveedores, proveedorFoto, proveedorIcono } from '@/lib/cafe';
import type { Proveedor } from '@/lib/cafe';
import Hero from '@/components/Hero.astro';
import { getHeroBySlug } from '@/lib/heroes';

const proveedores = await getProveedores();

const fallback: Proveedor[] = [
  { id: 1, documentId: '1', nombre: 'Familia Cardona', slug: 'familia-cardona', producto: 'Café de origen', ubicacion: 'Vereda El Carmen', distancia_km: 2.3, historia: 'Tres generaciones cultivando café en las laderas del Ambalá. Tueste medio, notas de panela y cítricos.', foto: { url: '/images/hero-cafe.webp' }, orden: 1 },
  { id: 2, documentId: '2', nombre: 'Finca La Cumbre', slug: 'finca-la-cumbre', producto: 'Leche y quesos', ubicacion: 'Cajamarca', distancia_km: 3.8, historia: 'Ganadería regenerativa a pequeña escala. Leche cruda para nuestro chocolate y quesos de temporada.', foto: { url: '/images/linea-granja.webp' }, orden: 2 },
  { id: 3, documentId: '3', nombre: 'Cacao El Espinal', slug: 'cacao-el-espinal', producto: 'Cacao fino de aroma', ubicacion: 'El Espinal', distancia_km: 38, historia: 'La excepción a nuestra regla de 4 km. Cacao fino de aroma del valle del Magdalena, fermentado 5 días.', foto: { url: '/images/linea-naturaleza.webp' }, orden: 3 },
  { id: 4, documentId: '4', nombre: 'Meliponario Iwagé', slug: 'meliponario-iwage', producto: 'Miel de Angelita', ubicacion: 'Corredor Ambalá', distancia_km: 0.2, historia: 'Nuestra propia miel de Tetragonisca angustula. Cosecha limitada, dulzor floral único.', foto: { url: '/images/linea-meliponas.webp' }, orden: 0 },
];

const display = proveedores.length > 0 ? proveedores : fallback;

function slugify(s: string): string {
  return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const hero = await getHeroBySlug('/cafe/proveedores');
---

<BrandLayout brand="cafe" title="Proveedores · Café Iwagé" description="Cada ingrediente tiene un rostro y una historia. Proveedores locales a menos de 4 km del café, cadena corta y nombre propio. Algunos son anfitriones del territorio y ofrecen experiencias.">
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Café Iwagé"
    />
  ) : (
    <header class="bg-dark-bg text-dark-text">
      <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">Café Iwagé</p>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight font-display">Proveedores</h1>
        <p class="mt-4 text-dark-text/60 max-w-xl mx-auto">
          Cadena corta, nombre propio. Cada ingrediente tiene un rostro y una distancia.
          Algunos proveedores son también anfitriones y abren sus fincas a experiencias.
        </p>
      </div>
    </header>
  )}

  <!-- Supplier cards — estilo ficha con imagen -->
  <Section>
    <ScrollReveal>
      <SectionHeader
        label="Cadena corta"
        title="Menos de 4 km (casi siempre)"
        subtitle="Conocemos a cada proveedor por nombre. Visitamos sus fincas. Sabemos cómo trabajan."
      />
    </ScrollReveal>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {display.map((p, i) => {
        const foto = proveedorFoto(p);
        const icono = proveedorIcono(p);
        const provSlug = p.slug || slugify(p.nombre);
        const anfitriones = p.anfitriones ?? [];
        const experiencias = p.experiencias ?? [];
        const esAnfitrion = p.es_anfitrion || anfitriones.length > 0;
        const tieneExperiencias = p.ofrece_experiencias || experiencias.length > 0;
        return (
          <ScrollReveal delay={i * 80}>
            <a
              href={`/cafe/proveedores/${provSlug}`}
              class="group block bg-surface-raised rounded-2xl border border-border overflow-hidden h-full flex flex-col transition-all hover:border-brand/40 hover:shadow-md"
            >
              {/* Imagen header */}
              <div class="relative w-full h-40 overflow-hidden">
                {foto ? (
                  <img src={foto} alt={p.nombre} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-brand-muted/40 flex items-center justify-center">
                    <Icon name={icono} class="w-10 h-10 text-brand/40" />
                  </div>
                )}
                {p.distancia_km != null && (
                  <span class="absolute top-3 right-3 text-[10px] font-bold bg-accent/90 text-white rounded-full px-2.5 py-1 backdrop-blur-sm">
                    {p.distancia_km} km
                  </span>
                )}
                {p.destacado && (
                  <span class="absolute top-3 left-3 text-[10px] font-bold bg-brand/90 text-white rounded-full px-2.5 py-1 backdrop-blur-sm flex items-center gap-1">
                    <Icon name="star" class="w-3 h-3" /> Destacado
                  </span>
                )}
              </div>
              {/* Body */}
              <div class="p-5 flex flex-col flex-1">
                {/* Badges de rol */}
                {(esAnfitrion || tieneExperiencias) && (
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    {esAnfitrion && (
                      <span class="text-[9px] font-semibold bg-[#2d5016]/10 text-[#2d5016] rounded-full px-2 py-0.5 flex items-center gap-1">
                        <Icon name="compass" class="w-3 h-3" /> Anfitrión
                      </span>
                    )}
                    {tieneExperiencias && (
                      <span class="text-[9px] font-semibold bg-accent/10 text-accent rounded-full px-2 py-0.5 flex items-center gap-1">
                        <Icon name="leaf" class="w-3 h-3" /> Experiencias
                      </span>
                    )}
                  </div>
                )}
                <h3 class="text-base font-semibold text-text-primary group-hover:text-brand transition-colors mb-1 leading-snug">
                  {p.nombre}
                </h3>
                {p.producto && (
                  <p class="text-xs text-brand font-medium mb-2">{p.producto}</p>
                )}
                <p class="text-xs text-text-secondary leading-relaxed line-clamp-2 flex-1">
                  {p.historia || p.ubicacion || ''}
                </p>
                <div class="mt-3 flex items-center justify-between">
                  <span class="text-[10px] text-text-muted flex items-center gap-1">
                    <Icon name="map-pin" class="w-3 h-3" /> {p.ubicacion || 'Corredor Ambalá'}
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] font-medium text-brand opacity-0 group-hover:opacity-100 transition-opacity">
                    Ver ficha <Icon name="arrow-right" class="w-3 h-3" />
                  </span>
                </div>
              </div>
            </a>
          </ScrollReveal>
        );
      })}
    </div>
  </Section>

  <!-- Philosophy -->
  <Section bg="sunken" class="!py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-text-primary mb-4 font-display">Nuestra regla de los 4 km</h2>
      <p class="text-text-secondary leading-relaxed mb-8">
        Todo ingrediente principal debe venir de menos de 4 kilómetros. La excepción es el cacao,
        que no crece a nuestra altitud. Esta regla no es marketing: es la forma en que garantizamos
        frescura, trazabilidad y que el dinero se queda en el territorio.
      </p>
    </div>
  </Section>

  <!-- CTA: Quiero ser proveedor -->
  <Section bg="dark" class="!py-14">
    <ScrollReveal>
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-14 h-14 rounded-2xl bg-brand-muted/20 flex items-center justify-center mx-auto mb-5">
          <Icon name="handshake" class="w-7 h-7 text-brand" />
        </div>
        <h2 class="text-2xl md:text-3xl font-bold text-dark-text mb-3 font-display">¿Quieres ser proveedor?</h2>
        <p class="text-dark-text/60 mb-8 leading-relaxed">
          Si produces café, miel, frutas, hierbas, panadería o cualquier ingrediente dentro del corredor Ambalá y alrededores, nos gustaría conocerte. Trabajamos con productores locales que compartan nuestra filosofía de cadena corta y calidad con nombre propio.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://wa.me/573026693366?text=Hola%2C%20me%20interesa%20ser%20proveedor%20del%20Caf%C3%A9%20Iwag%C3%A9" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-accent text-white rounded-full px-7 py-3.5 text-sm font-semibold hover:bg-accent-light transition-all">
            <Icon name="message-circle" class="w-4 h-4" /> Escríbenos por WhatsApp
          </a>
          <a href="/cafe/contacto" class="inline-flex items-center gap-2 border border-dark-text/20 text-dark-text rounded-full px-7 py-3.5 text-sm font-medium hover:border-brand hover:text-brand transition-all">
            <Icon name="mail" class="w-4 h-4" /> Formulario de contacto
          </a>
        </div>
      </div>
    </ScrollReveal>
  </Section>
</BrandLayout>
