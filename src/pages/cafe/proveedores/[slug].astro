---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Icon from '@/components/shared/Icon.astro';
import { getProveedores, proveedorFoto, proveedorIcono } from '@/lib/cafe';
import type { Proveedor } from '@/lib/cafe';

const proveedores = await getProveedores();

// Fallback cuando Strapi no responde
const fallback: Proveedor[] = [
  { id: 1, documentId: '1', nombre: 'Familia Cardona', slug: 'familia-cardona', producto: 'Café de origen', ubicacion: 'Vereda El Carmen', distancia_km: 2.3, historia: 'Tres generaciones cultivando café en las laderas del Ambalá. Tueste medio, notas de panela y cítricos.', foto: { url: '/images/hero-cafe.webp' }, orden: 1 },
  { id: 2, documentId: '2', nombre: 'Finca La Cumbre', slug: 'finca-la-cumbre', producto: 'Leche y quesos', ubicacion: 'Cajamarca', distancia_km: 3.8, historia: 'Ganadería regenerativa a pequeña escala. Leche cruda para nuestro chocolate y quesos de temporada.', foto: { url: '/images/linea-granja.webp' }, orden: 2 },
  { id: 3, documentId: '3', nombre: 'Cacao El Espinal', slug: 'cacao-el-espinal', producto: 'Cacao fino de aroma', ubicacion: 'El Espinal', distancia_km: 38, historia: 'La excepción a nuestra regla de 4 km. Cacao fino de aroma del valle del Magdalena, fermentado 5 días.', foto: { url: '/images/linea-naturaleza.webp' }, orden: 3 },
  { id: 4, documentId: '4', nombre: 'Meliponario Iwagé', slug: 'meliponario-iwage', producto: 'Miel de Angelita', ubicacion: 'Corredor Ambalá', distancia_km: 0.2, historia: 'Nuestra propia miel de Tetragonisca angustula. Cosecha limitada, dulzor floral único.', foto: { url: '/images/linea-meliponas.webp' }, orden: 0 },
];

const allProveedores = proveedores.length > 0 ? proveedores : fallback;

// Resolve slug from URL
const { slug } = Astro.params;
const proveedor = allProveedores.find(p => (p.slug || slugify(p.nombre)) === slug);

function slugify(s: string): string {
  return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

if (!proveedor) {
  return Astro.redirect('/cafe/proveedores');
}

const foto = proveedorFoto(proveedor);
const icono = proveedorIcono(proveedor);
const anfitriones = proveedor.anfitriones ?? [];
const experiencias = proveedor.experiencias ?? [];
const propiedades = proveedor.propiedades ?? [];
const propiedadesGestion = proveedor.propiedades_gestion ?? [];
const servicios = (proveedor.servicios ?? []) as string[];
const esAnfitrion = proveedor.es_anfitrion || anfitriones.length > 0;
const tieneExperiencias = proveedor.ofrece_experiencias || experiencias.length > 0;
const tienePropiedades = propiedades.length > 0;
const tieneGestion = propiedadesGestion.length > 0;

// Otros proveedores para cross-nav
const otrosProveedores = allProveedores
  .filter(p => p.nombre !== proveedor.nombre)
  .slice(0, 4);

const waLink = (wa: string) => `https://wa.me/${wa.replace(/\D/g, '')}`;
const igLink = (ig: string) => `https://instagram.com/${ig.replace(/^@/, '')}`;

const tipoLabel: Record<string, string> = {
  finca: 'Finca', lote: 'Lote', casa_campestre: 'Casa campestre',
  predio_rural: 'Predio rural', terreno: 'Terreno', otro: 'Predio',
};
const gestionLabel: Record<string, string> = {
  renta_corta: 'Renta corta', finca_productiva: 'Finca productiva',
  segunda_residencia: 'Segunda residencia', operacion_turistica: 'Operación turística',
};
---

<BrandLayout brand="cafe" title={`${proveedor.nombre} · Proveedores · Café Iwagé`} description={`${proveedor.historia || proveedor.producto || proveedor.nombre} — Proveedor del Café Iwagé a ${proveedor.distancia_km ?? '?'} km.`}>
  <!-- Breadcrumb -->
  <div class="bg-surface-sunken border-b border-border">
    <div class="max-w-4xl mx-auto px-6 py-3">
      <nav class="flex items-center gap-2 text-xs text-text-muted">
        <a href="/cafe/" class="hover:text-brand transition-colors">Café</a>
        <Icon name="chevron-right" class="w-3 h-3" />
        <a href="/cafe/proveedores" class="hover:text-brand transition-colors">Proveedores</a>
        <Icon name="chevron-right" class="w-3 h-3" />
        <span class="text-text-primary font-medium truncate">{proveedor.nombre}</span>
      </nav>
    </div>
  </div>

  <!-- Hero con foto -->
  <section class="relative h-56 md:h-72 overflow-hidden">
    {foto ? (
      <img src={foto} alt={proveedor.nombre} class="absolute inset-0 w-full h-full object-cover" loading="eager" />
    ) : (
      <div class="absolute inset-0 w-full h-full bg-brand-muted/40 flex items-center justify-center">
        <Icon name={icono} class="w-20 h-20 text-brand/30" />
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-dark-bg/40 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 max-w-4xl mx-auto">
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-accent mb-2">Proveedor del Café Iwagé</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight font-display">{proveedor.nombre}</h1>
          {proveedor.producto && (
            <p class="text-sm text-white/70 mt-1.5 font-medium">{proveedor.producto}</p>
          )}
        </div>
        <div class="ml-auto flex items-center gap-2">
          {proveedor.distancia_km != null && (
            <span class="text-xs font-medium bg-accent/90 text-white rounded-full px-3 py-1.5 backdrop-blur-sm">
              {proveedor.distancia_km} km
            </span>
          )}
          {proveedor.destacado && (
            <span class="text-xs font-medium bg-brand/90 text-white rounded-full px-3 py-1.5 backdrop-blur-sm">
              <Icon name="star" class="w-3 h-3 inline align-[-1px] mr-0.5" />Destacado
            </span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido principal -->
  <Section>
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Columna principal -->
        <div class="md:col-span-2 space-y-8">
          <!-- Historia -->
          {proveedor.historia && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-2">Su historia</p>
                <p class="text-base text-text-secondary leading-relaxed">{proveedor.historia}</p>
              </div>
            </ScrollReveal>
          )}

          <!-- Badges de rol -->
          {(esAnfitrion || tieneExperiencias || tienePropiedades || tieneGestion) && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-3">Rol en el territorio</p>
                <div class="flex flex-wrap gap-2">
                  {esAnfitrion && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#2d5016]/10 text-[#2d5016] rounded-full px-3 py-1.5">
                      <Icon name="compass" class="w-4 h-4" />
                      {anfitriones.length > 0 ? `Anfitrión: ${anfitriones[0].nombre}` : 'Anfitrión del territorio'}
                    </span>
                  )}
                  {tieneExperiencias && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-accent/10 text-accent rounded-full px-3 py-1.5">
                      <Icon name="leaf" class="w-4 h-4 text-accent" />
                      {experiencias.length > 0
                        ? `${experiencias.length} experiencia${experiencias.length > 1 ? 's' : ''}`
                        : 'Ofrece experiencias'}
                    </span>
                  )}
                  {tienePropiedades && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#1a4a6b]/10 text-[#1a4a6b] rounded-full px-3 py-1.5">
                      <Icon name="home" class="w-4 h-4 text-[#1a4a6b]" />
                      {propiedades.length} propiedad{propiedades.length > 1 ? 'es' : ''} en venta
                    </span>
                  )}
                  {tieneGestion && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#6b3fa0]/10 text-[#6b3fa0] rounded-full px-3 py-1.5">
                      <Icon name="key-round" class="w-4 h-4 text-[#6b3fa0]" />
                      {propiedadesGestion.length} en gestión
                    </span>
                  )}
                </div>
              </div>
            </ScrollReveal>
          )}

          <!-- Servicios -->
          {servicios.length > 0 && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-3">Servicios</p>
                <div class="flex flex-wrap gap-2">
                  {servicios.map(s => (
                    <span class="text-xs text-text-secondary bg-surface-sunken border border-border rounded-full px-3 py-1">{s}</span>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          )}

          {/* Anfitriones vinculados */}
          {anfitriones.length > 0 && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-3">Anfitriones del territorio</p>
                <div class="space-y-2">
                  {anfitriones.map(a => (
                    <a href={a.slug ? `/naturaleza/anfitriones/${a.slug}` : '/naturaleza/anfitriones'}
                      class="group flex items-center gap-3 rounded-xl border border-border bg-surface-raised p-4 hover:border-[#2d5016]/50 transition-colors">
                      <Icon name="compass" class="w-5 h-5 text-[#2d5016] shrink-0" />
                      <div class="min-w-0 flex-1">
                        <p class="text-sm font-semibold text-text-primary group-hover:text-[#2d5016] transition-colors">{a.nombre}</p>
                        {a.especialidad && <p class="text-xs text-text-secondary mt-0.5">{a.especialidad}</p>}
                      </div>
                      <Icon name="arrow-right" class="w-4 h-4 text-text-muted group-hover:text-[#2d5016] transition-colors shrink-0" />
                    </a>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          )}

          {/* Experiencias */}
          {experiencias.length > 0 && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-3">Experiencias en el territorio</p>
                <div class="space-y-2">
                  {experiencias.map(e => (
                    <a href={e.slug ? `/naturaleza/experiencias/${e.slug}` : '/naturaleza/experiencias'}
                      class="group flex items-start gap-3 rounded-xl border border-border bg-surface-raised p-4 hover:border-accent/50 transition-colors">
                      <Icon name="leaf" class="w-5 h-5 text-accent shrink-0 mt-0.5" />
                      <div class="min-w-0 flex-1">
                        <p class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">{e.titulo}</p>
                        {e.resumen && <p class="text-xs text-text-secondary mt-0.5 line-clamp-2">{e.resumen}</p>}
                        {e.categoria && <p class="text-[10px] font-mono uppercase tracking-wider text-text-muted mt-1">{e.categoria}</p>}
                      </div>
                      <Icon name="arrow-right" class="w-4 h-4 text-text-muted group-hover:text-accent transition-colors shrink-0" />
                    </a>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          )}

          {/* Propiedades en venta */}
          {propiedades.length > 0 && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-3">Propiedades en venta (Tierras Iwagé)</p>
                <div class="space-y-2">
                  {propiedades.map(pr => {
                    const tipo = tipoLabel[pr.tipo_propiedad] || pr.tipo_propiedad || 'Propiedad';
                    const area = pr.area_hectareas ? `${pr.area_hectareas} ha` : '';
                    const precio = pr.precio ? `$${Number(pr.precio).toLocaleString('es-CO')}` : '';
                    return (
                      <a href={pr.slug ? `/tierras/${pr.slug}` : '/tierras'}
                        class="group flex items-start gap-3 rounded-xl border border-border bg-surface-raised p-4 hover:border-[#1a4a6b]/50 transition-colors">
                        <Icon name="home" class="w-5 h-5 text-[#1a4a6b] shrink-0 mt-0.5" />
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-semibold text-text-primary group-hover:text-[#1a4a6b] transition-colors">{pr.titulo}</p>
                          <p class="text-xs text-text-secondary mt-0.5">{[tipo, pr.ubicacion_municipio, area, precio].filter(Boolean).join(' · ')}</p>
                          {pr.estado && (
                            <p class="text-[10px] font-mono mt-1 text-emerald-600">{pr.estado === 'disponible' ? 'Disponible' : pr.estado === 'reservado' ? 'Reservado' : pr.estado}</p>
                          )}
                        </div>
                        <Icon name="arrow-right" class="w-4 h-4 text-text-muted group-hover:text-[#1a4a6b] transition-colors shrink-0" />
                      </a>
                    );
                  })}
                </div>
              </div>
            </ScrollReveal>
          )}

          {/* Propiedades en gestión */}
          {propiedadesGestion.length > 0 && (
            <ScrollReveal>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-3">Propiedades gestionadas (Gestión Iwagé)</p>
                <div class="space-y-2">
                  {propiedadesGestion.map(pg => {
                    const tipo = gestionLabel[pg.tipo_gestion] || pg.tipo_gestion || 'Gestión';
                    const area = pg.area_hectareas ? `${pg.area_hectareas} ha` : '';
                    return (
                      <a href={pg.slug ? `/gestion/${pg.slug}` : '/gestion'}
                        class="group flex items-start gap-3 rounded-xl border border-border bg-surface-raised p-4 hover:border-[#6b3fa0]/50 transition-colors">
                        <Icon name="key-round" class="w-5 h-5 text-[#6b3fa0] shrink-0 mt-0.5" />
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-semibold text-text-primary group-hover:text-[#6b3fa0] transition-colors">{pg.titulo}</p>
                          <p class="text-xs text-text-secondary mt-0.5">{[tipo, pg.ubicacion_municipio, area].filter(Boolean).join(' · ')}</p>
                          {pg.estado && (
                            <p class="text-[10px] font-mono mt-1">{pg.estado === 'activa' ? 'Activa' : pg.estado === 'pausada' ? 'Pausada' : pg.estado}</p>
                          )}
                        </div>
                        <Icon name="arrow-right" class="w-4 h-4 text-text-muted group-hover:text-[#6b3fa0] transition-colors shrink-0" />
                      </a>
                    );
                  })}
                </div>
              </div>
            </ScrollReveal>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-5">
          <!-- Ubicación -->
          {proveedor.ubicacion && (
            <div class="bg-surface-raised rounded-2xl border border-border p-5">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="map-pin" class="w-4 h-4 text-brand" />
                <p class="text-xs font-mono uppercase tracking-widest text-text-muted">Ubicación</p>
              </div>
              <p class="text-sm text-text-primary font-medium">{proveedor.ubicacion}</p>
              {proveedor.distancia_km != null && (
                <p class="text-xs text-text-muted mt-1">A {proveedor.distancia_km} km del café</p>
              )}
              {proveedor.direccion && (
                <p class="text-xs text-text-secondary mt-2">{proveedor.direccion}</p>
              )}
            </div>
          )}

          <!-- Contacto -->
          {(proveedor.whatsapp || proveedor.instagram || proveedor.telefono || proveedor.horario) && (
            <div class="bg-surface-raised rounded-2xl border border-border p-5">
              <p class="text-xs font-mono uppercase tracking-widest text-text-muted mb-3">Contacto</p>
              <div class="space-y-2.5">
                {proveedor.whatsapp && (
                  <a href={waLink(proveedor.whatsapp)} target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-text-secondary hover:text-[#25D366] transition-colors">
                    <Icon name="message-circle" class="w-4 h-4 shrink-0" /> WhatsApp
                  </a>
                )}
                {proveedor.instagram && (
                  <a href={igLink(proveedor.instagram)} target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition-colors">
                    <Icon name="camera" class="w-4 h-4 shrink-0" /> {proveedor.instagram.replace(/^@/, '')}
                  </a>
                )}
                {proveedor.telefono && (
                  <a href={`tel:${proveedor.telefono.replace(/\s/g, '')}`} class="flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition-colors">
                    <Icon name="phone" class="w-4 h-4 shrink-0" /> {proveedor.telefono}
                  </a>
                )}
                {proveedor.horario && (
                  <div class="flex items-center gap-2 text-sm text-text-secondary">
                    <Icon name="clock" class="w-4 h-4 shrink-0" /> {proveedor.horario}
                  </div>
                )}
              </div>
            </div>
          )}

          {/* CTA: volver a proveedores */}
          <a href="/cafe/proveedores" class="flex items-center justify-center gap-2 bg-brand text-white rounded-xl px-5 py-3 text-sm font-semibold hover:bg-brand-dark transition-all">
            <Icon name="arrow-left" class="w-4 h-4" /> Volver a proveedores
          </a>
        </aside>
      </div>
    </div>
  </Section>

  <!-- Cross-nav: otros proveedores -->
  {otrosProveedores.length > 0 && (
    <Section bg="sunken" class="!py-12">
      <div class="max-w-4xl mx-auto">
        <p class="font-mono text-xs uppercase tracking-widest text-accent mb-6 text-center">Otros proveedores</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {otrosProveedores.map(op => {
            const opFoto = proveedorFoto(op);
            const opIcono = proveedorIcono(op);
            const opSlug = op.slug || slugify(op.nombre);
            return (
              <a href={`/cafe/proveedores/${opSlug}`} class="group bg-surface-raised rounded-xl border border-border p-4 text-center hover:border-brand/40 hover:shadow-md transition-all">
                {opFoto ? (
                  <img src={opFoto} alt={op.nombre} class="w-10 h-10 rounded-lg object-cover mx-auto mb-2" loading="lazy" />
                ) : (
                  <div class="w-10 h-10 rounded-lg bg-brand-muted/40 flex items-center justify-center mx-auto mb-2">
                    <Icon name={opIcono} class="w-5 h-5 text-brand/40" />
                  </div>
                )}
                <p class="text-xs font-semibold text-text-primary group-hover:text-brand transition-colors truncate">{op.nombre}</p>
                <p class="text-[10px] text-text-muted mt-0.5">{op.producto || op.ubicacion || ''}</p>
              </a>
            );
          })}
        </div>
      </div>
    </Section>
  )}
</BrandLayout>
