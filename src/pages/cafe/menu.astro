---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Icon from '@/components/shared/Icon.astro';
import { getMenuItems, CATEGORIAS_MENU, itemImage } from '@/lib/cafe';
import type { ItemMenu } from '@/lib/cafe';
import { icons } from 'lucide';

// Serializa un icono Lucide a SVG inline (build-time, zero runtime)
function lucideSvg(name: string, className: string): string {
  const pascal = name.replace(/(^|-)(\w)/g, (_, _s, c: string) => c.toUpperCase());
  const node = (icons as Record<string, [string, Record<string, string | number>][] | undefined>)[pascal];
  if (!node) return '';
  const inner = node.map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`).join('');
  return `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${className}" aria-hidden="true">${inner}</svg>`;
}

const allItems = await getMenuItems();

// ── Helpers de variaciones ──
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const parsePrecio = (p: string | null) => parseInt(String(p || '0').replace(/[^0-9]/g, ''), 10) || 0;
const fmtCOP = (n: number) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);

interface MenuEntry {
  rep: ItemMenu;            // item representativo que muestra la card
  variaciones: ItemMenu[];  // todos los items de la familia (>= 1), ordenados por precio
  precioDesde: number;      // precio más bajo de la familia
}

// Agrupa las variaciones de una misma familia en una sola card (la representativa).
// Los items sin familia quedan como cards individuales. La lista completa se
// conserva para el selector del modal de detalle.
function colapsarFamilias(items: ItemMenu[]): MenuEntry[] {
  const out: MenuEntry[] = [];
  const porFamilia = new Map<string, MenuEntry>();
  for (const it of items) {
    if (!it.familia) {
      out.push({ rep: it, variaciones: [it], precioDesde: parsePrecio(it.precio) });
      continue;
    }
    const existente = porFamilia.get(it.familia);
    if (existente) {
      existente.variaciones.push(it);
    } else {
      const entry: MenuEntry = { rep: it, variaciones: [it], precioDesde: parsePrecio(it.precio) };
      porFamilia.set(it.familia, entry);
      out.push(entry);
    }
  }
  for (const entry of out) {
    entry.variaciones.sort((a, b) => parsePrecio(a.precio) - parsePrecio(b.precio));
    entry.precioDesde = parsePrecio(entry.variaciones[0]?.precio ?? entry.rep.precio);
  }
  return out;
}

// Group by category (only categories with items), colapsando familias en una card
const grouped = CATEGORIAS_MENU.map(cat => ({
  ...cat,
  entries: colapsarFamilias(allItems.filter(i => i.categoria === cat.slug)),
})).filter(g => g.entries.length > 0);

// Fallback if Strapi is empty
const fallbackItems: ItemMenu[] = [
  // ── Café de origen Ambalá (familia: cafe-ambala, eje: Tamaño) ──
  { id: 1, documentId: '1', nombre: 'Café de origen Ambalá', slug: 'cafe-ambala-pequeno', descripcion: 'Notas de panela y cítricos', historia: 'Cultivado a 1,400 m.s.n.m. por la familia Cardona. Tueste medio, cuerpo redondo.', tags: ['Origen único', 'Tueste medio'], precio: '$5.500', destacado: true, categoria: 'cafe', imagen: null, orden: 1, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'cafe-ambala', etiqueta_variacion: 'Pequeño · 8 oz', eje_variacion: 'Tamaño' },
  { id: 2, documentId: '2', nombre: 'Café de origen Ambalá', slug: 'cafe-ambala-mediano', descripcion: 'Notas de panela y cítricos', historia: 'Cultivado a 1,400 m.s.n.m. por la familia Cardona. Tueste medio, cuerpo redondo.', tags: ['Origen único', 'Tueste medio'], precio: '$6.500', destacado: false, categoria: 'cafe', imagen: null, orden: 2, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'cafe-ambala', etiqueta_variacion: 'Mediano · 12 oz', eje_variacion: 'Tamaño' },
  { id: 3, documentId: '3', nombre: 'Café de origen Ambalá', slug: 'cafe-ambala-grande', descripcion: 'Notas de panela y cítricos', historia: 'Cultivado a 1,400 m.s.n.m. por la familia Cardona. Tueste medio, cuerpo redondo.', tags: ['Origen único', 'Tueste medio'], precio: '$7.500', destacado: false, categoria: 'cafe', imagen: null, orden: 3, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'cafe-ambala', etiqueta_variacion: 'Grande · 16 oz', eje_variacion: 'Tamaño' },
  // ── Espresso (sin variaciones) ──
  { id: 4, documentId: '4', nombre: 'Espresso doble', slug: null, descripcion: 'Doble shot, cuerpo medio', historia: 'Doble shot de nuestro blend house. Cuerpo medio, final dulce.', tags: ['Clásico'], precio: '$5.000', destacado: false, categoria: 'cafe', imagen: null, orden: 4, disponible: true, temporada: false, nota_disponibilidad: null },
  // ── Signature: Miel con café (familia: miel-cafe, eje: Tamaño) ──
  { id: 5, documentId: '5', nombre: 'Miel de Angelita con café', slug: 'miel-cafe-8oz', descripcion: 'Dulzor natural sin azúcar', historia: 'Infusión de miel cruda de T. angustula en espresso doble. Dulzor natural sin azúcar.', tags: ['Signature', 'Sin azúcar'], precio: '$9.000', destacado: true, categoria: 'signature', imagen: null, orden: 1, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'miel-cafe', etiqueta_variacion: 'Taza · 8 oz', eje_variacion: 'Tamaño' },
  { id: 6, documentId: '6', nombre: 'Miel de Angelita con café', slug: 'miel-cafe-12oz', descripcion: 'Dulzor natural sin azúcar', historia: 'Infusión de miel cruda de T. angustula en espresso doble. Dulzor natural sin azúcar.', tags: ['Signature', 'Sin azúcar'], precio: '$11.000', destacado: false, categoria: 'signature', imagen: null, orden: 2, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'miel-cafe', etiqueta_variacion: 'Grande · 12 oz', eje_variacion: 'Tamaño' },
  // ── Signature: Latte de miel y canela (familia: latte-miel, eje: Tamaño) ──
  { id: 7, documentId: '7', nombre: 'Latte de miel y canela', slug: 'latte-miel-8oz', descripcion: 'Leche de la Finca La Cumbre', historia: 'Leche de la Finca La Cumbre, espresso doble, miel de Angelita y canela del Huila.', tags: ['Signature', 'Caliente'], precio: '$9.500', destacado: true, categoria: 'signature', imagen: null, orden: 3, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'latte-miel', etiqueta_variacion: 'Taza · 8 oz', eje_variacion: 'Tamaño' },
  { id: 8, documentId: '8', nombre: 'Latte de miel y canela', slug: 'latte-miel-12oz', descripcion: 'Leche de la Finca La Cumbre', historia: 'Leche de la Finca La Cumbre, espresso doble, miel de Angelita y canela del Huila.', tags: ['Signature', 'Caliente'], precio: '$11.500', destacado: false, categoria: 'signature', imagen: null, orden: 4, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'latte-miel', etiqueta_variacion: 'Grande · 12 oz', eje_variacion: 'Tamaño' },
  // ── Aromática de flora nativa (familia: aromatica-flora, eje: Sabor) ──
  { id: 9, documentId: '9', nombre: 'Aromática de flora nativa', slug: 'aromatica-hierbabuena', descripcion: 'Hierbas del corredor biológico', historia: 'Blend de hierbas del corredor: hierbabuena, limoncillo y flor de guamo.', tags: ['Sin cafeína', 'Herbal'], precio: '$5.500', destacado: false, categoria: 'infusion', imagen: null, orden: 1, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'aromatica-flora', etiqueta_variacion: 'Hierbabuena', eje_variacion: 'Sabor' },
  { id: 10, documentId: '10', nombre: 'Aromática de flora nativa', slug: 'aromatica-limoncillo', descripcion: 'Hierbas del corredor biológico', historia: 'Infusión de limoncillo fresco del corredor. Cítrico, refrescante, digestivo.', tags: ['Sin cafeína', 'Herbal'], precio: '$5.500', destacado: false, categoria: 'infusion', imagen: null, orden: 2, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'aromatica-flora', etiqueta_variacion: 'Limoncillo', eje_variacion: 'Sabor' },
  { id: 11, documentId: '11', nombre: 'Aromática de flora nativa', slug: 'aromatica-guamo', descripcion: 'Hierbas del corredor biológico', historia: 'Flor de guamo recolectada en el corredor. Floral, suave, aromática.', tags: ['Sin cafeína', 'Floral'], precio: '$6.000', destacado: false, categoria: 'infusion', imagen: null, orden: 3, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'aromatica-flora', etiqueta_variacion: 'Flor de guamo', eje_variacion: 'Sabor' },
  // ── Cold brew Ambalá (familia: cold-brew, eje: Tamaño) ──
  { id: 12, documentId: '12', nombre: 'Cold brew Ambalá', slug: 'cold-brew-8oz', descripcion: 'Extracción en frío 18h', historia: 'Extracción en frío durante 18 horas con café de cosecha reciente. Suave, dulce, refrescante.', tags: ['Extracción 18h', 'Edición cosecha'], precio: '$8.000', destacado: false, categoria: 'frio', imagen: null, orden: 1, disponible: true, temporada: true, nota_disponibilidad: null, familia: 'cold-brew', etiqueta_variacion: 'Vaso · 8 oz', eje_variacion: 'Tamaño' },
  { id: 13, documentId: '13', nombre: 'Cold brew Ambalá', slug: 'cold-brew-16oz', descripcion: 'Extracción en frío 18h', historia: 'Extracción en frío durante 18 horas con café de cosecha reciente. Suave, dulce, refrescante.', tags: ['Extracción 18h', 'Edición cosecha'], precio: '$11.000', destacado: false, categoria: 'frio', imagen: null, orden: 2, disponible: true, temporada: true, nota_disponibilidad: null, familia: 'cold-brew', etiqueta_variacion: 'Grande · 16 oz', eje_variacion: 'Tamaño' },
  // ── Chocolate de cacao local (familia: chocolate-local, eje: Tamaño) ──
  { id: 14, documentId: '14', nombre: 'Chocolate de cacao local', slug: 'chocolate-8oz', descripcion: 'Cacao de El Espinal', historia: 'Cacao de El Espinal, preparado con leche de la finca La Cumbre.', tags: ['Caliente', 'Local'], precio: '$7.000', destacado: false, categoria: 'acompanamiento', imagen: null, orden: 1, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'chocolate-local', etiqueta_variacion: 'Taza · 8 oz', eje_variacion: 'Tamaño' },
  { id: 15, documentId: '15', nombre: 'Chocolate de cacao local', slug: 'chocolate-12oz', descripcion: 'Cacao de El Espinal', historia: 'Cacao de El Espinal, preparado con leche de la finca La Cumbre.', tags: ['Caliente', 'Local'], precio: '$9.000', destacado: false, categoria: 'acompanamiento', imagen: null, orden: 2, disponible: true, temporada: false, nota_disponibilidad: null, familia: 'chocolate-local', etiqueta_variacion: 'Grande · 12 oz', eje_variacion: 'Tamaño' },
  // ── Pan de yuca y miel (sin variaciones) ──
  { id: 16, documentId: '16', nombre: 'Pan de yuca y miel', slug: null, descripcion: 'Horneado del día', historia: 'Almidón de yuca del Espinal con miel de Angelita. Horneado cada mañana.', tags: ['Horneado del día', 'Sin gluten'], precio: '$4.500', destacado: false, categoria: 'panaderia', imagen: null, orden: 1, disponible: true, temporada: false, nota_disponibilidad: null },
  // ── Queso de la Cumbre con arepa (sin variaciones) ──
  { id: 17, documentId: '17', nombre: 'Queso de la Cumbre con arepa', slug: null, descripcion: 'Desayuno del territorio', historia: 'Queso fresco del día, arepa de maíz pelado. El desayuno del territorio.', tags: ['Local', 'Desayuno'], precio: '$8.500', destacado: false, categoria: 'acompanamiento', imagen: null, orden: 3, disponible: true, temporada: false, nota_disponibilidad: null },
];

const displayGrouped: Array<{ slug: string; label: string; icon: string; entries: MenuEntry[] }> =
  grouped.length > 0
    ? grouped
    : CATEGORIAS_MENU.map(cat => ({
        ...cat,
        entries: colapsarFamilias(fallbackItems.filter(i => i.categoria === cat.slug)),
      })).filter(g => g.entries.length > 0);

// Count available vs total
const totalItems = allItems.length || fallbackItems.length;
const availableCount = (allItems.length > 0 ? allItems : fallbackItems).filter(i => i.disponible).length;

// Category icon lookup for modal (pre-rendered SVGs, zero runtime)
const CAT_ICON_NAMES: Record<string, string> = { cafe: 'coffee', signature: 'sparkles', panaderia: 'croissant', infusion: 'leaf', frio: 'snowflake', acompanamiento: 'candy' };
const CAT_ICON_SVGS: Record<string, string> = Object.fromEntries(
  Object.entries(CAT_ICON_NAMES).map(([cat, name]) => [cat, lucideSvg(name, 'w-12 h-12')])
);
// SVGs pequenos para badges (inyectados al script de cliente)
const BADGE_SVGS: Record<string, string> = {
  sprout: lucideSvg('sprout', 'w-3 h-3 inline align-[-1px] mr-0.5'),
  star: lucideSvg('star', 'w-3 h-3 inline align-[-1px] mr-0.5'),
  coffee: lucideSvg('coffee', 'w-3 h-3 inline align-[-1px] mr-0.5'),
};
const catLabels: Record<string, string> = { cafe: 'Café', signature: 'Signature', panaderia: 'Panadería', infusion: 'Infusiones', frio: 'Fríos', acompanamiento: 'Acompañamientos' };
---

<BrandLayout brand="cafe" title="Menú · Café Iwagé" description="Cada producto tiene nombre, historia y proveedor. Café de origen, infusiones de flora nativa, panadería y signatures con miel de Angelita. Disponibilidad en tiempo real.">
  <!-- Header -->
  <section class="bg-dark-bg text-dark-text">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">Café Iwagé</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight font-display">Menú</h1>
      <p class="mt-4 text-dark-text/60 max-w-xl mx-auto">
        Cada producto es un personaje con nombre, historia y proveedor. Nada genérico.
      </p>
      <!-- Availability summary -->
      <div class="mt-5 inline-flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-5 py-2 text-sm">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          {availableCount} disponibles hoy
        </span>
        {availableCount < totalItems && (
          <span class="flex items-center gap-1.5 text-dark-text/50">
            <span class="w-2 h-2 rounded-full bg-red-400"></span>
            {totalItems - availableCount} agotados
          </span>
        )}
      </div>
    </div>
  </section>

  <!-- Menu grid -->
  <Section>
    {displayGrouped.map((group) => (
      <div class="mb-14 last:mb-0">
        <h2 class="text-xl font-bold text-text-primary mb-6 flex items-center gap-3">
          <span class="text-2xl">{(group as any).icon ?? 'coffee'}</span>
          {group.label}
          <span class="text-xs font-normal text-text-muted bg-surface-sunken rounded-full px-2.5 py-0.5 ml-1">
            {group.entries.filter(en => en.variaciones.some(v => v.disponible)).length}/{group.entries.length}
          </span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {group.entries.map((entry, i) => {
            const item = entry.rep;
            const img = itemImage(item);
            const tieneVar = entry.variaciones.length > 1;
            const numVar = entry.variaciones.length;
            const agotado = !entry.variaciones.some(v => v.disponible);
            const rawSlug = item.slug || slugify(item.nombre);
            const recursoSlug = `cafe-${rawSlug}`;
            const precioNum = parsePrecio(item.precio);
            const variacionesPayload = tieneVar
              ? entry.variaciones.map((v) => {
                  const vSlug = v.slug || slugify(v.nombre);
                  return {
                    slug: vSlug,
                    nombre: v.nombre,
                    etiqueta: v.etiqueta_variacion || v.nombre,
                    eje: v.eje_variacion || 'Presentación',
                    precio: v.precio,
                    precio_num: parsePrecio(v.precio),
                    recurso_slug: `cafe-${vSlug}`,
                    disponible: v.disponible !== false,
                    historia: v.historia,
                    descripcion: v.descripcion,
                    imagen: itemImage(v),
                  };
                })
              : [];
            return (
              <ScrollReveal delay={i * 60}>
                <article
                  data-menu-item={JSON.stringify({
                    nombre: item.nombre,
                    descripcion: item.descripcion,
                    historia: item.historia,
                    precio: item.precio,
                    precio_num: precioNum,
                    recurso_slug: recursoSlug,
                    tags: item.tags,
                    categoria: item.categoria,
                    disponible: item.disponible,
                    temporada: item.temporada,
                    nota_disponibilidad: item.nota_disponibilidad,
                    destacado: item.destacado,
                    imagen: img,
                    familia: item.familia || null,
                    eje_variacion: item.eje_variacion || null,
                    variaciones: variacionesPayload,
                  })}
                  class:list={[
                    'relative rounded-2xl border h-full flex flex-col overflow-hidden transition-all duration-200 cursor-pointer group',
                    agotado
                      ? 'bg-surface-sunken border-border/50 opacity-70 hover:opacity-90'
                      : item.destacado
                        ? 'bg-surface-raised border-accent ring-1 ring-accent/20 shadow-md hover:shadow-lg'
                        : 'bg-surface-raised border-border shadow-sm hover:shadow-md hover:border-brand/30',
                  ]}
                >
                  {/* Image */}
                  {img && (
                    <div class="h-36 w-full overflow-hidden">
                      <img
                        src={img}
                        alt={item.nombre}
                        class:list={['w-full h-full object-cover transition-transform duration-300 group-hover:scale-105', agotado && 'grayscale']}
                        loading="lazy"
                      />
                    </div>
                  )}

                  {/* Badges */}
                  <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
                    {agotado && (
                      <span class="bg-red-500/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-2.5 py-1 backdrop-blur-sm">
                        Agotado
                      </span>
                    )}
                    {item.temporada && (
                      <span class="bg-amber-500/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-2.5 py-1 backdrop-blur-sm">
                        <Icon name="sprout" class="w-3 h-3 inline align-[-1px] mr-0.5" />Temporada
                      </span>
                    )}
                    {item.destacado && !agotado && (
                      <span class="bg-accent/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-2.5 py-1 backdrop-blur-sm">
                        <Icon name="star" class="w-3 h-3 inline align-[-1px] mr-0.5" />Destacado
                      </span>
                    )}
                    {tieneVar && !agotado && (
                      <span class="bg-brand/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-2.5 py-1 backdrop-blur-sm">
                        <Icon name="coffee" class="w-3 h-3 inline align-[-1px] mr-0.5" />{numVar} opciones
                      </span>
                    )}
                  </div>

                  {/* Content */}
                  <div class:list={['flex flex-col flex-1 p-5', !img && 'pt-11']}>
                    <div class="flex items-start justify-between gap-3 mb-1.5">
                      <h3 class:list={[
                        'text-base font-semibold leading-snug',
                        agotado ? 'text-text-muted line-through decoration-1' : 'text-text-primary',
                      ]}>
                        {item.nombre}
                      </h3>
                      {item.precio && (
                        <span class:list={[
                          'text-base font-bold shrink-0',
                          agotado ? 'text-text-muted' : 'text-brand',
                        ]}>
                          {tieneVar ? `Desde ${fmtCOP(entry.precioDesde)}` : item.precio}
                        </span>
                      )}
                    </div>

                    {/* Descripcion corta */}
                    {item.descripcion && (
                      <p class="text-xs text-text-muted font-medium mb-2">{item.descripcion}</p>
                    )}

                    {/* Historia truncated */}
                    {item.historia && (
                      <p class:list={[
                        'text-sm italic leading-relaxed mb-3 flex-1 line-clamp-2',
                        agotado ? 'text-text-muted/60' : 'text-text-secondary',
                      ]}>
                        {item.historia}
                      </p>
                    )}

                    {/* Nota de disponibilidad */}
                    {agotado && item.nota_disponibilidad && (
                      <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 mb-3">
                        <Icon name="calendar" class="w-3.5 h-3.5 inline align-[-2px] mr-1" />{item.nota_disponibilidad}
                      </p>
                    )}

                    {/* Tags */}
                    {item.tags && item.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
                        {item.tags.map((tag: string) => (
                          <span class:list={[
                            'text-xs font-medium rounded-full px-2.5 py-0.5',
                            agotado ? 'bg-surface text-text-muted' : 'bg-brand-muted text-brand',
                          ]}>
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Click hint + quick add */}
                    <div class="flex items-center justify-between mt-3">
                      <p class="text-[10px] text-text-muted/50 opacity-0 group-hover:opacity-100 transition-opacity">
                        Ver detalle <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
                      </p>
                      {!agotado && (
                        <button
                          type="button"
                          class="quick-add w-9 h-9 rounded-full bg-brand text-white text-lg font-bold flex items-center justify-center shadow-sm hover:bg-brand-light hover:scale-110 transition-all"
                          data-recurso-slug={recursoSlug}
                          data-nombre={item.nombre}
                          data-precio-num={precioNum}
                          aria-label={`Agregar ${item.nombre} al carrito`}
                        >
                          +
                        </button>
                      )}
                    </div>
                  </div>
                </article>
              </ScrollReveal>
            );
          })}
        </div>
      </div>
    ))}
  </Section>

  <!-- Legend + CTA -->
  <Section bg="sunken" class="!py-12">
    <div class="max-w-2xl mx-auto text-center">
      <div class="flex flex-wrap justify-center gap-4 text-xs text-text-muted mb-6">
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> Disponible
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span> Agotado
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> De temporada
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-accent"></span> Destacado
        </span>
      </div>
      <p class="text-sm text-text-muted">
        Precios en COP. Menú sujeto a disponibilidad de cosecha y producción diaria.
        Los productos de temporada aparecen solo cuando hay materia prima fresca.
      </p>
      <p class="mt-3 text-sm">
        ¿Ya decidiste? Agrega productos con el botón <strong>+</strong> y paga todo junto desde tu carrito.
      </p>
    </div>
  </Section>

  <!-- SVGs de iconos pre-renderizados (build-time) para el script de cliente -->
  <script type="application/json" id="menu-icon-svgs" set:html={JSON.stringify({ cat: CAT_ICON_SVGS, badge: BADGE_SVGS })}></script>

  <!-- ═══ Detail Modal ═══ -->
  <dialog id="menu-modal" class="fixed inset-0 z-[100] m-auto w-[calc(100%-2rem)] max-w-lg rounded-3xl border-0 p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:items-center">
    <div class="max-h-[85vh] overflow-y-auto rounded-3xl bg-white">
      {/* Hero / Image area */}
      <div id="modal-hero" class="relative h-44 bg-gradient-to-br from-brand/10 to-accent/10 flex items-center justify-center overflow-hidden rounded-t-3xl">
        <img id="modal-img" src="" alt="" class="absolute inset-0 w-full h-full object-cover hidden" />
        <span id="modal-icon" class="opacity-30" set:html={CAT_ICON_SVGS.cafe}></span>
        <button id="modal-close" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/20 backdrop-blur-sm text-white flex items-center justify-center text-lg hover:bg-black/40 transition-colors" aria-label="Cerrar">✕</button>
        {/* Status badges */}
        <div id="modal-badges" class="absolute top-4 left-4 flex flex-wrap gap-2"></div>
      </div>

      {/* Body */}
      <div class="p-6 md:p-8">
        {/* Category + price row */}
        <div class="flex items-center justify-between mb-2">
          <span id="modal-cat" class="text-xs font-mono uppercase tracking-widest text-text-muted"></span>
          <span id="modal-precio" class="text-2xl font-bold text-brand"></span>
        </div>

        {/* Name */}
        <h2 id="modal-nombre" class="text-2xl font-bold text-text-primary leading-tight mb-2"></h2>

        {/* Descripcion */}
        <p id="modal-desc" class="text-sm text-text-muted font-medium mb-4"></p>

        {/* Historia */}
        <div id="modal-historia-wrap" class="mb-5">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-1.5">La historia</p>
          <p id="modal-historia" class="text-sm text-text-secondary leading-relaxed italic"></p>
        </div>

        {/* Nota disponibilidad */}
        <div id="modal-nota-wrap" class="hidden mb-5">
          <p class="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
            <Icon name="calendar" class="w-3.5 h-3.5 inline align-[-2px] mr-1" /><span id="modal-nota"></span>
          </p>
        </div>

        {/* Tags */}
        <div id="modal-tags-wrap" class="mb-6">
          <div id="modal-tags" class="flex flex-wrap gap-2"></div>
        </div>

        {/* Variaciones (tamaño, sabor, ...) */}
        <div id="modal-variaciones-wrap" class="hidden mb-6">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">
            Elige tu <span id="modal-var-eje">presentación</span>
          </p>
          <div id="modal-var-pills" class="flex flex-wrap gap-2"></div>
        </div>

        {/* CTA: agregar al carrito con cantidad */}
        <div class="pt-4 border-t border-border space-y-3">
          <div id="modal-qty-wrap" class="flex items-center justify-between gap-3">
            <span class="text-sm font-medium text-text-secondary">Cantidad</span>
            <div class="flex items-center gap-3">
              <button type="button" id="modal-qty-minus" class="w-9 h-9 rounded-full border border-border text-lg font-bold text-text-secondary hover:bg-brand-muted hover:text-brand transition-colors" aria-label="Restar">−</button>
              <span id="modal-qty" class="w-8 text-center text-base font-bold text-text-primary">1</span>
              <button type="button" id="modal-qty-plus" class="w-9 h-9 rounded-full border border-border text-lg font-bold text-text-secondary hover:bg-brand-muted hover:text-brand transition-colors" aria-label="Sumar">+</button>
            </div>
          </div>
          <button type="button" id="modal-add" class="w-full bg-brand text-white font-semibold rounded-xl px-5 py-3.5 text-sm hover:bg-brand/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            Agregar al carrito
          </button>
          <a href="/cafe/proveedores" class="block text-center text-xs text-text-muted hover:text-brand transition-colors underline underline-offset-2">
            Ver proveedores
          </a>
        </div>
      </div>
    </div>
  </dialog>
</BrandLayout>

<script>
  import { addItem } from '@/lib/cart-store';

  // SVGs pre-renderizados en el build (ver <script id="menu-icon-svgs">)
  const ICON_SVGS = JSON.parse(document.getElementById('menu-icon-svgs')?.textContent || '{}');
  const CAT_SVGS: Record<string, string> = ICON_SVGS.cat || {};
  const BADGE_SVG: Record<string, string> = ICON_SVGS.badge || {};
  const catLabels: Record<string, string> = { cafe: 'Café', signature: 'Signature', panaderia: 'Panadería', infusion: 'Infusiones', frio: 'Fríos', acompanamiento: 'Acompañamientos' };
  const fmtCOP = (n: number) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);

  const modal = document.getElementById('menu-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('modal-close')!;
  const qtyEl = document.getElementById('modal-qty')!;
  const addBtn = document.getElementById('modal-add') as HTMLButtonElement;

  let modalQty = 1;
  let currentData: any = null;
  let varList: any[] = [];
  let currentVar: any = null;
  let baseNombre = '';

  /** Item efectivo: la variación seleccionada, o el item base si no hay variaciones. */
  function eff(): any {
    return currentVar || currentData || {};
  }

  /** Nombre para el carrito: producto base + etiqueta de la variación elegida. */
  function nombreCarrito(): string {
    if (currentVar && currentVar.etiqueta && currentVar.etiqueta !== baseNombre) {
      return `${baseNombre} (${currentVar.etiqueta})`;
    }
    return baseNombre;
  }

  function updateAddBtn() {
    if (!currentData) return;
    const e = eff();
    if (e.disponible === false) {
      addBtn.textContent = 'No disponible actualmente';
      addBtn.disabled = true;
      return;
    }
    addBtn.disabled = false;
    const total = (e.precio_num || 0) * modalQty;
    addBtn.textContent = `Agregar al carrito — ${fmtCOP(total)}`;
  }

  /** Re-pinta precio, descripción, historia, imagen, badges y CTA según la variación activa. */
  function paintBody() {
    const e = eff();

    // Hero / imagen (cae en la imagen del item base si la variación no tiene)
    const img = document.getElementById('modal-img') as HTMLImageElement;
    const icon = document.getElementById('modal-icon')!;
    const imgSrc = e.imagen || currentData?.imagen || null;
    if (imgSrc) {
      img.src = imgSrc;
      img.alt = baseNombre;
      img.classList.remove('hidden');
      icon.classList.add('hidden');
    } else {
      img.classList.add('hidden');
      icon.classList.remove('hidden');
    }

    // Precio
    document.getElementById('modal-precio')!.textContent = e.precio || fmtCOP(e.precio_num || 0);

    // Descripción
    const descEl = document.getElementById('modal-desc')!;
    descEl.textContent = e.descripcion || '';
    descEl.classList.toggle('hidden', !e.descripcion);

    // Historia
    const histWrap = document.getElementById('modal-historia-wrap')!;
    if (e.historia) {
      document.getElementById('modal-historia')!.textContent = e.historia;
      histWrap.classList.remove('hidden');
    } else {
      histWrap.classList.add('hidden');
    }

    // Nota disponibilidad
    const notaWrap = document.getElementById('modal-nota-wrap')!;
    const nota = e.nota_disponibilidad || currentData?.nota_disponibilidad;
    if (e.disponible === false && nota) {
      document.getElementById('modal-nota')!.textContent = nota;
      notaWrap.classList.remove('hidden');
    } else {
      notaWrap.classList.add('hidden');
    }

    // Badges (el agotado sigue a la variación activa)
    const badges = document.getElementById('modal-badges')!;
    let badgeHtml = '';
    if (e.disponible === false) badgeHtml += '<span class="bg-red-500/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-3 py-1 backdrop-blur-sm">Agotado</span>';
    if (currentData?.temporada) badgeHtml += '<span class="bg-amber-500/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-3 py-1 backdrop-blur-sm">' + (BADGE_SVG.sprout || '') + 'Temporada</span>';
    if (currentData?.destacado && e.disponible !== false) badgeHtml += '<span class="bg-accent/90 text-white text-[11px] font-bold uppercase tracking-wide rounded-full px-3 py-1 backdrop-blur-sm">' + (BADGE_SVG.star || '') + 'Destacado</span>';
    badges.innerHTML = badgeHtml;

    // CTA: cantidad + agregar al carrito
    const qtyWrap = document.getElementById('modal-qty-wrap')!;
    if (e.disponible === false) {
      qtyWrap.classList.add('hidden');
      addBtn.textContent = 'No disponible actualmente';
      addBtn.disabled = true;
    } else {
      qtyWrap.classList.remove('hidden');
      addBtn.disabled = false;
      updateAddBtn();
    }
  }

  /** Dibuja el selector de variaciones (pills) y cablea la elección. */
  function renderVariaciones() {
    const wrap = document.getElementById('modal-variaciones-wrap')!;
    const pills = document.getElementById('modal-var-pills')!;
    if (varList.length < 2) {
      wrap.classList.add('hidden');
      pills.innerHTML = '';
      return;
    }
    const eje = currentData?.eje_variacion || varList[0]?.eje || 'Presentación';
    document.getElementById('modal-var-eje')!.textContent = String(eje).toLowerCase();
    pills.innerHTML = varList.map((v: any) => {
      const activo = currentVar && v.slug === currentVar.slug;
      const agotada = v.disponible === false;
      const cls = activo
        ? 'bg-brand text-white border-brand shadow-sm'
        : agotada
          ? 'bg-surface text-text-muted border-border/50 line-through cursor-not-allowed'
          : 'bg-surface text-text-secondary border-border hover:border-brand hover:text-brand';
      return `<button type="button" data-var-slug="${v.slug}" class="variacion-pill text-sm font-medium rounded-full border px-4 py-2 transition-colors ${cls}" ${agotada ? 'disabled' : ''}>${v.etiqueta}</button>`;
    }).join('');
    wrap.classList.remove('hidden');
    pills.querySelectorAll('.variacion-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = (btn as HTMLElement).dataset.varSlug;
        const v = varList.find((x: any) => x.slug === slug);
        if (!v || v.disponible === false) return;
        currentVar = v;
        renderVariaciones();
        paintBody();
      });
    });
  }

  function openModal(data: any) {
    currentData = data;
    baseNombre = data.nombre;
    modalQty = 1;
    qtyEl.textContent = '1';

    // Variaciones de la familia (tamaño, sabor, ...): por defecto la representativa
    varList = Array.isArray(data.variaciones) ? data.variaciones : [];
    if (varList.length > 1) {
      currentVar =
        varList.find((v: any) => v.slug === data.slug) ||
        varList.find((v: any) => v.disponible !== false) ||
        varList[0];
    } else {
      currentVar = null;
    }

    // Ícono hero (estable, según categoría) — SVG pre-renderizado
    const icon = document.getElementById('modal-icon')!;
    icon.innerHTML = CAT_SVGS[data.categoria] || CAT_SVGS.cafe || '';

    // Categoría + nombre (estables: el producto base; la variación se ve en el selector)
    document.getElementById('modal-cat')!.textContent = catLabels[data.categoria] || data.categoria;
    document.getElementById('modal-nombre')!.textContent = baseNombre;

    // Tags (del producto base)
    const tagsWrap = document.getElementById('modal-tags-wrap')!;
    const tagsEl = document.getElementById('modal-tags')!;
    if (data.tags && data.tags.length > 0) {
      tagsEl.innerHTML = data.tags.map((t: string) =>
        `<span class="text-xs font-medium rounded-full px-3 py-1 ${data.disponible ? 'bg-brand-muted text-brand' : 'bg-gray-100 text-gray-500'}">${t}</span>`
      ).join('');
      tagsWrap.classList.remove('hidden');
    } else {
      tagsWrap.classList.add('hidden');
    }

    renderVariaciones();
    paintBody();

    modal.showModal();
  }

  // ── Cantidad ──
  document.getElementById('modal-qty-minus')!.addEventListener('click', () => {
    if (modalQty > 1) { modalQty--; qtyEl.textContent = String(modalQty); updateAddBtn(); }
  });
  document.getElementById('modal-qty-plus')!.addEventListener('click', () => {
    if (modalQty < 10) { modalQty++; qtyEl.textContent = String(modalQty); updateAddBtn(); }
  });

  // ── Agregar al carrito desde el modal (usa la variación activa) ──
  addBtn.addEventListener('click', () => {
    const e = eff();
    if (!currentData || e.disponible === false) return;
    addItem({
      recurso_slug: e.recurso_slug,
      nombre: nombreCarrito(),
      precio: e.precio_num || 0,
      cantidad: modalQty,
      tipo: 'pedido_cafe',
      tipo_disponibilidad: 'inmediato',
      brand: 'cafe',
      origen: 'iwage_cafe',
      requiere_pago: (e.precio_num || 0) > 0,
      url: window.location.href,
    });
    addBtn.textContent = '✓ Agregado al carrito';
    addBtn.disabled = true;
    window.setTimeout(() => {
      modal.close();
      addBtn.disabled = false;
      updateAddBtn();
    }, 900);
  });

  // ── Quick add: botón + en las cards (1 unidad, sin abrir modal) ──
  document.querySelectorAll('.quick-add').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      // Si el producto tiene variaciones, abrir el modal para elegirlas
      const card = btn.closest('[data-menu-item]') as HTMLElement | null;
      if (card) {
        try {
          const data = JSON.parse(card.getAttribute('data-menu-item')!);
          if (Array.isArray(data.variaciones) && data.variaciones.length > 1) {
            openModal(data);
            return;
          }
        } catch { /* ignore parse errors */ }
      }
      const el = btn as HTMLElement;
      addItem({
        recurso_slug: el.dataset.recursoSlug!,
        nombre: el.dataset.nombre || 'Producto',
        precio: parseInt(el.dataset.precioNum || '0', 10),
        cantidad: 1,
        tipo: 'pedido_cafe',
        tipo_disponibilidad: 'inmediato',
        brand: 'cafe',
        origen: 'iwage_cafe',
        requiere_pago: parseInt(el.dataset.precioNum || '0', 10) > 0,
        url: window.location.href,
      });
      const original = el.textContent;
      el.textContent = '✓';
      el.classList.add('scale-110');
      window.setTimeout(() => { el.textContent = original; el.classList.remove('scale-110'); }, 1000);
    });
  });

  // Attach click handlers to all menu item cards
  document.querySelectorAll('[data-menu-item]').forEach((card) => {
    card.addEventListener('click', () => {
      try {
        const data = JSON.parse(card.getAttribute('data-menu-item')!);
        openModal(data);
      } catch (e) { /* ignore parse errors */ }
    });
  });

  // Close handlers
  closeBtn.addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
  modal.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') modal.close();
  });
</script>
