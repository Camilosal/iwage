---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Icon from '@/components/shared/Icon.astro';
import { getCafeConfig } from '@/lib/cafe';

const config = await getCafeConfig();
const whatsapp = (config?.whatsapp ?? '573026693366').replace(/\+/g, '');

const INTERESES = [
  { value: 'visita', label: 'Visitar el café y el meliponario' },
  { value: 'b2b', label: 'Suministro para mi negocio' },
  { value: 'menu', label: 'Menú y productos' },
  { value: 'proveedores', label: 'Ser proveedor de origen' },
  { value: 'otro', label: 'Otra pregunta' },
];
---

<BrandLayout brand="cafe" title="Contacto · Café Iwagé" description="Escríbenos para visitas, suministro B2B o cualquier pregunta. Café Iwagé, corredor Ambalá, Ibagué, Tolima.">
  <!-- Header -->
  <section class="bg-dark-bg text-dark-text">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">Café Iwagé</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight font-display">Contacto</h1>
      <p class="mt-4 text-dark-text/60 max-w-xl mx-auto">
        ¿Visita, suministro o simplemente quieres saber más? Escríbenos.
      </p>
    </div>
  </section>

  <Section>
    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-10">
      <!-- Contact info -->
      <ScrollReveal>
        <div class="space-y-6">
          <div>
            <h2 class="text-lg font-semibold text-text-primary mb-3">Información</h2>
            <ul class="space-y-3 text-sm text-text-secondary">
              <li class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5"><Icon name="map-pin" class="w-4 h-4" /></span>
                <span>{config?.direccion ?? 'Corredor Ambalá, Ibagué, Tolima'}</span>
              </li>
              {config?.horario && (
                <li class="flex items-start gap-3">
                  <span class="text-accent shrink-0 mt-0.5"><Icon name="clock" class="w-4 h-4" /></span>
                  <span class="whitespace-pre-line">{config.horario}</span>
                </li>
              )}
              {!config?.horario && (
                <li class="flex items-start gap-3">
                  <span class="text-accent shrink-0 mt-0.5"><Icon name="clock" class="w-4 h-4" /></span>
                  <span>Lunes a Sábado · 7:00 am – 5:00 pm</span>
                </li>
              )}
              {config?.telefono && (
                <li class="flex items-start gap-3">
                  <span class="text-accent shrink-0 mt-0.5"><Icon name="phone" class="w-4 h-4" /></span>
                  <span>{config.telefono}</span>
                </li>
              )}
              {config?.email && (
                <li class="flex items-start gap-3">
                  <span class="text-accent"><Icon name="mail" class="w-4 h-4" /></span>
                  <a href={`mailto:${config.email}`} class="text-brand hover:text-accent transition-colors">{config.email}</a>
                </li>
              )}
              {config?.instagram && (
                <li class="flex items-start gap-3">
                  <Icon name="camera" class="w-4 h-4 text-accent" />
                  <span>{config.instagram}</span>
                </li>
              )}
            </ul>
          </div>

          <div class="pt-4 border-t border-border">
            <h3 class="text-base font-semibold text-text-primary mb-3">Suministro B2B</h3>
            <p class="text-sm text-text-secondary mb-4">
              {config?.b2b_descripcion ?? 'Café de origen y miel de Angelita para restaurantes, hoteles y tiendas especializadas.'}
            </p>
            <a href={`https://wa.me/${whatsapp}?text=Hola%2C%20quiero%20información%20sobre%20suministro%20de%20café`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-accent text-white rounded-full px-5 py-2.5 text-sm font-medium hover:bg-accent-light transition-all">
              <Icon name="message-circle" class="w-3.5 h-3.5 inline" /> Cotizar por WhatsApp
            </a>
          </div>
        </div>
      </ScrollReveal>

      <!-- Lead form -->
      <ScrollReveal delay={100}>
        <div class="bg-surface-raised rounded-2xl border border-border p-6 md:p-8">
          <h2 class="text-lg font-semibold text-text-primary mb-4">Escríbenos directo</h2>
          <p class="text-sm text-text-secondary mb-6">
            Déjanos tus datos y te respondemos por WhatsApp en menos de 2 horas en horario de atención.
          </p>
          <form id="contact-form" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-sm font-medium text-text-secondary mb-2">Nombre *</label>
                <input type="text" id="nombre" name="nombre" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand" placeholder="Tu nombre" />
              </div>
              <div>
                <label for="whatsapp" class="block text-sm font-medium text-text-secondary mb-2">WhatsApp *</label>
                <input type="tel" id="whatsapp" name="whatsapp" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand" placeholder="+57 300 000 0000" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-text-secondary mb-2">Email</label>
              <input type="email" id="email" name="email" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand" placeholder="tu@correo.com" />
            </div>
            <div>
              <label for="tipo_proyecto" class="block text-sm font-medium text-text-secondary mb-2">¿Qué te interesa? *</label>
              <select id="tipo_proyecto" name="tipo_proyecto" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text-secondary focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand">
                <option value="">Selecciona una opción</option>
                {INTERESES.map((i) => (
                  <option value={i.value}>{i.label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="mensaje" class="block text-sm font-medium text-text-secondary mb-2">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="4" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand resize-none" placeholder="Cuéntanos más..."></textarea>
            </div>
            <input type="hidden" name="marca" value="cafe" />
            <button type="submit" class="w-full bg-brand text-white rounded-full px-6 py-3 font-medium hover:bg-brand-light transition-all">
              Enviar mensaje
            </button>
            <p id="form-status" class="text-sm text-center hidden"></p>
          </form>

          <div class="mt-8 pt-6 border-t border-border">
            <p class="text-xs font-mono uppercase tracking-widest text-text-muted mb-3">O escríbenos ya</p>
            <div class="space-y-3">
              <a href={`https://wa.me/${whatsapp}?text=Hola%2C%20quiero%20visitar%20el%20café`} target="_blank" rel="noopener" class="flex items-center gap-3 p-4 rounded-xl border border-border hover:border-accent hover:bg-accent/5 transition-all group">
                <Icon name="coffee" class="w-5 h-5 text-brand shrink-0" />
                <div>
                  <p class="text-sm font-medium text-text-primary group-hover:text-accent transition-colors">Planear una visita</p>
                  <p class="text-xs text-text-muted">Conoce el café y el meliponario</p>
                </div>
              </a>
              <a href={`https://wa.me/${whatsapp}?text=Hola%2C%20quiero%20información%20sobre%20suministro%20B2B`} target="_blank" rel="noopener" class="flex items-center gap-3 p-4 rounded-xl border border-border hover:border-accent hover:bg-accent/5 transition-all group">
                <span class="text-accent shrink-0"><Icon name="store" class="w-5 h-5" /></span>
                <div>
                  <p class="text-sm font-medium text-text-primary group-hover:text-accent transition-colors">Suministro para mi negocio</p>
                  <p class="text-xs text-text-muted">Café y miel al por mayor</p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </Section>
</BrandLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enviando...';

    try {
      const data = new FormData(form);
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      const result = await res.json();
      if (res.ok) {
        status.textContent = '¡Mensaje enviado! Te contactamos por WhatsApp muy pronto.';
        status.className = 'text-sm text-center text-brand';
        form.reset();
      } else {
        status.textContent = result.error || 'Error al enviar. Intenta de nuevo.';
        status.className = 'text-sm text-center text-red-500';
      }
    } catch {
      status.textContent = 'Error de conexión. Intenta de nuevo.';
      status.className = 'text-sm text-center text-red-500';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar mensaje';
      status.classList.remove('hidden');
    }
  });
</script>
