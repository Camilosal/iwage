---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';

const RECETAS_URL = 'https://recetas.iwage.co';
---

<BrandLayout brand="cafe" title="Recetas · Café Iwagé" description="Recetario digital de Café Iwagé: preparaciones, métodos de extracción y experimentos con café de origen del corredor Ambalá.">
  <!-- Header compacto -->
  <section class="bg-dark-bg text-dark-text">
    <div class="max-w-6xl mx-auto px-6 py-8 md:py-10 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-accent mb-2">Café Iwagé</p>
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight font-display">Recetas</h1>
      <p class="mt-3 text-dark-text/60 max-w-xl mx-auto text-sm md:text-base">
        Nuestro recetario digital: métodos de extracción, preparaciones y experimentos para sacarle todo al café de origen.
      </p>
    </div>
  </section>

  <!-- Web-app de recetas incrustada -->
  <section class="bg-surface">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-8">
      <div id="recetas-wrapper" class="relative w-full overflow-hidden rounded-2xl border border-border bg-white shadow-sm" style="height: min(88vh, 1000px); min-height: 600px;">
        <!-- Estado de carga -->
        <div id="recetas-loading" class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 bg-surface">
          <Icon name="book-open" class="w-10 h-10 animate-pulse text-brand" />
          <div class="flex items-center gap-2 text-sm text-text-secondary">
            <Icon name="loader-circle" class="w-4 h-4 animate-spin text-accent" />
            Cargando el recetario…
          </div>
        </div>

        <iframe
          id="recetas-frame"
          src={RECETAS_URL}
          title="Recetas · Café Iwagé"
          class="absolute inset-0 h-full w-full border-0"
          allow="clipboard-write"
          referrerpolicy="strict-origin-when-cross-origin"
          loading="eager"
        ></iframe>
      </div>

      <!-- Fallback si el navegador bloquea el marco -->
      <div class="mt-4 flex flex-col items-center gap-2 text-center">
        <p class="text-xs text-text-muted">
          ¿No carga el recetario?
          <a href={RECETAS_URL} target="_blank" rel="noopener" class="text-brand font-medium underline underline-offset-2 hover:text-accent transition-colors">
            Ábrelo en una pestaña nueva
          </a>
        </p>
      </div>
    </div>
  </section>
</BrandLayout>

<script>
  // Ocultar el estado de carga cuando la web-app termine de cargar
  const frame = document.getElementById('recetas-frame') as HTMLIFrameElement | null;
  const loading = document.getElementById('recetas-loading');
  if (frame && loading) {
    frame.addEventListener('load', () => {
      loading.classList.add('opacity-0', 'pointer-events-none', 'transition-opacity', 'duration-300');
      setTimeout(() => loading.remove(), 350);
    });
    // Red de seguridad: si a los 12s no ha cargado, se muestra igual el marco
    setTimeout(() => {
      if (document.body.contains(loading)) {
        loading.classList.add('opacity-0', 'pointer-events-none', 'transition-opacity', 'duration-300');
        setTimeout(() => loading.remove(), 350);
      }
    }, 12000);
  }
</script>
