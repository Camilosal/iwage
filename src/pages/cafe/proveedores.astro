---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { getProveedores, proveedorFoto } from '@/lib/cafe';
import type { Proveedor } from '@/lib/cafe';

const proveedores = await getProveedores();

const fallback: Proveedor[] = [
  { id: 1, documentId: '1', nombre: 'Familia Cardona', producto: 'Café de origen', ubicacion: 'Vereda El Carmen', distancia_km: 2.3, historia: 'Tres generaciones cultivando café en las laderas del Ambalá. Tueste medio, notas de panela y cítricos.', foto: null, orden: 1 },
  { id: 2, documentId: '2', nombre: 'Finca La Cumbre', producto: 'Leche y quesos', ubicacion: 'Cajamarca', distancia_km: 3.8, historia: 'Ganadería regenerativa a pequeña escala. Leche cruda para nuestro chocolate y quesos de temporada.', foto: null, orden: 2 },
  { id: 3, documentId: '3', nombre: 'Cacao El Espinal', producto: 'Cacao fino de aroma', ubicacion: 'El Espinal', distancia_km: 38, historia: 'La excepción a nuestra regla de 4 km. Cacao fino de aroma del valle del Magdalena, fermentado 5 días.', foto: null, orden: 3 },
  { id: 4, documentId: '4', nombre: 'Meliponario Iwagé', producto: 'Miel de Angelita', ubicacion: 'Corredor Ambalá', distancia_km: 0.2, historia: 'Nuestra propia miel de Tetragonisca angustula. Cosecha limitada, dulzor floral único.', foto: null, orden: 0 },
];

const display = proveedores.length > 0 ? proveedores : fallback;

// ── Helpers de contacto ──
const waLink = (wa: string) => `https://wa.me/${wa.replace(/\D/g, '')}`;
const igLink = (ig: string) => `https://instagram.com/${ig.replace(/^@/, '')}`;
const iniciales = (nombre: string) =>
  nombre.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---

<BrandLayout brand="cafe" title="Proveedores · Café Iwagé" description="Cada ingrediente tiene un rostro y una historia. Proveedores locales a menos de 4 km del café, cadena corta y nombre propio. Algunos son anfitriones del territorio y ofrecen experiencias.">
  <!-- Header -->
  <section class="bg-dark-bg text-dark-text">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">Café Iwagé</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight font-display">Proveedores</h1>
      <p class="mt-4 text-dark-text/60 max-w-xl mx-auto">
        Cadena corta, nombre propio. Cada ingrediente tiene un rostro y una distancia.
        Algunos proveedores son también anfitriones y abren sus fincas a experiencias.
      </p>
    </div>
  </section>

  <!-- Supplier cards -->
  <Section>
    <ScrollReveal>
      <SectionHeader
        label="Cadena corta"
        title="Menos de 4 km (casi siempre)"
        subtitle="Conocemos a cada proveedor por nombre. Visitamos sus fincas. Sabemos cómo trabajan."
      />
    </ScrollReveal>
    <div class="space-y-6">
      {display.map((p, i) => {
        const foto = proveedorFoto(p);
        const anfitriones = p.anfitriones ?? [];
        const experiencias = p.experiencias ?? [];
        const propiedades = p.propiedades ?? [];
        const propiedadesGestion = p.propiedades_gestion ?? [];
        const servicios = (p.servicios ?? []) as string[];
        const esAnfitrion = p.es_anfitrion || anfitriones.length > 0;
        const tieneExperiencias = p.ofrece_experiencias || experiencias.length > 0;
        const tienePropiedades = propiedades.length > 0;
        const tieneGestion = propiedadesGestion.length > 0;

        // Serialize for modal
        const modalData = JSON.stringify({
          nombre: p.nombre,
          producto: p.producto,
          ubicacion: p.ubicacion,
          distancia_km: p.distancia_km,
          historia: p.historia,
          foto: foto,
          destacado: p.destacado,
          es_anfitrion: esAnfitrion,
          ofrece_experiencias: tieneExperiencias,
          telefono: p.telefono,
          whatsapp: p.whatsapp,
          instagram: p.instagram,
          horario: p.horario,
          direccion: p.direccion,
          servicios: servicios,
          anfitriones: anfitriones.map(a => ({ nombre: a.nombre, slug: a.slug, especialidad: a.especialidad })),
          experiencias: experiencias.map(e => ({ titulo: e.titulo, slug: e.slug, categoria: e.categoria, resumen: e.resumen })),
          propiedades: propiedades.map(pr => ({ titulo: pr.titulo, slug: pr.slug, tipo_propiedad: pr.tipo_propiedad, operacion: pr.operacion, estado: pr.estado, ubicacion_municipio: pr.ubicacion_municipio, area_hectareas: pr.area_hectareas, precio: pr.precio })),
          propiedades_gestion: propiedadesGestion.map(pg => ({ titulo: pg.titulo, slug: pg.slug, tipo_gestion: pg.tipo_gestion, estado: pg.estado, ubicacion_municipio: pg.ubicacion_municipio, area_hectareas: pg.area_hectareas })),
        });

        return (
          <ScrollReveal delay={i * 80}>
            <article
              id={p.slug}
              data-proveedor={modalData}
              class="group relative rounded-2xl border border-border bg-surface-raised p-6 md:p-8 shadow-sm hover:shadow-md hover:border-brand/30 transition-all duration-200 cursor-pointer"
            >
              <div class="flex flex-col md:flex-row gap-6">
                {/* Avatar / Photo */}
                {foto ? (
                  <img
                    src={foto}
                    alt={p.nombre}
                    class="w-20 h-20 md:w-24 md:h-24 rounded-2xl object-cover shrink-0 transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-brand-muted flex items-center justify-center text-brand font-bold text-2xl shrink-0">
                    {iniciales(p.nombre)}
                  </div>
                )}

                <div class="flex-1 min-w-0">
                  {/* Nombre + badges principales */}
                  <div class="flex flex-wrap items-center gap-3 mb-2">
                    <h3 class="text-lg font-semibold text-text-primary">{p.nombre}</h3>
                    {p.distancia_km != null && (
                      <span class="text-xs font-medium bg-accent/10 text-accent rounded-full px-3 py-1">
                        {p.distancia_km} km
                      </span>
                    )}
                    {p.destacado && (
                      <span class="text-xs font-medium bg-brand/10 text-brand rounded-full px-3 py-1">
                        ★ Destacado
                      </span>
                    )}
                  </div>

                  {p.producto && (
                    <p class="text-sm font-medium text-brand mb-2">{p.producto}</p>
                  )}

                  {/* Badges de rol */}
                  {(esAnfitrion || tieneExperiencias || tienePropiedades || tieneGestion) && (
                    <div class="flex flex-wrap gap-2 mb-3">
                      {esAnfitrion && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#2d5016]/10 text-[#2d5016] rounded-full px-3 py-1.5">
                          <span aria-hidden="true">🧭</span>
                          {anfitriones.length > 0 ? `Anfitrión: ${anfitriones[0].nombre}` : 'Anfitrión del territorio'}
                        </span>
                      )}
                      {tieneExperiencias && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-accent/10 text-accent rounded-full px-3 py-1.5">
                          <span aria-hidden="true">🌿</span>
                          {experiencias.length > 0
                            ? `${experiencias.length} experiencia${experiencias.length > 1 ? 's' : ''}`
                            : 'Ofrece experiencias'}
                        </span>
                      )}
                      {tienePropiedades && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#1a4a6b]/10 text-[#1a4a6b] rounded-full px-3 py-1.5">
                          <span aria-hidden="true">🏡</span>
                          {propiedades.length} propiedad{propiedades.length > 1 ? 'es' : ''} en venta
                        </span>
                      )}
                      {tieneGestion && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#6b3fa0]/10 text-[#6b3fa0] rounded-full px-3 py-1.5">
                          <span aria-hidden="true">🔑</span>
                          {propiedadesGestion.length} en gestión
                        </span>
                      )}
                    </div>
                  )}

                  {p.historia && (
                    <p class="text-sm text-text-secondary leading-relaxed line-clamp-2">{p.historia}</p>
                  )}

                  {/* Click hint */}
                  <p class="text-[10px] text-text-muted/50 mt-3 text-right opacity-0 group-hover:opacity-100 transition-opacity">
                    Ver ficha completa →
                  </p>
                </div>
              </div>
            </article>
          </ScrollReveal>
        );
      })}
    </div>
  </Section>

  <!-- Philosophy -->
  <Section bg="sunken" class="!py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-text-primary mb-4 font-display">Nuestra regla de los 4 km</h2>
      <p class="text-text-secondary leading-relaxed">
        Todo ingrediente principal debe venir de menos de 4 kilómetros. La excepción es el cacao,
        que no crece a nuestra altitud. Esta regla no es marketing: es la forma en que garantizamos
        frescura, trazabilidad y que el dinero se queda en el territorio.
      </p>
    </div>
  </Section>

  <!-- ═══ Proveedor Detail Modal ═══ -->
  <dialog id="prov-modal" class="fixed inset-0 z-[100] m-auto w-[calc(100%-2rem)] max-w-lg rounded-3xl border-0 p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:items-center">
    <div class="max-h-[85vh] overflow-y-auto rounded-3xl bg-white">
      {/* Header with photo/initials */}
      <div class="relative bg-gradient-to-br from-brand/5 to-accent/10 p-6 pb-5 rounded-t-3xl">
        <button id="prov-close" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/10 text-text-secondary flex items-center justify-center text-lg hover:bg-black/20 transition-colors" aria-label="Cerrar">✕</button>
        <div class="flex items-center gap-4">
          <div id="prov-avatar" class="w-16 h-16 rounded-2xl bg-brand-muted flex items-center justify-center text-brand font-bold text-xl shrink-0 overflow-hidden">
          </div>
          <div>
            <h2 id="prov-nombre" class="text-xl font-bold text-text-primary leading-tight"></h2>
            <p id="prov-producto" class="text-sm font-medium text-brand mt-0.5"></p>
            <div id="prov-meta" class="flex flex-wrap items-center gap-2 mt-2"></div>
          </div>
        </div>
      </div>

      {/* Body */}
      <div class="p-6 md:p-8 pt-5 space-y-5">
        {/* Badges de rol */}
        <div id="prov-roles" class="hidden flex-wrap gap-2"></div>

        {/* Historia */}
        <div id="prov-historia-wrap">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-1.5">Su historia</p>
          <p id="prov-historia" class="text-sm text-text-secondary leading-relaxed italic"></p>
        </div>

        {/* Servicios */}
        <div id="prov-servicios-wrap" class="hidden">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">Servicios</p>
          <div id="prov-servicios" class="flex flex-wrap gap-2"></div>
        </div>

        {/* Anfitriones vinculados */}
        <div id="prov-anf-wrap" class="hidden">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">Anfitriones del territorio</p>
          <div id="prov-anf" class="space-y-2"></div>
        </div>

        {/* Experiencias */}
        <div id="prov-exp-wrap" class="hidden">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">Experiencias en el territorio</p>
          <div id="prov-exp" class="space-y-2"></div>
        </div>

        {/* Propiedades en venta */}
        <div id="prov-props-wrap" class="hidden">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">Propiedades en venta (Tierras Iwagé)</p>
          <div id="prov-props" class="space-y-2"></div>
        </div>

        {/* Propiedades en gestión */}
        <div id="prov-gestion-wrap" class="hidden">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">Propiedades gestionadas (Gestión Iwagé)</p>
          <div id="prov-gestion" class="space-y-2"></div>
        </div>

        {/* Contacto */}
        <div id="prov-contacto-wrap" class="hidden">
          <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted mb-2">Contacto</p>
          <div id="prov-contacto" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text-secondary"></div>
        </div>

        {/* Ubicación */}
        <div id="prov-ubicacion-wrap" class="hidden pt-3 border-t border-border">
          <p id="prov-ubicacion" class="text-xs text-text-muted"></p>
        </div>
      </div>
    </div>
  </dialog>
</BrandLayout>

<script>
  const modal = document.getElementById('prov-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('prov-close')!;

  const iniciales = (nombre: string) =>
    nombre.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase();

  const tipoLabel: Record<string, string> = {
    finca: 'Finca', lote: 'Lote', casa_campestre: 'Casa campestre',
    predio_rural: 'Predio rural', terreno: 'Terreno', otro: 'Predio',
  };
  const gestionLabel: Record<string, string> = {
    renta_corta: 'Renta corta', finca_productiva: 'Finca productiva',
    segunda_residencia: 'Segunda residencia', operacion_turistica: 'Operación turística',
  };

  function openModal(d: any) {
    // Avatar
    const avatar = document.getElementById('prov-avatar')!;
    if (d.foto) {
      avatar.innerHTML = `<img src="${d.foto}" alt="${d.nombre}" class="w-full h-full object-cover" />`;
    } else {
      avatar.textContent = iniciales(d.nombre);
    }

    // Name + product
    document.getElementById('prov-nombre')!.textContent = d.nombre;
    const prodEl = document.getElementById('prov-producto')!;
    prodEl.textContent = d.producto || '';
    prodEl.classList.toggle('hidden', !d.producto);

    // Meta badges
    const meta = document.getElementById('prov-meta')!;
    let metaHtml = '';
    if (d.distancia_km != null) metaHtml += `<span class="text-xs font-medium bg-accent/10 text-accent rounded-full px-3 py-1">${d.distancia_km} km</span>`;
    if (d.destacado) metaHtml += '<span class="text-xs font-medium bg-brand/10 text-brand rounded-full px-3 py-1">★ Destacado</span>';
    meta.innerHTML = metaHtml;

    // Roles
    const roles = document.getElementById('prov-roles')!;
    let rolesHtml = '';
    if (d.es_anfitrion) {
      rolesHtml += '<span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#2d5016]/10 text-[#2d5016] rounded-full px-3 py-1.5">🧭 Anfitrión del territorio</span>';
    }
    if (d.ofrece_experiencias) {
      const count = d.experiencias?.length || 0;
      rolesHtml += `<span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-accent/10 text-accent rounded-full px-3 py-1.5">🌿 ${count > 0 ? count + ' experiencia' + (count > 1 ? 's' : '') : 'Ofrece experiencias'}</span>`;
    }
    if (d.propiedades?.length > 0) {
      rolesHtml += `<span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#1a4a6b]/10 text-[#1a4a6b] rounded-full px-3 py-1.5">🏡 ${d.propiedades.length} propiedad${d.propiedades.length > 1 ? 'es' : ''} en venta</span>`;
    }
    if (d.propiedades_gestion?.length > 0) {
      rolesHtml += `<span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#6b3fa0]/10 text-[#6b3fa0] rounded-full px-3 py-1.5">🔑 ${d.propiedades_gestion.length} en gestión</span>`;
    }
    if (rolesHtml) {
      roles.innerHTML = rolesHtml;
      roles.classList.remove('hidden');
      roles.classList.add('flex');
    } else {
      roles.classList.add('hidden');
      roles.classList.remove('flex');
    }

    // Historia
    const histWrap = document.getElementById('prov-historia-wrap')!;
    if (d.historia) {
      document.getElementById('prov-historia')!.textContent = d.historia;
      histWrap.classList.remove('hidden');
    } else {
      histWrap.classList.add('hidden');
    }

    // Servicios
    const servWrap = document.getElementById('prov-servicios-wrap')!;
    if (d.servicios && d.servicios.length > 0) {
      document.getElementById('prov-servicios')!.innerHTML = d.servicios.map((s: string) =>
        `<span class="text-xs text-text-secondary bg-surface-sunken border border-border rounded-full px-3 py-1">${s}</span>`
      ).join('');
      servWrap.classList.remove('hidden');
    } else {
      servWrap.classList.add('hidden');
    }

    // Anfitriones vinculados
    const anfWrap = document.getElementById('prov-anf-wrap')!;
    if (d.anfitriones && d.anfitriones.length > 0) {
      document.getElementById('prov-anf')!.innerHTML = d.anfitriones.map((a: any) => `
        <a href="${a.slug ? '/naturaleza/anfitriones/' + a.slug : '/naturaleza/anfitriones'}"
           class="group/anf flex items-center gap-3 rounded-xl border border-border bg-surface-sunken p-3 hover:border-[#2d5016]/50 transition-colors">
          <span class="text-lg">🧭</span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-text-primary group-hover/anf:text-[#2d5016] transition-colors">${a.nombre}</span>
            ${a.especialidad ? `<span class="block text-xs text-text-secondary mt-0.5">${a.especialidad}</span>` : ''}
          </span>
          <span class="ml-auto text-text-muted group-hover/anf:text-[#2d5016] transition-colors shrink-0">→</span>
        </a>
      `).join('');
      anfWrap.classList.remove('hidden');
    } else {
      anfWrap.classList.add('hidden');
    }

    // Experiencias
    const expWrap = document.getElementById('prov-exp-wrap')!;
    if (d.experiencias && d.experiencias.length > 0) {
      document.getElementById('prov-exp')!.innerHTML = d.experiencias.map((e: any) => `
        <a href="${e.slug ? '/naturaleza/experiencias/' + e.slug : '/naturaleza/experiencias'}"
           class="group/exp flex items-start gap-3 rounded-xl border border-border bg-surface-sunken p-3 hover:border-accent/50 transition-colors">
          <span class="text-lg mt-0.5">🌿</span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-text-primary group-hover/exp:text-accent transition-colors">${e.titulo}</span>
            ${e.resumen ? `<span class="block text-xs text-text-secondary mt-0.5 line-clamp-2">${e.resumen}</span>` : ''}
            ${e.categoria ? `<span class="inline-block text-[10px] font-mono uppercase tracking-wider text-text-muted mt-1">${e.categoria}</span>` : ''}
          </span>
          <span class="ml-auto text-text-muted group-hover/exp:text-accent transition-colors shrink-0">→</span>
        </a>
      `).join('');
      expWrap.classList.remove('hidden');
    } else {
      expWrap.classList.add('hidden');
    }

    // Propiedades en venta
    const propsWrap = document.getElementById('prov-props-wrap')!;
    if (d.propiedades && d.propiedades.length > 0) {
      document.getElementById('prov-props')!.innerHTML = d.propiedades.map((pr: any) => {
        const tipo = tipoLabel[pr.tipo_propiedad] || pr.tipo_propiedad || 'Propiedad';
        const estado = pr.estado === 'disponible' ? '🟢 Disponible' : pr.estado === 'reservado' ? '🟡 Reservado' : pr.estado || '';
        const area = pr.area_hectareas ? `${pr.area_hectareas} ha` : '';
        const precio = pr.precio ? `$${Number(pr.precio).toLocaleString('es-CO')}` : '';
        return `
        <a href="${pr.slug ? '/tierras/' + pr.slug : '/tierras'}"
           class="group/pr flex items-start gap-3 rounded-xl border border-border bg-surface-sunken p-3 hover:border-[#1a4a6b]/50 transition-colors">
          <span class="text-lg mt-0.5">🏡</span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-text-primary group-hover/pr:text-[#1a4a6b] transition-colors">${pr.titulo}</span>
            <span class="block text-xs text-text-secondary mt-0.5">${[tipo, pr.ubicacion_municipio, area, precio].filter(Boolean).join(' · ')}</span>
            ${estado ? `<span class="inline-block text-[10px] font-mono mt-1">${estado}</span>` : ''}
          </span>
          <span class="ml-auto text-text-muted group-hover/pr:text-[#1a4a6b] transition-colors shrink-0">→</span>
        </a>`;
      }).join('');
      propsWrap.classList.remove('hidden');
    } else {
      propsWrap.classList.add('hidden');
    }

    // Propiedades en gestión
    const gestionWrap = document.getElementById('prov-gestion-wrap')!;
    if (d.propiedades_gestion && d.propiedades_gestion.length > 0) {
      document.getElementById('prov-gestion')!.innerHTML = d.propiedades_gestion.map((pg: any) => {
        const tipo = gestionLabel[pg.tipo_gestion] || pg.tipo_gestion || 'Gestión';
        const estado = pg.estado === 'activa' ? '🟢 Activa' : pg.estado === 'pausada' ? '⏸ Pausada' : pg.estado || '';
        const area = pg.area_hectareas ? `${pg.area_hectareas} ha` : '';
        return `
        <a href="${pg.slug ? '/gestion/' + pg.slug : '/gestion'}"
           class="group/gg flex items-start gap-3 rounded-xl border border-border bg-surface-sunken p-3 hover:border-[#6b3fa0]/50 transition-colors">
          <span class="text-lg mt-0.5">🔑</span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-text-primary group-hover/gg:text-[#6b3fa0] transition-colors">${pg.titulo}</span>
            <span class="block text-xs text-text-secondary mt-0.5">${[tipo, pg.ubicacion_municipio, area].filter(Boolean).join(' · ')}</span>
            ${estado ? `<span class="inline-block text-[10px] font-mono mt-1">${estado}</span>` : ''}
          </span>
          <span class="ml-auto text-text-muted group-hover/gg:text-[#6b3fa0] transition-colors shrink-0">→</span>
        </a>`;
      }).join('');
      gestionWrap.classList.remove('hidden');
    } else {
      gestionWrap.classList.add('hidden');
    }

    // Contacto
    const contWrap = document.getElementById('prov-contacto-wrap')!;
    let contHtml = '';
    if (d.whatsapp) contHtml += `<a href="https://wa.me/${d.whatsapp.replace(/\D/g, '')}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[#25D366] transition-colors font-medium">💬 WhatsApp</a>`;
    if (d.instagram) contHtml += `<a href="https://instagram.com/${d.instagram.replace(/^@/, '')}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors font-medium">📷 ${d.instagram.replace(/^@/, '')}</a>`;
    if (d.telefono) contHtml += `<a href="tel:${d.telefono.replace(/\s/g, '')}" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors font-medium">📞 ${d.telefono}</a>`;
    if (d.horario) contHtml += `<span class="inline-flex items-center gap-1.5">🕒 ${d.horario}</span>`;
    if (d.direccion) contHtml += `<span class="inline-flex items-center gap-1.5">📍 ${d.direccion}</span>`;
    if (contHtml) {
      document.getElementById('prov-contacto')!.innerHTML = contHtml;
      contWrap.classList.remove('hidden');
    } else {
      contWrap.classList.add('hidden');
    }

    // Ubicación
    const ubiWrap = document.getElementById('prov-ubicacion-wrap')!;
    if (d.ubicacion) {
      document.getElementById('prov-ubicacion')!.textContent = `📍 ${d.ubicacion}`;
      ubiWrap.classList.remove('hidden');
    } else {
      ubiWrap.classList.add('hidden');
    }

    modal.showModal();
  }

  // Attach click handlers
  document.querySelectorAll('[data-proveedor]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      try {
        const data = JSON.parse(card.getAttribute('data-proveedor')!);
        openModal(data);
      } catch (err) { /* ignore */ }
    });
  });

  // Close handlers
  closeBtn.addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
  modal.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') modal.close();
  });
</script>
