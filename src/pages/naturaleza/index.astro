---
import BrandLayout from '@/layouts/BrandLayout.astro';
import { getExperienciasDestacadas, getAnfitriones, experienciaImagen, anfitrionFoto, formatPrecioCOP, dificultadInfo, nivelInfo } from '@/lib/naturaleza';

const destacadas = await getExperienciasDestacadas(3);
const { data: anfitriones } = await getAnfitriones(1, 3);

const PUERTAS = [
  { title: 'Vivir una experiencia', desc: 'Caminatas, retiros y días de campo.', footer: 'Desde $180.000 COP', icon: '🌿', link: '/naturaleza/experiencias' },
  { title: 'Conocer anfitriones', desc: 'Los guardianes locales que te guiarán.', footer: 'Guías certificados', icon: '🧭', link: '/naturaleza/anfitriones' },
  { title: 'Paquetes completos', desc: 'Itinerarios armados todo incluido.', footer: '2-5 días de duración', icon: '🗓️', link: '/naturaleza/programas' },
];
---

<BrandLayout brand="naturaleza" title="Iwagé Naturaleza · Turismo Regenerativo · Tolima" description="Experiencias de turismo regenerativo guiadas por anfitriones locales en el corredor Ambalá, Tolima. Avistamiento, senderismo y conexión con el territorio.">

  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-[#0e1a08]">
    <img
      src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=1600&q=80"
      alt="Niebla sobre el bosque del Tolima"
      class="absolute inset-0 w-full h-full object-cover opacity-40"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0e1a08]/60 via-transparent to-[#0e1a08]"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-2 h-2 rounded-full bg-[#4a7c23] animate-pulse"></div>
        <span class="text-xs font-bold tracking-[0.4em] text-[#4a7c23] uppercase">Iwagé Naturaleza</span>
      </div>
      <h1 class="text-5xl lg:text-7xl font-light text-white leading-tight mb-6">
        Donde la tierra<br/><span class="font-serif italic text-[#d4920a]">tiene historia</span>
      </h1>
      <p class="text-xl text-white/70 leading-relaxed mb-12">
        ¿Qué estás buscando hoy? Elige tu puerta de entrada al Tolima.
      </p>

      <!-- Three Doors -->
      <div class="grid md:grid-cols-3 gap-6">
        {PUERTAS.map((puerta) => (
          <a
            href={puerta.link}
            class="group relative h-64 rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-xl hover:border-[#d4920a]/50 hover:shadow-2xl hover:shadow-[#d4920a]/10 transition-all duration-500"
          >
            <div class="absolute inset-0 bg-gradient-to-t from-[#0e1a08] via-transparent to-transparent"></div>
            <div class="relative z-10 p-6 h-full flex flex-col justify-end text-left">
              <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                {puerta.icon}
              </div>
              <h3 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-2 group-hover:text-[#d4920a] transition-colors">
                {puerta.title}
              </h3>
              <p class="text-xs text-white/50 leading-relaxed mb-3">{puerta.desc}</p>
              <span class="text-[10px] font-bold text-[#d4920a] uppercase tracking-widest">{puerta.footer}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Experiences -->
  <section class="py-14 px-4 bg-[#f8faf5]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-[0.3em] text-[#4a7c23] uppercase">Experiencias destacadas</span>
        <h2 class="text-3xl lg:text-4xl font-light text-[#1a3009] mt-3">Caminos que transforman</h2>
      </div>

      {destacadas.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {destacadas.map((exp) => {
            const diff = dificultadInfo(exp.nivel_dificultad);
            return (
              <a href={`/naturaleza/experiencias/${exp.slug}`} class="group rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300">
                <div class="relative h-52 overflow-hidden">
                  <img src={experienciaImagen(exp)} alt={exp.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#2d5016]/90 text-white text-[10px] font-bold uppercase tracking-wider">
                    {exp.categoria}
                  </div>
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-semibold text-[#1a3009] mb-2 group-hover:text-[#4a7c23] transition-colors">{exp.titulo}</h3>
                  <p class="text-sm text-gray-600 line-clamp-2 mb-4">{exp.resumen}</p>
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <span>⏱ {exp.duracion || '4-5 horas'}</span>
                    <span class="font-bold text-[#2d5016]">{formatPrecioCOP(exp.precio_desde)}</span>
                  </div>
                  <div class="mt-3 pt-3 border-t border-gray-100 flex items-center gap-2">
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#f8faf5] text-[#4a7c23] font-medium">{diff.label}</span>
                    {exp.ubicacion && <span class="text-[10px] text-gray-400">📍 {exp.ubicacion}</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-center text-gray-500">Próximamente nuevas experiencias.</p>
      )}

      <div class="text-center mt-10">
        <a href="/naturaleza/experiencias" class="inline-block px-8 py-3 rounded-full bg-[#2d5016] text-white text-sm font-bold uppercase tracking-wider hover:bg-[#4a7c23] transition-colors">
          Ver todas las experiencias
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Hosts -->
  <section class="py-14 px-4 bg-[#0e1a08]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-[0.3em] text-[#d4920a] uppercase">Guardianes del territorio</span>
        <h2 class="text-3xl lg:text-4xl font-light text-white mt-3">Quienes te guían</h2>
      </div>

      {anfitriones.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {anfitriones.map((host) => {
            const nivel = nivelInfo(host.nivel_escalafon);
            return (
              <a href={`/naturaleza/anfitriones/${host.slug}`} class="group text-center p-6 rounded-2xl border border-white/10 bg-white/5 hover:border-[#d4920a]/40 transition-all duration-300">
                <img src={anfitrionFoto(host)} alt={host.nombre} class="w-24 h-24 rounded-full object-cover mx-auto mb-4 ring-2 ring-[#d4920a]/30" loading="lazy" />
                <h3 class="text-lg font-semibold text-white group-hover:text-[#d4920a] transition-colors">{host.nombre}</h3>
                <p class="text-sm text-white/60 mt-1">{host.especialidad}</p>
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs text-white/80">
                  <span>{nivel.icono}</span>
                  <span>{nivel.nombre}</span>
                  <span class="text-[#d4920a]">★ {host.calificacion_promedio?.toFixed(1) || '5.0'}</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-center text-white/50">Próximamente conocerás a nuestros anfitriones.</p>
      )}

      <div class="text-center mt-10">
        <a href="/naturaleza/anfitriones" class="inline-block px-8 py-3 rounded-full border border-[#d4920a] text-[#d4920a] text-sm font-bold uppercase tracking-wider hover:bg-[#d4920a] hover:text-[#0e1a08] transition-colors">
          Directorio de anfitriones
        </a>
      </div>
    </div>
  </section>

  <!-- Impact Banner -->
  <section class="py-16 px-4 bg-[#f8faf5]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl lg:text-3xl font-light text-[#1a3009] mb-4">Cada experiencia regenera</h2>
      <p class="text-gray-600 leading-relaxed mb-8">
        El 2% de cada experiencia va directo a nuestro fondo de restauración. Con él financiamos proyectos comunitarios de siembra nativa, protección de fuentes hídricas y formación de nuevos guardianes.
      </p>
      <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto">
        <div>
          <div class="text-3xl font-bold text-[#2d5016]">2%</div>
          <div class="text-xs text-gray-500 mt-1">Fondo impacto</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[#2d5016]">5</div>
          <div class="text-xs text-gray-500 mt-1">Niveles escalafón</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[#2d5016]">7</div>
          <div class="text-xs text-gray-500 mt-1">Rutas de dificultad</div>
        </div>
      </div>
      <div class="mt-8">
        <a href="/naturaleza/impacto" class="text-sm font-bold text-[#4a7c23] underline underline-offset-4 hover:text-[#2d5016]">Conocer nuestro impacto →</a>
      </div>
    </div>
  </section>
</BrandLayout>
