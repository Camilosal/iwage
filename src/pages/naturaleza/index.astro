---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Hero from '@/components/Hero.astro';
import Icon from '@/components/shared/Icon.astro';
import { getExperienciasDestacadas, getExperiencias, getAnfitriones, getPaquetes, experienciaImagen, anfitrionFoto, formatPrecioCOP, dificultadInfo, nivelInfo } from '@/lib/naturaleza';
import { strapiImage } from '@/lib/strapi';
import { getHeroBySlug } from '@/lib/heroes';
import UltimasDeBitacora from '@/components/brand/UltimasDeBitacora.astro';

const hero = await getHeroBySlug('/naturaleza');

// Featured experiences: flagged ones first, fallback to the most recent so the section never looks empty
let destacadas = await getExperienciasDestacadas(3);
if (destacadas.length === 0) {
  const { data: recientes } = await getExperiencias({ pageSize: 3 });
  destacadas = recientes;
}

// Programs & packages for the home (sorted destacado first by the API)
const paquetes = (await getPaquetes()).slice(0, 3);

const { total: totalExperiencias } = await getExperiencias({ pageSize: 1 });
const { total: totalAnfitriones } = await getAnfitriones(1, 1);

// Find an experience with 2+ anfitriones to illustrate "same land, different eyes"
const { data: todasExp } = await getExperiencias({ pageSize: 20 });
const expMultiHost = todasExp.find((e) => e.anfitriones && e.anfitriones.length >= 2) || null;
const miradas = expMultiHost
  ? (expMultiHost.anfitriones || []).map((host) => {
      const j = expMultiHost.anfitriones_data?.find((d) => d.anfitrion_id === host.slug);
      return { host, junction: j || null };
    })
  : [];

// Featured hosts: exclude anfitriones already shown in "La misma tierra, mil miradas" to avoid repetition
const { data: anfitrionesPool } = await getAnfitriones(1, 6);
const miradasSlugs = new Set(miradas.map((m) => m.host.slug));
const guardianes = anfitrionesPool.filter((h) => !miradasSlugs.has(h.slug)).slice(0, 3);

const CAMINOS = [
  {
    icon: 'footprints',
    title: 'Quiero vivir el territorio',
    desc: 'Experiencias guiadas por quienes han habitado esta tierra. Elige tu anfitrión y reserva.',
    pasos: ['Explora experiencias', 'Elige tu anfitrión', 'Reserva en línea', 'Vive el territorio'],
    cta: 'Explorar experiencias',
    href: '/naturaleza/experiencias',
    dark: false,
  },
  {
    icon: 'sprout',
    title: 'Quiero ser anfitrión',
    desc: 'Convierte tu tierra o conocimiento en una experiencia de la red Iwagé.',
    pasos: ['Radicación sin compromiso', 'Capacitación y auditoría', 'Producción y publicación', 'Recibe reservas'],
    cta: 'Presentar mi tierra',
    href: '/naturaleza/se-anfitrion',
    dark: true,
  },
];

const CICLO_ECOSISTEMA = [
  {
    icon: 'leaf',
    marca: 'Iwagé Naturaleza',
    titulo: 'Vive el territorio',
    desc: 'Experiencias guiadas por anfitriones locales.',
    href: '/naturaleza/experiencias',
    color: '#4a7c23',
  },
  {
    icon: 'home',
    marca: 'Iwagé Tierras',
    titulo: 'Enamórate y cómprala',
    desc: 'Predios en venta auditados por tu anfitrión.',
    href: '/tierras/propiedades',
    color: '#1B4332',
  },
  {
    icon: 'key-round',
    marca: 'Iwagé Gestión',
    titulo: 'Protégela y adminístrala',
    desc: 'Renta corta, segunda residencia o finca productiva.',
    href: '/gestion',
    color: '#2d5a8f',
  },
  {
    icon: 'coffee',
    marca: 'Iwagé Café & Meliponas',
    titulo: 'Hazla productiva',
    desc: 'Café especial y polinización con meliponas.',
    href: '/cafe/proveedores',
    color: '#6D4C41',
  },
];

const OFERTA_BULLETS = [
  { icon: 'coins', title: 'Ingresos transparentes', desc: 'Sabes exactamente qué ganas por cada experiencia. Sin sorpresas ni letras pequeñas.' },
  { icon: 'graduation-cap', title: 'Capacitación gratuita', desc: 'Primeros auxilios, interpretación ambiental y hospitalidad. Te formamos sin costo.' },
  { icon: 'sparkles', title: 'Visibilidad en la red', desc: 'Tu perfil y tu espacio en el directorio de Iwagé Naturaleza, ante viajeros calificados.' },
];
---

<BrandLayout brand="naturaleza" title="Iwagé Naturaleza · Turismo Regenerativo · Tolima" description="Agencia de turismo rural en el Tolima: experiencias guiadas por anfitriones locales, cada uno con su propia mirada del territorio. Sé anfitrión o presenta tu espacio.">

  <!-- Hero -->
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Agencia de Turismo Rural · Tolima"
    />
  ) : (
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-[#0e1a08]">
      <img src="/images/hero-naturaleza.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0e1a08]/60 via-transparent to-[#0e1a08]"></div>
      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto py-24">
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="w-2 h-2 rounded-full bg-[#4a7c23] animate-pulse"></div>
          <span class="text-xs font-bold tracking-[0.4em] text-[#4a7c23] uppercase">Agencia de Turismo Rural · Tolima</span>
        </div>
        <h1 class="text-5xl lg:text-7xl font-light text-white leading-tight mb-6">Donde la tierra<br/><span class="font-serif italic text-[#d4920a]">tiene historia</span></h1>
      </div>
    </section>
  )}

  <!-- Dual Paths -->
  <section class="py-16 px-4 bg-[#f8faf5]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-[0.3em] text-[#4a7c23] uppercase">Dos caminos, un mismo territorio</span>
        <h2 class="text-3xl lg:text-4xl font-light text-[#1a3009] mt-3">¿Qué te trae a Iwagé Naturaleza?</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {CAMINOS.map((camino) => (
          <a
            href={camino.href}
            class:list={[
              'group block rounded-3xl p-8 border transition-all duration-300 h-full',
              camino.dark
                ? 'bg-[#1a3009] border-[#1a3009] hover:shadow-2xl hover:shadow-[#d4920a]/10'
                : 'bg-white border-gray-100 hover:border-[#4a7c23]/40 hover:shadow-2xl',
            ]}
          >
            <span class="block mb-4"><Icon name={camino.icon} class="w-10 h-10" /></span>
            <h3 class:list={['text-xl font-semibold mb-3 transition-colors', camino.dark ? 'text-white group-hover:text-[#d4920a]' : 'text-[#1a3009] group-hover:text-[#4a7c23]']}>
              {camino.title}
            </h3>
            <p class:list={['text-sm mb-6', camino.dark ? 'text-white/60' : 'text-gray-500']}>{camino.desc}</p>
            <ol class="space-y-2 mb-6">
              {camino.pasos.map((paso, i) => (
                <li class:list={['flex items-center gap-3 text-sm', camino.dark ? 'text-white/70' : 'text-gray-600']}>
                  <span class:list={['w-5 h-5 rounded-full text-[10px] font-bold flex items-center justify-center shrink-0', camino.dark ? 'bg-[#d4920a]/20 text-[#d4920a]' : 'bg-[#4a7c23]/10 text-[#4a7c23]']}>{i + 1}</span>
                  {paso}
                </li>
              ))}
            </ol>
            <span class:list={['inline-block text-sm font-bold transition-transform group-hover:translate-x-1', camino.dark ? 'text-[#d4920a]' : 'text-[#4a7c23]']}>
              {camino.cta} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Experiences -->
  <section class="py-14 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-[0.3em] text-[#4a7c23] uppercase">Experiencias destacadas</span>
        <h2 class="text-3xl lg:text-4xl font-light text-[#1a3009] mt-3">Caminos que transforman</h2>
      </div>

      {destacadas.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {destacadas.map((exp) => {
            const diff = dificultadInfo(exp.nivel_dificultad);
            return (
              <a href={`/naturaleza/experiencias/${exp.slug}`} class="group rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">
                <div class="relative h-52 overflow-hidden">
                  <img src={experienciaImagen(exp)} alt={exp.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#2d5016]/90 text-white text-[10px] font-bold uppercase tracking-wider">
                    {exp.categoria}
                  </div>
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-semibold text-[#1a3009] mb-2 group-hover:text-[#4a7c23] transition-colors">{exp.titulo}</h3>
                  <p class="text-sm text-gray-600 line-clamp-2 mb-4">{exp.resumen}</p>
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <span class="inline-flex items-center gap-1"><Icon name="timer" class="w-3.5 h-3.5" /> {exp.duracion || '4-5 horas'}</span>
                    <span class="font-bold text-[#2d5016]">{formatPrecioCOP(exp.precio_desde)}</span>
                  </div>
                  <div class="mt-3 pt-3 border-t border-gray-100 flex items-center gap-2">
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#f8faf5] text-[#4a7c23] font-medium">{diff.label}</span>
                    {exp.ubicacion && <span class="text-[10px] text-gray-400 inline-flex items-center gap-1"><Icon name="map-pin" class="w-3 h-3" /> {exp.ubicacion}</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-center text-gray-500">Próximamente nuevas experiencias.</p>
      )}

      <div class="text-center mt-10">
        <a href="/naturaleza/experiencias" class="inline-block px-8 py-3 rounded-full bg-[#2d5016] text-white text-sm font-bold uppercase tracking-wider hover:bg-[#4a7c23] transition-colors">
          Ver todas las experiencias
        </a>
      </div>
    </div>
  </section>

  <!-- Programs & Packages -->
  {paquetes.length > 0 && (
    <section class="py-14 px-4 bg-[#f8faf5]">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold tracking-[0.3em] text-[#4a7c23] uppercase">Programas & paquetes</span>
          <h2 class="text-3xl lg:text-4xl font-light text-[#1a3009] mt-3">Itinerarios <span class="font-serif italic text-[#4a7c23]">todo incluido</span></h2>
          <p class="text-gray-600 max-w-2xl mx-auto mt-4 text-sm leading-relaxed">
            De 2 a 5 días con hospedaje, alimentación, transporte y anfitrión local. Solo llega y camina.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {paquetes.map((pkg) => {
            const heroUrl = pkg.imagen_hero?.url ? strapiImage(pkg.imagen_hero.url) : 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&q=70';
            return (
              <a href={`/naturaleza/programas/${pkg.slug}`} class="group rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">
                <div class="relative h-44 overflow-hidden">
                  <img src={heroUrl} alt={pkg.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                  {pkg.destacado && (
                    <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#d4920a] text-white text-[10px] font-bold uppercase tracking-wider">Destacado</span>
                  )}
                  <span class="absolute bottom-3 left-3 text-[10px] font-bold text-white bg-black/40 px-2 py-0.5 rounded inline-flex items-center gap-1"><Icon name="calendar" class="w-3 h-3" /> {pkg.duracion_texto || `${pkg.duracion_dias} días`}</span>
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-semibold text-[#1a3009] mb-1 group-hover:text-[#4a7c23] transition-colors">{pkg.titulo}</h3>
                  {pkg.tagline && <p class="text-sm text-gray-600 line-clamp-2 mb-4">{pkg.tagline}</p>}
                  <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                    <div>
                      <span class="text-xl font-bold text-[#2d5016]">{formatPrecioCOP(pkg.precio_base)}</span>
                      {pkg.precio_por_persona && <span class="text-[10px] text-gray-400 ml-1">/persona</span>}
                    </div>
                    <span class="text-xs font-bold text-[#4a7c23] group-hover:translate-x-1 transition-transform">Ver programa →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
        <div class="text-center mt-10">
          <a href="/naturaleza/programas" class="inline-block px-8 py-3 rounded-full border-2 border-[#2d5016] text-[#2d5016] text-sm font-bold uppercase tracking-wider hover:bg-[#2d5016] hover:text-white transition-colors">
            Ver todos los programas
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Same Land, Different Eyes (core differentiator) -->
  <section class="py-16 px-4 bg-[#0e1a08]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-[0.3em] text-[#d4920a] uppercase">El corazón de Iwagé Naturaleza</span>
        <h2 class="text-3xl lg:text-4xl font-light text-white mt-3">La misma tierra, <span class="font-serif italic text-[#d4920a]">mil miradas</span></h2>
        <p class="text-white/60 max-w-2xl mx-auto mt-4 text-sm leading-relaxed">
          Cada anfitrión le da su propia perspectiva a la ruta. Elige con quién caminar y vivirás un territorio distinto.
        </p>
      </div>

      {expMultiHost && miradas.length >= 2 ? (
        <div>
          <p class="text-center text-xs text-white/40 mb-6">
            En <a href={`/naturaleza/experiencias/${expMultiHost.slug}`} class="text-[#d4920a] font-bold hover:underline">{expMultiHost.titulo}</a>, cada anfitrión te muestra una faceta distinta:
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            {miradas.map(({ host, junction }) => {
              const nivel = nivelInfo(host.nivel_escalafon);
              return (
                <a href={`/naturaleza/experiencias/${expMultiHost.slug}`} class="group p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-[#d4920a]/40 hover:bg-white/10 transition-all">
                  <div class="flex items-center gap-4 mb-4">
                    <img src={anfitrionFoto(host)} alt={host.nombre} class="w-14 h-14 rounded-full object-cover ring-2 ring-[#d4920a]/30" loading="lazy" />
                    <div>
                      <h3 class="font-semibold text-white group-hover:text-[#d4920a] transition-colors">{host.nombre}</h3>
                      <p class="text-[10px] text-white/50 inline-flex items-center gap-1"><Icon name={nivel.icono} class="w-3 h-3" /> {nivel.nombre} · {host.especialidad || 'Anfitrión local'}</p>
                    </div>
                  </div>
                  {junction?.enfoque_de_ruta && (
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#d4920a] mb-2">{junction.enfoque_de_ruta}</p>
                  )}
                  <p class="text-sm text-white/70 font-serif italic leading-relaxed">
                    “{junction?.superpoder_en_esta_ruta || junction?.toque_unico || host.especialidad || 'Una mirada única del territorio'}”
                  </p>
                </a>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { icon: 'bird', enfoque: 'Mirada contemplativa', desc: 'El anfitrión que conoce cada mirador y detiene el tiempo frente al valle.' },
            { icon: 'wheat', enfoque: 'Mirada ancestral', desc: 'La guardiana que narra la historia de la tierra y sus saberes de siembra.' },
            { icon: 'hexagon', enfoque: 'Mirada productiva', desc: 'El anfitrión que te muestra la finca viva: café, miel y bosque que producen.' },
          ].map((m) => (
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
              <span class="block mb-3"><Icon name={m.icon} class="w-8 h-8" /></span>
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#d4920a] mb-2">{m.enfoque}</p>
              <p class="text-sm text-white/70 font-serif italic leading-relaxed">“{m.desc}”</p>
            </div>
          ))}
        </div>
      )}

      <div class="text-center mt-10">
        <a href="/naturaleza/anfitriones" class="inline-block px-8 py-3 rounded-full border border-[#d4920a] text-[#d4920a] text-sm font-bold uppercase tracking-wider hover:bg-[#d4920a] hover:text-[#0e1a08] transition-colors">
          Conocer a los anfitriones
        </a>
      </div>
    </div>
  </section>

  <!-- Ecosystem & Sales Cycle -->
  <section class="py-16 px-4 bg-[#f8faf5]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-[0.3em] text-[#4a7c23] uppercase">Ecosistema Iwagé</span>
        <h2 class="text-3xl lg:text-4xl font-light text-[#1a3009] mt-3">La experiencia es la <span class="font-serif italic text-[#4a7c23]">puerta de entrada</span></h2>
        <p class="text-gray-600 max-w-2xl mx-auto mt-4 text-sm leading-relaxed">
          Naturaleza es el primer paso de un ciclo que conecta el territorio con tu próxima inversión.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {CICLO_ECOSISTEMA.map((etapa, i) => (
          <a href={etapa.href} class="group relative block bg-white border border-gray-100 rounded-2xl p-6 hover:border-[#4a7c23]/40 hover:shadow-xl transition-all h-full">
            <span class="absolute top-4 right-4 text-[10px] font-mono text-gray-300">0{i + 1}</span>
            <span class="block mb-3"><Icon name={etapa.icon} class="w-8 h-8" /></span>
            <p class="text-[10px] font-bold uppercase tracking-widest mb-1" style={`color: ${etapa.color}`}>{etapa.marca}</p>
            <h3 class="font-semibold text-[#1a3009] group-hover:text-[#4a7c23] transition-colors mb-2">{etapa.titulo}</h3>
            <p class="text-xs text-gray-500">{etapa.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Hosts (hidden when all hosts are already shown in "mil miradas") -->
  {guardianes.length > 0 && (
    <section class="py-14 px-4 bg-[#0e1a08]">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold tracking-[0.3em] text-[#d4920a] uppercase">Guardianes del territorio</span>
          <h2 class="text-3xl lg:text-4xl font-light text-white mt-3">Quienes te guían</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {guardianes.map((host) => {
            const nivel = nivelInfo(host.nivel_escalafon);
            return (
              <a href={`/naturaleza/anfitriones/${host.slug}`} class="group text-center p-6 rounded-2xl border border-white/10 bg-white/5 hover:border-[#d4920a]/40 transition-all duration-300">
                <img src={anfitrionFoto(host)} alt={host.nombre} class="w-24 h-24 rounded-full object-cover mx-auto mb-4 ring-2 ring-[#d4920a]/30" loading="lazy" />
                <h3 class="text-lg font-semibold text-white group-hover:text-[#d4920a] transition-colors">{host.nombre}</h3>
                <p class="text-sm text-white/60 mt-1">{host.especialidad}</p>
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs text-white/80">
                  <Icon name={nivel.icono} class="w-4 h-4" />
                  <span>{nivel.nombre}</span>
                  <span class="text-[#d4920a]">★ {host.calificacion_promedio?.toFixed(1) || '5.0'}</span>
                </div>
              </a>
            );
          })}
        </div>

        <div class="text-center mt-10">
          <a href="/naturaleza/anfitriones" class="inline-block px-8 py-3 rounded-full border border-[#d4920a] text-[#d4920a] text-sm font-bold uppercase tracking-wider hover:bg-[#d4920a] hover:text-[#0e1a08] transition-colors">
            Directorio de anfitriones
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Supply Band: become a host / present your space -->
  <section class="py-16 px-4" style="background: linear-gradient(135deg, #2d1a04 0%, #1a1003 100%)">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-1/2">
          <p class="text-xs font-bold tracking-[0.3em] text-[#d4920a] uppercase mb-3">Para la comunidad local</p>
          <h2 class="text-2xl md:text-3xl font-light text-white mb-4">Convierte tu tierra en <span class="font-serif italic text-[#d4920a]">experiencia</span></h2>
          <p class="text-white/60 text-sm mb-6 leading-relaxed">
            Si tienes una finca o un saber territorial, la red Iwagé lo convierte en una experiencia con reservas en línea y viajeros calificados.
          </p>
          <a href="/naturaleza/se-anfitrion" class="inline-block bg-[#d4920a] text-[#0e1a08] px-8 py-4 rounded-full font-bold text-sm hover:bg-[#d4920a]/90 transition-all shadow-lg">
            Sé Anfitrión o Presenta mi Espacio →
          </a>
        </div>
        <div class="lg:w-1/2 space-y-4">
          {OFERTA_BULLETS.map((item) => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="shrink-0"><Icon name={item.icon} class="w-8 h-8 text-[#d4920a]" /></span>
              <div>
                <h4 class="font-bold text-white text-sm mb-1">{item.title}</h4>
