                      <div class="flex flex-wrap items-center gap-3 mt-2">
                        <button
                          type="button"
                          data-preselect-anfitrion={host.slug}
                          data-recurso={exp.slug}
                          class="px-6 py-3 rounded-xl bg-[#d4920a] text-white text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#1a3009] transition-colors"
