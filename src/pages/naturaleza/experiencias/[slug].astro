          <div class="flex justify-between"><span>Grupo máx.</span><span class="font-medium">{exp.cupo_maximo_desc || '6-8'}</span></div>
          <div class="flex justify-between"><span>Dificultad</span><span class="font-medium">{diff.label}</span></div>
          {exp.ofrece_transporte && <div class="flex justify-between"><span>Transporte</span><span class="font-medium text-green-600">Incluido</span></div>}
        </div>

        <!-- Online Booking Widget -->
        <div id="booking-widget">
          <BookingWidget
            client:visible
            recursoSlug={exp.slug}
            recursoNombre={exp.titulo}
            precioBase={exp.precio_desde || 0}
            capacidadMaxima={parseInt(exp.cupo_maximo_desc) || 8}
            requierePago={true}
            origen="iwage_naturaleza"
            anfitriones={widgetAnfitriones}
          />
        </div>

        <!-- WhatsApp fallback -->
        <div class="mt-3 pt-3 border-t border-gray-100">
          <a
            href={waReservar}
            target="_blank"
            rel="noopener"
            class="block w-full py-2.5 rounded-xl border border-[#2d5016]/20 text-[#2d5016] text-center text-xs font-bold uppercase tracking-wider hover:bg-[#2d5016]/5 transition-colors"
