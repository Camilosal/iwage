                              <p class="text-[10px] text-gray-400 mt-1">base: {formatPrecioCOP(exp.precio_desde)}</p>
                            )}
                          </div>
                        ) : exp.precio_desde ? (
                          <div>
                            <p class="text-lg font-bold text-[#1a3009]">{formatPrecioCOP(exp.precio_desde)}</p>
                            <p class="text-[10px] text-gray-500">por persona</p>
                          </div>
                        ) : (
                          <p class="text-xs text-gray-500">Precio a consultar</p>
