            {exp.link_drone && <a href={exp.link_drone} target="_blank" rel="noopener" class="block text-xs text-[#4a7c23] hover:underline inline-flex items-center gap-1"><Icon name="helicopter" class="w-3.5 h-3.5" /> Vista de dron</a>}
          </div>
        </div>
