                        <h4 class="text-sm font-semibold text-[#1a3009] line-clamp-2">{pg.titulo}</h4>
                        <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-[10px] text-gray-500">
                          {pg.ubicacion_municipio && <span class="inline-flex items-center gap-1"><Icon name="map-pin" class="w-3 h-3" /> {pg.ubicacion_municipio}</span>}
