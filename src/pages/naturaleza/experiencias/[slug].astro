                    <span class="block text-sm font-semibold leading-tight">{host.nombre.split(' ')[0]}</span>
                    <span class:list={['host-tab-precio block text-[10px] font-bold', idx === 0 ? 'text-[#d4920a]' : 'text-[#4a7c23]']}>
                      {precioHost ? `${formatPrecioCOP(precioHost)} / pers.` : 'Precio a consultar'}
                    </span>
                  </span>
                </button>
              );
