            )}
            {bundle.price && (
              <div class="flex items-center justify-between pt-4 border-t border-[#4a7c23]/10">
                <div>
                  <p class="text-[10px] text-gray-500 uppercase font-bold">Precio por persona</p>
                  <p class="text-2xl font-bold text-[#1a3009]">{formatPrecioCOP(bundle.price)} <span class="text-xs font-normal text-gray-500">COP</span></p>
                </div>
                <a
                  href={`https://wa.me/${waPhone}?text=${encodeURIComponent(`Hola, quiero info del paquete: ${bundle.title}`)}`}
                  target="_blank" rel="noopener"
                  class="px-6 py-3 rounded-xl bg-[#d4920a]/10 border border-[#d4920a]/20 text-[#d4920a] text-[10px] font-bold uppercase tracking-wider hover:bg-[#d4920a] hover:text-white transition-colors"
                >
                  Explorar paquete
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Related Experiences -->
  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pb-16">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-6 h-[1px] bg-[#d4920a]"></span>
            <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#d4920a]">La montaña florece</span>
          </div>
          <h2 class="text-2xl font-light text-[#1a3009]">Otras rutas en la zona</h2>
        </div>
        <a href="/naturaleza/experiencias" class="text-[10px] font-bold uppercase tracking-wider text-[#d4920a] hover:text-[#1a3009] transition-colors">
          Ver todas →
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {related.map((rel) => (
          <a href={`/naturaleza/experiencias/${rel.slug}`} class="group block">
            <div class="rounded-2xl border border-gray-100 overflow-hidden bg-white shadow-sm hover:shadow-md transition-all h-full flex flex-col">
              <div class="relative h-40 overflow-hidden">
                <img src={experienciaImagen(rel)} alt={rel.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <span class="absolute top-3 left-3 bg-white/90 text-[#1a3009] text-[9px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">{rel.categoria}</span>
              </div>
              <div class="p-4 flex flex-col flex-grow">
                {rel.ubicacion && <p class="text-[9px] font-bold uppercase tracking-wider text-[#d4920a] mb-1 inline-flex items-center gap-1"><Icon name="map-pin" class="w-3 h-3" /> {rel.ubicacion}</p>}
                <h3 class="font-semibold text-[#1a3009] group-hover:text-[#4a7c23] transition-colors">{rel.titulo}</h3>
                <div class="mt-auto pt-3 border-t border-gray-50 flex items-center gap-2 text-[10px] text-gray-400">
                  {rel.tiempo_desde_ciudad && <span class="inline-flex items-center gap-1"><Icon name="timer" class="w-3 h-3" /> {rel.tiempo_desde_ciudad}</span>}
                  {rel.precio_desde && <span class="ml-auto font-bold text-[#2d5016]">{formatPrecioCOP(rel.precio_desde)}</span>}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Mobile Floating Booking Bar -->
  <div class="fixed bottom-0 left-0 right-0 z-50 p-3 bg-white/95 backdrop-blur-md border-t border-gray-200 lg:hidden">
    <div class="flex items-center justify-between max-w-lg mx-auto">
      <div>
        <span class="text-lg font-bold text-[#2d5016]" data-precio-dinamico>{formatPrecioCOP(exp.precio_desde)}</span>
        <span class="text-xs text-gray-400 ml-1">/ persona</span>
      </div>
      <a
        href={waReservar}
        target="_blank" rel="noopener"
        class="px-6 py-2.5 rounded-xl bg-[#2d5016] text-white text-sm font-bold hover:bg-[#4a7c23] transition-colors"
      >
        Reservar
      </a>
    </div>
  </div>
  <!-- Pre-select anfitrión bridge (vanilla JS → React island) -->
  <script>
    const dispatchPreselect = (recursoSlug: string | null, anfitrionSlug: string | null) => {
      const dispatch = () =>
        document.dispatchEvent(
          new CustomEvent('iwage:preselect-anfitrion', { detail: { recursoSlug, anfitrionSlug } })
        );
      dispatch();
      // Retry once in case the React island has not hydrated yet.
      setTimeout(dispatch, 700);
    };

    document.querySelectorAll('[data-preselect-anfitrion]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const anfitrionSlug = btn.getAttribute('data-preselect-anfitrion');
        const recursoSlug = btn.getAttribute('data-recurso');
        const widget = document.getElementById('booking-widget');
        if (widget) widget.scrollIntoView({ behavior: 'smooth', block: 'center' });
        dispatchPreselect(recursoSlug, anfitrionSlug);
      });
    });

    // Tabs de anfitriones: activa el panel, sincroniza el precio visible y preselecciona en el widget.
    const fmtCOP = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
    const TAB_ACTIVE = ['bg-[#1a3009]', 'border-[#1a3009]', 'text-white', 'shadow-md'];
    const TAB_INACTIVE = ['bg-white', 'border-gray-200', 'text-[#1a3009]', 'hover:border-[#4a7c23]/40'];
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-host-tab]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const slug = tab.getAttribute('data-host-tab');
        if (!slug) return;

        // Estado visual de las pestañas
        tabs.forEach((t) => {
          const activo = t === tab;
          t.setAttribute('aria-selected', activo ? 'true' : 'false');
          t.classList.remove(...(activo ? TAB_INACTIVE : TAB_ACTIVE));
          t.classList.add(...(activo ? TAB_ACTIVE : TAB_INACTIVE));
          const precioSpan = t.querySelector('.host-tab-precio');
          if (precioSpan) {
            precioSpan.classList.toggle('text-[#d4920a]', activo);
            precioSpan.classList.toggle('text-[#4a7c23]', !activo);
          }
        });

        // Panel visible
        document.querySelectorAll<HTMLElement>('[data-host-panel]').forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-host-panel') !== slug);
        });

        // Precio dinámico en sidebar y barra móvil
        const precio = Number(tab.getAttribute('data-precio') || '');
        const nombre = (tab.getAttribute('data-nombre') || '').split(' ')[0];
        if (precio > 0) {
          document.querySelectorAll('[data-precio-dinamico]').forEach((el) => {
            el.textContent = fmtCOP.format(precio);
          });
          document.querySelectorAll('[data-precio-nota]').forEach((el) => {
            el.textContent = nombre ? `por persona · con ${nombre}` : 'por persona';
          });
        }

        // Sincroniza el widget de reservas (sin hacer scroll)
        dispatchPreselect(tab.getAttribute('data-recurso'), slug);
      });
    });
  </script>
</BrandLayout>
