              const precioHost = j?.precio_personalizado || null;
              return (
                <div data-host-panel={host.slug} role="tabpanel" class:list={['p-6 lg:p-8 rounded-2xl bg-white border border-gray-100 shadow-sm', idx > 0 && 'hidden']}>
