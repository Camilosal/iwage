                        <a href={`/naturaleza/anfitriones/${host.slug}`} class="px-6 py-3 rounded-xl border border-[#4a7c23]/20 text-[#2d5016] text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#f8faf5] transition-colors">
