---
import BrandLayout from '@/layouts/BrandLayout.astro';
import { getAnfitriones, anfitrionFoto, nivelInfo } from '@/lib/naturaleza';

const { data: anfitriones, total } = await getAnfitriones(1, 30);
---

<BrandLayout brand="naturaleza" title="Anfitriones · Iwagé Naturaleza" description="Directorio de anfitriones locales y guardianes del territorio en el Tolima. Guías certificados con arraigo ancestral.">

  <!-- Header -->
  <section class="pt-28 pb-12 px-4 bg-[#0e1a08]">
    <div class="max-w-6xl mx-auto text-center">
      <span class="text-xs font-bold tracking-[0.4em] text-[#d4920a] uppercase">Guardianes del territorio</span>
      <h1 class="text-4xl lg:text-5xl font-light text-white mt-4 mb-4">Nuestros anfitriones</h1>
      <p class="text-white/60 max-w-xl mx-auto">Cada anfitrión es una mirada distinta del territorio: guardián con años de arraigo, conocimiento ancestral y su propia forma de mostrarte la misma tierra.</p>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-12 px-4 bg-[#f8faf5] min-h-[50vh]">
    <div class="max-w-6xl mx-auto">
      {anfitriones.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {anfitriones.map((host) => {
            const nivel = nivelInfo(host.nivel_escalafon);
            return (
              <a href={`/naturaleza/anfitriones/${host.slug}`} class="group p-6 rounded-2xl bg-white shadow-sm hover:shadow-xl transition-all duration-300 text-center">
                <div class="relative inline-block mb-4">
                  <img src={anfitrionFoto(host)} alt={host.nombre} class="w-24 h-24 rounded-full object-cover ring-2 ring-gray-100 group-hover:ring-[#d4920a]/40 transition-all" loading="lazy" />
                  <span class="absolute -bottom-1 -right-1 w-8 h-8 rounded-full bg-white shadow flex items-center justify-center text-sm" title={nivel.nombre}>{nivel.icono}</span>
                </div>
                <h3 class="text-lg font-semibold text-[#1a3009] group-hover:text-[#4a7c23] transition-colors">{host.nombre}</h3>
                <p class="text-sm text-gray-500 mt-1">{host.especialidad}</p>
                <div class="mt-3 flex items-center justify-center gap-4 text-xs text-gray-500">
                  <span class="text-[#d4920a] font-bold">★ {host.calificacion_promedio?.toFixed(1) || '5.0'}</span>
                  <span>{host.numero_resenas || 0} reseñas</span>
                  {host.anos_en_territorio && <span>{host.anos_en_territorio} años</span>}
                </div>
                <div class="mt-4 inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider" style={`background: ${nivel.color}15; color: ${nivel.color}`}>
                  {nivel.nombre}
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-14">
          <p class="text-4xl mb-4">🧭</p>
          <p class="text-gray-500">Próximamente conocerás a nuestros guardianes.</p>
        </div>
      )}
    </div>
  </section>
</BrandLayout>
