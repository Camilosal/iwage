---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import { getPaqueteBySlug, getPaquetes, formatPrecioCOP, DIFICULTAD_LABELS } from '@/lib/naturaleza';
import { strapiImage } from '@/lib/strapi';
import { getBrand } from '@/config/brands';
import BookingWidget from '@/components/reservas/BookingWidget';

export async function getStaticPaths() {
  const paquetes = await getPaquetes();
  return paquetes.map((pkg) => ({ params: { slug: pkg.slug }, props: { pkg } }));
}

const { pkg } = Astro.props;
if (!pkg) return Astro.redirect('/naturaleza/programas', 302);

const heroUrl = pkg.imagen_hero?.url ? strapiImage(pkg.imagen_hero.url) : 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=1200&q=70';
const dificultad = pkg.dificultad ? DIFICULTAD_LABELS[pkg.dificultad] : null;
const galleryUrls = (pkg.imagenes || []).map((img) => strapiImage(img.url)).filter(Boolean);
const waPhone = getBrand('naturaleza')?.whatsapp || '573026693366';
---

<BrandLayout brand="naturaleza" title={`${pkg.seo_titulo || pkg.titulo} · Iwagé Naturaleza`} description={pkg.seo_descripcion || pkg.descripcion || `Paquete turístico ${pkg.titulo} en el Tolima.`}>

  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-end overflow-hidden bg-[#0e1a08]">
    <img src={heroUrl} alt={pkg.titulo} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e1a08] via-[#0e1a08]/40 to-transparent"></div>
    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 pb-16 pt-32">
      <a href="/naturaleza/programas" class="text-white/60 hover:text-white text-sm mb-4 inline-block">← Todos los programas</a>
      {pkg.destacado && <span class="inline-block px-3 py-1 rounded-full bg-[#d4920a] text-white text-[10px] font-bold uppercase mb-4 ml-4">Destacado</span>}
      <h1 class="text-4xl md:text-6xl font-serif text-white leading-tight mb-4">{pkg.titulo}</h1>
      {pkg.tagline && <p class="text-xl text-white/70 font-light">{pkg.tagline}</p>}
      <div class="flex flex-wrap gap-4 mt-6 text-sm text-white/80">
        {pkg.duracion_texto && <span class="flex items-center gap-1"><Icon name="calendar" class="w-4 h-4" /> {pkg.duracion_texto}</span>}
        {pkg.ubicacion && <span class="flex items-center gap-1"><Icon name="map-pin" class="w-4 h-4" /> {pkg.ubicacion}</span>}
        {dificultad && <span class="flex items-center gap-1"><Icon name="mountain" class="w-4 h-4" /> {dificultad.label}</span>}
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-12">
        <!-- Description -->
        {pkg.descripcion && (
          <section>
            <h2 class="font-serif text-2xl text-[#1a3009] mb-4">Sobre este programa</h2>
            <p class="text-gray-600 leading-relaxed whitespace-pre-line">{pkg.descripcion}</p>
          </section>
        )}

        <!-- Includes -->
        {pkg.incluye && pkg.incluye.length > 0 && (
          <section>
            <h2 class="font-serif text-2xl text-[#1a3009] mb-4">Qué incluye</h2>
            <div class="grid sm:grid-cols-2 gap-3">
              {pkg.incluye.map((item) => (
                <div class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="text-[#40916C] shrink-0">✓</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Not Includes -->
        {pkg.no_incluye && pkg.no_incluye.length > 0 && (
          <section>
            <h2 class="font-serif text-xl text-[#1a3009] mb-4">No incluye</h2>
            <div class="grid sm:grid-cols-2 gap-3">
              {pkg.no_incluye.map((item) => (
                <div class="flex items-start gap-2 text-sm text-gray-500">
                  <span class="text-red-400 shrink-0">✗</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Experiences in package -->
        {pkg.experiencias_data && pkg.experiencias_data.length > 0 && (
          <section>
            <h2 class="font-serif text-2xl text-[#1a3009] mb-4">Experiencias incluidas</h2>
            <div class="space-y-3">
              {pkg.experiencias_data.map((exp) => (
                <a href={`/naturaleza/experiencias/${exp.slug}`} class="flex items-center gap-4 p-4 bg-[#f8faf5] rounded-xl border border-[#EDE5D4] hover:shadow-md transition-all">
                  <Icon name="leaf" class="w-5 h-5 text-[#40916C]" />
                  <span class="font-medium text-[#1a3009]">{exp.titulo}</span>
                  <span class="ml-auto text-[#40916C] text-sm">Ver →</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Gallery -->
        {galleryUrls.length > 0 && (
          <section>
            <h2 class="font-serif text-2xl text-[#1a3009] mb-4">Galería</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
              {galleryUrls.map((url) => (
                <img src={url} alt={pkg.titulo} class="rounded-xl w-full h-40 object-cover" loading="lazy" />
              ))}
            </div>
          </section>
        )}

        <!-- Hosts -->
        {pkg.anfitriones_data && pkg.anfitriones_data.length > 0 && (
          <section>
            <h2 class="font-serif text-2xl text-[#1a3009] mb-4">Anfitriones</h2>
            <div class="flex flex-wrap gap-4">
              {pkg.anfitriones_data.map((anf) => (
                <div class="flex items-center gap-3 bg-white rounded-xl border border-[#EDE5D4] px-4 py-3">
                  <div class="w-10 h-10 rounded-full bg-[#40916C]/10 flex items-center justify-center text-sm font-bold text-[#40916C]">
                    {(anf.nombre || '?')[0]}
                  </div>
                  <div>
                    <p class="font-medium text-sm text-[#1a3009]">{anf.nombre}</p>
                    {anf.rol && <p class="text-xs text-gray-400">{anf.rol}</p>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="sticky top-24 bg-white rounded-2xl border border-[#EDE5D4] p-6 shadow-sm">
          <div class="mb-6">
            <span class="text-3xl font-bold text-[#1a3009]">{pkg.precio_base ? formatPrecioCOP(pkg.precio_base) : 'Consultar'}</span>
            {pkg.precio_por_persona && <span class="text-sm text-gray-400 ml-1">/persona</span>}
          </div>
          <div class="space-y-3 text-sm text-gray-600 mb-6">
            {pkg.duracion_texto && <p class="flex items-center gap-1"><Icon name="calendar" class="w-4 h-4" /> {pkg.duracion_texto}</p>}
            {pkg.ubicacion && <p class="flex items-center gap-1"><Icon name="map-pin" class="w-4 h-4" /> {pkg.ubicacion}</p>}
            {dificultad && <p class="flex items-center gap-1"><Icon name="mountain" class="w-4 h-4" /> Dificultad: {dificultad.label}</p>}
            {pkg.categoria && <p class="flex items-center gap-1"><Icon name="tag" class="w-4 h-4" /> {pkg.categoria}</p>}
          </div>

          <!-- Online Booking Widget -->
          <BookingWidget
            client:visible
            recursoSlug={pkg.slug}
            recursoNombre={pkg.titulo}
            precioBase={pkg.precio_base || 0}
            capacidadMaxima={10}
            requierePago={true}
            origen="iwage_naturaleza"
          />

          <!-- WhatsApp fallback -->
          <div class="mt-3 pt-3 border-t border-[#EDE5D4]">
            <a
              href={`https://wa.me/${waPhone}?text=${encodeURIComponent(`Hola, quiero reservar el paquete: ${pkg.titulo}`)}`}
              target="_blank"
              rel="noopener"
              class="block w-full text-center px-6 py-3 rounded-xl border border-[#2d5016]/20 text-[#2d5016] text-xs font-bold uppercase tracking-wider hover:bg-[#2d5016]/5 transition-colors mb-3"
            >
              <Icon name="message-circle" class="w-4 h-4 inline align-[-2px] mr-1" /> Reservar por WhatsApp
            </a>
          </div>
          <a href="/naturaleza/programas" class="block w-full text-center px-6 py-3 rounded-xl border border-[#EDE5D4] text-sm text-gray-600 hover:bg-[#f8faf5] transition-colors">
            Ver otros programas
          </a>
        </div>
      </aside>
    </div>
  </div>
</BrandLayout>
