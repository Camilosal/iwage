---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import { getPaquetes, formatPrecioCOP } from '@/lib/naturaleza';
import { strapiImage } from '@/lib/strapi';
import { getBrand } from '@/config/brands';
import Hero from '@/components/Hero.astro';
import { getHeroBySlug } from '@/lib/heroes';

const paquetes = await getPaquetes();
const waPhone = getBrand('naturaleza')?.whatsapp || '573026693366';

const hero = await getHeroBySlug('/naturaleza/programas');
---

<BrandLayout brand="naturaleza" title="Programas y Paquetes · Iwagé Naturaleza" description="Itinerarios completos de turismo regenerativo en el Tolima. Paquetes todo incluido de 2 a 5 días con anfitriones locales.">
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Agencia de Turismo Rural · Tolima"
    />
  ) : (
    <header class="pt-28 pb-12 px-4 bg-[#0e1a08]">
      <div class="max-w-6xl mx-auto text-center">
        <span class="text-xs font-bold tracking-[0.4em] text-[#d4920a] uppercase">Itinerarios completos</span>
        <h1 class="text-4xl lg:text-5xl font-light text-white mt-4 mb-4">Programas & Paquetes</h1>
        <p class="text-white/60 max-w-xl mx-auto">Experiencias multi-día todo incluido: hospedaje, alimentación, transporte y guías locales certificados.</p>
      </div>
    </header>
  )}

  <!-- Packages Grid -->
  <section class="py-12 px-4 bg-[#f8faf5] min-h-[50vh]">
    <div class="max-w-6xl mx-auto">
      {paquetes.length > 0 ? (
        <div class="grid md:grid-cols-2 gap-8">
          {paquetes.map((pkg) => {
            const heroUrl = pkg.imagen_hero?.url ? strapiImage(pkg.imagen_hero.url) : 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800&q=70';
            return (
              <div class="group rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300">
                <div class="relative h-56 overflow-hidden">
                  <img src={heroUrl} alt={pkg.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                  <div class="absolute bottom-4 left-4 right-4">
                    {pkg.destacado && <span class="inline-block px-2 py-0.5 rounded bg-[#d4920a] text-white text-[9px] font-bold uppercase mb-2">Destacado</span>}
                    <h3 class="text-xl font-semibold text-white">{pkg.titulo}</h3>
                    {pkg.tagline && <p class="text-sm text-white/70 mt-1">{pkg.tagline}</p>}
                  </div>
                </div>
                <div class="p-6">
                  {pkg.descripcion && <p class="text-sm text-gray-600 mb-4 line-clamp-3">{pkg.descripcion}</p>}
                  <div class="flex flex-wrap gap-3 text-xs text-gray-500 mb-4">
                    {pkg.duracion_texto && <span class="inline-flex items-center gap-1"><Icon name="calendar" class="w-3.5 h-3.5" /> {pkg.duracion_texto}</span>}
                    {pkg.ubicacion && <span class="inline-flex items-center gap-1"><Icon name="map-pin" class="w-3.5 h-3.5" /> {pkg.ubicacion}</span>}
                    {pkg.dificultad && <span class="inline-flex items-center gap-1"><Icon name="mountain" class="w-3.5 h-3.5" /> Nivel {pkg.dificultad}</span>}
                  </div>
                  {pkg.incluye && pkg.incluye.length > 0 && (
                    <div class="mb-4">
                      <span class="text-[10px] font-bold text-[#2d5016] uppercase tracking-wider">Incluye:</span>
                      <div class="flex flex-wrap gap-1.5 mt-1.5">
                        {pkg.incluye.slice(0, 5).map((item) => (
                          <span class="px-2 py-0.5 rounded bg-[#f8faf5] text-[10px] text-gray-600">{item}</span>
                        ))}
                        {pkg.incluye.length > 5 && <span class="text-[10px] text-gray-400">+{pkg.incluye.length - 5} más</span>}
                      </div>
                    </div>
                  )}
                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <div>
                      <span class="text-2xl font-bold text-[#2d5016]">{formatPrecioCOP(pkg.precio_base)}</span>
                      {pkg.precio_por_persona && <span class="text-xs text-gray-400 ml-1">/persona</span>}
                    </div>
                    <a
                      href={`https://wa.me/${waPhone}?text=${encodeURIComponent(`Hola, me interesa el paquete: ${pkg.titulo}`)}`}
                      target="_blank"
                      rel="noopener"
                      class="px-5 py-2.5 rounded-full bg-[#2d5016] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#4a7c23] transition-colors"
                    >
                      Reservar
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-14">
          <Icon name="calendar-days" class="w-10 h-10 block mx-auto mb-4 text-gray-400" />
          <p class="text-gray-500">Estamos diseñando nuevos programas. ¡Vuelve pronto!</p>
          <a href={`https://wa.me/${waPhone}?text=Hola,%20quiero%20info%20de%20paquetes`} target="_blank" rel="noopener" class="mt-4 inline-block text-sm text-[#4a7c23] underline">Consultar disponibilidad</a>
        </div>
      )}
    </div>
  </section>
</BrandLayout>
