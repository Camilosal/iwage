---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import StepTimeline from '@/components/StepTimeline.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getProyectos, TIPO_LABELS } from '@/lib/proyectos';

const proyectosRelacionados = (await getProyectos({ tipo: 'finca' })).slice(0, 3);

const beneficios = [
  { icon: 'trending-up', title: 'Más polinización, más cosecha', desc: 'Mejoras de 14–22% en cuajado de frutos (aguacate, café, cítricos) con colonias estratégicamente ubicadas.' },
  { icon: 'droplets', title: 'Miel premium', desc: 'Miel de Angelita (Tetragonisca angustula): alta demanda gourmet, cosechas de 1–1.5 L por colmena activa.' },
  { icon: 'leaf', title: 'Sistema agroforestal', desc: 'Las colmenas se integran a bordes de lote, cercas vivas y bosque secundario sin competir con el cultivo principal.' },
  { icon: 'bar-chart-3', title: 'Datos de producción', desc: 'Monitoreo IoT de temperatura, humedad y peso de colmena. Reportes trimestrales de actividad y producción.' },
  { icon: 'badge-check', title: 'Trazabilidad QR', desc: 'Cada cosecha con identidad digital: el consumidor escanea y ve la finca, la colonia y la fecha de extracción.' },
  { icon: 'handshake', title: 'Acompañamiento mensual', desc: 'Visitas técnicas programadas, asistencia en cosecha y manejo sanitario preventivo todo el año.' },
];

const pasos = [
  { number: 1, title: 'Diagnóstico del predio', description: 'Recorrido de la finca: cultivos, flora melífera disponible, fuentes de agua, microclimas y puntos óptimos de instalación.' },
  { number: 2, title: 'Diseño del sistema', description: 'Plano de distribución de colmenas según cultivo objetivo, carga recomendada por hectárea y calendario de cosechas.' },
  { number: 3, title: 'Instalación', description: 'Montaje de colmenas INPA o AF en atriles, señalización y capacitación inicial del equipo de campo.' },
  { number: 4, title: 'Producción y seguimiento', description: 'Visitas mensuales, monitoreo IoT, cosechas asistidas y reportes de mejora en polinización por ciclo.' },
];

const incluye = [
  'Diagnóstico gratuito del predio',
  'Plano de distribución y carga por hectárea',
  'Colmenas INPA o AF con atril según diseño',
  'Instalación y capacitación del equipo de campo',
  'Acompañamiento técnico mensual (12 meses)',
  'Cosechas asistidas con protocolo sanitario',
  'Monitoreo IoT y reportes trimestrales',
  'Trazabilidad QR para comercialización de miel',
];

const cultivos = [
  { nombre: 'Aguacate Hass', mejora: '+22%', nota: 'Cuajado y calibre de fruto' },
  { nombre: 'Café', mejora: '+14%', nota: 'Grano más uniforme y pesado' },
  { nombre: 'Cítricos', mejora: '+18%', nota: 'Mayor tamaño y jugosidad' },
  { nombre: 'Mora', mejora: '+20%', nota: 'Frutos más grandes y firmes' },
];

const faqs = [
  { q: '¿Cuántas colmenas necesita mi finca?', a: 'Depende del cultivo y el área. Como referencia: 4–6 colmenas por hectárea para aguacate, 2–4 para café en bordes de lote. El diagnóstico gratuito define la carga óptima sin sobrecargar la flora disponible.' },
  { q: '¿Las meliponas compiten con mis abejas de miel (Apis)?', a: 'No significativamente. Las meliponas forrajean en flora diferente y a distancias más cortas (300–500 m). Son complementarias: mientras Apis cubre grandes extensiones, las nativas polinizan flores pequeñas que Apis ignora.' },
  { q: '¿En cuánto tiempo veo resultados?', a: 'La mejora en polinización se observa desde la primera floración posterior a la instalación (3–6 meses). La producción de miel arranca en firme desde el segundo semestre.' },
  { q: '¿Qué mantenimiento requieren las colmenas?', a: 'Mínimo: revisión mensual de 30–40 minutos por colmena. Nosotros lo hacemos en el plan de acompañamiento y capacitamos a tu equipo para autonomía progresiva.' },
  { q: '¿La miel de Angelita se vende bien?', a: 'Sí. Tiene 3–4 veces el valor por litro de la miel convencional y demanda creciente en gastronomía y cosmética. Con trazabilidad QR el diferencial de precio aumenta.' },
];
---

<BrandLayout
  title="Fincas Productivas con Meliponas · Iwagé Meliponario"
  description="Polinización gestionada y producción de miel de Angelita para fincas de aguacate, café y cítricos en el Tolima. Diagnóstico gratuito, instalación y acompañamiento mensual."
>
  <!-- Hero -->
  <section class="bg-surface-sunken">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <nav class="flex items-center gap-2 text-sm text-text-muted mb-8" aria-label="Breadcrumb">
        <a href="/meliponas/proyectos" class="hover:text-brand transition-colors">Proyectos</a>
        <span>/</span>
        <span class="text-text-primary font-medium">Fincas Productivas</span>
      </nav>
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <ScrollReveal>
          <div class="w-16 h-16 rounded-2xl bg-brand-muted flex items-center justify-center text-brand mb-6">
            <i data-lucide="tractor" class="w-8 h-8"></i>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Línea · Agro productivo</p>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-tight mb-6">
            Fincas Productivas
          </h1>
          <p class="text-lg text-text-secondary leading-relaxed mb-6">
            Polinización gestionada y producción de miel integradas a tu sistema agroforestal. Más fruto, mejor grano y un ingreso adicional premium: todo con abejas nativas sin aguijón.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/meliponas/contacto" class="inline-flex items-center gap-2 bg-brand text-white rounded-full px-7 py-3.5 font-medium hover:bg-brand-light transition-all">
              Diagnóstico gratuito
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
            <a href="#resultados" class="inline-flex items-center gap-2 border border-border text-text-primary rounded-full px-7 py-3.5 font-medium hover:border-brand hover:text-brand transition-all">
              Ver resultados
            </a>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={150}>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-surface-raised border border-border rounded-2xl p-5 text-center">
              <p class="text-3xl font-bold text-brand">+22%</p>
              <p class="text-xs text-text-muted mt-1">Polinización aguacate</p>
            </div>
            <div class="bg-surface-raised border border-border rounded-2xl p-5 text-center">
              <p class="text-3xl font-bold text-brand">20</p>
              <p class="text-xs text-text-muted mt-1">Colmenas en fincas</p>
            </div>
            <div class="bg-surface-raised border border-border rounded-2xl p-5 text-center">
              <p class="text-3xl font-bold text-brand">7.7L</p>
              <p class="text-xs text-text-muted mt-1">Miel cosechada / año</p>
            </div>
            <div class="bg-surface-raised border border-border rounded-2xl p-5 text-center">
              <p class="text-3xl font-bold text-brand">11</p>
              <p class="text-xs text-text-muted mt-1">Familias vinculadas</p>
            </div>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- Resultados por cultivo -->
  <Section id="resultados">
    <ScrollReveal>
      <SectionHeader
        label="Evidencia"
        title="Resultados medidos en campo"
        subtitle="Mejora promedio en polinización por cultivo, medida en nuestros proyectos activos del piedemonte tolimense."
      />
    </ScrollReveal>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {cultivos.map((c, i) => (
        <ScrollReveal delay={i * 80}>
          <div class="bg-surface-raised border border-border rounded-2xl p-6 text-center h-full">
            <p class="text-3xl font-bold text-brand mb-1">{c.mejora}</p>
            <p class="font-semibold text-text-primary">{c.nombre}</p>
            <p class="text-xs text-text-muted mt-1">{c.nota}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Beneficios -->
  <Section bg="sunken">
    <ScrollReveal>
      <SectionHeader label="Beneficios" title="¿Por qué integrar meliponas a tu finca?" align="center" />
    </ScrollReveal>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {beneficios.map((b, i) => (
        <ScrollReveal delay={i * 60}>
          <div class="bg-surface-raised rounded-2xl border border-border p-6 h-full">
            <div class="w-12 h-12 rounded-xl bg-brand-muted flex items-center justify-center text-brand mb-4">
              <i data-lucide={b.icon} class="w-6 h-6"></i>
            </div>
            <h3 class="text-base font-semibold text-text-primary mb-2">{b.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{b.desc}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Cómo funciona -->
  <Section>
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <ScrollReveal>
        <SectionHeader
          label="Metodología"
          title="De la visita al primer litro"
          subtitle="Un proceso técnico que garantiza la carga correcta de colmenas según tu flora disponible, para resultados desde la primera floración."
        />
        <StepTimeline steps={pasos} />
      </ScrollReveal>
      <ScrollReveal delay={150}>
        <div class="bg-surface-raised border border-border rounded-2xl p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-text-muted mb-5 flex items-center gap-2">
            <i data-lucide="package-check" class="w-4 h-4"></i> Qué incluye
          </h2>
          <ul class="space-y-3">
            {incluye.map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <i data-lucide="check-circle-2" class="w-4 h-4 text-brand shrink-0 mt-0.5"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </ScrollReveal>
    </div>
  </Section>

  <!-- Proyectos relacionados -->
  {proyectosRelacionados.length > 0 && (
    <Section bg="sunken">
      <ScrollReveal>
        <SectionHeader label="Casos reales" title="Fincas con meliponarios activos" />
      </ScrollReveal>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {proyectosRelacionados.map((p, i) => (
          <ScrollReveal delay={i * 80}>
            <ProjectCard
              title={p.nombre}
              location={p.ubicacion ?? `${p.municipio ?? ''}, Tolima`}
              type={TIPO_LABELS[p.tipo] ?? p.tipo}
              status={p.estado}
              description={p.descripcion_corta ?? p.descripcion ?? ''}
              colmenas={p.colmenas ?? undefined}
              image={p.imagen ?? undefined}
              slug={p.slug}
              iot={p.iot_activo}
              trazabilidad={p.trazabilidad_qr}
            />
          </ScrollReveal>
        ))}
      </div>
    </Section>
  )}

  <!-- FAQ -->
  <Section>
    <ScrollReveal>
      <SectionHeader label="Preguntas frecuentes" title="Resolvemos tus dudas" align="center" />
    </ScrollReveal>
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq, i) => (
        <ScrollReveal delay={i * 50}>
          <details class="group bg-surface-raised border border-border rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
              <span class="font-medium text-text-primary">{faq.q}</span>
              <i data-lucide="chevron-down" class="w-5 h-5 text-text-muted shrink-0 group-open:rotate-180 transition-transform"></i>
            </summary>
            <p class="px-5 pb-5 text-sm text-text-secondary leading-relaxed">{faq.a}</p>
          </details>
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section bg="dark" class="!py-14">
    <ScrollReveal>
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold text-dark-text mb-4">¿Tu finca puede producir más?</h2>
        <p class="text-dark-text/60 mb-8">Agenda el diagnóstico gratuito. Recorremos tu predio, evaluamos la flora y te entregamos el diseño con proyección de producción.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/meliponas/contacto" class="inline-flex items-center gap-2 bg-accent text-white rounded-full px-8 py-4 font-medium hover:bg-accent-light transition-all">
            Agendar diagnóstico
            <i data-lucide="arrow-right" class="w-5 h-5"></i>
          </a>
          <a href="/meliponas/polinizacion" class="inline-flex items-center gap-2 border border-dark-text/30 text-dark-text rounded-full px-8 py-4 font-medium hover:border-dark-text/60 transition-all">
            Ver servicio de polinización
          </a>
        </div>
      </div>
    </ScrollReveal>
  </Section>
</BrandLayout>
