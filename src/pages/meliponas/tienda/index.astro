---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import ProductCard from '@/components/ProductCard.astro';
import Icon from '@/components/shared/Icon.astro';
import { SEO } from '@/config/site';
import { getProductos, agruparPorFamilia, CATEGORIAS } from '@/lib/tienda';
import { getCatalogo, resolveRecurso } from '@/lib/catalogo';
import Hero from '@/components/Hero.astro';
import { getHeroBySlug } from '@/lib/heroes';

const productos = await getProductos({ canal: 'online', marca: 'meliponas' });
const catalogo = await getCatalogo();

const hero = await getHeroBySlug('/meliponas/tienda');

// Una card por familia: las variaciones (presentaciones/tamaños) se eligen en la ficha
const agrupados = agruparPorFamilia(productos);

// Pills solo para categorías con productos
const categoriaLabel = new Map(CATEGORIAS.map((c) => [c.id, c.label]));
const pills = CATEGORIAS.filter((c) => agrupados.some((g) => g.producto.categoria === c.id));

// Las tres cosas que cubre la asistencia, en las palabras del dueño: selección, configuración
// y acompañamiento en el uso de lo que se lleva.
const ASISTENCIA = [
  { icono: 'compass', titulo: 'Selección', desc: 'Qué le sirve a su colmena en este momento y qué puede esperar.' },
  { icono: 'settings', titulo: 'Configuración', desc: 'Cómo se monta y se ajusta cada pieza cuando llega a la casa.' },
  { icono: 'users', titulo: 'Acompañamiento', desc: 'Seguimos con usted mientras usa los productos.' },
];
---

<BrandLayout title={SEO.tienda.title} description={SEO.tienda.description}>
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Biotecnología Nativa · Tolima"
    />
  ) : (
    <header class="bg-surface pt-12 pb-8">
      <div class="max-w-6xl mx-auto px-6">
        <SectionHeader
          label="Tienda"
          title="Productos del meliponario"
          subtitle={agrupados.length > 0
            ? 'Miel con trazabilidad por lote, cajas en nogal cafetero y kits para empezar tu meliponario.'
            : undefined}
        />
      </div>
    </header>
  )}

  <!-- Condiciones de compra: solo con catálogo publicado, para no prometer envíos de nada -->
  {agrupados.length > 0 && (
    <div class="max-w-6xl mx-auto px-6 mb-8">
      <div class="bg-accent-muted rounded-xl px-5 py-3 flex items-center gap-3">
        <Icon name="truck" class="w-5 h-5 text-accent shrink-0" />
        <p class="text-sm text-text-secondary">
          Envío a todo Colombia · Pago contra entrega disponible en Ibagué · Empaque refrigerado para miel
        </p>
      </div>
    </div>
  )}

  <!-- Products -->
  <Section class="!pt-0">
    {agrupados.length > 0 ? (
      <>
        <!-- Filtro por categoría (pills) -->
        <div class="flex flex-wrap gap-2 mb-8" id="filtro-categorias">
          <button
            type="button"
            class="filtro-pill"
            data-categoria="todos"
            aria-pressed="true"
          >
            Todos
          </button>
          {pills.map((c) => (
            <button
              type="button"
              class="filtro-pill"
              data-categoria={c.id}
              aria-pressed="false"
            >
              {c.label}
            </button>
          ))}
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="grid-productos">
          {agrupados.map((g, i) => {
            const p = g.producto;
            const rec = resolveRecurso(catalogo, p.slug, p.nombre);
            return (
            <div class="producto-item h-full" data-categoria={p.categoria}>
              <ScrollReveal delay={i * 60} class="h-full">
                <ProductCard
                  name={g.nombre}
                  description={p.descripcion_corta ?? p.descripcion ?? ''}
                  price={g.precioDesde}
                  presentation={g.numVariaciones > 1 ? g.etiquetas.join(' · ') : p.presentacion ?? undefined}
                  image={p.imagen?.url}
                  imageAlt={p.imagen?.alt}
                  destacado={p.destacado}
                  slug={p.slug}
                  precioComparativo={g.numVariaciones > 1 ? undefined : p.precio_comparativo}
                  envioGratis={p.envio_gratis}
                  stockDisponible={p.stock_disponible}
                  recursoSlug={rec?.slug ?? `meliponas-${p.slug}`}
                  tipo={rec?.tipo ?? 'producto'}
                  tipoDisponibilidad={rec?.tipo_disponibilidad ?? 'inmediato'}
                  requierePago={rec?.requiere_pago ?? true}
                  origen={rec?.origen ?? 'iwage_meliponas'}
                  brand="meliponas"
                  categoriaLabel={categoriaLabel.get(p.categoria)}
                  variaciones={g.numVariaciones}
                  ejeVariacion={g.eje}
                  precioDesde={g.numVariaciones > 1}
                />
              </ScrollReveal>
            </div>
            );
          })}
        </div>
      </>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center">
        <Icon name="package" class="w-10 h-10 block mx-auto mb-4 text-brand/40" />
        <h2 class="text-lg font-semibold text-text-primary mb-1">Aún no publicamos productos</h2>
        <p class="text-sm text-text-secondary max-w-md mx-auto">
          Próximamente mostraremos aquí los productos del meliponario.
        </p>
      </div>
    )}
  </Section>

  <!-- La asistencia técnica salió del catálogo como SKU y quedó como puerta: no es un producto
       suelto, es el acompañamiento de todo lo que se lleva. -->
  <Section bg="dark" width="7xl" compact id="asistencia-tecnica">
    <ScrollReveal>
      <SectionHeader
        label="Asistencia técnica"
        title="Antes de comprar y después de instalar"
        subtitle="Le ayudamos a elegir los productos que necesita su meliponario, a configurarlos y a usarlos."
        dark
        align="center"
      />
    </ScrollReveal>
    <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {ASISTENCIA.map((a, i) => (
        <ScrollReveal delay={i * 100}>
          <div class="text-center p-6">
            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-accent mx-auto mb-4">
              <Icon name={a.icono} class="w-6 h-6" />
            </div>
            <h3 class="font-semibold text-dark-text mb-2">{a.titulo}</h3>
            <p class="text-sm text-dark-text/60">{a.desc}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
    <ScrollReveal>
      <div class="text-center mt-8">
        <a
          href="/meliponas/contacto"
          class="inline-flex items-center gap-2 bg-accent text-white rounded-full px-8 py-3.5 font-medium hover:bg-accent-light hover:scale-[1.02] transition-all"
        >
          Pedir asistencia técnica
          <Icon name="arrow-right" class="w-5 h-5" />
        </a>
      </div>
    </ScrollReveal>
  </Section>
</BrandLayout>

<style>
  .filtro-pill {
    padding: 0.5rem 1.125rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    background: var(--color-surface-raised);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .filtro-pill:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
  .filtro-pill[aria-pressed='true'] {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #fff;
  }
  .producto-item.oculto {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    var filtro = document.getElementById('filtro-categorias');
    var items = document.querySelectorAll('#grid-productos .producto-item');
    if (!filtro || items.length === 0) return;

    filtro.addEventListener('click', function (e) {
      var btn = e.target.closest('.filtro-pill');
      if (!btn) return;
      var cat = btn.getAttribute('data-categoria');

      filtro.querySelectorAll('.filtro-pill').forEach(function (p) {
        p.setAttribute('aria-pressed', String(p === btn));
      });
      items.forEach(function (item) {
        var visible = cat === 'todos' || item.getAttribute('data-categoria') === cat;
        item.classList.toggle('oculto', !visible);
      });
    });
  })();
</script>
