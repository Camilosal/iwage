---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import TabGroup from '@/components/TabGroup.astro';
import ProductCard from '@/components/ProductCard.astro';
import { SEO } from '@/config/site';
import { getProductosPorCategoria, CATEGORIAS } from '@/lib/tienda';
import { getCatalogo, resolveRecurso } from '@/lib/catalogo';

const productosPorCat = await getProductosPorCategoria('online');
const catalogo = await getCatalogo();

// Only show tabs for categories that have products
const tabs = CATEGORIAS
  .filter((c) => productosPorCat[c.id]?.length > 0)
  .map((c) => ({ id: c.id, label: c.label }));

const defaultTab = tabs[0]?.id ?? 'miel';
---

<BrandLayout title={SEO.tienda.title} description={SEO.tienda.description}>
  <!-- Hero -->
  <section class="bg-surface pt-12 pb-8">
    <div class="max-w-6xl mx-auto px-6">
      <SectionHeader
        label="Tienda"
        title="Productos del meliponario"
        subtitle="Miel con trazabilidad por lote, cajas en nogal cafetero y kits para empezar tu meliponario."
      />
    </div>
  </section>

  <!-- Shipping info -->
  <div class="max-w-6xl mx-auto px-6 mb-8">
    <div class="bg-accent-muted rounded-xl px-5 py-3 flex items-center gap-3">
      <i data-lucide="truck" class="w-5 h-5 text-accent shrink-0"></i>
      <p class="text-sm text-text-secondary">
        Envío a todo Colombia · Pago contra entrega disponible en Ibagué · Empaque refrigerado para miel
      </p>
    </div>
  </div>

  <!-- Products -->
  <Section class="!pt-0">
    <TabGroup tabs={tabs} defaultTab={defaultTab}>
      {Object.entries(productosPorCat).map(([cat, items]) => (
        <div data-panel={cat} class="tab-panel">
          <div class="grid grid-cols-2 lg:grid-cols-3 gap-6">
            {items.map((p, i) => {
              const rec = resolveRecurso(catalogo, p.slug, p.nombre);
              return (
              <ScrollReveal delay={i * 80}>
                <ProductCard
                  name={p.nombre}
                  description={p.descripcion_corta ?? p.descripcion ?? ''}
                  price={p.precio}
                  presentation={p.presentacion ?? undefined}
                  image={p.imagen ?? undefined}
                  destacado={p.destacado}
                  slug={p.slug}
                  precioComparativo={p.precio_comparativo}
                  envioGratis={p.envio_gratis}
                  stockDisponible={p.stock_disponible}
                  recursoSlug={rec?.slug ?? `meliponas-${p.slug}`}
                  tipo={rec?.tipo ?? 'producto'}
                  tipoDisponibilidad={rec?.tipo_disponibilidad ?? 'inmediato'}
                  requierePago={rec?.requiere_pago ?? true}
                  origen={rec?.origen ?? 'iwage_meliponas'}
                  brand="meliponas"
                />
              </ScrollReveal>
              );
            })}
          </div>
        </div>
      ))}
    </TabGroup>
  </Section>
</BrandLayout>
