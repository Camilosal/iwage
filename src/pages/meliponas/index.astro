---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import StatGrid from '@/components/StatGrid.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import BitacoraCard from '@/components/BitacoraCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Hero from '@/components/Hero.astro';
import Icon from '@/components/shared/Icon.astro';
import { SEO } from '@/config/site';
import { getProyectos, getProyectoBySlug } from '@/lib/proyectos';
import { getProductos } from '@/lib/tienda';
import { getCultivos } from '@/lib/polinizacion';
import { SITE_METRICS } from '@/config/site-metrics';
import { getBitacoraByMarca } from '@/lib/bitacora';
import { getHeroBySlug } from '@/lib/heroes';

const hero = await getHeroBySlug('/meliponas');

const stats = [
  { value: `${SITE_METRICS.colmenasActivas}+`, label: SITE_METRICS.colmenasActivasLabel },
  { value: String(SITE_METRICS.modelosCaja), label: 'Modelos de caja' },
  { value: `${SITE_METRICS.kmFloraNativa} km`, label: 'Flora nativa' },
  { value: SITE_METRICS.trazabilidadPorLote, label: 'Trazable por lote' },
];

// Retrato de cada tarjeta de navegación: la primera portada real del tema al que apunta, leída
// de Strapi. Sin portada cargada, la tarjeta conserva su mosaico Icon — nunca una ruta inventada.
const [meliponarioCentral, productosTienda, cultivosPolinizacion] = await Promise.all([
  getProyectoBySlug('meliponario-central-iwage'),
  getProductos({ marca: 'meliponas' }),
  getCultivos(),
]);
// La tarjeta de la Tienda se decide por categoría, no por orden alfabético: «miel» es lo que
// define la marca, y `getProductos` viene ordenado por categoria:asc (abono abriría primero).
const portadaTienda =
  productosTienda.find((p) => p.categoria === 'miel' && p.imagen)?.imagen?.url
  ?? productosTienda.find((p) => p.imagen)?.imagen?.url
  ?? null;
const portadaCultivos = cultivosPolinizacion.find((c) => c.imagen)?.imagen?.url ?? null;

const features = [
  {
    icon: 'shopping-bag',
    title: 'Tienda',
    description: 'Miel de Angelita pura, cajas tecnificadas INPA/AF y kits de meliponicultura con envío a todo Colombia.',
    href: '/meliponas/tienda',
    image: portadaTienda,
  },
  {
    icon: 'sprout',
    title: 'Proyectos',
    description: 'Diseño e instalación de meliponarios para colegios, fincas, turismo y paisajismo residencial.',
    href: '/meliponas/proyectos',
    image: meliponarioCentral?.imagen?.url ?? null,
  },
  {
    icon: 'flower-2',
    title: 'Polinización',
    description: 'Servicio de polinización gestionada con abejas nativas para cultivos del corredor Ambalá.',
    href: '/meliponas/polinizacion',
    image: portadaCultivos,
  },
];

const testimonials = [
  {
    quote: 'Las colmenas de Iwagé transformaron nuestro proyecto PRAE. Los estudiantes ahora entienden la biodiversidad desde la observación directa.',
    name: 'María Fernanda Gutiérrez',
    role: 'Coordinadora Académica',
    location: 'I.E. Ambalá',
  },
  {
    quote: 'La miel de Angelita tiene un perfil de cata que no encontramos en ningún otro proveedor. Trazabilidad impecable.',
    name: 'Andrés Restrepo',
    role: 'Chef Ejecutivo',
    location: 'Restaurante Origen, Bogotá',
  },
  {
    quote: 'Instalaron 8 colmenas en nuestra finca y la polinización del café mejoró notablemente en una temporada.',
    name: 'Jorge Iván Cardona',
    role: 'Caficultor',
    location: 'Vereda El Carmen, Ibagué',
  },
];

const { data: bitacoraPosts } = await getBitacoraByMarca('meliponas', { pageSize: 4 });

// Proyectos: 4 priorizados (destacados) o los últimos 4
// `.filter(p => p.slug)`: sin slug no hay ruta de detalle; enlazar `/null` fue
// medido en producción (2026-10-04) antes del backfill de slugs en Strapi.
// El desempate por `orden` va ASCENDENTE porque ese es el significado del campo en todo el
// sitio (`proyectos`, `cafe`, `tienda`, `heroes`, `naturaleza` y el indexador RAG ordenan
// `orden:asc`). Hoy no se nota: los seis proyectos no destacados comparten `orden: 0`. Se
// notaría el día que alguien numere 1, 2, 3 para acomodar el home: el home los mostraría al
// revés que el resto del sitio.
const proyectos = await getProyectos();
const proyectosHome = proyectos
  .filter((p) => Boolean(p.slug))
  .sort((a, b) => {
    if (a.destacado !== b.destacado) return b.destacado ? 1 : -1;
    return (a.orden ?? 0) - (b.orden ?? 0);
  })
  .slice(0, 4);

// La banda «Conoce el meliponario» habla de nuestro propio meliponario. Sin ficha o sin
// fotos, la banda se retira entera: lo que había debajo era un mosaico de cuatro proyectos
// de clientes vendido como «el día a día de nuestras colmenas» (medido 2026-10-04).
const laminasCentral = meliponarioCentral
  ? [meliponarioCentral.imagen, ...(meliponarioCentral.galeria ?? [])]
      .flatMap((m) => (m && m.kind === 'imagen' ? [m] : []))
      .slice(0, 3)
  : [];
const bandaMeliponario =
  meliponarioCentral?.slug && laminasCentral.length > 0 ? { ...meliponarioCentral, laminas: laminasCentral } : null;

// Coordenadas del meliponario base (Ibagué, Tolima) - gestionables desde Strapi en futuro
const meliponarioLocation = {
  lat: 4.4389,
  lng: -75.2322,
  nombre: 'Meliponario Base Iwagé',
  direccion: 'Vereda El Carmen, Ibagué, Tolima',
  zoom: 14,
};
---

<BrandLayout brand="meliponas" title={SEO.home.title} description={SEO.home.description}>
  <!-- Hero -->
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Meliponario · Ibagué, Tolima"
    />
  ) : (
    <section class="relative overflow-hidden bg-surface">
      <img src="/images/hero-meliponas.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-surface/80 via-surface/70 to-surface/85"></div>
      <div class="relative max-w-3xl mx-auto px-6 py-16 md:py-20 text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Meliponario · Ibagué, Tolima</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-text-primary leading-tight">Biotecnología<br /><span class="text-brand">Nativa</span></h1>
      </div>
    </section>
  )}

  <!-- Trust bar - ancho completo como header, compacto -->
  <Section bg="sunken" width="7xl" compact class="!py-6 md:!py-8">
    <ScrollReveal>
      <StatGrid stats={stats} />
    </ScrollReveal>
  </Section>

  <!-- Features: Tres líneas de acción -->
  <Section width="7xl" compact>
    <ScrollReveal>
      <SectionHeader
        label="Qué hacemos"
        title="Tres líneas de acción"
        subtitle="Un ecosistema completo alrededor de las abejas nativas y el territorio."
        align="center"
      />
    </ScrollReveal>
    <div class="grid md:grid-cols-3 gap-6">
      {features.map((f, i) => (
        <ScrollReveal delay={i * 100}>
          <FeatureCard icon={f.icon} title={f.title} description={f.description} href={f.href} image={f.image} />
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Conoce el meliponario: nuestro propio meliponario, con sus fotos reales -->
  {bandaMeliponario && (
    <Section id="meliponario" width="7xl" compact class="!py-10">
      <ScrollReveal>
        <div class="text-center mb-8">
          <span class="font-mono text-xs uppercase tracking-widest text-accent">Nuestra casa</span>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold text-text-primary">Conoce el meliponario</h2>
          <p class="mt-3 text-base md:text-lg text-text-secondary max-w-xl mx-auto">
            Las colonias propias del corredor Ambalá: de aquí sale la miel Angelita y aquí
            prueban las cajas antes de irse a un proyecto.
          </p>
        </div>
        <div class="rounded-2xl overflow-hidden bg-surface-sunken border border-border">
          <a
            href={`/meliponas/proyectos/${bandaMeliponario.slug}`}
            class="grid grid-cols-3 gap-1 p-1 group focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 focus:ring-offset-surface"
            aria-label={`Ver ${bandaMeliponario.nombre}`}
          >
            {bandaMeliponario.laminas.map((m) => (
              <span class="relative block overflow-hidden aspect-square">
                <img
                  src={m.url}
                  alt={m.alt || bandaMeliponario.nombre}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="400"
                />
              </span>
            ))}
          </a>
          <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h3 class="font-semibold text-text-primary">{bandaMeliponario.nombre}</h3>
              <p class="text-sm text-text-secondary mt-1">{bandaMeliponario.ubicacion}</p>
            </div>
            <a
              href={`/meliponas/proyectos/${bandaMeliponario.slug}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand text-white text-sm font-medium hover:gap-3 transition-all shrink-0"
            >
              Ver el meliponario
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </ScrollReveal>
    </Section>
  )}

  <!-- Testimonials -->
  <Section bg="dark" width="7xl" compact>
    <ScrollReveal>
      <SectionHeader label="Testimonios" title="Lo que dicen de nosotros" dark align="center" />
    </ScrollReveal>
    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <ScrollReveal delay={i * 100}>
          <TestimonialCard quote={t.quote} name={t.name} role={t.role} location={t.location} />
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Proyectos destacados - fix imagen -->
  <Section width="7xl" compact>
    <ScrollReveal>
      <SectionHeader label="Proyectos" title="Instalaciones recientes" subtitle="Meliponarios educativos, productivos y turísticos en el Tolima." align="center" />
    </ScrollReveal>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {proyectosHome.map((p, i) => (
        <ScrollReveal delay={i * 100}>
          <ProjectCard
            title={p.nombre}
            location={p.ubicacion ?? ''}
            type={p.tipo}
            status={p.estado}
            description={p.descripcion_corta ?? p.descripcion ?? ''}
            colmenas={p.colmenas ?? undefined}
            image={p.imagen?.url ?? p.galeria?.[0]?.url}
            imageAlt={p.imagen?.alt ?? p.galeria?.[0]?.alt}
            slug={p.slug}
            iot={p.iot_activo}
            trazabilidad={p.trazabilidad_qr}
          />
        </ScrollReveal>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/meliponas/proyectos" class="inline-flex items-center gap-2 text-brand font-medium hover:gap-3 transition-all">
        Ver todos los proyectos →
      </a>
    </div>
  </Section>

  <!-- Bitácora preview - 4 tarjetas en fila -->
  <Section width="7xl" compact>
    <ScrollReveal>
      <SectionHeader label="Bitácora" title="Conocimiento abierto" subtitle="Guías técnicas, flora nativa y territorio Pijao." align="center" />
    </ScrollReveal>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {bitacoraPosts.map((post, i) => (
        <ScrollReveal delay={i * 100}>
          <BitacoraCard
            title={post.titulo}
            excerpt={post.extracto ?? ''}
            category={post.categoria ?? 'General'}
            date={post.fecha ?? ''}
            readTime={String(post.tiempo_lectura ?? 5)}
            href={`/meliponas/bitacora/${post.slug}`}
            image={post.imagen ?? undefined}
          />
        </ScrollReveal>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/meliponas/bitacora" class="inline-flex items-center gap-2 text-brand font-medium hover:gap-3 transition-all">
        Ver todos los artículos →
      </a>
    </div>
  </Section>

  <!-- Mapa de localización -->
  <Section id="ubicacion" width="7xl" compact>
    <ScrollReveal>
      <SectionHeader label="Ubicación" title="Dónde estamos" subtitle="Visítanos en el piedemonte tolimense. Coordenadas gestionables desde Strapi." align="center" />
    </ScrollReveal>
    <div class="relative rounded-2xl overflow-hidden bg-surface-sunken border border-border aspect-[16/9]">
      <iframe
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${meliponarioLocation.lng - 0.02}%2C${meliponarioLocation.lat - 0.015}%2C${meliponarioLocation.lng + 0.02}%2C${meliponarioLocation.lat + 0.015}&layer=mapnik&marker=${meliponarioLocation.lat}%2C${meliponarioLocation.lng}`}
        class="absolute inset-0 w-full h-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Ubicación: ${meliponarioLocation.nombre}`}
        allowfullscreen
      ></iframe>
      <div class="absolute bottom-4 left-4 right-4 bg-white/95 dark:bg-dark-bg/95 backdrop-blur-sm rounded-xl p-4 shadow-lg">
        <h3 class="font-semibold text-text-primary">{meliponarioLocation.nombre}</h3>
        <p class="text-sm text-text-secondary mt-1">{meliponarioLocation.direccion}</p>
        <div class="mt-2 flex flex-wrap gap-2 text-xs text-text-muted">
          <span>📍 {meliponarioLocation.lat.toFixed(4)}, {meliponarioLocation.lng.toFixed(4)}</span>
          <a href={`https://www.openstreetmap.org/?mlat=${meliponarioLocation.lat}&mlon=${meliponarioLocation.lng}#map=${meliponarioLocation.zoom}/${meliponarioLocation.lat}/${meliponarioLocation.lng}`} target="_blank" rel="noopener" class="text-brand hover:underline">
            Ver en OpenStreetMap →
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- Final CTA -->
  <Section bg="dark" width="7xl" compact class="!py-10">
    <ScrollReveal>
      <div class="text-center">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-dark-text mb-4">
          ¿Listo para empezar?
        </h2>
        <p class="text-dark-text/60 mb-8 max-w-lg mx-auto">
          Cuéntanos qué tienes en mente. Respondemos en menos de 24 horas.
        </p>
        <a href="/meliponas/contacto" class="inline-flex items-center gap-2 bg-accent text-white rounded-full px-8 py-3.5 font-medium hover:bg-accent-light hover:scale-[1.02] transition-all">
          Hablemos →
        </a>
      </div>
    </ScrollReveal>
  </Section>
</BrandLayout>
