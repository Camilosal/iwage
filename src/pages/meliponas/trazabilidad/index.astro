---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Icon from '@/components/shared/Icon.astro';
import { SEO } from '@/config/site';
import Hero from '@/components/Hero.astro';
import { getHeroBySlug } from '@/lib/heroes';

const estandares = [
  {
    id: 'miel',
    numero: '01',
    icono: 'hexagon',
    titulo: 'Estándar de Miel',
    audiencia: 'Para consumidores, chefs y compradores B2B',
    desc: 'Trazabilidad por lote, cadena de frío, análisis de laboratorio y QR en cada frasco. Conoce el origen exacto de tu miel.',
    href: '/meliponas/trazabilidad/miel',
    cta: 'Ver estándar de miel',
  },
  {
    id: 'cajas',
    numero: '02',
    icono: 'package',
    titulo: 'Estándar de Cajas',
    audiencia: 'Para meliponicultores y adoptantes',
    desc: 'Cada caja INPA/AF lleva ID único, sensores IoT de temperatura y humedad, bitácora de colonia e historial transferible.',
    href: '/meliponas/trazabilidad/cajas',
    cta: 'Ver estándar de cajas',
  },
  {
    id: 'polinizacion',
    numero: '03',
    icono: 'flower-2',
    titulo: 'Estándar de Polinización',
    audiencia: 'Para productores agrícolas',
    desc: 'Servicio con diagnóstico de predio, contrato, colonias certificadas, monitoreo en campo e informe de resultados.',
    href: '/meliponas/trazabilidad/polinizacion',
    cta: 'Ver estándar de polinización',
  },
];

const hero = await getHeroBySlug('/meliponas/trazabilidad');
---

<BrandLayout title={SEO.trazabilidad.title} description={SEO.trazabilidad.description}>
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Biotecnología Nativa · Tolima"
    />
  ) : (
    <header class="bg-dark-bg text-dark-text">
      <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Trazabilidad Iwagé</p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-6">
          Tres estándares,<br />una misma promesa
        </h1>
        <p class="text-lg text-dark-text/60 leading-relaxed max-w-2xl mx-auto">
          Cada producto y servicio del meliponario está respaldado por un protocolo verificable. Elige el estándar según lo que buscas.
        </p>
      </div>
    </header>
  )}

  <!-- Estándares -->
  <Section>
    <div class="grid md:grid-cols-3 gap-6">
      {estandares.map((e, i) => (
        <ScrollReveal delay={i * 100}>
          <a href={e.href} class="group block bg-surface-raised rounded-2xl border border-border p-8 shadow-sm hover:shadow-lg hover:border-brand/30 transition-all h-full">
            <div class="flex items-center justify-between mb-5">
              <Icon name={e.icono} class="w-9 h-9 text-brand" />
              <span class="font-mono text-xs text-accent">{e.numero}</span>
            </div>
            <h2 class="text-xl font-bold text-text-primary mb-2 group-hover:text-brand transition-colors">{e.titulo}</h2>
            <p class="font-mono text-[10px] uppercase tracking-widest text-accent mb-3">{e.audiencia}</p>
            <p class="text-sm text-text-secondary leading-relaxed mb-6">{e.desc}</p>
            <span class="inline-flex items-center gap-2 text-brand font-medium text-sm group-hover:gap-3 transition-all">
              {e.cta}
              <Icon name="arrow-right" class="w-4 h-4" />
            </span>
          </a>
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Qué significa trazabilidad -->
  <Section bg="sunken">
    <ScrollReveal>
      <SectionHeader
        label="Nuestra promesa"
        title="¿Qué significa trazabilidad para Iwagé?"
        subtitle="No es un sello de marketing. Es la capacidad de responder, con datos, de dónde viene cada cosa y qué pasó con ella en cada etapa."
        align="center"
      />
    </ScrollReveal>
    <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <ScrollReveal>
        <div class="text-center p-6">
          <div class="w-12 h-12 rounded-xl bg-brand-muted flex items-center justify-center text-brand mx-auto mb-4">
            <Icon name="map-pin" class="w-6 h-6" />
          </div>
          <h3 class="font-semibold text-text-primary mb-2">Origen</h3>
          <p class="text-sm text-text-secondary">Sabemos exactamente de qué colmena, caja o predio viene cada producto.</p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={100}>
        <div class="text-center p-6">
          <div class="w-12 h-12 rounded-xl bg-brand-muted flex items-center justify-center text-brand mx-auto mb-4">
            <Icon name="history" class="w-6 h-6" />
          </div>
          <h3 class="font-semibold text-text-primary mb-2">Historia</h3>
          <p class="text-sm text-text-secondary">Cada etapa queda registrada: cosecha, inspección, monitoreo, entrega.</p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={200}>
        <div class="text-center p-6">
          <div class="w-12 h-12 rounded-xl bg-brand-muted flex items-center justify-center text-brand mx-auto mb-4">
            <Icon name="shield-check" class="w-6 h-6" />
          </div>
          <h3 class="font-semibold text-text-primary mb-2">Verificación</h3>
          <p class="text-sm text-text-secondary">Los datos son accesibles y auditables. No pedimos confianza: la demostramos.</p>
        </div>
      </ScrollReveal>
    </div>
  </Section>
</BrandLayout>
