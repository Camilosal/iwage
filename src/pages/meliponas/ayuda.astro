---
export const prerender = true;
import BrandLayout from '@/layouts/BrandLayout.astro';

const CATEGORIES = [{"id": "todos", "label": "Todos", "icon": "📋"}, {"id": "productos", "label": "Productos", "icon": "🍯"}, {"id": "tecnico", "label": "Técnico", "icon": "🔧"}, {"id": "polinizacion", "label": "Polinización", "icon": "🌸"}, {"id": "pedidos", "label": "Pedidos", "icon": "📦"}];

const FAQS = [{"pregunta": "¿Qué es la miel de Angelita?", "respuesta": "Es la miel producida por Tetragonisca angustula, una abeja sin aguijón nativa. Tiene mayor humedad (22-25%), menor viscosidad y un perfil de sabor más complejo que la miel convencional, con notas cítricas y florales.", "categoria": "productos"}, {"pregunta": "¿Cómo conservo la miel de Angelita?", "respuesta": "Refrigeración constante (4-8°C) para preservar sus propiedades enzimáticas. A diferencia de la miel de Apis, la miel de Angelita puede fermentar a temperatura ambiente por su mayor contenido de humedad.", "categoria": "productos"}, {"pregunta": "¿Qué diferencia hay entre cajas INPA y AF?", "respuesta": "INPA: diseño modular con pisos separados, ideal para producción de miel, más fácil de cosechar. AF: diseño compacto de un solo cuerpo, ideal para observación y educación, más fácil de transportar.", "categoria": "tecnico"}, {"pregunta": "¿Cuántas colmenas necesito para empezar?", "respuesta": "Recomendamos iniciar con 3-5 colonias para aprender el manejo sin riesgo. Una colonia establecida produce entre 1-2 litros de miel al año en condiciones del piedemonte tolimense.", "categoria": "tecnico"}, {"pregunta": "¿Hacen asistencia técnica a domicilio?", "respuesta": "Sí. Ofrecemos visitas técnicas en Ibagué y municipios cercanos del corredor Ambalá. Para zonas más alejadas, coordinamos jornadas grupales. La primera visita de diagnóstico es gratuita.", "categoria": "tecnico"}, {"pregunta": "¿Qué es la polinización gestionada?", "respuesta": "Es el servicio de ubicar colmenas de abejas nativas en cultivos para mejorar rendimiento y calidad de frutos. A diferencia de Apis, las meliponas no dañan flores delicadas y son más eficientes en cultivos de invernadero.", "categoria": "polinizacion"}, {"pregunta": "¿Qué cultivos se benefician de polinización con meliponas?", "respuesta": "Tomate, pimentón, fresa, uchuva, café, aguacate y frutales en general. En invernadero, la mejora de rendimiento puede ser del 20-40% vs polinización manual.", "categoria": "polinizacion"}, {"pregunta": "¿Hacen envíos a todo Colombia?", "respuesta": "Sí. Envíos refrigerados a todo el país con transportadoras especializadas. El costo varía según destino. Pedidos superiores a $150.000 tienen envío gratis dentro del Tolima.", "categoria": "pedidos"}, {"pregunta": "¿Cuánto tarda un pedido?", "respuesta": "Preparamos tu pedido en 1-2 días hábiles. El envío toma 2-4 días adicionales dependiendo del destino. Recibirás número de rastreo por WhatsApp.", "categoria": "pedidos"}];
---

<BrandLayout brand="meliponas" title="Centro de Ayuda · Iwagé Meliponario" description="Preguntas frecuentes y soporte de Iwagé Meliponario. Encuentra respuestas rápidas.">
  <!-- Hero -->
  <section class="bg-surface pt-12 pb-8">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="text-4xl block mb-4">🐝</span>
      <h1 class="text-3xl md:text-4xl font-serif text-text-primary mb-3">Centro de Ayuda</h1>
      <p class="text-text-secondary max-w-lg mx-auto mb-8">Dudas sobre miel de Angelita, cajas, polinización y proyectos meliponarios.</p>
      <!-- Search -->
      <div class="max-w-md mx-auto relative">
        <input
          type="search"
          id="faq-search"
          placeholder="Buscar pregunta..."
          class="w-full rounded-full border border-border bg-surface-raised px-5 py-3 pl-11 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand"
        />
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-sm">🔍</span>
      </div>
    </div>
  </section>

  <!-- Category filter -->
  <div class="max-w-4xl mx-auto px-6 mb-8">
    <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2 justify-center flex-wrap">
      {CATEGORIES.map((cat, i) => (
        <button
          type="button"
          class={`cat-pill rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap transition-all ${i === 0 ? 'bg-brand text-white' : 'bg-surface-sunken text-text-secondary hover:bg-brand-muted hover:text-brand'}`}
          data-cat={cat.id}
        >
          {cat.icon} {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- FAQ List -->
  <section class="max-w-3xl mx-auto px-6 pb-20">
    <div id="faq-list" class="space-y-3">
      {FAQS.map(faq => (
        <details class="faq-item group bg-surface-raised rounded-xl border border-border overflow-hidden" data-cat={faq.categoria}>
          <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer select-none hover:bg-brand-muted/30 transition-colors">
            <span class="text-sm font-medium text-text-primary">{faq.pregunta}</span>
            <span class="text-text-muted group-open:rotate-180 transition-transform shrink-0">▾</span>
          </summary>
          <div class="px-6 pb-5">
            <p class="text-sm text-text-secondary leading-relaxed">{faq.respuesta}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Empty state -->
    <div id="faq-empty" class="hidden text-center py-12">
      <span class="text-3xl block mb-3">🤷</span>
      <p class="text-text-secondary">No encontramos preguntas que coincidan.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-surface-sunken py-12">
    <div class="max-w-xl mx-auto px-6 text-center">
      <h2 class="text-xl font-bold text-text-primary mb-3">¿No encontraste tu respuesta?</h2>
      <p class="text-text-secondary mb-6">Escríbenos directamente y te ayudamos en menos de 2 horas.</p>
      <a href="/meliponas/contacto" class="inline-flex items-center gap-2 bg-brand text-white rounded-full px-6 py-3 font-medium hover:bg-brand-light transition-all">
        Contactar soporte →
      </a>
    </div>
  </section>
</BrandLayout>

<script>
  const searchInput = document.getElementById('faq-search') as HTMLInputElement;
  const pills = document.querySelectorAll('.cat-pill');
  const items = document.querySelectorAll('.faq-item');
  const emptyState = document.getElementById('faq-empty') as HTMLElement;
  let activeCat = 'todos';

  function filterFaqs() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const cat = el.getAttribute('data-cat') || '';
      const text = el.textContent?.toLowerCase() || '';
      const matchCat = activeCat === 'todos' || cat === activeCat;
      const matchSearch = !query || text.includes(query);
      if (matchCat && matchSearch) {
        el.style.display = '';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });
    emptyState.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', filterFaqs);

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCat = pill.getAttribute('data-cat') || 'todos';
      pills.forEach((p) => {
        p.classList.remove('bg-brand', 'text-white');
        p.classList.add('bg-surface-sunken', 'text-text-secondary');
      });
      pill.classList.add('bg-brand', 'text-white');
      pill.classList.remove('bg-surface-sunken', 'text-text-secondary');
      filterFaqs();
    });
  });

  // URL param support
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get('category');
  if (catParam) {
    const target = document.querySelector(`.cat-pill[data-cat="${catParam}"]`) as HTMLElement;
    target?.click();
  }
</script>
