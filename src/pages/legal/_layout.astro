---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ChatWidget from '@/components/ChatWidget.astro';
import SearchOverlay from '@/components/SearchOverlay.astro';
import UnifiedCart from '@/components/cart/UnifiedCart';
import Icon from '@/components/shared/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** Current active path for sidebar highlighting (e.g. '/legal/terminos-y-condiciones') */
  activePath?: string;
  /** Última fecha de actualización del documento (formato legible) */
  updated?: string;
}

const {
  title,
  description = 'Documentos legales y políticas de la plataforma Iwagé',
  activePath = '',
  updated,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://iwage.co');

const legalLinks = [
  { label: 'Términos y Condiciones', href: '/legal/terminos-y-condiciones', icon: 'scale' },
  { label: 'Tratamiento de Datos', href: '/legal/tratamiento-de-datos', icon: 'shield' },
  { label: 'Política de Cookies', href: '/legal/cookies', icon: 'cookie' },
  { label: 'Devoluciones y Retracto', href: '/legal/devoluciones-y-retracto', icon: 'package-open' },
  { label: 'Cancelaciones y Reembolsos', href: '/legal/cancelaciones-y-reembolsos', icon: 'calendar-x' },
];

function isActive(href: string): boolean {
  return activePath === href || activePath.startsWith(href + '/');
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Legal Iwagé</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} · Legal Iwagé`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Iwagé" />
    <meta name="robots" content="noindex, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('iwage-theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-text-primary font-[Inter,system-ui,sans-serif]">
    <Navbar />

    <main class="flex-1 pt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-text-muted mb-6 font-mono uppercase tracking-wider">
          <a href="/legal/" class="hover:text-brand transition-colors">Legal</a>
          <span>/</span>
          <slot name="breadcrumb" />
        </nav>

        <div class="flex gap-8">
          <!-- Sidebar (desktop) -->
          <aside class="hidden lg:block w-64 shrink-0">
            <div class="sticky top-24 space-y-6">
              <div>
                <h3 class="text-[11px] font-bold uppercase tracking-widest text-accent mb-3 px-3">Documentos legales</h3>
                <ul class="space-y-0.5">
                  {legalLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class={`flex items-center gap-2.5 px-3 py-2 text-sm rounded-lg transition-colors ${
                          isActive(link.href)
                            ? 'bg-brand-muted text-brand font-semibold'
                            : 'text-text-secondary hover:text-brand hover:bg-brand-muted/50'
                        }`}
                      >
                        <Icon name={link.icon} class="w-4 h-4 shrink-0" />
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="px-3 pt-4 border-t border-border">
                <a href="/ayuda/" class="flex items-center gap-2 text-sm text-text-secondary hover:text-brand transition-colors">
                  <Icon name="circle-help" class="w-4 h-4 shrink-0" />
                  Centro de Ayuda
                </a>
                <a href="/meliponas/contacto" class="flex items-center gap-2 text-sm text-text-secondary hover:text-brand transition-colors mt-2.5">
                  <Icon name="mail" class="w-4 h-4 shrink-0" />
                  Contacto
                </a>
              </div>
            </div>
          </aside>

          <!-- Mobile nav -->
          <div class="lg:hidden fixed bottom-4 right-4 z-40">
            <details class="group">
              <summary class="list-none flex items-center gap-2 bg-brand text-white text-sm font-medium px-4 py-2.5 rounded-full shadow-lg cursor-pointer">
                <Icon name="scale" class="w-4 h-4" />
                Documentos
              </summary>
              <div class="absolute bottom-14 right-0 w-72 bg-surface-raised border border-border rounded-xl shadow-xl p-3 space-y-0.5">
                {legalLinks.map((link) => (
                  <a
                    href={link.href}
                    class={`flex items-center gap-2.5 px-3 py-2 text-sm rounded-lg transition-colors ${
                      isActive(link.href)
                        ? 'bg-brand-muted text-brand font-semibold'
                        : 'text-text-secondary hover:text-brand hover:bg-brand-muted/50'
                    }`}
                  >
                    <Icon name={link.icon} class="w-4 h-4 shrink-0" />
                    {link.label}
                  </a>
                ))}
              </div>
            </details>
          </div>

          <!-- Content -->
          <article class="flex-1 min-w-0 max-w-3xl">
            {updated && (
              <p class="text-xs font-mono text-text-muted uppercase tracking-wider mb-4">
                Última actualización: {updated}
              </p>
            )}
            <slot />

            <!-- Footer del documento -->
            <div class="mt-12 pt-8 border-t border-border">
              <div class="bg-surface-raised border border-border rounded-xl p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div>
                  <p class="text-sm font-semibold text-text-primary">¿Tienes preguntas sobre este documento?</p>
                  <p class="text-xs text-text-secondary mt-1">Escríbenos a hola@iwage.co y te responderemos lo antes posible.</p>
                </div>
                <a href="/meliponas/contacto" class="shrink-0 inline-flex items-center gap-2 bg-brand text-white text-sm font-medium px-4 py-2 rounded-full hover:bg-brand-light transition-colors">
                  <Icon name="mail" class="w-4 h-4" />
                  Contactar
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </main>

    <Footer />
    <ChatWidget />
    <SearchOverlay />
    <UnifiedCart client:only="react" />
  </body>
</html>
