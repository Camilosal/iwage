---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import Section from '@/components/Section.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { SELLOS_VAP } from '@/lib/tierras';
export const prerender = true;
---

<BrandLayout brand="tierras" title="Protocolo VAP · Iwagé Tierras" description="Verificación de Activos Rurales: el protocolo de auditoría técnica que verifica títulos, linderos, agua y normativa antes de publicar cualquier propiedad.">

  <section class="bg-[#0F120E] text-white py-14 md:py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-[#52B788] mb-4">Transparencia Radical</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Protocolo <span class="text-[#52B788]">VAP</span></h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        <strong class="text-white">VAP = Verificación de Activos Rurales.</strong> Nuestro protocolo único de auditoría técnica que verifica títulos, linderos, agua y normativa antes de publicar cualquier propiedad.
      </p>
    </div>
  </section>

  <!-- 4 Ejes -->
  <Section class="bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold text-[#1B4332] text-center mb-10">Los 4 Ejes de Auditoría</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { icon: 'search', title: 'Títulos y Propiedad', desc: 'Estudio de títulos de 20 años. Verificamos la cadena de tradición, escrituras públicas, folios de matrícula y ausencia de cargas o gravámenes.', items: ['Escritura pública registrada', 'Folio de Matrícula Inmobiliaria', 'Certificado de Libertad y Tradición', 'Ausencia de embargos/hipotecas'] },
          { icon: 'map', title: 'Topografía y Linderos', desc: 'Georreferenciación GPS con precisión submétrica. El área real en terreno debe coincidir con los registros del IGAC.', items: ['Levantamiento topográfico GPS', 'Coincidencia IGAC vs terreno', 'Linderos físicos identificados', 'Plano georreferenciado'] },
          { icon: 'droplets', title: 'Recurso Hídrico', desc: 'Verificación de concesiones de agua ante Cortolima. Sin agua legal, no hay propiedad productiva.', items: ['Concesión de agua vigente', 'Caudal autorizado (L/s)', 'Servidumbres de paso', 'Fuentes hídricas mapeadas'] },
          { icon: 'clipboard-list', title: 'Normativa & PBOT', desc: 'Compatibilidad del uso del suelo con el Plan Básico de Ordenamiento Territorial del municipio.', items: ['Vocación del suelo PBOT', 'Restricción de fraccionamiento', 'Usos permitidos documentados', 'Restricciones ambientales'] },
        ].map((eje) => (
          <ScrollReveal>
            <div class="bg-[#FAFAF7] rounded-2xl p-6 border border-gray-100">
              <div class="flex items-center gap-3 mb-4">
                <span class="block"><Icon name={eje.icon} class="w-8 h-8 text-[#52B788]" /></span>
                <h3 class="text-lg font-bold text-[#1B4332]">{eje.title}</h3>
              </div>
              <p class="text-sm text-gray-500 mb-4">{eje.desc}</p>
              <ul class="space-y-2">
                {eje.items.map((item) => (
                  <li class="flex items-center gap-2 text-sm text-gray-600">
                    <span class="text-[#52B788]">✓</span> {item}
                  </li>
                ))}
              </ul>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Sellos -->
  <Section class="bg-[#FAFAF7]">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold text-[#1B4332] text-center mb-4">Grados de Certeza</h2>
      <p class="text-gray-500 text-center mb-10 max-w-lg mx-auto text-sm">Cada propiedad recibe un sello según el resultado de la auditoría. Total transparencia: si hay un riesgo, lo ves.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {SELLOS_VAP.map((sello) => (
          <ScrollReveal>
            <div class="bg-white rounded-2xl p-6 border border-gray-100">
              <div class="flex items-center gap-4 mb-3">
                <span class="block"><Icon name={sello.icono} class="w-9 h-9 text-[#C8933E]" /></span>
                <div>
                  <h3 class="font-bold text-[#1B4332]">{sello.label}</h3>
                  <p class="text-xs font-bold uppercase text-[#52B788] tracking-wider">{sello.tagline}</p>
                </div>
              </div>
              <p class="text-sm text-gray-600">{sello.desc}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Interactive Evaluator CTA -->
  <section class="py-14 bg-[#1B4332]">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="block mb-4"><Icon name="pencil" class="w-10 h-10 mx-auto text-[#52B788]" /></span>
      <h2 class="text-2xl font-bold text-white mb-3">Evaluación VAP Interactiva</h2>
      <p class="text-white/60 mb-6 max-w-lg mx-auto text-sm">Recorre las 3 fases del protocolo, marca el checklist de 16 ítems, configura el semáforo de riesgos y obtén el sello calculado automáticamente. 100% en tu navegador.</p>
      <a href="/tierras/herramientas/evaluacion-vap" class="inline-block bg-[#52B788] text-[#0F120E] px-8 py-3.5 rounded-full font-bold text-sm hover:bg-white transition-all shadow-lg">Iniciar Evaluación <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-white">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-[#1B4332] mb-4">Propiedades 100% auditadas</h2>
      <p class="text-gray-500 mb-8">Cada propiedad en nuestro catálogo pasó por el Protocolo VAP. Lo que otras ocultan, nosotros lo transparentamos.</p>
      <a href="/tierras/propiedades" class="inline-block bg-[#52B788] text-[#0F120E] px-10 py-4 rounded-full font-bold text-sm hover:bg-[#52B788]/90 transition-all shadow-lg">Ver Catálogo Auditado <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></a>
    </div>
  </section>
</BrandLayout>
