---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Hero from '@/components/Hero.astro';
import Icon from '@/components/shared/Icon.astro';
import Section from '@/components/Section.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { getPropiedadesDestacadas, getPropiedades, formatPrecio, formatArea, propiedadImagen, PERFILES_COMPRADOR, SELLOS_VAP } from '@/lib/tierras';
import { getHeroBySlug } from '@/lib/heroes';

const hero = await getHeroBySlug('/tierras');

const destacadas = await getPropiedadesDestacadas(6);
const { total: totalPropiedades } = await getPropiedades({ pageSize: 1 });

const CICLO_ECOSISTEMA = [
  {
    icon: 'leaf',
    marca: 'Iwagé Naturaleza',
    titulo: 'Vive la tierra antes de comprarla',
    desc: 'Experiencias guiadas en propiedades del catálogo: recorre, siente y valida el territorio con anfitriones locales.',
    href: '/naturaleza/experiencias',
    color: '#2E7D32',
  },
  {
    icon: 'shield',
    marca: 'Iwagé Tierras',
    titulo: 'Compra con certeza verificada',
    desc: 'Protocolo VAP: títulos, linderos GPS, agua y normativa auditados antes de publicar cada predio.',
    href: '/tierras/protocolo-vap',
    color: '#52B788',
  },
  {
    icon: 'home',
    marca: 'Iwagé Gestión',
    titulo: 'Protege y administra tu inversión',
    desc: 'Renta corta, segunda residencia o finca productiva: operamos tu propiedad mientras no estás.',
    href: '/gestion',
    color: '#1e3a5f',
  },
  {
    icon: 'coffee',
    marca: 'Iwagé Café & Meliponas',
    titulo: 'Hazla productiva',
    desc: 'Proveedores de café especial y polinización con meliponas para activar el potencial agropecuario.',
    href: '/cafe/proveedores',
    color: '#6D4C41',
  },
];

const TICS = [
  { icon: 'satellite', title: 'GPS Precisión', desc: 'Georreferenciación submétrica para linderos exactos' },
  { icon: 'camera', title: 'Foto Drone', desc: 'Imágenes aéreas de alta resolución' },
  { icon: 'refresh-cw', title: 'Tour 360°', desc: 'Recorrido virtual interactivo' },
  { icon: 'ruler', title: 'Modelo 3D', desc: 'Representación digital del terreno' },
];
---

<BrandLayout brand="tierras" title="Iwagé Tierras · Inmobiliaria Rural con Conocimiento Territorial" description="Propiedades rurales con verificación técnica VAP en el Tolima. Fincas productivas, lotes para glamping, casas campestres. Títulos claros, agua certificada, GPS preciso.">

  <!-- Hero -->
  {hero ? (
    <Hero
      titulo={hero.titulo}
      subtitulo={hero.subtitulo}
      imagen={hero.imagen}
      cta_primario_texto={hero.cta_primario_texto}
      cta_primario_url={hero.cta_primario_url}
      cta_secundario_texto={hero.cta_secundario_texto}
      cta_secundario_url={hero.cta_secundario_url}
      label="Inmobiliaria Rural · Tolima, Colombia"
    />
  ) : (
    <section class="relative min-h-[75vh] flex items-center justify-center overflow-hidden bg-dark-bg">
      <img src="/images/hero-tierras.webp" alt="" class="absolute inset-0 w-full h-full object-cover brightness-[0.7]" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-dark-bg"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-brand-light mb-4">Inmobiliaria Rural · Tolima, Colombia</p>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight leading-tight mb-4">Inmobiliaria rural con<br/><span class="text-brand-light italic font-light">conocimiento territorial</span></h1>
      </div>
    </section>
  )}

  <!-- Dual Paths: Comprar / Vender (simplified cards) -->
  <Section class="bg-surface">
    <div class="text-center mb-10">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-brand-light mb-2">Dos caminos, una misma certeza</p>
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary">¿Qué te trae a Iwagé Tierras?</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      <ScrollReveal>
        <a href="/tierras/comprar" class="group block bg-surface-raised rounded-2xl p-8 border border-border hover:border-brand-light/50 hover:shadow-xl transition-all h-full">
          <span class="block mb-4"><Icon name="search" class="w-10 h-10 text-brand-light" /></span>
          <h3 class="text-xl font-bold text-text-primary group-hover:text-brand-light transition-colors mb-3">Quiero comprar tierra</h3>
          <p class="text-sm text-text-secondary mb-5">
            Encuentra fincas, lotes y casas campestres con verificación técnica completa. Sin sorpresas legales, sin linderos fantasma, sin promesas vacías.
          </p>
          <span class="inline-block text-sm font-bold text-brand-light group-hover:translate-x-1 transition-transform">Guía de compra <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></span>
        </a>
      </ScrollReveal>
      <ScrollReveal>
        <a href="/tierras/vender" class="group block bg-dark-bg rounded-2xl p-8 border border-dark-bg hover:shadow-xl transition-all h-full">
          <span class="block mb-4"><Icon name="tag" class="w-10 h-10 text-accent" /></span>
          <h3 class="text-xl font-bold text-dark-text group-hover:text-brand-light transition-colors mb-3">Quiero vender mi tierra</h3>
          <p class="text-sm text-dark-text/70 mb-5">
            Radica tu predio y nosotros lo auditamos, lo producimos audiovisualmente y lo comercializamos ante compradores calificados. Precio justo, cero fricción.
          </p>
          <span class="inline-block text-sm font-bold text-accent group-hover:translate-x-1 transition-transform">Radicar mi predio <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></span>
        </a>
      </ScrollReveal>
    </div>

    <!-- Process diagram: steps for each path -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Compra process -->
        <div>
          <h3 class="flex items-center gap-2 text-lg font-bold text-text-primary mb-5">
            <Icon name="search" class="w-5 h-5 text-brand-light" /> Proceso de compra
          </h3>
          <div class="space-y-4">
            {[
              { icon: 'compass', title: 'Explora el catálogo auditado', desc: 'Propiedades verificadas con GPS, títulos y agua certificada' },
              { icon: 'target', title: 'Define tu uso del predio', desc: 'Productivo, campestre, turístico o patrimonial' },
              { icon: 'calendar', title: 'Agenda visita guiada', desc: 'Recorre el terreno con un anfitrión local' },
              { icon: 'file-check', title: 'Cierra con acompañamiento legal', desc: 'Escritura, registro y timbre gestionados por nosotros' },
            ].map((step, i) => (
              <div class="flex items-start gap-4 bg-surface-raised border border-border rounded-xl p-4">
                <span class="shrink-0 w-8 h-8 rounded-full bg-brand-light/10 text-brand-light text-xs font-bold flex items-center justify-center">{i + 1}</span>
                <div>
                  <h4 class="font-bold text-text-primary text-sm flex items-center gap-2">
                    <Icon name={step.icon} class="w-4 h-4 text-brand-light" /> {step.title}
                  </h4>
                  <p class="text-xs text-text-secondary mt-0.5">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Venta process -->
        <div>
          <h3 class="flex items-center gap-2 text-lg font-bold text-text-primary mb-5">
            <Icon name="tag" class="w-5 h-5 text-accent" /> Proceso de venta
          </h3>
          <div class="space-y-4">
            {[
              { icon: 'upload', title: 'Radicación sin compromiso', desc: 'Sube los datos básicos de tu predio en 5 minutos' },
              { icon: 'shield-check', title: 'Auditoría VAP sin costo', desc: 'Verificamos títulos, linderos, agua y normativa ambiental' },
              { icon: 'camera', title: 'Producción drone + tour 360°', desc: 'Fotografía aérea profesional y recorrido virtual interactivo' },
              { icon: 'handshake', title: 'Venta con acompañamiento total', desc: 'Conectamos con compradores calificados y gestionamos el cierre' },
            ].map((step, i) => (
              <div class="flex items-start gap-4 bg-surface-raised border border-border rounded-xl p-4">
                <span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-bold flex items-center justify-center">{i + 1}</span>
                <div>
                  <h4 class="font-bold text-text-primary text-sm flex items-center gap-2">
                    <Icon name={step.icon} class="w-4 h-4 text-accent" /> {step.title}
                  </h4>
                  <p class="text-xs text-text-secondary mt-0.5">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Featured Properties -->
  {destacadas.length > 0 && (
    <Section class="bg-surface-raised">
      <div class="text-center mb-10">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-brand-light mb-2">Catálogo Auditado</p>
        <h2 class="text-2xl md:text-3xl font-bold text-text-primary">Propiedades Destacadas</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {destacadas.map((prop) => (
          <ScrollReveal>
            <a href={`/tierras/propiedades/${prop.slug}`} class="group block bg-surface-raised rounded-2xl overflow-hidden border border-border hover:border-brand-light/40 hover:shadow-xl transition-all">
              <div class="relative h-52 bg-surface-sunken overflow-hidden">
                {propiedadImagen(prop) ? (
                  <img src={propiedadImagen(prop)!} alt={prop.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-brand/10">
                    <Icon name="mountain" class="w-8 h-8 text-brand/40" />
                  </div>
                )}
                <div class="absolute top-3 left-3 flex gap-2">
                  <span class="bg-brand-light text-dark-bg text-[10px] font-bold px-2 py-1 rounded-full uppercase">{prop.tipo_propiedad.replace('_', ' ')}</span>
                  {prop.sello_vap === 'oro' && <span class="bg-yellow-400 text-black text-[10px] font-bold px-2 py-1 rounded-full inline-flex items-center gap-1"><Icon name="medal" class="w-3 h-3 inline" /> VAP Oro</span>}
                </div>
              </div>
              <div class="p-5">
                <h3 class="font-bold text-text-primary group-hover:text-brand-light transition-colors mb-1">{prop.titulo}</h3>
                <p class="text-xs text-text-secondary mb-3"><Icon name="map-pin" class="w-3 h-3 inline align-[-1px] mr-0.5" />{prop.ubicacion_municipio || 'Tolima'} {prop.distancia_centro_poblado ? `· ${prop.distancia_centro_poblado} km al centro` : ''}</p>
                <div class="flex items-center justify-between">
                  <span class="text-lg font-bold text-text-primary">{formatPrecio(prop.precio, prop.moneda)}</span>
                  <span class="text-xs text-text-secondary">{formatArea(prop)}</span>
                </div>
              </div>
            </a>
          </ScrollReveal>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/tierras/propiedades" class="inline-block bg-brand text-white px-8 py-3 rounded-full font-bold text-sm hover:bg-brand/90 transition-all">
          Ver todo el catálogo <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
        </a>
      </div>
    </Section>
  )}

  <!-- Ecosystem & Sales Cycle -->
  <Section bg="dark" class="text-white">
    <div class="text-center mb-10">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-brand-light mb-2">Ecosistema Iwagé</p>
      <h2 class="text-2xl md:text-3xl font-bold">El ciclo completo de tu <span class="italic font-light text-brand-light">inversión rural</span></h2>
      <p class="text-dark-text/60 mt-3 max-w-2xl mx-auto text-sm">
        Tierras no es una isla: es la puerta de entrada a un ecosistema que te acompaña antes, durante y después de la compra.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
      {CICLO_ECOSISTEMA.map((etapa, i) => (
        <ScrollReveal>
          <a href={etapa.href} class="group relative block bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-light/40 hover:bg-white/10 transition-all h-full">
            <span class="absolute top-4 right-4 text-[10px] font-mono text-white/30">0{i + 1}</span>
            <span class="block mb-3"><Icon name={etapa.icon} class="w-8 h-8" style={`color: ${etapa.color}`} /></span>
            <p class="text-[10px] font-bold uppercase tracking-widest mb-1" style={`color: ${etapa.color === '#52B788' ? 'var(--color-brand-light)' : etapa.color}`}>{etapa.marca}</p>
            <h3 class="font-bold text-white group-hover:text-brand-light transition-colors mb-2">{etapa.titulo}</h3>
            <p class="text-xs text-dark-text/50">{etapa.desc}</p>
          </a>
        </ScrollReveal>
      ))}
    </div>
    <!-- TICs inside ecosystem -->
    <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="md:w-1/3">
          <p class="text-[10px] font-bold uppercase tracking-widest text-brand-light mb-1">Tecnología Iwagé</p>
          <h3 class="text-lg font-bold">TICs al servicio de cada venta</h3>
          <p class="text-xs text-dark-text/50 mt-2">Cada predio del catálogo se documenta con tecnología de precisión para que compres o vendas con información real.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:w-2/3">
          {TICS.map((tic) => (
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <span class="block mb-2"><Icon name={tic.icon} class="w-6 h-6 text-brand-light" /></span>
              <h4 class="font-bold text-white text-sm mb-1">{tic.title}</h4>
              <p class="text-[11px] text-dark-text/50">{tic.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- VAP Compact Strip -->
  <Section class="bg-surface-raised">
    <div class="flex flex-col lg:flex-row items-center gap-8">
      <div class="lg:w-1/3">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-brand-light mb-2">Niveles de certeza</p>
        <h2 class="text-2xl font-bold text-text-primary mb-3">Grados de Certeza <span class="italic font-light text-brand-light">VAP</span></h2>
        <p class="text-sm text-text-secondary mb-5">
          <strong>VAP = Verificación de Activos Rurales.</strong> Cada propiedad recibe un sello según su auditoría: títulos, linderos, agua y normativa.
        </p>
        <a href="/tierras/protocolo-vap" class="inline-block bg-brand text-white px-6 py-3 rounded-full font-bold text-sm hover:bg-brand/90 transition-all">
          Conocer el protocolo <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:w-2/3">
        {SELLOS_VAP.map((sello) => (
          <ScrollReveal>
            <div class="text-center p-5 rounded-2xl border border-border hover:border-brand-light/40 hover:shadow-lg transition-all">
              <span class="block mb-2"><Icon name={sello.icono} class="w-9 h-9 mx-auto text-accent" /></span>
              <h3 class="font-bold text-text-primary text-sm">{sello.label}</h3>
              <p class="text-[10px] font-bold uppercase text-brand-light tracking-wider mt-1">{sello.tagline}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Seller Band -->
  <section class="py-16" style="background: linear-gradient(135deg, #2c1a05 0%, #1a1003 100%)">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="lg:w-1/2">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent mb-3">Para propietarios</p>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Vendemos tu tierra al <span class="italic font-light text-accent">precio que merece</span></h2>
          <p class="text-dark-text/60 text-sm mb-6">
            El campo colombiano sufre de asimetría de información: el propietario no sabe cuánto vale su tierra y el comprador no confía. Iwagé elimina esa brecha.
          </p>
          <a href="/tierras/vender" class="inline-block bg-accent text-white px-8 py-4 rounded-full font-bold text-sm hover:bg-accent/90 transition-all shadow-lg">
            Radicar mi Predio <Icon name="arrow-right" class="w-3.5 h-3.5 inline" />
          </a>
        </div>
        <div class="lg:w-1/2 space-y-4">
          {[
            { icon: 'shield', title: 'Auditoría VAP sin costo', desc: 'Verificamos títulos, linderos, agua y normativa. Tu predio sale al mercado con sello de certeza.' },
            { icon: 'clapperboard', title: 'Producción audiovisual profesional', desc: 'Fotografía con drone, tour 360° y ficha técnica. Tu propiedad se ve como merece.' },
            { icon: 'target', title: 'Difusión segmentada', desc: 'Conectamos tu predio con el perfil de comprador correcto: productivo, campestre, nómada, turístico o patrimonial.' },
          ].map((item) => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="shrink-0"><Icon name={item.icon} class="w-6 h-6 text-accent" /></span>
              <div>
                <h4 class="font-bold text-white text-sm mb-1">{item.title}</h4>
                <p class="text-xs text-dark-text/50">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Land Use (Buyer Profiles) -->
  <Section class="bg-surface">
    <div class="text-center mb-10">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-brand-light mb-2">¿Para qué buscas tu tierra?</p>
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary">Usos del Predio</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PERFILES_COMPRADOR.map((perfil) => (
        <ScrollReveal>
          <a href={`/tierras/perfiles/${perfil.id}`} class="group block bg-surface-raised border border-border rounded-2xl p-6 hover:border-brand-light/40 hover:shadow-lg transition-all">
            <p class="text-[10px] font-bold tracking-[0.3em] text-brand-light uppercase mb-2">{perfil.tag}</p>
            <h3 class="text-xl font-bold text-text-primary mb-2 group-hover:text-brand-light transition-colors">{perfil.label}</h3>
            <p class="text-sm text-text-secondary mb-4">{perfil.subheadline.slice(0, 120)}...</p>
            <div class="flex gap-4">
              {perfil.metrics.map((m) => (
                <div class="text-center">
                  <p class="text-lg font-bold text-brand-light">{m.val}</p>
                  <p class="text-[10px] text-text-muted">{m.lbl}</p>
                </div>
              ))}
            </div>
          </a>
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Tools CTA -->
  <Section class="bg-surface-raised">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <a href="/tierras/herramientas/calculadora-notarial" class="bg-surface p-6 rounded-2xl border border-border hover:border-brand-light/40 hover:shadow-lg transition-all flex items-center gap-5">
        <div class="w-14 h-14 bg-brand-light/10 rounded-xl flex items-center justify-center shrink-0">
          <Icon name="calculator" class="w-5 h-5 text-brand-light" />
        </div>
        <div>
          <h4 class="font-bold text-text-primary">Calculadora Notarial</h4>
          <p class="text-sm text-text-secondary">Estima gastos de escritura, registro y timbre antes de comprar.</p>
        </div>
      </a>
      <a href="/tierras/herramientas/roi-calculator" class="bg-surface p-6 rounded-2xl border border-border hover:border-brand-light/40 hover:shadow-lg transition-all flex items-center gap-5">
        <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center shrink-0">
          <span class="block"><Icon name="trending-up" class="w-6 h-6 text-accent" /></span>
        </div>
        <div>
          <h4 class="font-bold text-text-primary">Calculadora ROI Rural</h4>
          <p class="text-sm text-text-secondary">Compara retorno de inversión: turismo, agricultura, ganadería, valorización.</p>
        </div>
      </a>
    </div>
  </Section>

  <!-- Final CTA -->
  <section class="py-16 bg-surface">
    <div class="max-w-3xl mx-auto px-6">
      <div class="rounded-2xl p-10 md:p-14 text-center" style="background: linear-gradient(135deg, #1B4332 0%, #0F120E 100%)">
        <Icon name="shield" class="w-8 h-8 block mb-4 mx-auto text-brand-light" />
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Tu próxima inversión rural merece certeza</h2>
        <p class="text-white/70 mb-8">No invertas en lo oscuro. Explora propiedades auditadas o radica la tuya para vender con transparencia.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/tierras/propiedades" class="bg-brand-light text-dark-bg px-10 py-4 rounded-full font-bold uppercase text-sm hover:bg-brand-light/90 transition-all shadow-lg">Ver Catálogo Auditado</a>
          <a href="/tierras/vender" class="bg-accent text-white px-10 py-4 rounded-full font-bold uppercase text-sm hover:bg-accent/90 transition-all shadow-lg">Radicar mi Predio</a>
        </div>
      </div>
    </div>
  </section>
</BrandLayout>
