---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Icon from '@/components/shared/Icon.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import FilterSidebar from '@/components/tierras/FilterSidebar.astro';
import PropertyCard from '@/components/tierras/PropertyCard.astro';
import PropertiesMap from '@/components/tierras/PropertiesMap.astro';
import SearchAgent from '@/components/tierras/SearchAgent.astro';
import { getPropiedades } from '@/lib/tierras';

const url = new URL(Astro.request.url);
const tipo = url.searchParams.get('tipo') || '';
const operacion = url.searchParams.get('operacion') || '';
const perfil = url.searchParams.get('perfil') || '';
const municipio = url.searchParams.get('municipio') || '';
const precioMin = url.searchParams.get('precioMin') || '';
const precioMax = url.searchParams.get('precioMax') || '';
const areaMin = url.searchParams.get('areaMin') || '';
const page = parseInt(url.searchParams.get('page') || '1', 10);

const { data: propiedades, total, pageSize } = await getPropiedades({
  tipo: tipo || undefined,
  operacion: operacion || undefined,
  perfil: perfil || undefined,
  municipio: municipio || undefined,
  precioMin: precioMin ? Number(precioMin) : undefined,
  precioMax: precioMax ? Number(precioMax) : undefined,
  areaMin: areaMin ? Number(areaMin) : undefined,
  page,
  pageSize: 12,
});

const totalPages = Math.ceil(total / pageSize);

// Build query string helper for pagination
const qs = new URLSearchParams();
if (tipo) qs.set('tipo', tipo);
if (operacion) qs.set('operacion', operacion);
if (perfil) qs.set('perfil', perfil);
if (municipio) qs.set('municipio', municipio);
if (precioMin) qs.set('precioMin', precioMin);
if (precioMax) qs.set('precioMax', precioMax);
if (areaMin) qs.set('areaMin', areaMin);
const baseQs = qs.toString();
---

<BrandLayout brand="tierras" title="Propiedades Rurales · Iwagé Tierras" description="Catálogo de propiedades rurales auditadas en el Tolima. Fincas, lotes, casas campestres con verificación VAP.">

  <!-- Header + Search (single frame) -->
  <section class="bg-[#0F120E] text-white py-10 pb-12">
    <div class="max-w-7xl mx-auto px-6">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-[#52B788] mb-2">Catálogo Auditado</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-1">Propiedades Rurales</h1>
      <p class="text-white/60 text-sm mb-6">{total} propiedades verificadas con Protocolo VAP</p>
      <div class="max-w-3xl">
        <SearchAgent />
      </div>
    </div>
  </section>

  <!-- Main content: Sidebar + Results -->
  <section class="bg-[#FAFAF7] pt-8 pb-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="lg:flex lg:gap-8 items-start">

        <!-- Unified FilterSidebar (desktop: sticky sidebar, mobile: drawer) -->
        <FilterSidebar
          currentTipo={tipo}
          currentOperacion={operacion}
          currentPerfil={perfil}
          currentMunicipio={municipio}
          currentPrecioMin={precioMin}
          currentPrecioMax={precioMax}
          currentAreaMin={areaMin}
        />

        <!-- Results column -->
        <div class="flex-1 min-w-0">
          <!-- Toolbar -->
          <div class="flex items-center justify-between mb-6">
            <p class="text-sm text-gray-500">{total} propiedades encontradas</p>
            <div class="flex gap-2">
              <button id="btn-grid" class="view-toggle px-3 py-1.5 rounded-lg text-xs font-bold bg-[#1B4332] text-white"><Icon name="layout-grid" class="w-3.5 h-3.5 inline align-[-2px] mr-1" />Lista</button>
              <button id="btn-map" class="view-toggle px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-gray-600 border border-gray-200 hover:border-[#52B788]"><Icon name="map" class="w-3.5 h-3.5 inline align-[-2px] mr-1" />Mapa</button>
            </div>
          </div>

          <!-- Map View (hidden by default) -->
          <div id="map-view" class="hidden mb-8">
            <PropertiesMap properties={propiedades} />
          </div>

          {propiedades.length === 0 ? (
            <div class="text-center py-14">
              <Icon name="mountain" class="w-10 h-10 block mb-4 mx-auto text-[#52B788]" />
              <h3 class="text-xl font-bold text-[#1B4332] mb-2">No hay propiedades con estos filtros</h3>
              <p class="text-gray-500 mb-6">Prueba ampliar la búsqueda o contáctanos para una búsqueda personalizada.</p>
              <a href="/tierras/propiedades" class="text-[#52B788] font-bold hover:underline">Ver todas las propiedades <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></a>
            </div>
          ) : (
            <div id="grid-view" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {propiedades.map((prop) => (
                <ScrollReveal>
                  <PropertyCard prop={prop} />
                </ScrollReveal>
              ))}
            </div>
          )}

          <!-- Pagination -->
          {totalPages > 1 && (
            <div class="flex items-center justify-center gap-2 mt-10">
              {page > 1 && (
                <a href={`/tierras/propiedades?page=${page - 1}${baseQs ? `&${baseQs}` : ''}`}
                  class="px-4 py-2 rounded-lg border border-gray-200 text-sm hover:border-[#52B788] transition-colors">← Anterior</a>
              )}
              <span class="text-sm text-gray-500 px-4">Página {page} de {totalPages}</span>
              {page < totalPages && (
                  <a href={`/tierras/propiedades?page=${page + 1}${baseQs ? `&${baseQs}` : ''}`}
                    class="px-4 py-2 rounded-lg border border-gray-200 text-sm hover:border-[#52B788] transition-colors">Siguiente <Icon name="arrow-right" class="w-3.5 h-3.5 inline" /></a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnGrid = document.getElementById('btn-grid');
    const btnMap = document.getElementById('btn-map');
    const gridView = document.getElementById('grid-view');
    const mapView = document.getElementById('map-view');
    if (!btnGrid || !btnMap) return;

    btnMap.addEventListener('click', () => {
      mapView?.classList.remove('hidden');
      gridView?.classList.add('hidden');
      btnMap.classList.add('bg-[#1B4332]', 'text-white');
      btnMap.classList.remove('bg-white', 'text-gray-600');
      btnGrid.classList.remove('bg-[#1B4332]', 'text-white');
      btnGrid.classList.add('bg-white', 'text-gray-600');
      // Fix Leaflet rendering after container becomes visible
      setTimeout(() => (window as any).__leafletMap?.invalidateSize(), 100);
    });

    btnGrid.addEventListener('click', () => {
      gridView?.classList.remove('hidden');
      mapView?.classList.add('hidden');
      btnGrid.classList.add('bg-[#1B4332]', 'text-white');
      btnGrid.classList.remove('bg-white', 'text-gray-600');
      btnMap.classList.remove('bg-[#1B4332]', 'text-white');
      btnMap.classList.add('bg-white', 'text-gray-600');
    });
  });
</script>
</BrandLayout>
