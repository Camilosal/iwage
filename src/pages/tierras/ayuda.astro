---
export const prerender = true;
import BrandLayout from '@/layouts/BrandLayout.astro';

const CATEGORIES = [{"id": "todos", "label": "Todos", "icon": "📋"}, {"id": "vap", "label": "Protocolo VAP", "icon": "🛡️"}, {"id": "compra", "label": "Compra", "icon": "🏡"}, {"id": "venta", "label": "Venta", "icon": "💰"}, {"id": "legal", "label": "Legal", "icon": "⚖️"}];

const FAQS = [{"pregunta": "¿Qué es el Protocolo VAP?", "respuesta": "El VAP (Verificación de Autenticidad Predial) es nuestro sistema propietario de auditoría que evalúa la seguridad jurídica, ambiental y productiva de cada predio. Consta de 5 fases: documentación, inspección física, análisis jurídico, evaluación ambiental y dictamen final.", "categoria": "vap"}, {"pregunta": "¿Qué significan los sellos Oro, Plata y Bronce?", "respuesta": "Oro: predio con 100% de cumplimiento en las 5 fases. Plata: cumplimiento entre 80-99% con observaciones menores. Bronce: cumplimiento entre 60-79% con condiciones específicas a resolver.", "categoria": "vap"}, {"pregunta": "¿Cuánto cuesta la verificación VAP?", "respuesta": "La verificación VAP no tiene costo para el comprador. El vendedor asume un costo que se descuenta de la comisión de venta. Si el predio no pasa, no se publica.", "categoria": "vap"}, {"pregunta": "¿Cuánto tarda el proceso VAP?", "respuesta": "El proceso completo toma entre 15 y 30 días hábiles dependiendo de la complejidad del predio y la disponibilidad de documentos.", "categoria": "vap"}, {"pregunta": "¿Cómo busco propiedades disponibles?", "respuesta": "Explora el catálogo en /tierras/propiedades con filtros por municipio, área, uso y rango de precio. Cada propiedad incluye ficha técnica completa, fotografías y resultado VAP.", "categoria": "compra"}, {"pregunta": "¿Puedo visitar un predio antes de comprar?", "respuesta": "Sí. Coordinamos visitas acompañadas con nuestro equipo territorial. La visita incluye recorrido por linderos, presentación del informe VAP y contexto del vecindario rural.", "categoria": "compra"}, {"pregunta": "¿Iwagé financia compras?", "respuesta": "No somos entidad financiera, pero asesoramos en estructuración de créditos rurales con aliados (Banco Agrario, Finagro) y facilitamos acuerdos de pago directo con vendedores cuando aplica.", "categoria": "compra"}, {"pregunta": "¿Cómo publico mi propiedad en Iwagé?", "respuesta": "Contáctanos por WhatsApp o el formulario de Vender. Nuestro equipo agenda una visita, inicia el proceso VAP y si el predio aprueba, se publica con fotografía profesional y narrativa personalizada.", "categoria": "venta"}, {"pregunta": "¿Cuánto cobra Iwagé por vender mi propiedad?", "respuesta": "La comisión estándar es del 3-5% sobre el valor de venta, significativamente menor al mercado tradicional (6-10%). Incluye: verificación VAP, fotografía profesional, marketing digital, acompañamiento notarial y cierre.", "categoria": "venta"}, {"pregunta": "¿Qué documentos necesito para vender?", "respuesta": "Certificado de tradición y libertad (vigencia < 30 días), escritura pública, paz y salvo predial, cédula del propietario, y si aplica: licencia ambiental, concepto de uso de suelo y RUT.", "categoria": "venta"}, {"pregunta": "¿Cómo sé si un predio tiene problemas jurídicos?", "respuesta": "El Protocolo VAP incluye un estudio de títulos completo: verificación de tradición, gravámenes, embargos, litigios y afectaciones. Publicamos el resultado con total transparencia.", "categoria": "legal"}, {"pregunta": "¿Qué es el acompañamiento notarial?", "respuesta": "Te acompañamos en todo el proceso de escrituración: revisión de minuta, coordinación con notaría, verificación de paz y salvos, y registro de la escritura en la Oficina de Instrumentos Públicos.", "categoria": "legal"}];
---

<BrandLayout brand="tierras" title="Centro de Ayuda · Iwagé Tierras" description="Preguntas frecuentes y soporte de Iwagé Tierras. Encuentra respuestas rápidas.">
  <!-- Hero -->
  <section class="bg-surface pt-12 pb-8">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="text-4xl block mb-4">🌄</span>
      <h1 class="text-3xl md:text-4xl font-serif text-text-primary mb-3">Centro de Ayuda</h1>
      <p class="text-text-secondary max-w-lg mx-auto mb-8">Resuelve tus dudas sobre compra, venta y verificación de propiedades rurales.</p>
      <!-- Search -->
      <div class="max-w-md mx-auto relative">
        <input
          type="search"
          id="faq-search"
          placeholder="Buscar pregunta..."
          class="w-full rounded-full border border-border bg-surface-raised px-5 py-3 pl-11 text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand"
        />
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-sm">🔍</span>
      </div>
    </div>
  </section>

  <!-- Category filter -->
  <div class="max-w-4xl mx-auto px-6 mb-8">
    <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2 justify-center flex-wrap">
      {CATEGORIES.map((cat, i) => (
        <button
          type="button"
          class={`cat-pill rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap transition-all ${i === 0 ? 'bg-brand text-white' : 'bg-surface-sunken text-text-secondary hover:bg-brand-muted hover:text-brand'}`}
          data-cat={cat.id}
        >
          {cat.icon} {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- FAQ List -->
  <section class="max-w-3xl mx-auto px-6 pb-20">
    <div id="faq-list" class="space-y-3">
      {FAQS.map(faq => (
        <details class="faq-item group bg-surface-raised rounded-xl border border-border overflow-hidden" data-cat={faq.categoria}>
          <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer select-none hover:bg-brand-muted/30 transition-colors">
            <span class="text-sm font-medium text-text-primary">{faq.pregunta}</span>
            <span class="text-text-muted group-open:rotate-180 transition-transform shrink-0">▾</span>
          </summary>
          <div class="px-6 pb-5">
            <p class="text-sm text-text-secondary leading-relaxed">{faq.respuesta}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Empty state -->
    <div id="faq-empty" class="hidden text-center py-12">
      <span class="text-3xl block mb-3">🤷</span>
      <p class="text-text-secondary">No encontramos preguntas que coincidan.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-surface-sunken py-12">
    <div class="max-w-xl mx-auto px-6 text-center">
      <h2 class="text-xl font-bold text-text-primary mb-3">¿No encontraste tu respuesta?</h2>
      <p class="text-text-secondary mb-6">Escríbenos directamente y te ayudamos en menos de 2 horas.</p>
      <a href="/tierras/contacto" class="inline-flex items-center gap-2 bg-brand text-white rounded-full px-6 py-3 font-medium hover:bg-brand-light transition-all">
        Contactar soporte →
      </a>
    </div>
  </section>
</BrandLayout>

<script>
  const searchInput = document.getElementById('faq-search') as HTMLInputElement;
  const pills = document.querySelectorAll('.cat-pill');
  const items = document.querySelectorAll('.faq-item');
  const emptyState = document.getElementById('faq-empty') as HTMLElement;
  let activeCat = 'todos';

  function filterFaqs() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const cat = el.getAttribute('data-cat') || '';
      const text = el.textContent?.toLowerCase() || '';
      const matchCat = activeCat === 'todos' || cat === activeCat;
      const matchSearch = !query || text.includes(query);
      if (matchCat && matchSearch) {
        el.style.display = '';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });
    emptyState.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', filterFaqs);

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCat = pill.getAttribute('data-cat') || 'todos';
      pills.forEach((p) => {
        p.classList.remove('bg-brand', 'text-white');
        p.classList.add('bg-surface-sunken', 'text-text-secondary');
      });
      pill.classList.add('bg-brand', 'text-white');
      pill.classList.remove('bg-surface-sunken', 'text-text-secondary');
      filterFaqs();
    });
  });

  // URL param support
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get('category');
  if (catParam) {
    const target = document.querySelector(`.cat-pill[data-cat="${catParam}"]`) as HTMLElement;
    target?.click();
  }
</script>
