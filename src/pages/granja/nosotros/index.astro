---
import BrandLayout from '@/layouts/BrandLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Icon from '@/components/shared/Icon.astro';

const valores = [
  { icon: 'recycle', title: 'Ciclos cerrados', desc: 'Nada que sale del sistema se considera basura.' },
  { icon: 'bar-chart-3', title: 'Datos, no discurso', desc: 'Cada decisión se mide con sensores y se documenta.' },
  { icon: 'book-open', title: 'Conocimiento abierto', desc: 'La bitácora publica los aciertos y los errores.' },
  { icon: 'map-pin', title: 'Territorio', desc: 'Un modelo peri-urbano pensado para el corredor Ambalá.' },
];

const timeline = [
  { year: '2021', event: 'La primera colmena de abejas nativas llega al predio: nace el ecosistema Iwagé.' },
  { year: '2023', event: 'Se define el mapa del sistema autosustentable: agua, energía, alimento y datos.' },
  { year: '2024', event: 'Sistema solar off-grid y gestión hídrica de ciclo cerrado en operación.' },
  { year: '2025', event: 'Gemelo digital con Home Assistant y ESP32; la bitácora se publica en abierto.' },
  { year: '2026', event: 'Tienda de la granja y visitas guiadas: el sistema abre sus puertas.' },
];
---

<BrandLayout
  brand="granja"
  title="Quiénes somos · Iwagé Granja Autosustentable"
  description="La historia de la granja autosustentable Iwagé: un sistema peri-urbano en construcción en el corredor Ambalá, Ibagué, documentado en abierto por Camilo Saldarriaga."
>
  <!-- Hero -->
  <section class="bg-surface">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Nosotros</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-tight mb-6">
        Una vida diseñada<br />como un sistema
      </h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl mx-auto">
        La granja autosustentable Iwagé no es una finca de fin de semana: es el proyecto de construir, medir y documentar un modo de vida autosuficiente en el borde peri-urbano de Ibagué.
      </p>
    </div>
  </section>

  <!-- Story -->
  <Section bg="sunken">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <ScrollReveal>
        <SectionHeader label="Historia" title="Cómo empezó" />
        <div class="space-y-4 text-text-secondary leading-relaxed">
          <p>
            Todo comenzó con una pregunta simple: ¿es posible que un predio peri-urbano produzca su propia agua, energía y alimento sin depender de las redes? En lugar de teorizar, decidimos construirlo.
          </p>
          <p>
            Subsistema por subsistema — hídrico, solar, bio-refinería, agroecosistema, gemelo digital — la granja se fue convirtiendo en un laboratorio vivo. Cada avance, cada error y cada dato se publica en la bitácora para que otros puedan replicar el modelo.
          </p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={200}>
        <div class="bg-brand-muted rounded-2xl p-8">
          <p class="font-mono text-xs uppercase tracking-widest text-brand mb-4">El principio</p>
          <p class="text-2xl font-bold text-text-primary mb-2">Sistema, no colección</p>
          <p class="text-text-secondary">La granja no es una suma de tecnologías: es un organismo donde el agua alimenta la huerta, la huerta al compost, el compost al suelo y los datos a todas las decisiones.</p>
        </div>
      </ScrollReveal>
    </div>
  </Section>

  <!-- Conexión personal -->
  <Section>
    <div class="max-w-3xl mx-auto">
      <ScrollReveal>
        <div class="prose prose-lg text-text-secondary leading-relaxed space-y-5">
          <p>
            Esta granja es mi proyecto de vida. No la construyo para venderla ni para mostrarla en redes:
            la construyo para habitarla, y la documento porque creo que la autosuficiencia deja de ser
            utopía cuando alguien publica los números reales. Cada sensor, cada cosecha y cada factura
            hacen parte de la misma historia.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </Section>

  <!-- Ecosistema Iwagé -->
  <Section bg="sunken">
    <div class="max-w-3xl mx-auto">
      <ScrollReveal>
        <div class="bg-surface-raised rounded-2xl border border-border p-8">
          <p class="font-mono text-xs uppercase tracking-widest text-accent mb-4">Ecosistema Iwagé</p>
          <p class="text-text-secondary leading-relaxed">
            Este proyecto es parte del <strong class="text-text-primary">Ecosistema Iwagé</strong>, una iniciativa
            liderada por Manuel Camilo Saldarriaga Acosta como materialización del Eje 3 — El Propósito
            y el Hobby de su filosofía de los Tres Ejes. Conoce más sobre esta visión en
            <a href="https://camilosaldarriaga.com" target="_blank" rel="noopener" class="text-brand underline hover:text-brand-light transition-colors">camilosaldarriaga.com</a>.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </Section>

  <!-- Values -->
  <Section>
    <ScrollReveal>
      <SectionHeader label="Valores" title="Lo que nos guía" align="center" />
    </ScrollReveal>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {valores.map((v, i) => (
        <ScrollReveal delay={i * 80}>
          <div class="bg-surface-raised rounded-2xl border border-border p-6 shadow-sm text-center h-full">
            <div class="w-12 h-12 rounded-xl bg-brand-muted flex items-center justify-center text-brand mx-auto mb-4">
              <Icon name={v.icon} class="w-6 h-6" />
            </div>
            <h3 class="text-base font-semibold text-text-primary mb-2">{v.title}</h3>
            <p class="text-sm text-text-secondary">{v.desc}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </Section>

  <!-- Timeline -->
  <Section bg="sunken">
    <div class="max-w-2xl mx-auto">
      <ScrollReveal>
        <SectionHeader label="Trayectoria" title="El camino del sistema" />
        <div class="relative">
          <div class="absolute left-2 top-0 bottom-0 w-px bg-border"></div>
          <div class="space-y-8">
            {timeline.map((t) => (
              <div class="relative flex gap-6">
                <div class="relative z-10 w-4 h-4 rounded-full bg-brand border-4 border-surface-sunken shrink-0 mt-1"></div>
                <div>
                  <p class="font-mono text-sm text-accent font-medium">{t.year}</p>
                  <p class="text-sm text-text-secondary">{t.event}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>
    </div>
  </Section>

  <!-- Enlaces cruzados del ecosistema -->
  <Section class="!py-12">
    <div class="max-w-4xl mx-auto">
      <ScrollReveal>
        <p class="font-mono text-xs uppercase tracking-widest text-accent mb-6 text-center">Explora el ecosistema Iwagé</p>
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
          <a href="/meliponas/nosotros" class="group flex flex-col items-center gap-2 p-4 rounded-xl border border-border hover:border-accent hover:bg-surface-raised transition-all text-center">
            <span class="text-2xl">🐝</span>
            <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">Meliponario</span>
            <span class="text-xs text-text-muted">Abejas nativas</span>
          </a>
          <a href="/cafe/nosotros" class="group flex flex-col items-center gap-2 p-4 rounded-xl border border-border hover:border-accent hover:bg-surface-raised transition-all text-center">
            <span class="text-2xl">☕</span>
            <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">Café</span>
            <span class="text-xs text-text-muted">Café de especialidad</span>
          </a>
          <a href="/tierras/nosotros" class="group flex flex-col items-center gap-2 p-4 rounded-xl border border-border hover:border-accent hover:bg-surface-raised transition-all text-center">
            <span class="text-2xl">🌱</span>
            <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">Tierras</span>
            <span class="text-xs text-text-muted">Inmobiliaria rural</span>
          </a>
          <a href="/naturaleza/nosotros" class="group flex flex-col items-center gap-2 p-4 rounded-xl border border-border hover:border-accent hover:bg-surface-raised transition-all text-center">
            <span class="text-2xl">🌿</span>
            <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">Naturaleza</span>
            <span class="text-xs text-text-muted">Turismo regenerativo</span>
          </a>
          <a href="/gestion/nosotros" class="group flex flex-col items-center gap-2 p-4 rounded-xl border border-border hover:border-accent hover:bg-surface-raised transition-all text-center">
            <span class="text-2xl">🏡</span>
            <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">Gestión</span>
            <span class="text-xs text-text-muted">Gestión de propiedades</span>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </Section>
</BrandLayout>
