---
import BrandLayout from '@/layouts/BrandLayout.astro';
import { getBitacoraBySlug, formatFecha } from '@/lib/bitacora';
import { rutaDeLaMarcaDelArticulo } from '@/lib/bitacora-ruta';
import { renderMarkdown } from '@/lib/render-markdown';
import { obtenerRegistroDeEnlaces } from '@/lib/enlaces-registro';
import Icon from '@/components/shared/Icon.astro';
import { BITACORA_MARCAS } from '@/config/bitacora-marcas';

const MARCA = BITACORA_MARCAS['granja'];
const BRAND = MARCA.slug;
const BRAND_NAME = MARCA.nombre;
const AUTHOR = MARCA.autor;
const LOCATION = MARCA.lugar;

const { slug } = Astro.params;
const article = await getBitacoraBySlug(slug!);

if (!article) {
  return Astro.redirect('/granja/experimentos');
}

// El slug puede pertenecer a otra marca: `getBitacoraBySlug` no filtra, y servirlo acá
// canonicaría 6 URLs distintas para un mismo documento con la Organización equivocada.
const rutaAjena = rutaDeLaMarcaDelArticulo({ marcaRuta: BRAND, marcaArticulo: article.marca, slug: slug! });
if (rutaAjena) return Astro.redirect(rutaAjena, 301);

// Render content with full markdown support
const htmlContent = article.contenido ? renderMarkdown(article.contenido, { registro: await obtenerRegistroDeEnlaces(), marca: BRAND }) : '';

// Word count for reading metadata
const wordCount = article.contenido ? article.contenido.split(/\s+/).length : 0;

// Article metadata for structured data (JSON-LD) and OG tags
const articleMeta = {
  title: article.titulo,
  description: article.extracto || article.titulo,
  datePublished: article.fecha || new Date().toISOString().split('T')[0],
  dateModified: article.fecha_actualizacion || article.updatedAt || article.fecha,
  author: article.autor || AUTHOR,
  authorPlace: MARCA.lugar,
  // sin etiquetas en el borrador, la sección y la marca sostienen las keywords
  keywords: [...new Set([...(article.etiquetas ?? []), ...(article.categoria ? [article.categoria] : []), BRAND_NAME])].slice(0, 8),
  image: article.imagen?.url ?? undefined,
  section: article.categoria || 'Bitácora',
  wordCount,
};
---

<BrandLayout brand={BRAND} title={`${article.meta_title || article.titulo} · ${BRAND_NAME}`} description={article.meta_description || article.extracto || article.titulo} ogType="article" article={articleMeta} ogImage={article.imagen?.url ?? undefined}>
  <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-text-muted flex-wrap">
      <a href="/granja/" class="hover:text-brand transition-colors">Inicio</a>
      <span>/</span>
      <a href="/granja/experimentos" class="hover:text-brand transition-colors">Experimentos</a>
      <span>/</span>
      <span class="text-text-secondary truncate max-w-[200px]">{article.titulo}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <span class="inline-flex items-center gap-1.5 bg-brand-muted text-brand text-xs font-semibold rounded-full px-3 py-1">
          <Icon name="file-text" class="w-3.5 h-3.5" /> Documentación
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary leading-tight mb-5">
        {article.titulo}
      </h1>
      {article.extracto && (
        <p class="text-lg text-text-secondary leading-relaxed mb-6">{article.extracto}</p>
      )}
      <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted pb-6 border-b border-border">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-brand-muted flex items-center justify-center">
            <Icon name="sprout" class="w-4 h-4 text-brand" />
          </div>
          <span class="font-medium text-text-secondary">{AUTHOR}</span>
        </div>
        <span class="w-1 h-1 rounded-full bg-text-muted"></span>
        <time>{formatFecha(article.fecha)}</time>
        {article.tiempo_lectura && (
          <>
            <span class="w-1 h-1 rounded-full bg-text-muted"></span>
            <span>{article.tiempo_lectura} min lectura</span>
          </>
        )}
        <span class="w-1 h-1 rounded-full bg-text-muted"></span>
        <span>{wordCount.toLocaleString('es-CO')} palabras</span>
      </div>
    </header>

    <!-- Content -->
    <div class="article-body prose prose-sm md:prose-base max-w-none" set:html={htmlContent} />

    <!-- Back to experiments -->
    <div class="mt-12 pt-6 border-t border-border">
      <a href="/granja/experimentos" class="inline-flex items-center gap-2 text-brand hover:text-brand/80 font-medium transition-colors">
        <Icon name="arrow-left" class="w-4 h-4" />
        Volver a experimentos
      </a>
    </div>
  </article>

  <!-- Cierre: llevar el lector de la bitácora a una acción -->
  <section class="bg-dark-bg py-14">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-dark-text">Esto no es un plan en un cajón</h2>
      <p class="mt-3 text-dark-text/60">
        Lo que esta bitácora documenta está de pie en el predio. Venga a verlo, o llévese lo que ya produce.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/granja/visitas" class="inline-flex items-center gap-2 bg-accent text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-accent-light transition-all">
          <Icon name="calendar-check" class="w-4 h-4" /> Agendar visita
        </a>
        <a href="/granja/tienda" class="inline-flex items-center gap-2 border border-dark-text/20 text-dark-text rounded-full px-6 py-3 text-sm font-medium hover:border-accent hover:text-accent transition-all">
          <Icon name="shopping-bag" class="w-4 h-4" /> Ver la tienda
        </a>
        <a href="/granja/servicios" class="inline-flex items-center gap-2 border border-dark-text/20 text-dark-text rounded-full px-6 py-3 text-sm font-medium hover:border-accent hover:text-accent transition-all">
          <Icon name="wrench" class="w-4 h-4" /> Servicios y asesoría
        </a>
        <a href="/granja/contacto" class="inline-flex items-center gap-2 text-dark-text/60 text-sm font-medium hover:text-accent transition-colors">
          <Icon name="message-circle" class="w-4 h-4" /> Escribirnos
        </a>
      </div>
    </div>
  </section>
</BrandLayout>
