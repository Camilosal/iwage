{
  "kind": "collectionType",
  "collectionName": "hero_configuracions",
  "info": {
    "singularName": "hero-configuracion",
    "pluralName": "hero-configuracions",
    "displayName": "Hero Configuración",
    "description": "Hero sections para cada página del sitio"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "pagina": {
      "type": "string",
      "required": true,
      "unique": true,
      "configurable": false
    },
    "slug_ruta": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "titulo": {
      "type": "string",
      "required": true
    },
    "subtitulo": {
      "type": "text"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": false
    },
    "imagen_externa_url": {
      "type": "string",
      "configurable": false
    },
    "cta_primario_texto": {
      "type": "string"
    },
    "cta_primario_url": {
      "type": "string"
    },
    "cta_secundario_texto": {
      "type": "string"
    },
    "cta_secundario_url": {
      "type": "string"
    },
    "color_overlay": {
      "type": "string",
      "default": "from-surface/80 via-surface/70 to-surface/85"
    },
    "orden": {
      "type": "integer",
      "default": 0
    }
  }
}
